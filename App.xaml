            </LinearGradientBrush>

            <!-- Aura Glass Card Style -->
            <Style x:Key="AuraGlassCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppCardBackground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- Elevated Glass Card Style -->
            <Style x:Key="ElevatedGlassCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppCardBackground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- Gaming Turbo Card Style -->
            <Style x:Key="GamingTurboCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppCardBackground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- AI WinCare Engine Card Style -->
            <Style x:Key="AiWinCareEngineCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppCardBackground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- Floating Action Deck Style -->
            <Style x:Key="FloatingActionDeckStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>

            <Style x:Key="VibrantPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PrimaryAccentGradient}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20,10" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootButtonGrid" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <CompositeTransform x:Name="ButtonScaleTransform" ScaleX="1.0" ScaleY="1.0" TranslateY="0" />
                                </Grid.RenderTransform>

                                <!-- 1. Ambient Dynamic Outer Glow Halo -->
                                <Border x:Name="GlowHalo" 
                                        Background="{StaticResource PrimaryAccentGradient}" 
                                        CornerRadius="{TemplateBinding CornerRadius}" 
                                        Opacity="0.0" 
                                        Margin="-3,-2,-3,-2" />

                                <!-- 2. Main Button Body -->
                                <Border x:Name="MainButtonBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{StaticResource AuroraGlowBorderBrush}"
                                        BorderThickness="1.2"
                                        CornerRadius="{TemplateBinding CornerRadius}">
                                    <Grid>
                                        <!-- Top Specular Glass Reflection Sheen -->
                                        <Border Height="1.2" VerticalAlignment="Top" CornerRadius="12,12,0,0" Opacity="0.55">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#FFFFFFFF" Offset="0.5"/>
                                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- Content Presenter -->
                                        <ContentPresenter x:Name="ContentPresenter"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            ContentTransitions="{TemplateBinding ContentTransitions}"
                                            Padding="{TemplateBinding Padding}"
                                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </Grid>
                                </Border>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition To="PointerOver" GeneratedDuration="0:0:0.18">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="TranslateY" To="-1.5" Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="GlowHalo" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.18"/>
                                                </Storyboard>
                                            </VisualTransition>
                                            <VisualTransition To="Pressed" GeneratedDuration="0:0:0.1">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.1">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.1">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="TranslateY" To="1.0" Duration="0:0:0.1">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="GlowHalo" Storyboard.TargetProperty="Opacity" To="0.2" Duration="0:0:0.1"/>
                                                </Storyboard>
                                            </VisualTransition>
                                            <VisualTransition To="Normal" GeneratedDuration="0:0:0.25">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="TranslateY" To="0" Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="GlowHalo" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.25"/>
                                                </Storyboard>
                                            </VisualTransition>
                                        </VisualStateGroup.Transitions>

                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ButtonScaleTransform.ScaleX" Value="1.03" />
                                                <Setter Target="ButtonScaleTransform.ScaleY" Value="1.03" />
                                                <Setter Target="ButtonScaleTransform.TranslateY" Value="-1.5" />
                                                <Setter Target="GlowHalo.Opacity" Value="0.45" />
                                                <Setter Target="MainButtonBorder.BorderBrush" Value="{StaticResource PrimaryAccentGradient}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ButtonScaleTransform.ScaleX" Value="0.97" />
                                                <Setter Target="ButtonScaleTransform.ScaleY" Value="0.97" />
                                                <Setter Target="ButtonScaleTransform.TranslateY" Value="1.0" />
                                                <Setter Target="GlowHalo.Opacity" Value="0.2" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootButtonGrid.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Cleaner Hero Green Button Style (Emerald Purge Button - High Contrast Active / Crisp Muted Disabled) -->
            <Style x:Key="CleanerHeroGreenButtonStyle" TargetType="Button">
                <Setter Property="Background">
