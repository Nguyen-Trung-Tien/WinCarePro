<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WinCarePro.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinCarePro">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <!-- Dark Theme Tokens -->
                    <SolidColorBrush x:Key="AppCardBackground" Color="#221E1E2E" />
                    <SolidColorBrush x:Key="AppCardBorder" Color="#357F56D9" />
                    <SolidColorBrush x:Key="AppCardSubtleBorder" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="AppSecondaryCardBackground" Color="#18182432" />
                    <SolidColorBrush x:Key="AppStatChipBackground" Color="#152A2A3E" />
                    <SolidColorBrush x:Key="AppStatChipBorder" Color="#257F56D9" />
                    <SolidColorBrush x:Key="AppTerminalBackground" Color="#080810" />
                    <SolidColorBrush x:Key="AppTerminalForeground" Color="#00F2FE" />
                    <SolidColorBrush x:Key="AppBadgeGoodBg" Color="#1E10B981" />
                    <SolidColorBrush x:Key="AppBadgeGoodBorder" Color="#4010B981" />
                    <SolidColorBrush x:Key="AppBadgeWarningBg" Color="#1EF59E0B" />
                    <SolidColorBrush x:Key="AppBadgeWarningBorder" Color="#40F59E0B" />
                    <SolidColorBrush x:Key="AppBadgeCriticalBg" Color="#1EEF4444" />
                    <SolidColorBrush x:Key="AppBadgeCriticalBorder" Color="#40EF4444" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <!-- Light Theme Tokens (Ultra High-Contrast, Bold Borders & Vivid Icons) -->
                    <SolidColorBrush x:Key="AppCardBackground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AppCardBorder" Color="#456366F1" />
                    <SolidColorBrush x:Key="AppCardSubtleBorder" Color="#30000000" />
                    <SolidColorBrush x:Key="AppSecondaryCardBackground" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="AppStatChipBackground" Color="#EEF2FF" />
                    <SolidColorBrush x:Key="AppStatChipBorder" Color="#506366F1" />
                    <SolidColorBrush x:Key="AppTerminalBackground" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="AppTerminalForeground" Color="#0F172A" />
                    <SolidColorBrush x:Key="AppBadgeGoodBg" Color="#2210B981" />
                    <SolidColorBrush x:Key="AppBadgeGoodBorder" Color="#8010B981" />
                    <SolidColorBrush x:Key="AppBadgeWarningBg" Color="#22F59E0B" />
                    <SolidColorBrush x:Key="AppBadgeWarningBorder" Color="#80F59E0B" />
                    <SolidColorBrush x:Key="AppBadgeCriticalBg" Color="#22EF4444" />
                    <SolidColorBrush x:Key="AppBadgeCriticalBorder" Color="#80EF4444" />
                    
                    <!-- System Text & Control Overrides for Crisp Light Mode Readability -->
                    <SolidColorBrush x:Key="SystemControlPageTextBaseMediumBrush" Color="#334155" /> <!-- Rich Dark Slate for labels/subtext -->
                    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#CBD5E1" /> <!-- Crisp border stroke -->
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Brand Linear Gradients (Vibrant & Deep Space Neon) -->
            <LinearGradientBrush x:Key="PrimaryAccentGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFA78BFA" Offset="0" /> <!-- Light Purple -->
                <GradientStop Color="#FF3B82F6" Offset="0.5" /> <!-- Electric Blue -->
                <GradientStop Color="#FF22D3EE" Offset="1" /> <!-- Neon Cyan -->
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="CyberAccentGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFC084FC" Offset="0" /> <!-- Cyber Pink-Purple -->
                <GradientStop Color="#FF6366F1" Offset="0.5" /> <!-- Indigo -->
                <GradientStop Color="#FF06B6D4" Offset="1" /> <!-- Cyber Teal -->
            </LinearGradientBrush>

            <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#FF8B5CF6" />
            <SolidColorBrush x:Key="PrimaryAccentLightBrush" Color="#228B5CF6" />
            <SolidColorBrush x:Key="PrimaryAccentBorderBrush" Color="#558B5CF6" />

            <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#407F56D9" Offset="0" />
                <GradientStop Color="#207F56D9" Offset="0.5" />
                <GradientStop Color="#357F56D9" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="CyberGlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#608B5CF6" Offset="0" />
                <GradientStop Color="#257F56D9" Offset="0.5" />
                <GradientStop Color="#4006B6D4" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="HealthGoodGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FF34D399" Offset="0" />
                <GradientStop Color="#FF059669" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="HealthWarningGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FBFB59E0" Offset="0" />
                <GradientStop Color="#FFD97706" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="HealthCriticalGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FFF87171" Offset="0" />
                <GradientStop Color="#FFDC2626" Offset="1" />
            </LinearGradientBrush>

            <!-- Resource Specific Brushes -->
            <SolidColorBrush x:Key="CpuAccentBrush" Color="#FFF59E0B" />
            <SolidColorBrush x:Key="RamAccentBrush" Color="#FF3B82F6" />
            <SolidColorBrush x:Key="GpuAccentBrush" Color="#FF8B5CF6" />
            <SolidColorBrush x:Key="DiskAccentBrush" Color="#FF10B981" />

            <SolidColorBrush x:Key="CpuTrackBrush" Color="#20F59E0B" />
            <SolidColorBrush x:Key="RamTrackBrush" Color="#203B82F6" />
            <SolidColorBrush x:Key="GpuTrackBrush" Color="#208B5CF6" />
            <SolidColorBrush x:Key="DiskTrackBrush" Color="#2010B981" />

            <!-- Card Containers Styling -->
            <Style x:Key="ModernCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppCardBackground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <Style x:Key="GradientBorderCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppCardBackground}" />
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentGradient}" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <Style x:Key="GlowCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppCardBackground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorder}" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <!-- v3.0 Nova — Glassmorphism Card (frosted glass effect) -->
            <Style x:Key="GlassmorphismCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppCardBackground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorder}" />
                <Setter Property="BorderThickness" Value="1.2" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>

            <!-- v3.0 Nova — Quick Stat Card (compact info chip) -->
            <Style x:Key="QuickStatCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppStatChipBackground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppStatChipBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="MinHeight" Value="68" />
            </Style>

            <!-- v3.0 Nova — Status Badge Styles -->
            <Style x:Key="StatusBadgeGoodStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppBadgeGoodBg}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppBadgeGoodBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12,6" />
            </Style>

            <Style x:Key="StatusBadgeWarningStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppBadgeWarningBg}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppBadgeWarningBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12,6" />
            </Style>

            <Style x:Key="StatusBadgeCriticalStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppBadgeCriticalBg}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppBadgeCriticalBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12,6" />
            </Style>

            <!-- v3.0 Nova — Accent Neon Glow Border -->
            <Style x:Key="NeonGlowBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppCardBackground}" />
                <Setter Property="BorderBrush" Value="{StaticResource CyberAccentGradient}" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>

            <Style x:Key="DarkTerminalStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{ThemeResource AppTerminalBackground}" />
                <Setter Property="Foreground" Value="{ThemeResource AppTerminalForeground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorder}" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- Global typography & header standards -->
            <Style x:Key="PageHeaderTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="ExtraBold" />
                <Setter Property="CharacterSpacing" Value="-10" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="PageHeaderSubtitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>

            <Style x:Key="SectionHeaderTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <!-- Global default style for standard buttons -->
            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <!-- Custom transparent button style for title bars and round icon buttons -->
            <Style x:Key="DateTimeFlyoutCalendarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="ContentPresenter"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource ButtonBackgroundPointerOver}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ButtonForegroundPointerOver}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource ButtonBackgroundPressed}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ButtonForegroundPressed}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource ButtonBackgroundDisabled}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ButtonForegroundDisabled}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Transparent button wrapper style for cards -->
            <Style x:Key="TransparentWrapperButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="ContentPresenter"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver" />
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Value Converters -->
            <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <local:StatusToBrushConverter x:Key="StatusToBrushConverter" />
            <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

