                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                                <Setter Target="GlowHalo.Opacity" Value="0.0" />
                                                <Setter Target="RootButtonGrid.Opacity" Value="0.6" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Cleaner Hero Scan Button Style (Violet-Blue Scan Button) -->
            <Style x:Key="CleanerHeroScanButtonStyle" TargetType="Button">
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF7C3AED" Offset="0" />
                            <GradientStop Color="#FF2563EB" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="20,9" />
                <Setter Property="BorderThickness" Value="1.2" />
                <Setter Property="BorderBrush" Value="#407C3AED" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootButtonGrid" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <CompositeTransform x:Name="ButtonScaleTransform" ScaleX="1.0" ScaleY="1.0" TranslateY="0" />
                                </Grid.RenderTransform>

                                <Border x:Name="GlowHalo" 
                                        CornerRadius="{TemplateBinding CornerRadius}" 
                                        Opacity="0.0" 
                                        Margin="-3,-2,-3,-2">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#807C3AED" Offset="0" />
                                            <GradientStop Color="#802563EB" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <Border x:Name="MainButtonBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}">
                                    <Grid>
                                        <Border Height="1.2" VerticalAlignment="Top" CornerRadius="10,10,0,0" Opacity="0.5">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#FFFFFFFF" Offset="0.5"/>
                                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <ContentPresenter x:Name="ContentPresenter"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            ContentTransitions="{TemplateBinding ContentTransitions}"
                                            Padding="{TemplateBinding Padding}"
                                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </Grid>
                                </Border>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition To="PointerOver" GeneratedDuration="0:0:0.18">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.18"/>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.18"/>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="TranslateY" To="-1.5" Duration="0:0:0.18"/>
                                                    <DoubleAnimation Storyboard.TargetName="GlowHalo" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.18"/>
                                                </Storyboard>
                                            </VisualTransition>
                                            <VisualTransition To="Pressed" GeneratedDuration="0:0:0.1">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.1"/>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.1"/>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="TranslateY" To="1.0" Duration="0:0:0.1"/>
                                                    <DoubleAnimation Storyboard.TargetName="GlowHalo" Storyboard.TargetProperty="Opacity" To="0.2" Duration="0:0:0.1"/>
                                                </Storyboard>
                                            </VisualTransition>
                                            <VisualTransition To="Normal" GeneratedDuration="0:0:0.25">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.25"/>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.25"/>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="TranslateY" To="0" Duration="0:0:0.25"/>
                                                    <DoubleAnimation Storyboard.TargetName="GlowHalo" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.25"/>
                                                </Storyboard>
                                            </VisualTransition>
                                        </VisualStateGroup.Transitions>

                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ButtonScaleTransform.ScaleX" Value="1.04" />
                                                <Setter Target="ButtonScaleTransform.ScaleY" Value="1.04" />
                                                <Setter Target="ButtonScaleTransform.TranslateY" Value="-1.5" />
                                                <Setter Target="GlowHalo.Opacity" Value="0.55" />
                                                <Setter Target="MainButtonBorder.BorderBrush" Value="#FFA78BFA" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ButtonScaleTransform.ScaleX" Value="0.96" />
                                                <Setter Target="ButtonScaleTransform.ScaleY" Value="0.96" />
                                                <Setter Target="ButtonScaleTransform.TranslateY" Value="1.0" />
                                                <Setter Target="GlowHalo.Opacity" Value="0.2" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="MainButtonBorder.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                                <Setter Target="MainButtonBorder.BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                                <Setter Target="GlowHalo.Opacity" Value="0.0" />
                                                <Setter Target="RootButtonGrid.Opacity" Value="0.6" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Standard Secondary Button Style (Glassmorphism Pill Button) -->
            <Style x:Key="StandardSecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootButtonGrid" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <CompositeTransform x:Name="ButtonScaleTransform" ScaleX="1.0" ScaleY="1.0" TranslateY="0" />
                                </Grid.RenderTransform>
                                <ContentPresenter x:Name="ContentPresenter"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualStateGroup.Transitions>
                                                <VisualTransition To="PointerOver" GeneratedDuration="0:0:0.15">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="0:0:0.15">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="ScaleY" To="1.025" Duration="0:0:0.15">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="TranslateY" To="-1.0" Duration="0:0:0.15">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </VisualTransition>
                                                <VisualTransition To="Pressed" GeneratedDuration="0:0:0.1">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.1">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.1">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="TranslateY" To="1.0" Duration="0:0:0.1">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </VisualTransition>
                                                <VisualTransition To="Normal" GeneratedDuration="0:0:0.2">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform" Storyboard.TargetProperty="TranslateY" To="0" Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </VisualTransition>
                                            </VisualStateGroup.Transitions>
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                                    <Setter Target="ContentPresenter.BorderBrush" Value="{StaticResource PrimaryAccentBrush}" />
                                                    <Setter Target="ButtonScaleTransform.ScaleX" Value="1.025" />
                                                    <Setter Target="ButtonScaleTransform.ScaleY" Value="1.025" />
                                                    <Setter Target="ButtonScaleTransform.TranslateY" Value="-1.0" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                                    <Setter Target="ContentPresenter.Opacity" Value="0.85" />
                                                    <Setter Target="ButtonScaleTransform.ScaleX" Value="0.97" />
                                                    <Setter Target="ButtonScaleTransform.ScaleY" Value="0.97" />
                                                    <Setter Target="ButtonScaleTransform.TranslateY" Value="1.0" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Target="ContentPresenter.Opacity" Value="0.45" />
                                                    <Setter Target="RootButtonGrid.Opacity" Value="0.45" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </ContentPresenter>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Global Default Button Style (Master Unified Secondary Button) -->
            <Style x:Key="DefaultButtonStyle" TargetType="Button" BasedOn="{StaticResource StandardSecondaryButtonStyle}" />

            <!-- Global Accent Button Style (Master Unified Primary Gradient Button) -->
            <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource VibrantPrimaryButtonStyle}">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,7" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
            </Style>

            <!-- Destructive / Danger Action Button Style (Red Glass Glow) -->
            <Style x:Key="DangerButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AppBadgeCriticalBg}" />
                <Setter Property="Foreground" Value="{ThemeResource AppBadgeCriticalFg}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppBadgeCriticalBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootButtonGrid" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <CompositeTransform x:Name="ButtonScaleTransform" ScaleX="1.0" ScaleY="1.0" TranslateY="0" />
                                </Grid.RenderTransform>
                                <ContentPresenter x:Name="ContentPresenter"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="ContentPresenter.Background" Value="#FFEF4444" />
                                                    <Setter Target="ContentPresenter.Foreground" Value="White" />
                                                    <Setter Target="ContentPresenter.BorderBrush" Value="#FFDC2626" />
                                                    <Setter Target="ButtonScaleTransform.ScaleX" Value="1.03" />
                                                    <Setter Target="ButtonScaleTransform.ScaleY" Value="1.03" />
                                                    <Setter Target="ButtonScaleTransform.TranslateY" Value="-1.0" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="ContentPresenter.Background" Value="#FFDC2626" />
                                                    <Setter Target="ContentPresenter.Foreground" Value="White" />
                                                    <Setter Target="ButtonScaleTransform.ScaleX" Value="0.96" />
                                                    <Setter Target="ButtonScaleTransform.ScaleY" Value="0.96" />
                                                    <Setter Target="ButtonScaleTransform.TranslateY" Value="1.0" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Target="RootButtonGrid.Opacity" Value="0.45" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </ContentPresenter>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Success Action Button Style (Emerald Glass Glow) -->
            <Style x:Key="SuccessButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AppBadgeGoodBg}" />
                <Setter Property="Foreground" Value="{ThemeResource AppBadgeGoodFg}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppBadgeGoodBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootButtonGrid" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <CompositeTransform x:Name="ButtonScaleTransform" ScaleX="1.0" ScaleY="1.0" TranslateY="0" />
                                </Grid.RenderTransform>
                                <ContentPresenter x:Name="ContentPresenter"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="ContentPresenter.Background" Value="#FF10B981" />
                                                    <Setter Target="ContentPresenter.Foreground" Value="White" />
                                                    <Setter Target="ContentPresenter.BorderBrush" Value="#FF059669" />
                                                    <Setter Target="ButtonScaleTransform.ScaleX" Value="1.03" />
                                                    <Setter Target="ButtonScaleTransform.ScaleY" Value="1.03" />
                                                    <Setter Target="ButtonScaleTransform.TranslateY" Value="-1.0" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="ContentPresenter.Background" Value="#FF059669" />
                                                    <Setter Target="ContentPresenter.Foreground" Value="White" />
                                                    <Setter Target="ButtonScaleTransform.ScaleX" Value="0.96" />
                                                    <Setter Target="ButtonScaleTransform.ScaleY" Value="0.96" />
                                                    <Setter Target="ButtonScaleTransform.TranslateY" Value="1.0" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Target="RootButtonGrid.Opacity" Value="0.45" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </ContentPresenter>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Compact Action Button Style (for items in tables/lists/cards) -->
            <Style x:Key="CompactActionButtonStyle" TargetType="Button" BasedOn="{StaticResource StandardSecondaryButtonStyle}">
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="10,2" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>

            <!-- Power Option Item Button Style (Solid, perfectly contrast in Dark & Light) -->
            <Style x:Key="PowerOptionItemButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AppFlyoutItemBackground}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppFlyoutItemBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="ContentPresenter"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
