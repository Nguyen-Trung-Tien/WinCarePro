<Page
    x:Class="WinCarePro.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Background="Transparent">
        <!-- OpenPaneLength set to 220px, CompactPaneLength to 60px -->
        <NavigationView x:Name="NavView" PaneDisplayMode="Auto" SelectionChanged="OnNavSelectionChanged" BackRequested="OnNavBackRequested" IsBackButtonVisible="Auto" AlwaysShowHeader="False" IsSettingsVisible="True" OpenPaneLength="220" CompactPaneLength="60" Background="Transparent">

            <!-- v5.2 Spatial Glass — User Profile Capsule in Pane Footer -->
            <NavigationView.PaneFooter>
                <StackPanel Padding="0,0,0,12">
                    <!-- User Profile Chip at the bottom — Spatial Glass pill button with full keyboard navigation -->
                    <Button x:Name="UserProfileButton" Margin="8,0,8,4" Padding="8,6" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource StandardSecondaryButtonStyle}" Click="OnUserProfileClick" helpers:AnimationHelper.HoverScale="1.02" helpers:AnimationHelper.PressedScale="0.98" AutomationProperties.Name="User Profile Settings" AutomationProperties.HelpText="Open Settings page to configure user preferences and application options.">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border x:Name="UserAvatarBorder" Width="32" Height="32" CornerRadius="16" Background="{StaticResource CyberAccentGradient}">
                                    <FontIcon Glyph="&#xE77B;" FontSize="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <!-- Online Status Beacon -->
                                <Border Width="9" Height="9" CornerRadius="4.5" Background="#FF10B981" BorderBrush="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="10,0,0,0" Visibility="{x:Bind NavView.IsPaneOpen, Mode=OneWay}">
                                <TextBlock x:Name="NavUserName" Text="User" FontSize="12.5" FontWeight="Bold" Foreground="{ThemeResource NavigationViewItemForeground}" TextTrimming="CharacterEllipsis" MaxWidth="130" FontFamily="Segoe UI Variable Display"/>
                                <TextBlock x:Name="NavMachineName" Text="PC" FontSize="11" Foreground="{ThemeResource NavigationViewItemHeaderForeground}" TextTrimming="CharacterEllipsis" MaxWidth="130" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
            </NavigationView.PaneFooter>

            <NavigationView.MenuItems>
                <!-- GROUP 1: OVERVIEW & AI -->
                <NavigationViewItemHeader x:Name="NavHeaderOverview" Content="CORE HUBS" />

                <NavigationViewItem x:Name="NavDashboard" Tag="Dashboard" Content="Smart Cockpit" AutomationProperties.Name="Smart Cockpit" AutomationProperties.HelpText="Overview of system health, hardware telemetry, and one-click quick boost.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" Foreground="{StaticResource PrimaryAccentBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavAi" Tag="AiWinCareEngine" Content="Smart Diagnostics" Visibility="Visible" AutomationProperties.Name="Smart Diagnostics" AutomationProperties.HelpText="Intelligent multi-factor system diagnostics and automated remedies.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE99A;" Foreground="{ThemeResource AppStatusCyanBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                
                <!-- GROUP 2: CLEAN & STORAGE -->
                <NavigationViewItemSeparator x:Name="NavSepClean" Visibility="Visible" />
                <NavigationViewItemHeader x:Name="NavHeaderClean" Content="CLEAN &amp; STORAGE" Visibility="Visible" />
                
                <NavigationViewItem x:Name="NavJunk" Tag="Junk" Content="Deep Cleaner" AutomationProperties.Name="Deep Cleaner" AutomationProperties.HelpText="Scan and safely clean temporary files, cache, system clutter, and registry entries.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA99;" Foreground="{ThemeResource AppStatusWarningBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavRegistry" Tag="Registry" Content="Registry Center" Visibility="Visible" AutomationProperties.Name="Registry Center" AutomationProperties.HelpText="Registry backup, defragmentation, and cleanup.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDA2;" Foreground="{ThemeResource AppStatusDangerBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavUninstall" Tag="Uninstall" Content="App Studio" AutomationProperties.Name="App Studio" AutomationProperties.HelpText="Uninstall desktop/Store apps and update third-party software.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource AppStatusDangerBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavUpdater" Tag="Updater" Content="Software Updater" Visibility="Visible" AutomationProperties.Name="Software Updater" AutomationProperties.HelpText="Scan and update installed third-party software applications.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" Foreground="{ThemeResource AppStatusPurpleBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- GROUP 3: SPEED & PERFORMANCE -->
                <NavigationViewItemSeparator x:Name="NavSepSpeed" Visibility="Visible" />
                <NavigationViewItemHeader x:Name="NavHeaderSpeed" Content="SPEED &amp; PERFORMANCE" Visibility="Visible" />

                <NavigationViewItem x:Name="NavOptimizer" Tag="Optimizer" Content="System Optimizer" AutomationProperties.Name="System Optimizer" AutomationProperties.HelpText="System tweaks, RAM boost, boot startup manager, and shell context menu.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" Foreground="{ThemeResource AppStatusWarningBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavStartup" Tag="Startup" Content="Startup &amp; Services" Visibility="Visible" AutomationProperties.Name="Startup &amp; Services Manager" AutomationProperties.HelpText="Manage and accelerate Windows boot apps, daemon states, and background velocity.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B5;" Foreground="{ThemeResource AppStatusPurpleBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavContextMenu" Tag="ContextMenu" Content="Context Menu" Visibility="Visible" AutomationProperties.Name="Context Menu Manager" AutomationProperties.HelpText="Manage and clean Windows Explorer right-click shell extensions.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EC;" Foreground="{ThemeResource AppStatusPurpleBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- GROUP 4: SECURITY & REPAIR -->
                <NavigationViewItemSeparator x:Name="NavSepSecurity" Visibility="Visible" />
                <NavigationViewItemHeader x:Name="NavHeaderSecurity" Content="SECURITY &amp; REPAIR" Visibility="Visible" />

                <NavigationViewItem x:Name="NavRepair" Tag="Repair" Content="System Doctor" AutomationProperties.Name="System Doctor" AutomationProperties.HelpText="Windows system file checker, DISM repair, and network diagnostics.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" Foreground="{ThemeResource AppStatusCyanBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavNetwork" Tag="Network" Content="Network Center" Visibility="Visible" AutomationProperties.Name="Network Center" AutomationProperties.HelpText="Network monitoring, DNS benchmark, and latency diagnostics.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE701;" Foreground="{ThemeResource AppStatusInfoBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavSecurity" Tag="Security" Content="Security Shield" AutomationProperties.Name="Security Shield" AutomationProperties.HelpText="Windows Defender, Firewall, and privacy telemetry settings.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE727;" Foreground="{ThemeResource AppStatusGoodBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

            </NavigationView.MenuItems>

            <!-- Navigation Frame Content Area + Contextual Hub Sub-Navigation Pill Bar -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Contextual Hub Sub-Navigation Bar (1-Click Switch between Integrated Hub Tools) -->
                <Border x:Name="HubSubNavBar" Grid.Row="0" Margin="28,10,28,0" Padding="6,5" CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" HorizontalAlignment="Left" Visibility="Visible">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="HubTabBtn1" Click="OnHubSubTabClick" Tag="Dashboard" CornerRadius="8" Padding="12,5" Style="{StaticResource VibrantPrimaryButtonStyle}" AutomationProperties.Name="Primary Hub View">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon x:Name="HubTabIcon1" Glyph="&#xE80F;" FontSize="12.5"/>
                                <TextBlock x:Name="HubTabText1" Text="Smart Cockpit" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="HubTabBtn2" Click="OnHubSubTabClick" Tag="AiWinCareEngine" CornerRadius="8" Padding="12,5" Style="{StaticResource StandardSecondaryButtonStyle}" AutomationProperties.Name="Secondary Hub View">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon x:Name="HubTabIcon2" Glyph="&#xE99A;" FontSize="12.5"/>
                                <TextBlock x:Name="HubTabText2" Text="Smart Diagnostics" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="HubTabBtn3" Click="OnHubSubTabClick" Tag="ContextMenu" Visibility="Collapsed" CornerRadius="8" Padding="12,5" Style="{StaticResource StandardSecondaryButtonStyle}" AutomationProperties.Name="Tertiary Hub View">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon x:Name="HubTabIcon3" Glyph="&#xE8EC;" FontSize="12.5"/>
                                <TextBlock x:Name="HubTabText3" Text="Context Menu" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Frame x:Name="ContentFrame" Grid.Row="1" Margin="0,4,0,0">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <NavigationThemeTransition>
                                <EntranceNavigationTransitionInfo />
                            </NavigationThemeTransition>
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>
            </Grid>
        </NavigationView>
    </Grid>
</Page>
