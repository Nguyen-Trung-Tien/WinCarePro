<Page
    x:Class="WinCarePro.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    mc:Ignorable="d">

    <Grid>
        <!-- OpenPaneLength set to 220px, CompactPaneLength to 60px -->
        <NavigationView x:Name="NavView" PaneDisplayMode="Auto" SelectionChanged="OnNavSelectionChanged" IsBackButtonVisible="Collapsed" AlwaysShowHeader="False" IsSettingsVisible="True" OpenPaneLength="220" CompactPaneLength="60">

            <!-- v3.0 Nova — User Chip in Pane Footer -->
            <NavigationView.PaneFooter>
                <StackPanel Padding="0,0,0,12">
                    <!-- User Profile Chip at the bottom -->
                    <Border Margin="8,4,8,4" Padding="6" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            helpers:AnimationHelper.HoverScale="1.03" helpers:AnimationHelper.PressedScale="0.97">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="{StaticResource CyberAccentGradient}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE77B;" FontSize="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="10,0,0,0" Visibility="{x:Bind NavView.IsPaneOpen, Mode=OneWay}">
                                <TextBlock x:Name="NavUserName" Text="User" FontSize="12.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                <TextBlock x:Name="NavMachineName" Text="PC" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </NavigationView.PaneFooter>

            <NavigationView.MenuItems>
                <!-- Dashboard View -->
                <NavigationViewItem Content="Dashboard" Tag="Dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" Foreground="{StaticResource PrimaryAccentBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- v4.0.0 Breakthrough Evolution Items -->
                <NavigationViewItem Content="🤖 AI Health Copilot" Tag="AiCopilot">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" Foreground="#FF06B6D4" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="⚡ Gaming Turbo 2.0" Tag="GamingTurbo">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" Foreground="#FFF59E0B" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                
                <NavigationViewItemSeparator />

                <!-- CARE & CLEAN -->
                <NavigationViewItemHeader Content="CARE &amp; CLEAN" />
                
                <NavigationViewItem Content="Junk Cleaner" Tag="Junk">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA99;" Foreground="Orange" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="App Uninstaller" Tag="Uninstall">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;" Foreground="Red" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Network Center" Tag="Network">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" Foreground="DodgerBlue" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="System Repair" Tag="Repair">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" Foreground="Teal" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Security Shield" Tag="Security">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE727;" Foreground="MediumSpringGreen" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />

                <!-- SYSTEM TUNING -->
                <NavigationViewItemHeader Content="SYSTEM TUNING" />

                <NavigationViewItem Content="System Optimizer" Tag="Optimizer">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" Foreground="MediumPurple" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Context Menu" Tag="ContextMenu">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" Foreground="Thistle" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Startup &amp; Services" Tag="Startup">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B5;" Foreground="Gold" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>


                <NavigationViewItem Content="Disk Tools" Tag="Disk">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F1;" Foreground="SkyBlue" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>


                <NavigationViewItem Content="Registry Center" Tag="Registry">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDA2;" Foreground="Tomato" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Software Updater" Tag="Updater">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE75C;" Foreground="Crimson" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>


            </NavigationView.MenuItems>

            <!-- Navigation Frame Content Area -->
            <Frame x:Name="ContentFrame" Margin="0,4,0,0">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition>
                            <EntranceNavigationTransitionInfo />
                        </NavigationThemeTransition>
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>
    </Grid>
</Page>

