<Page
    x:Class="WinCarePro.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    mc:Ignorable="d">

    <Grid>
        <!-- OpenPaneLength set to 220px, CompactPaneLength to 60px -->
        <NavigationView x:Name="NavView" PaneDisplayMode="Auto" SelectionChanged="OnNavSelectionChanged" IsBackButtonVisible="Collapsed" AlwaysShowHeader="False" IsSettingsVisible="True" OpenPaneLength="220" CompactPaneLength="60">

            <!-- v3.0 Nova — User Chip in Pane Footer -->
            <NavigationView.PaneFooter>
                <StackPanel Padding="0,0,0,12">
                    <!-- User Profile Chip at the bottom — Soft rounded pill -->
                    <Border x:Name="UserProfileBorder" Margin="6,4,6,4" Padding="6,5" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" PointerPressed="OnUserProfileClick" helpers:AnimationHelper.HoverScale="1.03" helpers:AnimationHelper.PressedScale="0.97">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="UserAvatarBorder" Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="{StaticResource CyberAccentGradient}" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE77B;" FontSize="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="8,0,0,0" Visibility="{x:Bind NavView.IsPaneOpen, Mode=OneWay}">
                                <TextBlock x:Name="NavUserName" Text="User" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                                <TextBlock x:Name="NavMachineName" Text="PC" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </NavigationView.PaneFooter>

            <NavigationView.MenuItems>
                <!-- Dashboard View -->
                <NavigationViewItem Content="Dashboard" Tag="Dashboard" AutomationProperties.Name="Dashboard" AutomationProperties.HelpText="Overview of system health, hardware telemetry, and one-click quick boost.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" Foreground="{ThemeResource PrimaryAccentBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="AI WinCare Engine" Tag="AiWinCareEngine" AutomationProperties.Name="AI WinCare Engine" AutomationProperties.HelpText="Intelligent multi-factor system diagnostics and automated remedies.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE99A;" Foreground="{ThemeResource PrimaryAccentBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                
                <NavigationViewItemSeparator />

                <!-- CARE & CLEAN -->
                <NavigationViewItemHeader Content="CARE &amp; CLEAN" />
                
                <NavigationViewItem Content="Junk Cleaner" Tag="Junk" AutomationProperties.Name="Junk Cleaner" AutomationProperties.HelpText="Scan and safely clean temporary files, cache, and system clutter.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA99;" Foreground="{ThemeResource PrimaryAccentBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="App Uninstaller" Tag="Uninstall" AutomationProperties.Name="App Uninstaller" AutomationProperties.HelpText="Uninstall desktop and Store apps with deep leftover cleanup.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource PrimaryAccentBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Network Center" Tag="Network" AutomationProperties.Name="Network Center" AutomationProperties.HelpText="Network monitoring, DNS benchmark, and latency diagnostics.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE701;" Foreground="{ThemeResource PrimaryAccentBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="System Repair" Tag="Repair" AutomationProperties.Name="System Repair" AutomationProperties.HelpText="Windows system file checker, DISM repair, and subsystem restoration.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" Foreground="{ThemeResource PrimaryAccentBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Security Shield" Tag="Security" AutomationProperties.Name="Security Shield" AutomationProperties.HelpText="Windows Defender, Firewall, and privacy telemetry settings.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE727;" Foreground="{ThemeResource PrimaryAccentBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />

                <!-- SYSTEM TUNING -->
                <NavigationViewItemHeader Content="SYSTEM TUNING" />

                <NavigationViewItem Content="System Optimizer" Tag="Optimizer" AutomationProperties.Name="System Optimizer" AutomationProperties.HelpText="System tweaks, RAM working set optimization, and performance profiles.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" Foreground="{ThemeResource PrimaryAccentBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Gaming Turbo" Tag="GamingTurbo" AutomationProperties.Name="Gaming Turbo" AutomationProperties.HelpText="High performance power scheme and background priority tuning.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE785;" Foreground="{ThemeResource PrimaryAccentBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Context Menu" Tag="ContextMenu" AutomationProperties.Name="Context Menu Manager" AutomationProperties.HelpText="Manage and clean Windows Explorer right-click shell extensions.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EC;" Foreground="{ThemeResource PrimaryAccentBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Startup &amp; Services" Tag="Startup" AutomationProperties.Name="Startup &amp; Services" AutomationProperties.HelpText="Manage startup applications and Windows background services.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B5;" Foreground="{ThemeResource PrimaryAccentBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Disk &amp; Storage" Tag="Disk" AutomationProperties.Name="Disk &amp; Storage" AutomationProperties.HelpText="Drive S.M.A.R.T. health, duplicate finder, and large files analyzer.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F1;" Foreground="{ThemeResource PrimaryAccentBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Registry Center" Tag="Registry" AutomationProperties.Name="Registry Center" AutomationProperties.HelpText="Registry backup, defragmentation, and cleanup.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDA2;" Foreground="{ThemeResource PrimaryAccentBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Software Updater" Tag="Updater" AutomationProperties.Name="Software Updater" AutomationProperties.HelpText="Scan and update installed third-party software applications.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" Foreground="{ThemeResource PrimaryAccentBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

            </NavigationView.MenuItems>

            <!-- Navigation Frame Content Area -->
            <Frame x:Name="ContentFrame" Margin="0,4,0,0">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition>
                            <SlideNavigationTransitionInfo Effect="FromRight" />
                        </NavigationThemeTransition>
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>
    </Grid>
</Page>

