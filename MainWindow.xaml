<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WinCarePro.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinCarePro"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="WinCarePro"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Ambient Aura Glow Mesh (Dynamic Background Depth) -->
        <Grid x:Name="AmbientAuraMesh" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False" Canvas.ZIndex="0" Opacity="0.85">
            <!-- Top-Right Accent Ambient Glow -->
            <Ellipse Width="700" Height="480" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-140,-140,0" Opacity="0.10">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop x:Name="AuraGlowStop1" Color="#FF3B82F6" Offset="0" />
                        <GradientStop Color="#003B82F6" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- Center Spatial Sub-Aura Glow -->
            <Ellipse Width="520" Height="340" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.05">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#FF06B6D4" Offset="0" />
                        <GradientStop Color="#0006B6D4" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- Bottom-Left Complementary Ambient Glow -->
            <Ellipse Width="600" Height="420" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-120,0,0,-120" Opacity="0.08">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop x:Name="AuraGlowStop2" Color="#FF8B5CF6" Offset="0" />
                        <GradientStop Color="#008B5CF6" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- Center-Right Vitality Pulse Glow -->
            <Ellipse Width="500" Height="360" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,80,-100,0" Opacity="0.06">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#FF10B981" Offset="0" />
                        <GradientStop Color="#0010B981" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- Custom Title Bar Grid — v3.0 Nova -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Height="56" Background="Transparent" Canvas.ZIndex="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />  <!-- Logo & Brand -->
                <ColumnDefinition Width="*" />     <!-- Drag Area & Search -->
                <ColumnDefinition Width="Auto" />  <!-- Right Controls -->
            </Grid.ColumnDefinitions>

            <!-- Drag Area Canvas (Acts as window drag region) -->
            <Grid x:Name="AppTitleDragArea" Grid.ColumnSpan="3" Background="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />

            <!-- Brand (Left) — Modern Spatial Glass Brand Badge -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Padding="16,0,8,0" VerticalAlignment="Center" Spacing="8" Canvas.ZIndex="10">
                <Grid Width="26" Height="26" VerticalAlignment="Center">
                    <Border CornerRadius="8" Background="{StaticResource PrimaryAccentGradient}" Padding="3">
                        <Image Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="Uniform"/>
                    </Border>
                </Grid>
                <TextBlock Text="WinCare Pro" FontFamily="Segoe UI Variable Display" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Background="{StaticResource PrimaryAccentLightBrush}" BorderBrush="{ThemeResource PrimaryAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock x:Name="AppTitleVersionBadge" Text="v5.2.0" FontSize="9" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- Search (Center) — Floating Spotlight Command Capsule -->
            <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" MaxWidth="460" Margin="16,0" Height="36" Canvas.ZIndex="10">
                <AutoSuggestBox x:Name="SearchBox" 
                                PlaceholderText="Search tools, diagnostics, settings... (Ctrl + K)" 
                                QueryIcon="Find" 
                                CornerRadius="12" 
                                HorizontalAlignment="Stretch" 
                                VerticalAlignment="Center" 
                                QuerySubmitted="OnSearchQuerySubmitted"
                                TextChanged="OnSearchTextChanged"
                                SuggestionChosen="OnSearchSuggestionChosen">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{Binding IconGlyph}" FontSize="15" Foreground="{ThemeResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </Grid>

            <!-- Controls (Right) — Unified Spatial Glass Action Island -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Padding="0,0,140,0" VerticalAlignment="Center" Canvas.ZIndex="10">
                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="14" 
                        Padding="4,3">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <!-- Telemetry Chips Subgroup -->
                        <Button x:Name="CpuChipButton" Style="{StaticResource TelemetryChipButtonStyle}" CornerRadius="10" Click="OnCpuChipClick" ToolTipService.ToolTip="CPU Usage Monitor — Click to view Dashboard performance" AutomationProperties.Name="CPU Usage Monitor" AutomationProperties.HelpText="Click to view real-time CPU diagnostics and telemetry on the Dashboard.">
                            <Border Background="{ThemeResource AppCpuChipBg}" BorderBrush="{ThemeResource AppCpuChipBorder}" BorderThickness="1" CornerRadius="9" Padding="7,3">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource AppCpuChipFg}" VerticalAlignment="Center"/>
                                    <FontIcon Glyph="&#xE9D9;" FontSize="11" Foreground="{ThemeResource AppCpuChipFg}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CpuChipText" Text="CPU" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource AppCpuChipFg}" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <Button x:Name="RamChipButton" Style="{StaticResource TelemetryChipButtonStyle}" CornerRadius="10" Click="OnRamChipClick" ToolTipService.ToolTip="RAM Memory Booster — Click for 1-Click RAM Purge" AutomationProperties.Name="RAM Working Set Booster" AutomationProperties.HelpText="Click to trigger instant memory cache reclamation.">
                            <Border Background="{ThemeResource AppRamChipBg}" BorderBrush="{ThemeResource AppRamChipBorder}" BorderThickness="1" CornerRadius="9" Padding="7,3">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource AppRamChipFg}" VerticalAlignment="Center"/>
                                    <FontIcon Glyph="&#xE7F1;" FontSize="11" Foreground="{ThemeResource AppRamChipFg}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RamChipText" Text="RAM" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource AppRamChipFg}" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- Sleek Vertical Hairline Divider -->
                        <Rectangle Width="1" Height="18" Fill="{ThemeResource ControlStrokeColorDefaultBrush}" Opacity="0.5" Margin="2,0"/>

                        <!-- Live Clock -->
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="4,0,4,0">
                            <FontIcon Glyph="&#xE787;" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ClockText" Text="--:--" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" AutomationProperties.Name="System Clock" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>

                        <!-- Sleek Vertical Hairline Divider -->
                        <Rectangle Width="1" Height="18" Fill="{ThemeResource ControlStrokeColorDefaultBrush}" Opacity="0.5" Margin="2,0"/>

                        <!-- Quick Action Controls -->
                        <Button x:Name="UserGuideButton" Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Width="28" Height="28" CornerRadius="8" Padding="0" Click="UserGuideButton_Click" ToolTipService.ToolTip="User Guide &amp; Documentation" AutomationProperties.Name="User Guide &amp; Documentation" AutomationProperties.HelpText="Open comprehensive user guide and technical documentation.">
                            <FontIcon Glyph="&#xE897;" FontSize="12.5" />
                        </Button>

                        <Button x:Name="ThemeButton" Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Width="28" Height="28" CornerRadius="8" Padding="0" Click="ThemeButton_Click" ToolTipService.ToolTip="Toggle Theme" AutomationProperties.Name="Toggle Theme" AutomationProperties.HelpText="Switch between Light and Dark interface appearance.">
                            <FontIcon x:Name="ThemeIcon" Glyph="&#xE706;" FontSize="12.5" />
                        </Button>

                        <Button x:Name="NotificationButton" Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Width="28" Height="28" CornerRadius="8" Padding="0" Click="NotificationButton_Click" ToolTipService.ToolTip="Notifications" AutomationProperties.Name="Notifications" AutomationProperties.HelpText="Open notification center and review recent system alerts.">
                            <Grid>
                                <FontIcon Glyph="&#xEA8F;" FontSize="12.5" />
                                <Border x:Name="NotificationBadge" Background="{ThemeResource AppStatusDangerBrush}" Width="7" Height="7" CornerRadius="3.5" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="2,-1,-1,2" Visibility="Collapsed" AutomationProperties.Name="Unread notification alert" AutomationProperties.LiveSetting="Polite"/>
                            </Grid>
                        </Button>

                        <Button x:Name="ExitAppButton" Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Width="28" Height="28" CornerRadius="8" Padding="0" ToolTipService.ToolTip="Power Options" AutomationProperties.Name="Power Options" AutomationProperties.HelpText="Open power options to minimize to tray or close application.">
                            <FontIcon Glyph="&#xE7E8;" FontSize="12.5" Foreground="{ThemeResource AppStatusDangerBrush}" />
                            <Button.Flyout>
                                <MenuFlyout x:Name="ExitPowerFlyout" Placement="BottomEdgeAlignedRight" Opening="ExitPowerFlyout_Opening">
                                    <MenuFlyoutItem x:Name="MenuMinimizeToTray" Text="Minimize to Tray" Click="OnMinimizeToTrayClick" AutomationProperties.Name="Minimize to Tray">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE718;" FontSize="14" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="MenuShutdown" Text="Shutdown" Click="OnConfirmShutdownClick" AutomationProperties.Name="Shutdown Application">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE7E8;" FontSize="14" Foreground="{ThemeResource AppStatusDangerBrush}"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Subtle Refractive Fluent Glass Border under Title Bar -->
        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{ThemeResource ControlStrokeColorDefaultBrush}" Opacity="0.2" Canvas.ZIndex="5" />

        <!-- Main Frame -->
        <Frame x:Name="RootFrame" Grid.Row="1" />

        <!-- Dynamic Toast Notification Container (Top-Center Floating Island) -->
        <ScrollViewer Grid.Row="0" Grid.RowSpan="2"
                      VerticalAlignment="Top"
                      HorizontalAlignment="Center"
                      Margin="0,58,0,0"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      Width="400"
                      MaxHeight="260"
                      Canvas.ZIndex="3000">
            <StackPanel x:Name="ToastContainer" Spacing="8" VerticalAlignment="Top" HorizontalAlignment="Center" />
        </ScrollViewer>

        <!-- Exit Overlay Grid (Cyber Farewell Graceful Power-Down) -->
        <Grid x:Name="ExitOverlayGrid" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Canvas.ZIndex="1000" Opacity="0">
            <Grid.Resources>
                <Storyboard x:Name="FadeInExitOverlay">
                    <DoubleAnimation Storyboard.TargetName="ExitOverlayGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ExitOverlayContent" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="30" To="0" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </Grid.Resources>

            <!-- Background Ambient Glowing Mesh -->
            <Grid x:Name="AmbientGlowContainer">
                <!-- Outer Radial Glow Circle 1 -->
                <Ellipse Width="500" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.18">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFF43F5E" Offset="0" />
                            <GradientStop Color="#FF8B5CF6" Offset="0.6" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!-- Outer Radial Glow Circle 2 -->
                <Ellipse Width="380" Height="380" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="60,30,0,0" Opacity="0.14">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFEF4444" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                
                <!-- Frosted Glass Layer with Theme Adaptation -->
                <Border BorderThickness="0" Background="{ThemeResource AppOverlayBackdropBrush}" />
            </Grid>
            
            <StackPanel x:Name="ExitOverlayContent" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" Width="400">
                <StackPanel.RenderTransform>
                    <TranslateTransform Y="30" />
                </StackPanel.RenderTransform>
                
                <!-- Clean App Logo with Radial Aura Glow -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="144" Height="144">
                    <Ellipse Width="140" Height="140" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#FF0284C7" Offset="0" />
                                <GradientStop Color="#FFF43F5E" Offset="0.6" />
                                <GradientStop Color="Transparent" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Image Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" Width="136" Height="136" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"/>
                </Grid>
                
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock x:Name="ExitOverlayTitle" Text="Shutting Down" FontSize="24" FontWeight="ExtraBold" FontFamily="Segoe UI Variable Display" HorizontalAlignment="Center" Foreground="{ThemeResource AppOverlayTitleBrush}" CharacterSpacing="0.5"/>
                    <TextBlock x:Name="ExitOverlayMessage" Text="Closing database connections and freeing resources..." FontSize="13" Foreground="{ThemeResource AppOverlaySubtitleBrush}" HorizontalAlignment="Center" FontWeight="Medium" TextAlignment="Center"/>
                </StackPanel>

                <!-- Exit Percentage Progress Bar Container -->
                <StackPanel Spacing="8" Margin="0,4,0,0">
                    <Grid>
                        <TextBlock x:Name="ExitProgressSubtext" Text="Finalizing shutdown..." FontSize="12.5" Foreground="{ThemeResource AppOverlayTextBrush}" HorizontalAlignment="Left" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ExitProgressPercent" Text="0%" FontSize="13" Foreground="{ThemeResource AppOverlayShutdownPercentBrush}" HorizontalAlignment="Right" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                    </Grid>
                    <Border Background="{ThemeResource AppOverlayTrackBgBrush}" CornerRadius="5" Height="10" BorderBrush="{ThemeResource AppOverlayTrackBorderBrush}" BorderThickness="1" Padding="1.5">
                        <ProgressBar x:Name="ExitProgressBar" Minimum="0" Maximum="100" Value="0" Height="6" CornerRadius="3" Foreground="{ThemeResource AppOverlayShutdownProgressBrush}" Background="Transparent" HorizontalAlignment="Stretch"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Startup Overlay Grid (Aura Genesis Cinematic Loader) -->
        <Grid x:Name="StartupOverlayGrid" Grid.Row="0" Grid.RowSpan="2" Visibility="Visible" Canvas.ZIndex="1100" Opacity="1">
            <Grid.Resources>
                <Storyboard x:Name="FadeOutStartupOverlay" Completed="FadeOutStartupOverlay_Completed">
                    <DoubleAnimation Storyboard.TargetName="StartupOverlayGrid" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.6">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </Grid.Resources>

            <!-- Background Ambient Glowing Mesh -->
            <Grid x:Name="StartupAmbientGlowContainer">
                <!-- Outer Radial Glow Circle 1 -->
                <Ellipse Width="500" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.16">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF8B5CF6" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!-- Outer Radial Glow Circle 2 -->
                <Ellipse Width="400" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="100,50,0,0" Opacity="0.12">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF06B6D4" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                
                <!-- Frosted Glass Layer with Theme Adaptation -->
                <Border BorderThickness="0" Background="{ThemeResource AppOverlayBackdropBrush}" />
            </Grid>
            
            <StackPanel x:Name="StartupOverlayContent" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" Width="380">
                <!-- App Logo with Neon Blue Aura Glow -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="156" Height="156">
                    <Ellipse Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.45">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#FF38BDF8" Offset="0" />
                                <GradientStop Color="#FF0284C7" Offset="0.6" />
                                <GradientStop Color="Transparent" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Image Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" Width="148" Height="148" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"/>
                </Grid>
                
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="WinCare Pro" FontSize="26" FontWeight="ExtraBold" FontFamily="Segoe UI Variable Display" HorizontalAlignment="Center" Foreground="{ThemeResource AppOverlayTitleBrush}" CharacterSpacing="0.5"/>
                    <TextBlock Text="System Optimization &amp; Care Suite" FontSize="13" Foreground="{ThemeResource AppOverlaySubtitleBrush}" HorizontalAlignment="Center" FontWeight="Medium"/>
                </StackPanel>

                <!-- Modern Percentage Progress Bar Container -->
                <StackPanel Spacing="8" Margin="0,6,0,0">
                    <Grid>
                        <TextBlock x:Name="StartupProgressText" Text="Loading systems..." FontSize="12.5" Foreground="{ThemeResource AppOverlayTextBrush}" HorizontalAlignment="Left" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StartupProgressPercent" Text="0%" FontSize="13" Foreground="{ThemeResource AppOverlayStartupPercentBrush}" HorizontalAlignment="Right" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                    </Grid>

                    <!-- Glowing Linear Progress Bar Track -->
                    <Border Background="{ThemeResource AppOverlayTrackBgBrush}" CornerRadius="5" Height="10" BorderBrush="{ThemeResource AppOverlayTrackBorderBrush}" BorderThickness="1" Padding="1.5">
                        <ProgressBar x:Name="StartupProgressBar" Minimum="0" Maximum="100" Value="0" Height="6" CornerRadius="3" Foreground="{ThemeResource AppOverlayStartupProgressBrush}" Background="Transparent" HorizontalAlignment="Stretch"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

