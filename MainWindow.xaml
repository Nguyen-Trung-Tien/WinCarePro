<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WinCarePro.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinCarePro"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="WinCarePro"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar Grid — v3.0 Nova -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Height="56" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />  <!-- Logo & Brand -->
                <ColumnDefinition Width="*" />     <!-- Drag Area & Search -->
                <ColumnDefinition Width="Auto" />  <!-- Right Controls -->
            </Grid.ColumnDefinitions>

            <!-- Drag Area Canvas (Acts as window drag region) -->
            <Grid x:Name="AppTitleDragArea" Grid.ColumnSpan="3" Background="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />

            <!-- Brand (Left) — v3.0 with version badge -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Padding="16,0" VerticalAlignment="Center" Spacing="8" Canvas.ZIndex="10">
                <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" Width="22" Height="22" VerticalAlignment="Center" Stretch="Uniform"/>
                <TextBlock Text="WinCare Pro" FontFamily="Segoe UI Variable Display" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                <Border Background="{StaticResource PrimaryAccentLightBrush}" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="v4.1.0" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- Search (Center) -->
            <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" MaxWidth="420" Margin="16,0" Height="36" Canvas.ZIndex="10">
                <AutoSuggestBox x:Name="SearchBox" 
                                PlaceholderText="Search tools, settings, apps... (Ctrl + F)" 
                                QueryIcon="Find" 
                                CornerRadius="18" 
                                HorizontalAlignment="Stretch" 
                                VerticalAlignment="Center" 
                                QuerySubmitted="OnSearchQuerySubmitted"
                                TextChanged="OnSearchTextChanged"
                                SuggestionChosen="OnSearchSuggestionChosen">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="local:SearchItem">
                            <Grid Padding="4" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{Binding IconGlyph}" FontSize="16" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </Grid>

            <!-- Controls (Right) — Clock + Notification Bell + Theme -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Padding="0,0,142,0" Spacing="4" VerticalAlignment="Center" Canvas.ZIndex="10">

                <!-- Live System Telemetry HUD Chips -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button x:Name="CpuChipButton" Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Click="OnCpuChipClick" ToolTipService.ToolTip="CPU Usage Monitor — Click to view Dashboard performance">
                        <Border Background="{ThemeResource AppCpuChipBg}" BorderBrush="{ThemeResource AppCpuChipBorder}" BorderThickness="1" CornerRadius="12" Padding="8,3">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE9D9;" FontSize="11" Foreground="{ThemeResource AppCpuChipFg}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CpuChipText" Text="CPU" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AppCpuChipFg}" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button x:Name="RamChipButton" Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Click="OnRamChipClick" ToolTipService.ToolTip="RAM Memory Booster — Click for 1-Click RAM Purge">
                        <Border Background="{ThemeResource AppRamChipBg}" BorderBrush="{ThemeResource AppRamChipBorder}" BorderThickness="1" CornerRadius="12" Padding="8,3">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE7F1;" FontSize="11" Foreground="{ThemeResource AppRamChipFg}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RamChipText" Text="RAM" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AppRamChipFg}" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                        </Border>
                    </Button>
                </StackPanel>

                <!-- Live Clock -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                    <FontIcon Glyph="&#xE787;" FontSize="13" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ClockText" Text="--:--" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                </StackPanel>

                <!-- Separator -->
                <Border Width="1" Height="20" Background="{ThemeResource ControlStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" Opacity="0.5"/>

                 <!-- Theme Switcher -->
                <Button x:Name="ThemeButton" Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Width="36" Height="36" CornerRadius="18" Padding="0" Click="ThemeButton_Click">
                    <FontIcon x:Name="ThemeIcon" Glyph="&#xE706;" FontSize="15" />
                </Button>
                
                <!-- Notification Bell -->
                <Button x:Name="NotificationButton" Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Width="36" Height="36" CornerRadius="18" Padding="0" Click="NotificationButton_Click">
                    <Grid>
                        <FontIcon Glyph="&#xEA8F;" FontSize="15" />
                        <!-- Red dot badge -->
                        <Border x:Name="NotificationBadge" Background="Red" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="4,-2,-2,4" Visibility="Collapsed" />
                    </Grid>
                </Button>

                <!-- Exit App Button with Power Options Flyout -->
                <Button x:Name="ExitAppButton" Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Width="36" Height="36" CornerRadius="18" Padding="0" ToolTipService.ToolTip="Power &amp; Exit Options">
                    <FontIcon Glyph="&#xE7E8;" FontSize="15" Foreground="#FFEF4444" />
                    <Button.Flyout>
                        <Flyout x:Name="ExitPowerFlyout" Placement="BottomEdgeAlignedRight">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="CornerRadius" Value="16"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Background" Value="{ThemeResource AppFlyoutBackground}"/>
                                    <Setter Property="BorderBrush" Value="{ThemeResource AppFlyoutBorder}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <Border Width="270" Background="{ThemeResource AppFlyoutBackground}" BorderBrush="{ThemeResource AppFlyoutBorder}" BorderThickness="1" CornerRadius="16" Padding="16,14">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#20EF4444" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7E8;" FontSize="13" Foreground="#FFEF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Power Options" FontSize="13.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="WinCare Pro Session" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Height="1" Background="{ThemeResource AppFlyoutItemBorder}" Margin="-16,2,-16,2"/>

                                    <!-- Shutdown Option -->
                                    <Button Click="OnConfirmShutdownClick" Style="{StaticResource PowerOptionItemButtonStyle}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE7E8;" FontSize="14" Foreground="#FFEF4444" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Text="Shut Down WinCare Pro" FontSize="12" FontWeight="Bold" Foreground="#FFEF4444"/>
                                                <TextBlock Text="Save state &amp; close completely" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Minimize to Tray Option -->
                                    <Button Click="OnMinimizeToTrayClick" Style="{StaticResource PowerOptionItemButtonStyle}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE718;" FontSize="14" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Text="Minimize to Tray" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="Keep active in background" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- v4.0.0 Aura Glass 2.0 — Aurora Gradient Line under Title Bar -->
        <Border Grid.Row="0" Height="1.5" VerticalAlignment="Bottom" Opacity="0.6" Canvas.ZIndex="5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#008B5CF6" Offset="0" />
                    <GradientStop Color="#FF8B5CF6" Offset="0.2" />
                    <GradientStop Color="#FF06B6D4" Offset="0.5" />
                    <GradientStop Color="#FFF59E0B" Offset="0.8" />
                    <GradientStop Color="#008B5CF6" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Main Frame -->
        <Frame x:Name="RootFrame" Grid.Row="1" />

        <!-- Dynamic Toast Notification Container -->
        <ScrollViewer Grid.Row="0" Grid.RowSpan="2"
                      VerticalAlignment="Bottom"
                      HorizontalAlignment="Right"
                      Margin="0,0,24,24"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      Width="360"
                      MaxHeight="500"
                      Canvas.ZIndex="2000">
            <StackPanel x:Name="ToastContainer" Spacing="10" VerticalAlignment="Bottom" />
        </ScrollViewer>

        <!-- Exit Overlay Grid (Cyber Farewell Graceful Power-Down) -->
        <Grid x:Name="ExitOverlayGrid" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Canvas.ZIndex="1000" Opacity="0">
            <Grid.Resources>
                <Storyboard x:Name="FadeInExitOverlay">
                    <DoubleAnimation Storyboard.TargetName="ExitOverlayGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ExitOverlayContent" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="30" To="0" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </Grid.Resources>

            <!-- Background Ambient Glowing Mesh -->
            <Grid x:Name="AmbientGlowContainer">
                <!-- Outer Radial Glow Circle 1 -->
                <Ellipse Width="480" Height="480" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.14">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF8B5CF6" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!-- Outer Radial Glow Circle 2 -->
                <Ellipse Width="380" Height="380" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="80,40,0,0" Opacity="0.10">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFEF4444" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                
                <!-- Frosted Glass Acrylic Layer -->
                <Border BorderThickness="0">
                    <Border.BackgroundSizing>OuterBorderEdge</Border.BackgroundSizing>
                    <Border.Background>
                        <AcrylicBrush TintColor="#050508" TintOpacity="0.85" FallbackColor="#050508"/>
                    </Border.Background>
                </Border>
            </Grid>
            
            <StackPanel x:Name="ExitOverlayContent" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" Width="400">
                <StackPanel.RenderTransform>
                    <TranslateTransform Y="30" />
                </StackPanel.RenderTransform>
                
                <!-- Exit App Icon with Cyber glowing frame -->
                <Grid Width="76" Height="76" HorizontalAlignment="Center">
                    <Ellipse Width="76" Height="76" Stroke="#30EF4444" StrokeThickness="3" StrokeDashArray="3,2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border Width="64" Height="64" CornerRadius="20" Background="#1AEF4444" BorderBrush="#50EF4444" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7E8;" FontSize="28" Foreground="#FFEF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock x:Name="ExitOverlayTitle" Text="Shutting Down" FontSize="24" FontWeight="ExtraBold" FontFamily="Segoe UI Variable Display" HorizontalAlignment="Center" Foreground="White" CharacterSpacing="0.5"/>
                    <TextBlock x:Name="ExitOverlayMessage" Text="Closing database connections and freeing resources..." FontSize="12.5" Foreground="#FFA0A0B5" HorizontalAlignment="Center" FontWeight="Normal" TextAlignment="Center"/>
                </StackPanel>

                <!-- Exit Percentage Progress Bar Container -->
                <StackPanel Spacing="8" Margin="0,4,0,0">
                    <Grid>
                        <TextBlock x:Name="ExitProgressSubtext" Text="Finalizing shutdown..." FontSize="12" Foreground="#FFA0A0B5" HorizontalAlignment="Left" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ExitProgressPercent" Text="0%" FontSize="12.5" Foreground="#FFEF4444" HorizontalAlignment="Right" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                    </Grid>
                    <Border Background="#1AFFFFFF" CornerRadius="4" Height="8" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="1">
                        <ProgressBar x:Name="ExitProgressBar" Minimum="0" Maximum="100" Value="0" Height="4" CornerRadius="2" Foreground="#FFEF4444" Background="Transparent" HorizontalAlignment="Stretch"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Startup Overlay Grid (Aura Genesis Cinematic Loader) -->
        <Grid x:Name="StartupOverlayGrid" Grid.Row="0" Grid.RowSpan="2" Visibility="Visible" Canvas.ZIndex="1100" Opacity="1">
            <Grid.Resources>
                <Storyboard x:Name="FadeOutStartupOverlay" Completed="FadeOutStartupOverlay_Completed">
                    <DoubleAnimation Storyboard.TargetName="StartupOverlayGrid" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.6">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </Grid.Resources>

            <!-- Background Ambient Glowing Mesh -->
            <Grid x:Name="StartupAmbientGlowContainer">
                <!-- Outer Radial Glow Circle 1 -->
                <Ellipse Width="500" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.16">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF8B5CF6" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!-- Outer Radial Glow Circle 2 -->
                <Ellipse Width="400" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="100,50,0,0" Opacity="0.12">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF06B6D4" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                
                <!-- Frosted Glass Acrylic Layer -->
                <Border BorderThickness="0">
                    <Border.BackgroundSizing>OuterBorderEdge</Border.BackgroundSizing>
                    <Border.Background>
                        <AcrylicBrush TintColor="#050508" TintOpacity="0.88" FallbackColor="#050508"/>
                    </Border.Background>
                </Border>
            </Grid>
            
            <StackPanel x:Name="StartupOverlayContent" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" Width="380">
                <!-- App Logo with Ambient Pulsing Glow Frame -->
                <Grid Width="80" Height="80" HorizontalAlignment="Center">
                    <Border Width="80" Height="80" CornerRadius="24" Background="#15FFFFFF" BorderBrush="{StaticResource PrimaryAccentBorderBrush}" BorderThickness="1.5">
                        <Image Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"/>
                    </Border>
                </Grid>
                
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="WinCare Pro" FontSize="26" FontWeight="ExtraBold" FontFamily="Segoe UI Variable Display" HorizontalAlignment="Center" Foreground="White" CharacterSpacing="0.5"/>
                    <TextBlock Text="System Optimization &amp; Care Suite" FontSize="12.5" Foreground="#FFA0A0B5" HorizontalAlignment="Center" FontWeight="Normal"/>
                </StackPanel>

                <!-- Modern Percentage Progress Bar Container -->
                <StackPanel Spacing="8" Margin="0,6,0,0">
                    <Grid>
                        <TextBlock x:Name="StartupProgressText" Text="Loading systems..." FontSize="12" Foreground="#FFA0A0B5" HorizontalAlignment="Left" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StartupProgressPercent" Text="0%" FontSize="12.5" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Right" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                    </Grid>

                    <!-- Glowing Linear Progress Bar Track -->
                    <Border Background="#1AFFFFFF" CornerRadius="4" Height="8" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="1">
                        <ProgressBar x:Name="StartupProgressBar" Minimum="0" Maximum="100" Value="0" Height="4" CornerRadius="2" Foreground="{StaticResource PrimaryAccentGradient}" Background="Transparent" HorizontalAlignment="Stretch"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

