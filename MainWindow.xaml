<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WinCarePro.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinCarePro"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="WinCarePro"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar Grid — v3.0 Nova -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Height="56" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />  <!-- Logo & Brand -->
                <ColumnDefinition Width="*" />     <!-- Drag Area & Search -->
                <ColumnDefinition Width="Auto" />  <!-- Right Controls -->
            </Grid.ColumnDefinitions>

            <!-- Drag Area Canvas (Acts as window drag region) -->
            <Grid x:Name="AppTitleDragArea" Grid.ColumnSpan="3" Background="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />

            <!-- Brand (Left) — Modern Compact Fluent TitleBar -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Padding="16,0,8,0" VerticalAlignment="Center" Spacing="8" Canvas.ZIndex="10">
                <Grid Width="24" Height="24" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="Uniform"/>
                </Grid>
                <TextBlock Text="WinCare Pro" FontFamily="Segoe UI Variable Display" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Background="{StaticResource PrimaryAccentLightBrush}" CornerRadius="4" Padding="5,1.5" VerticalAlignment="Center">
                    <TextBlock x:Name="AppTitleVersionBadge" Text="v4.6" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- Search (Center) -->
            <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" MaxWidth="420" Margin="16,0" Height="34" Canvas.ZIndex="10">
                <AutoSuggestBox x:Name="SearchBox" 
                                PlaceholderText="Search tools, settings, apps... (Ctrl + F)" 
                                QueryIcon="Find" 
                                CornerRadius="8" 
                                HorizontalAlignment="Stretch" 
                                VerticalAlignment="Center" 
                                QuerySubmitted="OnSearchQuerySubmitted"
                                TextChanged="OnSearchTextChanged"
                                SuggestionChosen="OnSearchSuggestionChosen">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{Binding IconGlyph}" FontSize="15" Foreground="{ThemeResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </Grid>

            <!-- Controls (Right) — Clock + Notification Bell + Theme -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Padding="0,0,142,0" Spacing="4" VerticalAlignment="Center" Canvas.ZIndex="10">

                <!-- Live System Telemetry HUD Chips -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button x:Name="CpuChipButton" Style="{StaticResource TelemetryChipButtonStyle}" CornerRadius="8" Click="OnCpuChipClick" ToolTipService.ToolTip="CPU Usage Monitor — Click to view Dashboard performance">
                        <Border Background="{ThemeResource AppCpuChipBg}" BorderBrush="{ThemeResource AppCpuChipBorder}" BorderThickness="1" CornerRadius="8" Padding="7,3">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE9D9;" FontSize="11" Foreground="{ThemeResource AppCpuChipFg}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CpuChipText" Text="CPU" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AppCpuChipFg}" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button x:Name="RamChipButton" Style="{StaticResource TelemetryChipButtonStyle}" CornerRadius="8" Click="OnRamChipClick" ToolTipService.ToolTip="RAM Memory Booster — Click for 1-Click RAM Purge">
                        <Border Background="{ThemeResource AppRamChipBg}" BorderBrush="{ThemeResource AppRamChipBorder}" BorderThickness="1" CornerRadius="8" Padding="7,3">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE7F1;" FontSize="11" Foreground="{ThemeResource AppRamChipFg}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RamChipText" Text="RAM" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AppRamChipFg}" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                        </Border>
                    </Button>
                </StackPanel>

                <!-- Live Clock -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                    <FontIcon Glyph="&#xE787;" FontSize="13" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ClockText" Text="--:--" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                </StackPanel>

                <!-- Separator -->
                <Border Width="1" Height="18" Background="{ThemeResource ControlStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" Opacity="0.6"/>

                 <!-- User Guide / Help Button '?' -->
                <Button x:Name="UserGuideButton" Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Width="34" Height="34" CornerRadius="8" Padding="0" Click="UserGuideButton_Click" ToolTipService.ToolTip="User Guide &amp; Documentation">
                    <FontIcon Glyph="&#xE897;" FontSize="14" />
                </Button>

                <!-- Theme Switcher -->
                <Button x:Name="ThemeButton" Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Width="34" Height="34" CornerRadius="8" Padding="0" Click="ThemeButton_Click" ToolTipService.ToolTip="Toggle Theme">
                    <FontIcon x:Name="ThemeIcon" Glyph="&#xE706;" FontSize="14" />
                </Button>
                
                <!-- Notification Bell -->
                <Button x:Name="NotificationButton" Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Width="34" Height="34" CornerRadius="8" Padding="0" Click="NotificationButton_Click" ToolTipService.ToolTip="Notifications">
                    <Grid>
                        <FontIcon Glyph="&#xEA8F;" FontSize="14" />
                        <!-- Red dot badge -->
                        <Border x:Name="NotificationBadge" Background="#FFEF4444" Width="7" Height="7" CornerRadius="3.5" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="3,-1,-1,3" Visibility="Collapsed" />
                    </Grid>
                </Button>

                <!-- Exit App Button with Native Fluent MenuFlyout -->
                <Button x:Name="ExitAppButton" Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Width="34" Height="34" CornerRadius="8" Padding="0" ToolTipService.ToolTip="Power Options">
                    <FontIcon Glyph="&#xE7E8;" FontSize="14" Foreground="#FFEF4444" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="ExitPowerFlyout" Placement="BottomEdgeAlignedRight" Opening="ExitPowerFlyout_Opening">
                            <MenuFlyoutItem x:Name="MenuMinimizeToTray" Text="Minimize to Tray" Click="OnMinimizeToTrayClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE718;" FontSize="14" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="MenuShutdown" Text="Shutdown" Click="OnConfirmShutdownClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7E8;" FontSize="14" Foreground="#FFEF4444"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Aurora Rainbow Gradient Line under Title Bar -->
        <Border Grid.Row="0" Height="2" VerticalAlignment="Bottom" Opacity="0.85" Canvas.ZIndex="5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#008B5CF6" Offset="0" />
                    <GradientStop Color="#FF8B5CF6" Offset="0.2" />
                    <GradientStop Color="#FF06B6D4" Offset="0.45" />
                    <GradientStop Color="#FF10B981" Offset="0.65" />
                    <GradientStop Color="#FFF59E0B" Offset="0.85" />
                    <GradientStop Color="#008B5CF6" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Main Frame -->
        <Frame x:Name="RootFrame" Grid.Row="1" />

        <!-- Dynamic Toast Notification Container -->
        <ScrollViewer Grid.Row="0" Grid.RowSpan="2"
                      VerticalAlignment="Bottom"
                      HorizontalAlignment="Right"
                      Margin="0,0,24,24"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      Width="360"
                      MaxHeight="500"
                      Canvas.ZIndex="2000">
            <StackPanel x:Name="ToastContainer" Spacing="10" VerticalAlignment="Bottom" />
        </ScrollViewer>

        <!-- Exit Overlay Grid (Cyber Farewell Graceful Power-Down) -->
        <Grid x:Name="ExitOverlayGrid" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Canvas.ZIndex="1000" Opacity="0">
            <Grid.Resources>
                <Storyboard x:Name="FadeInExitOverlay">
                    <DoubleAnimation Storyboard.TargetName="ExitOverlayGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ExitOverlayContent" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="30" To="0" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </Grid.Resources>

            <!-- Background Ambient Glowing Mesh -->
            <Grid x:Name="AmbientGlowContainer">
                <!-- Outer Radial Glow Circle 1 -->
                <Ellipse Width="500" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.18">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFF43F5E" Offset="0" />
                            <GradientStop Color="#FF8B5CF6" Offset="0.6" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!-- Outer Radial Glow Circle 2 -->
                <Ellipse Width="380" Height="380" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="60,30,0,0" Opacity="0.14">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFEF4444" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                
                <!-- Frosted Glass Acrylic Layer -->
                <Border BorderThickness="0">
                    <Border.BackgroundSizing>OuterBorderEdge</Border.BackgroundSizing>
                    <Border.Background>
                        <AcrylicBrush TintColor="#050508" TintOpacity="0.88" FallbackColor="#050508"/>
                    </Border.Background>
                </Border>
            </Grid>
            
            <StackPanel x:Name="ExitOverlayContent" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" Width="400">
                <StackPanel.RenderTransform>
                    <TranslateTransform Y="30" />
                </StackPanel.RenderTransform>
                
                <!-- Clean App Logo with Radial Aura Glow -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="144" Height="144">
                    <Ellipse Width="140" Height="140" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#FF0284C7" Offset="0" />
                                <GradientStop Color="#FFF43F5E" Offset="0.6" />
                                <GradientStop Color="Transparent" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Image Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" Width="136" Height="136" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"/>
                </Grid>
                
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock x:Name="ExitOverlayTitle" Text="Shutting Down" FontSize="24" FontWeight="ExtraBold" FontFamily="Segoe UI Variable Display" HorizontalAlignment="Center" Foreground="White" CharacterSpacing="0.5"/>
                    <TextBlock x:Name="ExitOverlayMessage" Text="Closing database connections and freeing resources..." FontSize="12.5" Foreground="#FFA0A0B5" HorizontalAlignment="Center" FontWeight="Normal" TextAlignment="Center"/>
                </StackPanel>

                <!-- Exit Percentage Progress Bar Container -->
                <StackPanel Spacing="8" Margin="0,4,0,0">
                    <Grid>
                        <TextBlock x:Name="ExitProgressSubtext" Text="Finalizing shutdown..." FontSize="12" Foreground="#FFA0A0B5" HorizontalAlignment="Left" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ExitProgressPercent" Text="0%" FontSize="12.5" Foreground="#FFF43F5E" HorizontalAlignment="Right" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                    </Grid>
                    <Border Background="#1AFFFFFF" CornerRadius="4" Height="8" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="1">
                        <ProgressBar x:Name="ExitProgressBar" Minimum="0" Maximum="100" Value="0" Height="4" CornerRadius="2" Foreground="#FFF43F5E" Background="Transparent" HorizontalAlignment="Stretch"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Startup Overlay Grid (Aura Genesis Cinematic Loader) -->
        <Grid x:Name="StartupOverlayGrid" Grid.Row="0" Grid.RowSpan="2" Visibility="Visible" Canvas.ZIndex="1100" Opacity="1">
            <Grid.Resources>
                <Storyboard x:Name="FadeOutStartupOverlay" Completed="FadeOutStartupOverlay_Completed">
                    <DoubleAnimation Storyboard.TargetName="StartupOverlayGrid" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.6">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </Grid.Resources>

            <!-- Background Ambient Glowing Mesh -->
            <Grid x:Name="StartupAmbientGlowContainer">
                <!-- Outer Radial Glow Circle 1 -->
                <Ellipse Width="500" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.16">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF8B5CF6" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!-- Outer Radial Glow Circle 2 -->
                <Ellipse Width="400" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="100,50,0,0" Opacity="0.12">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF06B6D4" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                
                <!-- Frosted Glass Acrylic Layer -->
                <Border BorderThickness="0">
                    <Border.BackgroundSizing>OuterBorderEdge</Border.BackgroundSizing>
                    <Border.Background>
                        <AcrylicBrush TintColor="#050508" TintOpacity="0.88" FallbackColor="#050508"/>
                    </Border.Background>
                </Border>
            </Grid>
            
            <StackPanel x:Name="StartupOverlayContent" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" Width="380">
                <!-- App Logo with Neon Blue Aura Glow -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="156" Height="156">
                    <Ellipse Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.45">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#FF38BDF8" Offset="0" />
                                <GradientStop Color="#FF0284C7" Offset="0.6" />
                                <GradientStop Color="Transparent" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Image Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" Width="148" Height="148" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"/>
                </Grid>
                
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="WinCare Pro" FontSize="26" FontWeight="ExtraBold" FontFamily="Segoe UI Variable Display" HorizontalAlignment="Center" Foreground="White" CharacterSpacing="0.5"/>
                    <TextBlock Text="System Optimization &amp; Care Suite" FontSize="12.5" Foreground="#FFA0A0B5" HorizontalAlignment="Center" FontWeight="Normal"/>
                </StackPanel>

                <!-- Modern Percentage Progress Bar Container -->
                <StackPanel Spacing="8" Margin="0,6,0,0">
                    <Grid>
                        <TextBlock x:Name="StartupProgressText" Text="Loading systems..." FontSize="12" Foreground="#FFA0A0B5" HorizontalAlignment="Left" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StartupProgressPercent" Text="0%" FontSize="12.5" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Right" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                    </Grid>

                    <!-- Glowing Linear Progress Bar Track -->
                    <Border Background="#1AFFFFFF" CornerRadius="4" Height="8" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="1">
                        <ProgressBar x:Name="StartupProgressBar" Minimum="0" Maximum="100" Value="0" Height="4" CornerRadius="2" Foreground="{StaticResource PrimaryAccentGradient}" Background="Transparent" HorizontalAlignment="Stretch"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

