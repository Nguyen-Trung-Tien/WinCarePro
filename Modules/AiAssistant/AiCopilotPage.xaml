<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Modules.AiAssistant.AiCopilotPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ai="using:WinCarePro.Modules.AiAssistant"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    mc:Ignorable="d">

    <Grid Padding="28,24" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Background="{StaticResource CyberAccentGradient}" CornerRadius="10" Padding="8">
                        <FontIcon Glyph="&#xE945;" FontSize="20" Foreground="White"/>
                    </Border>
                    <TextBlock Text="WinCare AI Assistant" Style="{StaticResource PageHeaderTitleStyle}" VerticalAlignment="Center"/>
                    <Border Background="#258B5CF6" BorderBrush="#608B5CF6" BorderThickness="1" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="Neural Engine" FontSize="11" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Intelligent system diagnostics and automatic PC optimization recommendations." Style="{StaticResource PageHeaderSubtitleStyle}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="ExportReportBtn" Click="OnExportReportClick" Style="{StaticResource StandardSecondaryButtonStyle}" Height="36" Padding="14,0"
                        helpers:AnimationHelper.HoverScale="1.03" helpers:AnimationHelper.PressedScale="0.97">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A7;" FontSize="13"/>
                        <TextBlock Text="Export AI Report" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RunAiDiagnosticsBtn" Click="OnRunAiScanClick" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="36" MinWidth="180" Padding="16,0"
                        helpers:AnimationHelper.HoverScale="1.03" helpers:AnimationHelper.PressedScale="0.97">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="RunAiProgressRing" IsActive="False" Visibility="Collapsed" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                        <FontIcon x:Name="RunAiIcon" Glyph="&#xE721;" FontSize="13"/>
                        <TextBlock x:Name="RunAiText" Text="Run AI Diagnostics" FontSize="12.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">
                
                <!-- AI Overall Score Card -->
                <Border Style="{StaticResource AuraGlassCardStyle}" helpers:AnimationHelper.HoverScale="1.005">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Score Badge -->
                        <Grid Grid.Column="0" Width="130" Height="130" Margin="0,0,24,0">
                            <Ellipse Stroke="{StaticResource PrimaryAccentGradient}" StrokeThickness="6"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="ScoreText" Text="95" FontSize="42" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="AI Score" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Score Details -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock x:Name="StatusTitleText" Text="Status: Optimal Health" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <Border Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                    <TextBlock Text="Active" FontSize="11" FontWeight="Bold" Foreground="#FF10B981"/>
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="SummaryMessageText" Text="WinCare AI Assistant predicts maximum system stability with 0 critical bottlenecks detected." 
                                       FontSize="13.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Predictive AI Insights Chips -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource QuickStatCardStyle}" helpers:AnimationHelper.HoverScale="1.01">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7F1;" FontSize="14" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock Text="Predictive Drive C: Free Outlook" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="PredictiveStorageText" Text="30+ Days Free" FontSize="20" FontWeight="ExtraBold" Foreground="#FF10B981"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource QuickStatCardStyle}" helpers:AnimationHelper.HoverScale="1.01">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7B5;" FontSize="14" Foreground="#FFF59E0B"/>
                                <TextBlock Text="Predictive Boot Speed Gain" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="PredictiveBootText" Text="-1.5s Boot Time" FontSize="20" FontWeight="ExtraBold" Foreground="#FFF59E0B"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- AI Recommendations Header -->
                <TextBlock Text="AI Recommended Optimizations" Style="{StaticResource SectionHeaderTitleStyle}"/>

                <!-- Empty State Card -->
                <Border x:Name="EmptyStateCard" Visibility="Collapsed" Style="{StaticResource GlassmorphismCardStyle}" Padding="32,24" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="54" Height="54" CornerRadius="27" Background="#2510B981" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE73E;" FontSize="24" Foreground="#FF10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="No System Bottlenecks Detected" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Your system is running at optimal peak performance. AI Assistant is continuously monitoring telemetry." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Recommendations ListView -->
                <ListView x:Name="RecommendationsListView" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GlassmorphismCardStyle}" Margin="0,0,0,10" Padding="16" helpers:AnimationHelper.HoverScale="1.008">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="{ThemeResource AppStatChipBackground}" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <FontIcon Glyph="{Binding CategoryIconGlyph}" FontSize="18" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <Border Background="{Binding ImpactBadgeBackgroundBrush}" 
                                                    BorderBrush="{Binding ImpactBadgeBorderBrush}" 
                                                    BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding ImpactLevel}" FontSize="10" FontWeight="Bold" 
                                                           Foreground="{Binding ImpactBadgeForegroundBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" Click="OnRecommendationActionClick" Tag="{Binding ActionKey}" 
                                            Style="{StaticResource VibrantPrimaryButtonStyle}" Height="32" Padding="14,0" VerticalAlignment="Center" Margin="12,0,0,0"
                                            helpers:AnimationHelper.HoverScale="1.04" helpers:AnimationHelper.PressedScale="0.96">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE721;" FontSize="11" Foreground="White"/>
                                            <TextBlock Text="Apply Fix" FontSize="11.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

