<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Modules.AiAssistant.AiWinCareEnginePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ai="using:WinCarePro.Modules.AiAssistant"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    mc:Ignorable="d">

    <Page.Resources>
        <Storyboard x:Name="AiPulseGlowAnimation" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="AiGlowEllipse" Storyboard.TargetProperty="Opacity" From="0.06" To="0.30" Duration="0:0:2.0">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid Padding="24,20" HorizontalAlignment="Stretch">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutVisualStates">
                <!-- Wide Layout: Viewport Width >= 1050px -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1050" />
                    </VisualState.StateTriggers>
                </VisualState>

                <!-- Narrow Layout: Viewport Width < 1050px -->
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderCol1.Width" Value="0" />
                        <Setter Target="HeaderTitlePanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderActionsPanel.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderActionsPanel.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderActionsPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderActionsPanel.HorizontalAlignment" Value="Left" />
                        <Setter Target="HeaderActionsPanel.Margin" Value="0,10,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,0,18">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow0" Height="Auto" />
                <RowDefinition x:Name="HeaderRow1" Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HeaderCol0" Width="*"/>
                <ColumnDefinition x:Name="HeaderCol1" Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="HeaderTitlePanel" Grid.Row="0" Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Style="{StaticResource PageHeaderIconBadgeStyle}" Background="{StaticResource CyberAccentGradient}">
                        <FontIcon Glyph="&#xE99A;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="AI WinCare Engine" Style="{StaticResource PageHeaderTitleStyle}" VerticalAlignment="Center"/>
                    <Border Background="{ThemeResource AppBadgeNeutralBg}" BorderBrush="{ThemeResource AppBadgeNeutralBorder}" BorderThickness="1" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="6" Height="6" Fill="{ThemeResource AppBadgeGoodFg}"/>
                            <TextBlock Text="Neural Core Engine" FontSize="11" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="Intelligent diagnostics &amp; automated optimization." Style="{StaticResource PageHeaderSubtitleStyle}"/>
            </StackPanel>

            <StackPanel x:Name="HeaderActionsPanel" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Name="ExportReportBtn" Click="OnExportReportClick" Style="{StaticResource StandardSecondaryButtonStyle}" Height="36" Padding="14,0" ToolTipService.ToolTip="Export diagnostic report to file">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A7;" FontSize="13"/>
                        <TextBlock Text="Export AI Report" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button x:Name="AutoRemedyAllBtn" Click="OnAutoRemedyAllClick" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="36" Padding="16,0" ToolTipService.ToolTip="Execute all safe AI optimization fixes in one click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="AutoRemedyProgressRing" IsActive="False" Visibility="Collapsed" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                        <FontIcon x:Name="AutoRemedyIcon" Glyph="&#xE777;" FontSize="13"/>
                        <TextBlock x:Name="AutoRemedyText" Text="1-Click Smart Remedy" FontSize="12.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RunAiDiagnosticsBtn" Click="OnRunAiScanClick" Style="{StaticResource StandardSecondaryButtonStyle}" Height="36" MinWidth="160" Padding="16,0" ToolTipService.ToolTip="Trigger a deep neural diagnostics scan">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="RunAiProgressRing" IsActive="False" Visibility="Collapsed" Width="14" Height="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <FontIcon x:Name="RunAiIcon" Glyph="&#xE721;" FontSize="13"/>
                        <TextBlock x:Name="RunAiText" Text="Run AI Diagnostics" FontSize="12.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
                
                <!-- 1. AI Overall Score & Neural Overview Hero Card -->
                <Border x:Name="AiHeroCard" Style="{StaticResource Holographic3DCardStyle}" Padding="22"
                        helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="5.0" helpers:Animation3DHelper.DepthZ="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Score Badge with Glowing Ring -->
                        <Grid Grid.Column="0" Width="140" Height="140" Margin="0,0,24,0">
                            <Ellipse x:Name="AiGlowEllipse" Width="130" Height="130" Opacity="0.15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FF8B5CF6" Offset="0" />
                                        <GradientStop Color="#FF06B6D4" Offset="0.6" />
                                        <GradientStop Color="Transparent" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="116" Height="116" Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="5" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3"/>
                            <ProgressRing x:Name="AiScoreRing" Value="100" Width="120" Height="120" Foreground="{StaticResource PrimaryAccentBrush}" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="1">
                                <TextBlock x:Name="ScoreText" Text="100" FontSize="36" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" CharacterSpacing="-20"/>
                                <TextBlock Text="AI SCORE" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center" CharacterSpacing="15"/>
                            </StackPanel>
                        </Grid>

                        <!-- Score Details & Status -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock x:Name="StatusTitleText" Text="Status: Optimal Health" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <Border Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Ellipse Width="6" Height="6" Fill="#FF10B981"/>
                                        <TextBlock Text="AI Active" FontSize="11" FontWeight="Bold" Foreground="#FF10B981"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="SummaryMessageText" Text="WinCare AI Assistant predicts maximum system stability with 0 critical bottlenecks detected." 
                                       FontSize="13.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" LineHeight="20"/>

                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="11" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        <TextBlock x:Name="AiLastScanText" Text="Neural Scan: Active &amp; Up to date" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Four Predictive AI Analytics Pillars -->
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Pillar 1: Storage Outlook -->
                    <Border Grid.Column="0" Style="{StaticResource QuickStatCardStyle}" Padding="14,12"
                            helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="7.0" helpers:Animation3DHelper.DepthZ="16">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="26" Height="26" CornerRadius="6" Background="#153B82F6">
                                    <FontIcon Glyph="&#xE7F1;" FontSize="12" Foreground="#FF3B82F6" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Storage Horizon" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="PredictiveStorageText" Text="30+ Days Free" FontSize="18" FontWeight="ExtraBold" Foreground="#FF10B981"/>
                            <TextBlock Text="Drive C: exhaustion forecast" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Pillar 2: Boot Acceleration -->
                    <Border Grid.Column="1" Style="{StaticResource QuickStatCardStyle}" Padding="14,12"
                            helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="7.0" helpers:Animation3DHelper.DepthZ="16">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="26" Height="26" CornerRadius="6" Background="#15F59E0B">
                                    <FontIcon Glyph="&#xE7B5;" FontSize="12" Foreground="#FFF59E0B" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Boot Optimization" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="PredictiveBootText" Text="-1.5s Boot Time" FontSize="18" FontWeight="ExtraBold" Foreground="#FFF59E0B"/>
                            <TextBlock Text="Potential startup shaving" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Pillar 3: Memory Pressure Index -->
                    <Border Grid.Column="2" Style="{StaticResource QuickStatCardStyle}" Padding="14,12"
                            helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="7.0" helpers:Animation3DHelper.DepthZ="16">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="26" Height="26" CornerRadius="6" Background="#158B5CF6">
                                    <FontIcon Glyph="&#xE950;" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Memory Index" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="PredictiveMemoryText" Text="Stable" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <TextBlock Text="Working set &amp; Standby state" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Pillar 4: System Telemetry Vector -->
                    <Border Grid.Column="3" Style="{StaticResource QuickStatCardStyle}" Padding="14,12"
                            helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="7.0" helpers:Animation3DHelper.DepthZ="16">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="26" Height="26" CornerRadius="6" Background="#1510B981">
                                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#FF10B981" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Stability Vector" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="99.9% Optimal" FontSize="18" FontWeight="ExtraBold" Foreground="#FF10B981"/>
                            <TextBlock Text="Zero crash anomalies" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 3. Smart Quick Action Command Deck (Balanced 4-Column Hub) -->
                <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="16,14">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header Row -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource PrimaryAccentLightBrush}" BorderBrush="{StaticResource PrimaryAccentBorderBrush}" BorderThickness="1">
                                    <FontIcon Glyph="&#xE7E8;" FontSize="13" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="AI Automated Quick Remedies" FontWeight="Bold" FontSize="13"/>
                                    <TextBlock Text="Instant single-click kernel optimizations &amp; resource purge" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource AppBadgeGoodFg}"/>
                                    <TextBlock Text="Engine Ready" FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource AppBadgeGoodFg}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 4-Column Balanced Action Cards Grid -->
                        <Grid Grid.Row="1" ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Action 1: RAM Cache Purge -->
                            <Button Grid.Column="0" Click="OnQuickPurgeRamClick" Style="{StaticResource TransparentWrapperButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Border Style="{StaticResource QuickStatCardStyle}" Padding="12,10" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{StaticResource PrimaryAccentBorderBrush}" BorderThickness="1">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#203B82F6" BorderBrush="#503B82F6" BorderThickness="1" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE950;" FontSize="15" Foreground="#FF3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="Purge RAM Cache" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Text="Free Working Set" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- Action 2: Clean Temp Junk -->
                            <Button Grid.Column="1" Click="OnQuickCleanJunkClick" Style="{StaticResource TransparentWrapperButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Border Style="{StaticResource QuickStatCardStyle}" Padding="12,10" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{StaticResource PrimaryAccentBorderBrush}" BorderThickness="1">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#20F59E0B" BorderBrush="#50F59E0B" BorderThickness="1" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xEA99;" FontSize="15" Foreground="#FFF59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="Clean Temp Junk" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Text="Purge Cache &amp; Debris" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- Action 3: Optimize Startup -->
                            <Button Grid.Column="2" Click="OnQuickOptimizeStartupClick" Style="{StaticResource TransparentWrapperButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Border Style="{StaticResource QuickStatCardStyle}" Padding="12,10" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{StaticResource PrimaryAccentBorderBrush}" BorderThickness="1">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#208B5CF6" BorderBrush="#508B5CF6" BorderThickness="1" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7B5;" FontSize="15" Foreground="#FF8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="Optimize Startup Apps" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Text="Trim Boot Overhead" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- Action 4: Flush DNS & Winsock -->
                            <Button Grid.Column="3" Click="OnQuickFlushDnsClick" Style="{StaticResource TransparentWrapperButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Border Style="{StaticResource QuickStatCardStyle}" Padding="12,10" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{StaticResource PrimaryAccentBorderBrush}" BorderThickness="1">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#2010B981" BorderBrush="#5010B981" BorderThickness="1" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE774;" FontSize="15" Foreground="#FF10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="Flush DNS &amp; Winsock" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Text="Repair Socket Cache" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 4. AI Recommended Optimizations Deck -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="AI Recommended Optimizations" Style="{StaticResource SectionHeaderTitleStyle}" VerticalAlignment="Center"/>
                </Grid>

                <!-- Shimmer Skeleton Loading Deck -->
                <StackPanel x:Name="AiSkeletonLoadingDeck" Spacing="10" Visibility="Collapsed">
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Style="{StaticResource ShimmerSkeletonStyle}" Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                <Border Height="14" Width="200" HorizontalAlignment="Left" Style="{StaticResource ShimmerSkeletonStyle}"/>
                                <Border Height="10" Width="320" HorizontalAlignment="Left" Style="{StaticResource ShimmerSkeletonStyle}"/>
                            </StackPanel>
                            <Border Grid.Column="2" Width="90" Height="32" CornerRadius="8" Style="{StaticResource ShimmerSkeletonStyle}"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Style="{StaticResource ShimmerSkeletonStyle}" Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                <Border Height="14" Width="180" HorizontalAlignment="Left" Style="{StaticResource ShimmerSkeletonStyle}"/>
                                <Border Height="10" Width="280" HorizontalAlignment="Left" Style="{StaticResource ShimmerSkeletonStyle}"/>
                            </StackPanel>
                            <Border Grid.Column="2" Width="90" Height="32" CornerRadius="8" Style="{StaticResource ShimmerSkeletonStyle}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Empty State Card -->
                <Border x:Name="EmptyStateCard" Visibility="Collapsed" Style="{StaticResource GlassmorphismCardStyle}" Padding="36,28" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="28" Background="#2510B981" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE73E;" FontSize="26" Foreground="#FF10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="No System Bottlenecks Detected" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Your system is running at optimal peak performance. AI Assistant is continuously monitoring telemetry in the background." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="500"/>
                    </StackPanel>
                </Border>

                <!-- Recommendations ListView -->
                <ListView x:Name="RecommendationsListView" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Tilt3DCardStyle}" Margin="0,0,0,10" Padding="16"
                                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="3.5" helpers:Animation3DHelper.DepthZ="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Category Icon with 3D Elevation -->
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1.2" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <FontIcon Glyph="{Binding CategoryIconGlyph}" FontSize="18" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <Border Background="{Binding ImpactBadgeBackgroundBrush}" 
                                                    BorderBrush="{Binding ImpactBadgeBorderBrush}" 
                                                    BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding ImpactLevelDisplayName}" FontSize="10" FontWeight="Bold" 
                                                           Foreground="{Binding ImpactBadgeForegroundBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="17"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" Click="OnRecommendationActionClick" Tag="{Binding ActionKey}" 
                                            Style="{StaticResource VibrantPrimaryButtonStyle}" Height="32" Padding="14,0" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
