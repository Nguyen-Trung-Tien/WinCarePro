<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinCarePro.ViewModels"
    xmlns:local="using:WinCarePro.Views"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    xmlns:db="using:WinCarePro.Database"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid Padding="20,16" HorizontalAlignment="Stretch">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutVisualStates">
                <!-- Wide Layout: Viewport Width >= 1200px -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1200" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- Medium Layout: Viewport Width >= 768px and < 1200px (Default Windowed Mode) -->
                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="768" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- Narrow Layout: Viewport Width < 768px -->
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HealthGaugeCard.(Grid.Row)" Value="0" />
                        <Setter Target="HealthGaugeCard.(Grid.Column)" Value="0" />
                        <Setter Target="HealthGaugeCard.(Grid.ColumnSpan)" Value="2" />

                        <Setter Target="AiWinCareEngineEmbeddedPanel.(Grid.Row)" Value="1" />
                        <Setter Target="AiWinCareEngineEmbeddedPanel.(Grid.Column)" Value="0" />
                        <Setter Target="AiWinCareEngineEmbeddedPanel.(Grid.ColumnSpan)" Value="2" />

                        <Setter Target="SimpleQuickActionsDeck.(Grid.Row)" Value="2" />
                        <Setter Target="SimpleQuickActionsDeck.(Grid.Column)" Value="0" />
                        <Setter Target="SimpleQuickActionsDeck.(Grid.ColumnSpan)" Value="2" />

                        <Setter Target="CpuRamGrid.(Grid.Row)" Value="3" />
                        <Setter Target="CpuRamGrid.(Grid.Column)" Value="0" />
                        <Setter Target="CpuRamGrid.(Grid.ColumnSpan)" Value="2" />

                        <Setter Target="BottleneckCard.(Grid.Row)" Value="4" />
                        <Setter Target="BottleneckCard.(Grid.Column)" Value="0" />
                        <Setter Target="BottleneckCard.(Grid.ColumnSpan)" Value="2" />

                        <Setter Target="GpuDiskGrid.(Grid.Row)" Value="5" />
                        <Setter Target="GpuDiskGrid.(Grid.Column)" Value="0" />
                        <Setter Target="GpuDiskGrid.(Grid.ColumnSpan)" Value="2" />

                        <Setter Target="QuickStatsGrid.(Grid.Row)" Value="6" />
                        <Setter Target="QuickStatsGrid.(Grid.Column)" Value="0" />
                        <Setter Target="QuickStatsGrid.(Grid.ColumnSpan)" Value="2" />

                        <Setter Target="RecommendationsCard.(Grid.Row)" Value="7" />
                        <Setter Target="RecommendationsCard.(Grid.Column)" Value="0" />
                        <Setter Target="RecommendationsCard.(Grid.ColumnSpan)" Value="2" />

                        <Setter Target="PerformanceChartCard.(Grid.Row)" Value="8" />
                        <Setter Target="PerformanceChartCard.(Grid.Column)" Value="0" />
                        <Setter Target="PerformanceChartCard.(Grid.ColumnSpan)" Value="2" />

                        <Setter Target="GaugeRingGrid.(Grid.Row)" Value="0" />
                        <Setter Target="GaugeRingGrid.(Grid.Column)" Value="0" />
                        <Setter Target="GaugeRingGrid.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="GaugeRingGrid.HorizontalAlignment" Value="Center" />
                        <Setter Target="GaugeRingGrid.Margin" Value="0,0,0,16" />

                        <Setter Target="GaugeDescPanel.(Grid.Row)" Value="1" />
                        <Setter Target="GaugeDescPanel.(Grid.Column)" Value="0" />
                        <Setter Target="GaugeDescPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="GaugeDescPanel.HorizontalAlignment" Value="Center" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Header — Spatial HUD Glass Banner -->
        <Border Grid.Row="0" Margin="0,0,0,14" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="16" Padding="18,12">
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="System Dashboard" Style="{StaticResource PageHeaderTitleStyle}" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display" FontSize="20" FontWeight="Bold"/>
                    <Border Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="6" Height="6" Fill="{ThemeResource AppBadgeGoodFg}" />
                            <TextBlock Text="Live Telemetry" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppBadgeGoodFg}" FontFamily="Segoe UI Variable Display"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="Real-time hardware telemetry &amp; intelligent autonomous system care." Style="{StaticResource PageHeaderSubtitleStyle}" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
            </StackPanel>
        </Border>

        <!-- Main Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10">

                <!-- Main Content Grid combining Core and Extended layers -->
                <Grid x:Name="MainContentGrid" ColumnSpacing="0" RowSpacing="0" Padding="0">
                    <Grid.RowDefinitions>
                        <!-- Wide Layout Rows -->
                        <RowDefinition x:Name="Row0" Height="Auto" />
                        <RowDefinition x:Name="Row1" Height="Auto" />
                        <RowDefinition x:Name="Row2" Height="Auto" />
                        <RowDefinition x:Name="Row3" Height="Auto" />
                        <RowDefinition x:Name="Row4" Height="Auto" />
                        <!-- Extra rows for Narrow Layout stacking -->
                        <RowDefinition x:Name="Row5" Height="Auto" />
                        <RowDefinition x:Name="Row6" Height="Auto" />
                        <RowDefinition x:Name="Row7" Height="Auto" />
                        <RowDefinition x:Name="Row8" Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftCol" Width="1*" />
                        <ColumnDefinition x:Name="RightCol" Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Side Column 0: System Health Overview Hero Bento Card -->
                    <Border x:Name="HealthGaugeCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource CyberBentoHeroCardStyle}" Margin="6" Padding="20,18" MinHeight="195" CornerRadius="16"
                            helpers:AnimationHelper.StaggerIndex="0" helpers:AnimationHelper.HoverScale="1.01">
                        <Grid x:Name="HealthGaugeGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="HealthGaugeRow0" Height="Auto" />
                                <RowDefinition x:Name="HealthGaugeRow1" Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="HealthGaugeCol0" Width="Auto" />
                                <ColumnDefinition x:Name="HealthGaugeCol1" Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Ambient Holographic Aura Glow -->
                            <Ellipse Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2" Width="200" Height="200" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-20,0,0,0" Opacity="0.14" IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop Color="#FF06B6D4" Offset="0" />
                                        <GradientStop Color="#FF3B82F6" Offset="0.6" />
                                        <GradientStop Color="Transparent" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- Clean High-Definition System Health Vitality Ring with Holographic Orbit -->
                            <Grid x:Name="GaugeRingGrid" Grid.Column="0" Width="140" Height="140" Margin="0,0,18,0" VerticalAlignment="Center">
                                <!-- Outer Holographic Halo Orbit Ring -->
                                <Ellipse Width="138" Height="138" Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="1.2" StrokeDashArray="3,3" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.32"/>

                                <!-- Background Track Ring -->
                                <Ellipse Width="122" Height="122" Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="8" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.22"/>

                                <!-- Main Health Progress Ring -->
                                <ProgressRing Value="{x:Bind ViewModel.HealthScore, Mode=OneWay}"
                                              Minimum="0" Maximum="100"
                                              IsIndeterminate="False"
                                              Width="122" Height="122"
                                              Foreground="{x:Bind GetHealthScoreBrush(ViewModel.HealthScore), Mode=OneWay}"
                                              Background="Transparent"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <!-- Centerpiece Typography HUD -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="0">
                                    <TextBlock Text="{x:Bind ViewModel.HealthScore, Mode=OneWay}" FontSize="36" FontWeight="Black" HorizontalAlignment="Center" Foreground="{x:Bind GetHealthScoreBrush(ViewModel.HealthScore), Mode=OneWay}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                    <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,2,0,0">
                                        <TextBlock Text="HEALTH SCORE" FontSize="8.5" FontWeight="Bold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center" CharacterSpacing="2"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="GaugeDescPanel" Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="System Health Status" FontSize="16.5" FontWeight="Bold" FontFamily="Segoe UI Variable Display" TextWrapping="Wrap" />
                                    <Border Background="{x:Bind GetHealthScoreBadgeBackground(ViewModel.HealthScore), Mode=OneWay}" Padding="8,3" CornerRadius="8">
                                        <TextBlock Text="{x:Bind GetStatusText(ViewModel.HealthScore), Mode=OneWay}" FontSize="11" FontWeight="ExtraBold" Foreground="{x:Bind GetHealthScoreBrush(ViewModel.HealthScore), Mode=OneWay}" TextWrapping="Wrap" FontFamily="Segoe UI Variable Display"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.HealthBreakdownText, Mode=OneWay}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" LineHeight="17" MaxLines="2" TextTrimming="CharacterEllipsis"/>

                                <Grid x:Name="GaugeActionButtonsGrid" Margin="0,8,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Tier 1: Hero Primary Call-To-Action (1-Click Smart Care - Full Width, Commanding Hero) -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                        <Button x:Name="OneClickCareBtn" Content="1-Click Smart Care (Scan &amp; Optimize)" Style="{StaticResource VibrantPrimaryButtonStyle}" Click="OnOneClickSmartCareClick" IsEnabled="{x:Bind GetOneClickEnabled(ViewModel.IsScanning, ViewModel.IsOptimizing), Mode=OneWay}" Height="42" HorizontalAlignment="Stretch" CornerRadius="12" FontWeight="ExtraBold" FontSize="14"
                                                helpers:AnimationHelper.HoverScale="1.03" helpers:AnimationHelper.PressedScale="0.97"
                                                AutomationProperties.Name="1-Click Smart Care"
                                                AutomationProperties.HelpText="Instantly scan and optimize system performance, RAM, and junk files in one single click."/>

                                        <ProgressRing x:Name="GaugeActionProgressRing" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" IsActive="{x:Bind GetProgressRingActive(ViewModel.IsScanning, ViewModel.IsOptimizing), Mode=OneWay}" Visibility="{x:Bind GetProgressRingVisibility(ViewModel.IsScanning, ViewModel.IsOptimizing), Mode=OneWay}" Width="18" Height="18" Foreground="White" IsHitTestVisible="False" />
                                    </Grid>

                                    <!-- Tier 2: Step-by-Step Granular Controls (Balanced 50/50 Dual Action Deck) -->
                                    <Grid Grid.Row="1" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="ScanSystemBtn" Grid.Column="0" Content="Scan Only" Style="{StaticResource StandardSecondaryButtonStyle}" Click="OnScanClick" IsEnabled="{x:Bind IsNot(ViewModel.IsScanning), Mode=OneWay}" Height="34" HorizontalAlignment="Stretch" CornerRadius="10" FontWeight="SemiBold" FontSize="12"
                                                helpers:AnimationHelper.HoverScale="1.02" helpers:AnimationHelper.PressedScale="0.98"
                                                AutomationProperties.Name="Scan System"
                                                AutomationProperties.HelpText="Initiates deep system scan for junk files, performance issues, and security status."/>

                                        <Button x:Name="OptimizeBtn" Grid.Column="1" Content="Optimize Only" Style="{StaticResource StandardSecondaryButtonStyle}" Click="OnOptimizeClick" Visibility="{x:Bind GetOptimizeVisibility(ViewModel.HasScanned, ViewModel.IsScanning), Mode=OneWay}" IsEnabled="{x:Bind IsNot(ViewModel.IsOptimizing), Mode=OneWay}" Height="34" HorizontalAlignment="Stretch" CornerRadius="10" FontWeight="SemiBold" FontSize="12"
                                                helpers:AnimationHelper.HoverScale="1.02" helpers:AnimationHelper.PressedScale="0.98"
                                                AutomationProperties.Name="Optimize System"
                                                AutomationProperties.HelpText="Optimizes system performance using the selected profile mode.">
                                            <Button.ContextFlyout>
                                                <MenuFlyout Placement="Bottom">
                                                    <MenuFlyoutItem Text="Recommended Mode (Caches &amp; Startup)" Click="OnRecommendedOptimizeClick" />
                                                    <MenuFlyoutItem Text="Safe Mode (Temp &amp; DNS)" Click="OnSafeOptimizeClick" />
                                                    <MenuFlyoutItem Text="Advanced Mode (Registry &amp; Tweaks)" Click="OnAdvancedOptimizeClick" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Undo Last Optimization" Click="OnUndoOptimizeClick" />
                                                </MenuFlyout>
                                            </Button.ContextFlyout>
                                        </Button>
                                    </Grid>
                                </Grid>

                                <!-- Reassuring Safety & Restore Point Indicator -->
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                    <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="{ThemeResource AppStatusGoodBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Automatic Restore Point Protection Active • 1-Click Undo Supported" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Visibility="{x:Bind GetProgressVisibility(ViewModel.IsScanning), Mode=OneWay}" Spacing="4" Margin="0,3,0,0">
                                    <ProgressBar Value="{x:Bind ViewModel.ScanProgress, Mode=OneWay}" Maximum="100" Height="5" Foreground="{StaticResource PrimaryAccentGradient}" CornerRadius="2.5" />
                                </StackPanel>

                                <TextBlock Text="{x:Bind ViewModel.ScanStatus, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Margin="0,2,0,0" FontSize="11.5"
                                           AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right Side Row 0 Column 1: WinCare AI Engine Bento Card -->
                    <Border x:Name="AiWinCareEngineEmbeddedPanel" Grid.Row="0" Grid.Column="1" Style="{StaticResource CyberBentoHeroCardStyle}" Margin="6" Padding="20,18" MinHeight="195" CornerRadius="16"
                            helpers:AnimationHelper.StaggerIndex="1" helpers:AnimationHelper.HoverScale="1.01">
                        <Grid>
                            <!-- Ambient AI Cortex Aura Glow -->
                            <Ellipse Width="190" Height="190" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-30,-30,0" Opacity="0.12" IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop Color="#FF8B5CF6" Offset="0" />
                                        <GradientStop Color="Transparent" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <StackPanel Spacing="8">
                            <!-- AI Header Row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="{StaticResource PrimaryAccentGradient}" CornerRadius="8" Padding="7,3">
                                            <FontIcon Glyph="&#xE99A;" FontSize="12" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="AI Copilot Advisor" FontSize="16" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Border Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="Autonomous" FontSize="9.5" FontWeight="ExtraBold" Foreground="{ThemeResource AppBadgeGoodFg}" FontFamily="Segoe UI Variable Display"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="AiSummaryText" Text="{x:Bind ViewModel.AiSummaryText, Mode=OneWay}" FontSize="11.5"
                                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" LineHeight="16"/>
                                </StackPanel>

                                <!-- AI Score Mini Ring -->
                                <Grid Grid.Column="1" Width="52" Height="52" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Ellipse Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="4" Opacity="0.25"/>
                                    <ProgressRing Value="{x:Bind ViewModel.AiHealthScore, Mode=OneWay}" Width="48" Height="48"
                                                  Foreground="{StaticResource PrimaryAccentBrush}" Background="Transparent" IsIndeterminate="False"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="AiScoreText" Text="{x:Bind ViewModel.AiHealthScore, Mode=OneWay}"
                                                   FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource PrimaryAccentBrush}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                        <TextBlock Text="AI Score" FontSize="7.5" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- Predictive Insights Chips (inline 2-column balanced) -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource QuickStatCardStyle}" CornerRadius="12" Padding="12,8" MinHeight="0">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE7F1;" FontSize="11" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                            <TextBlock Text="Storage Trajectory" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.AiPredictiveStorageText, Mode=OneWay}" FontSize="13" FontWeight="Bold" Foreground="#FF10B981" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource QuickStatCardStyle}" CornerRadius="12" Padding="12,8" MinHeight="0">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE7B5;" FontSize="11" Foreground="#FFF59E0B"/>
                                            <TextBlock Text="Boot Acceleration" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.AiPredictiveBootText, Mode=OneWay}" FontSize="13" FontWeight="Bold" Foreground="#FFF59E0B" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Bottom AI Recommendation & Scan Strip -->
                            <Border x:Name="TopAiRecommendationCard" Style="{StaticResource QuickStatCardStyle}" CornerRadius="12" Padding="14,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1" Margin="0,0,10,0">
                                        <TextBlock x:Name="TopRecommendationTitle" Text="Run AI Scan for insights" FontWeight="SemiBold" FontSize="11.5"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TopRecommendationDesc" Text="Click 'AI Scan' to analyze system health." FontSize="10.5"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                    </StackPanel>

                                    <!-- AI Scan Button on Far Right -->
                                    <Button Grid.Column="1" Click="OnEmbeddedAiScanClick" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="28" Padding="14,0" CornerRadius="8" VerticalAlignment="Center"
                                            AutomationProperties.Name="Run AI Scan"
                                            AutomationProperties.HelpText="Performs AI-assisted system analysis and generates health recommendations.">
                                        <TextBlock Text="AI Scan" FontSize="11" FontWeight="Bold"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                    <!-- Simple Mode Quick Actions Deck (Streamlined 3-card cockpit for casual users) -->
                    <Grid x:Name="SimpleQuickActionsDeck" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="6,4,6,6" ColumnSpacing="12" RowSpacing="12" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="SimpleDeckRow0" Height="Auto"/>
                            <RowDefinition x:Name="SimpleDeckRow1" Height="Auto"/>
                            <RowDefinition x:Name="SimpleDeckRow2" Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SimpleDeckCol0" Width="*"/>
                            <ColumnDefinition x:Name="SimpleDeckCol1" Width="*"/>
                            <ColumnDefinition x:Name="SimpleDeckCol2" Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Quick Junk Clean -->
                        <Border x:Name="SimpleCard0" Grid.Row="0" Grid.Column="0" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,14" CornerRadius="16"
                                helpers:AnimationHelper.HoverScale="1.015" helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="5.0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="34" Height="34" CornerRadius="10" Background="#20F59E0B">
                                        <FontIcon Glyph="&#xEA99;" FontSize="15" Foreground="#FFF59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Junk &amp; Storage" FontSize="13" FontWeight="Bold" FontFamily="Segoe UI Variable Display"/>
                                        <TextBlock Text="Cleanable Space Potential" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,10,0,4" VerticalAlignment="Bottom">
                                    <TextBlock Text="{x:Bind ViewModel.JunkFileSize, Mode=OneWay}" FontSize="24" FontWeight="Black" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" Foreground="#FFF59E0B"/>
                                    <TextBlock Text="cleanable junk" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="System caches, temp files, and old logs that are 100% safe to clean now." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,10"/>
                                <Button Grid.Row="3" Content="Clean Junk Now" Style="{StaticResource VibrantPrimaryButtonStyle}" HorizontalAlignment="Stretch" Height="34" CornerRadius="10" FontWeight="Bold" FontSize="12" Click="OnCleanDiskClick" IsEnabled="{x:Bind IsNot(ViewModel.IsOptimizing), Mode=OneWay}"
                                        helpers:AnimationHelper.HoverScale="1.03" helpers:AnimationHelper.PressedScale="0.97"
                                        AutomationProperties.Name="Clean Junk Now" AutomationProperties.HelpText="Instantly cleans safe temporary junk and caches."/>
                            </Grid>
                        </Border>

                        <!-- Card 2: Instant Memory Boost -->
                        <Border x:Name="SimpleCard1" Grid.Row="0" Grid.Column="1" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,14" CornerRadius="16"
                                helpers:AnimationHelper.HoverScale="1.015" helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="5.0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="34" Height="34" CornerRadius="10" Background="#203B82F6">
                                        <FontIcon Glyph="&#xE950;" FontSize="15" Foreground="#FF3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Memory &amp; Speed Boost" FontSize="13" FontWeight="Bold" FontFamily="Segoe UI Variable Display"/>
                                        <TextBlock Text="Instant RAM Booster" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,10,0,4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind FormatRamText(ViewModel.RamUsage), Mode=OneWay}" FontSize="20" FontWeight="Black" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" Foreground="#FF3B82F6"/>
                                    <Border Background="#2010B981" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="Smooth" FontSize="10.5" FontWeight="Bold" Foreground="#FF10B981"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="Purges unused standby cache and optimizes working sets for responsive speed." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,10"/>
                                <Button Grid.Row="3" Content="Boost RAM Now" Style="{StaticResource VibrantPrimaryButtonStyle}" HorizontalAlignment="Stretch" Height="34" CornerRadius="10" FontWeight="Bold" FontSize="12" Click="OnBoostRamClick" IsEnabled="{x:Bind IsNot(ViewModel.IsOptimizing), Mode=OneWay}"
                                        helpers:AnimationHelper.HoverScale="1.03" helpers:AnimationHelper.PressedScale="0.97"
                                        AutomationProperties.Name="Boost RAM Now" AutomationProperties.HelpText="Reclaims standby memory and optimizes system working sets."/>
                            </Grid>
                        </Border>

                        <!-- Card 3: Windows Quick Doctor & Healing -->
                        <Border x:Name="SimpleCard2" Grid.Row="0" Grid.Column="2" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,14" CornerRadius="16"
                                helpers:AnimationHelper.HoverScale="1.015" helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="5.0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="34" Height="34" CornerRadius="10" Background="#2010B981">
                                        <FontIcon Glyph="&#xE727;" FontSize="16" Foreground="#FF10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="System Protection &amp; Health" FontSize="13" FontWeight="Bold" FontFamily="Segoe UI Variable Display"/>
                                        <TextBlock Text="System Safety Status" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,12,0,8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="#FF10B981" VerticalAlignment="Center"/>
                                    <TextBlock Text="Fully Protected &amp; Secure" FontSize="16" FontWeight="ExtraBold" FontFamily="Segoe UI Variable Display" Foreground="#FF10B981" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="Operating system files intact, Registry strictly protected, and Restore Point active." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,10"/>
                                <Button Grid.Row="3" Content="Repair System Now" Style="{StaticResource StandardSecondaryButtonStyle}" HorizontalAlignment="Stretch" Height="34" CornerRadius="10" FontWeight="Bold" FontSize="12" Click="OnQuickRepairDoctorClick"
                                        helpers:AnimationHelper.HoverScale="1.03" helpers:AnimationHelper.PressedScale="0.97"
                                        AutomationProperties.Name="Repair System Now" AutomationProperties.HelpText="Navigate to System Repair Center."/>
                            </Grid>
                        </Border>

                        <!-- Collapsible Pro Drawer: Xem chi tiết phần cứng chuyên sâu -->
                        <Button x:Name="ToggleHardwareDrawerBtn" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                Click="OnToggleHardwareDrawerClick"
                                Style="{StaticResource StandardSecondaryButtonStyle}"
                                HorizontalAlignment="Stretch" Height="38" CornerRadius="12" Margin="0,4,0,0"
                                helpers:AnimationHelper.HoverScale="1.01" helpers:AnimationHelper.PressedScale="0.98">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="24" Height="24" CornerRadius="6" Background="{ThemeResource AppStatChipBackground}">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="View Deep Hardware Sensor Analytics" FontSize="12" FontWeight="Bold" FontFamily="Segoe UI Variable Display" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="CPU clock graphs, RAM bus, GPU &amp; WMI sensor details" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock x:Name="HardwareDrawerToggleStatusText" Text="Expand" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                                    <FontIcon x:Name="HardwareDrawerChevronIcon" Glyph="&#xE70D;" FontSize="11" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- 2. CPU & RAM Kinetic Bento Cards -->
                    <Grid x:Name="CpuRamGrid" Grid.Row="2" Grid.Column="0" ColumnSpacing="0" RowSpacing="0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="CpuRamRow0" Height="Auto" />
                            <RowDefinition x:Name="CpuRamRow1" Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="CpuRamCol0" Width="*" />
                            <ColumnDefinition x:Name="CpuRamCol1" Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- CPU Card with overload indicator border glow -->
                        <Border x:Name="CpuCard" Grid.Column="0" Style="{StaticResource GlassmorphismCardStyle}" Margin="6" Padding="16" CornerRadius="16"
                                BorderBrush="{x:Bind GetCpuCardBorderBrush(ViewModel.CpuUsage), Mode=OneWay}"
                                helpers:AnimationHelper.StaggerIndex="2"
                                helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="6.5" helpers:Animation3DHelper.DepthZ="16">
                            <StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="CPU Processor Load" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" FontSize="11.5"/>
                                    <TextBlock Text="{x:Bind FormatPercent(ViewModel.CpuUsage), Mode=OneWay}" FontSize="28" FontWeight="Black" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                    <ProgressBar Value="{x:Bind ViewModel.CpuUsage, Mode=OneWay}" Maximum="100" Height="5.5" Foreground="{StaticResource CpuAccentBrush}" Background="{StaticResource CpuTrackBrush}" CornerRadius="3" Margin="0,4,0,0" />
                                </StackPanel>
                                <Grid Margin="0,12,0,0" Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE9CA;" FontSize="11.5" Foreground="{StaticResource CpuAccentBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind ViewModel.CpuTempFormatted, Mode=OneWay}" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- RAM Card with overload indicator background glow/pulse -->
                        <Border x:Name="RamCard" Grid.Column="1" Style="{StaticResource GlassmorphismCardStyle}" Margin="6" Padding="16" CornerRadius="16"
                                Background="{x:Bind GetRamCardBackground(ViewModel.RamUsage), Mode=OneWay}"
                                helpers:AnimationHelper.StaggerIndex="3"
                                helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="6.5" helpers:Animation3DHelper.DepthZ="16">
                            <StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Memory (RAM) Footprint" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" FontSize="11.5"/>
                                    <TextBlock Text="{x:Bind FormatPercent(ViewModel.RamUsage), Mode=OneWay}" FontSize="28" FontWeight="Black" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                    <ProgressBar Value="{x:Bind ViewModel.RamUsage, Mode=OneWay}" Maximum="100" Height="5.5" Foreground="{StaticResource RamAccentBrush}" Background="{StaticResource RamTrackBrush}" CornerRadius="3" Margin="0,4,0,0" />
                                </StackPanel>
                                <Grid Margin="0,12,0,0" Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE950;" FontSize="11.5" Foreground="{StaticResource RamAccentBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind ViewModel.RamCapacityFormatted, Mode=OneWay}" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Grid.Column="1" Content="Purge RAM" Style="{StaticResource VibrantPrimaryButtonStyle}" Padding="12,0" Height="30" CornerRadius="8" FontSize="11.5" FontWeight="Bold" Click="OnBoostRamClick" IsEnabled="{x:Bind IsNot(ViewModel.IsOptimizing), Mode=OneWay}"
                                            AutomationProperties.Name="Boost Memory"
                                            AutomationProperties.HelpText="Clears standby memory and optimizes system working sets."/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Right Side Column 1 -->

                    <!-- 1. Bottleneck Advisor widget (Placed on Row 2 Column 1) -->
                    <Border x:Name="BottleneckCard" Grid.Row="2" Grid.Column="1" Style="{StaticResource GlassmorphismCardStyle}" Margin="6" Padding="16" CornerRadius="16" Visibility="Collapsed"
                            helpers:AnimationHelper.StaggerIndex="4"
                            helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="6.5" helpers:Animation3DHelper.DepthZ="16">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock Text="Bottleneck Detection" FontSize="16" FontWeight="Bold" FontFamily="Segoe UI Variable Display"/>
                            </StackPanel>
                            <Border Background="{x:Bind GetBottleneckBadgeBg(ViewModel.HasBottleneck), Mode=OneWay}" CornerRadius="8" Padding="10,4" HorizontalAlignment="Left">
                                <TextBlock Text="{x:Bind ViewModel.BottleneckStatus, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="{x:Bind GetBottleneckBadgeFg(ViewModel.HasBottleneck), Mode=OneWay}" FontFamily="Segoe UI Variable Display"/>
                            </Border>
                            <TextBlock Text="Weighted multi-factor analysis of CPU, RAM and NVMe/Disk constraints." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" LineHeight="16"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. Quick Stats Grid (Clickable navigation cards) -->
                    <Grid x:Name="QuickStatsGrid" Grid.Row="3" Grid.Column="1" RowSpacing="0" ColumnSpacing="0" Visibility="Collapsed"
                          helpers:AnimationHelper.StaggerIndex="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                          <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource TransparentWrapperButtonStyle}" Click="OnQuickStatUptimeClick"
                                  AutomationProperties.Name="System Uptime Details" AutomationProperties.HelpText="View system uptime details">
                            <Border Style="{StaticResource CyberStatCapsuleStyle}" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="60" Padding="12,10" CornerRadius="14">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="10" Background="{ThemeResource AppCardBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE916;" FontSize="14" Foreground="{StaticResource GpuAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Uptime" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.SystemUptime, Mode=OneWay}" FontSize="13.5" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>

                        <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource TransparentWrapperButtonStyle}" Click="OnQuickStatNetworkClick"
                                AutomationProperties.Name="Network Status Details" AutomationProperties.HelpText="View network activity details">
                            <Border Style="{StaticResource CyberStatCapsuleStyle}" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="60" Padding="12,10" CornerRadius="14">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="10" Background="{ThemeResource AppCardBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="#FF0284C7" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Network" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.NetworkStatus, Mode=OneWay}" FontSize="13.5" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>

                        <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource TransparentWrapperButtonStyle}" Click="OnQuickStatJunkClick"
                                AutomationProperties.Name="Navigate to Junk Cleaner" AutomationProperties.HelpText="Open Junk Cleaner module">
                            <Border Style="{StaticResource CyberStatCapsuleStyle}" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="60" Padding="12,10" CornerRadius="14">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="10" Background="{ThemeResource AppCardBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xEA99;" FontSize="14" Foreground="#FFF59E0B" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Junk Size" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.JunkFileSize, Mode=OneWay}" FontSize="13.5" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>

                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource TransparentWrapperButtonStyle}" Click="OnQuickStatAppsClick"
                                AutomationProperties.Name="Navigate to App Uninstaller" AutomationProperties.HelpText="Open App Uninstaller module">
                            <Border Style="{StaticResource CyberStatCapsuleStyle}" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="60" Padding="12,10" CornerRadius="14">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="10" Background="{ThemeResource AppCardBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE71D;" FontSize="14" Foreground="#FF8B5CF6" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Apps" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.InstalledAppsCount, Mode=OneWay}" FontSize="13.5" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </Grid>

                    <!-- Row 3: GPU and Disk Cards (Lazy Loaded) -->
                    <Grid x:Name="GpuDiskGrid" Grid.Row="3" Grid.Column="0" x:Load="{x:Bind ViewModel.IsExtendedLayerLoaded, Mode=OneWay}" Loaded="OnExtendedLayerPanelLoaded" ColumnSpacing="0" RowSpacing="0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="GpuDiskRow0" Height="Auto" />
                            <RowDefinition x:Name="GpuDiskRow1" Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="GpuDiskCol0" Width="*" />
                            <ColumnDefinition x:Name="GpuDiskCol1" Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- GPU Card -->
                        <Border x:Name="GpuCard" Grid.Column="0" Style="{StaticResource GlassmorphismCardStyle}" Margin="6" Padding="16" CornerRadius="16"
                                helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="6.5" helpers:Animation3DHelper.DepthZ="16">
                            <StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Graphics Card (GPU) Load" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" FontSize="11.5"/>
                                    <TextBlock Text="{x:Bind FormatPercent(ViewModel.GpuUsage), Mode=OneWay}" FontSize="28" FontWeight="Black" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                    <ProgressBar Value="{x:Bind ViewModel.GpuUsage, Mode=OneWay}" Maximum="100" Height="5.5" Foreground="{StaticResource GpuAccentBrush}" Background="{StaticResource GpuTrackBrush}" CornerRadius="3" Margin="0,4,0,0" />
                                </StackPanel>
                                <Grid Margin="0,12,0,0" Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE9F5;" FontSize="11.5" Foreground="{StaticResource GpuAccentBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Active Monitoring" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Storage Card with warning state glow -->
                        <Border x:Name="DiskCard" Grid.Column="1" Style="{StaticResource GlassmorphismCardStyle}" Margin="6" Padding="16" CornerRadius="16"
                                helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="6.5" helpers:Animation3DHelper.DepthZ="16"
                                BorderBrush="{x:Bind GetDiskCardBorderBrush(ViewModel.DiskUsage), Mode=OneWay}">
                            <StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="System Disk Activity" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" FontSize="11.5"/>
                                    <TextBlock Text="{x:Bind FormatPercent(ViewModel.DiskUsage), Mode=OneWay}" FontSize="28" FontWeight="Black" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                    <ProgressBar Value="{x:Bind ViewModel.DiskUsage, Mode=OneWay}" Maximum="100" Height="5.5" Foreground="{StaticResource DiskAccentBrush}" Background="{StaticResource DiskTrackBrush}" CornerRadius="3" Margin="0,4,0,0" />
                                </StackPanel>
                                <Grid Margin="0,12,0,0" Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xEA99;" FontSize="11.5" Foreground="{StaticResource DiskAccentBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind ViewModel.JunkFileSize, Mode=OneWay}" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Grid.Column="1" Content="Clean" Style="{StaticResource VibrantPrimaryButtonStyle}" Padding="12,0" Height="30" CornerRadius="8" FontSize="11.5" FontWeight="Bold" Click="OnCleanDiskClick" IsEnabled="{x:Bind IsNot(ViewModel.IsOptimizing), Mode=OneWay}"
                                            AutomationProperties.Name="Clean Disk"
                                            AutomationProperties.HelpText="Cleans temporary junk files from system drives."/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 4: Performance Trend Chart Card with Series Toggles (Lazy Loaded) -->
                    <Border x:Name="PerformanceChartCard" Grid.Row="4" Grid.Column="1" x:Load="{x:Bind ViewModel.IsExtendedLayerLoaded, Mode=OneWay}" Loaded="OnExtendedLayerPanelLoaded" Style="{StaticResource GlassmorphismCardStyle}" Margin="6" Padding="14" CornerRadius="14" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel x:Name="PerformanceHeaderGrid" Grid.Row="0" Margin="0,0,0,16" Spacing="8">
                                <StackPanel x:Name="PerformanceTitlePanel" Spacing="4">
                                    <TextBlock Text="Performance Trend History" FontSize="16" FontWeight="Bold" />
                                    <TextBlock Text="Rolling history of resource load levels (CPU, RAM, GPU, Disk)" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                </StackPanel>

                                <!-- Resource Insights Telemetry Banner -->
                                <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,2,0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE9D9;" FontSize="13" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ResourceInsightsText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ResourceAverageLoadText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                </Border>

                                <VariableSizedWrapGrid x:Name="PerformanceFiltersPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="CpuFilterCheck" Content="CPU" IsChecked="True" Checked="OnChartFilterChanged" Unchecked="OnChartFilterChanged" Margin="0,0,16,8" />
                                    <CheckBox x:Name="RamFilterCheck" Content="RAM" IsChecked="True" Checked="OnChartFilterChanged" Unchecked="OnChartFilterChanged" Margin="0,0,16,8" />
                                    <CheckBox x:Name="GpuFilterCheck" Content="GPU" IsChecked="True" Checked="OnChartFilterChanged" Unchecked="OnChartFilterChanged" Margin="0,0,16,8" />
                                    <CheckBox x:Name="DiskFilterCheck" Content="Disk" IsChecked="True" Checked="OnChartFilterChanged" Unchecked="OnChartFilterChanged" Margin="0,0,0,8" />
                                </VariableSizedWrapGrid>
                            </StackPanel>

                            <lvc:CartesianChart
                                Grid.Row="1"
                                Height="200"
                                Series="{x:Bind ViewModel.PerformanceSeries, Mode=OneWay}"
                                XAxes="{x:Bind ViewModel.XAxes, Mode=OneWay}"
                                YAxes="{x:Bind ViewModel.YAxes, Mode=OneWay}"
                                FindingStrategy="CompareAll" />
                        </Grid>
                    </Border>

                    <!-- Row 4: Smart AI Advice Card (Actionable layout) (Lazy Loaded) -->
                    <Border x:Name="RecommendationsCard" Grid.Row="4" Grid.Column="0" Grid.RowSpan="1" x:Load="{x:Bind ViewModel.IsExtendedLayerLoaded, Mode=OneWay}" Loaded="OnExtendedLayerPanelLoaded" Style="{StaticResource GlassmorphismCardStyle}" Margin="6" Padding="14" CornerRadius="14" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,12" Spacing="4">
                                <TextBlock Text="Smart AI Advice" FontSize="18" FontWeight="Bold" />
                                <TextBlock Text="Suggested actions based on diagnostics:" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="No recommendations. Run a full scan to evaluate your PC health." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Visibility="{x:Bind GetVisibility(ViewModel.Recommendations.Count), Mode=OneWay}" Margin="0,16,0,0" TextAlignment="Center" />

                                    <ItemsControl ItemsSource="{x:Bind ViewModel.Recommendations, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource ControlAltFillColorSecondaryBrush}" CornerRadius="10" Margin="0,0,0,10" Padding="14">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" Spacing="12" Grid.Column="0">
                                                            <Border Width="28" Height="28" Background="#157F56D9" CornerRadius="14" VerticalAlignment="Center">
                                                                <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Text="{x:Bind}" TextWrapping="Wrap" FontSize="12" LineHeight="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                        </StackPanel>
                                                        <!-- Actionable Quick Fix button in the card -->
                                                        <Button Grid.Column="1" Content="Fix" Style="{StaticResource DefaultButtonStyle}" VerticalAlignment="Center" Padding="12,6" Height="30" CornerRadius="6" FontSize="11.5" FontWeight="Bold" Click="OnRecommendationFixClick"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Clean Advanced Details & History Log Toggle Banner Deck -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,10"
                        Margin="6,4,6,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                <FontIcon Glyph="&#xE9D9;" FontSize="15" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="System Deep Layer Diagnostics" FontWeight="SemiBold" FontSize="13.5"/>
                                <TextBlock Text="Detailed audits, itemized discoveries &amp; operation logs" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <ToggleButton Grid.Column="2"
                                      x:Name="ShowDetailedInsightsBtn"
                                      Content="Advanced Details &amp; History Log"
                                      Checked="OnShowDeepLayerChecked"
                                      Unchecked="OnShowDeepLayerUnchecked"
                                      Style="{StaticResource DefaultToggleButtonStyle}"
                                      Background="{StaticResource PrimaryAccentGradient}"
                                      Foreground="White"
                                      FontWeight="SemiBold"
                                      CornerRadius="6"
                                      Padding="14,6"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Toggle Advanced Details and History Log"/>
                    </Grid>
                </Border>

                <!-- 3. DEEP LAYER (Loaded on Demand) -->
                <StackPanel x:Name="DeepLayerPanel" x:Load="False" Spacing="16">

                    <!-- Row 1: Detailed Audits Table -->
                    <Border x:Name="AuditsCard" Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE721;" FontSize="16" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Diagnostics Discoveries" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Export Report controls -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="ExportFormatCombo" SelectedIndex="0" Width="100" CornerRadius="6">
                                        <ComboBoxItem Content="TXT" />
                                        <ComboBoxItem Content="JSON" />
                                        <ComboBoxItem Content="CSV" />
                                    </ComboBox>
                                    <Button Content="Export Report" Style="{StaticResource DefaultButtonStyle}" Click="OnExportReportClick" CornerRadius="6" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="0" Margin="0,0,0,16" VerticalAlignment="Bottom">
                                <TextBlock x:Name="ExportStatusText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="MediumSeaGreen" Visibility="Collapsed"/>
                            </StackPanel>

                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.DiagnosticItems, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="False">
                                <ListView.ItemContainerTransitions>
                                    <TransitionCollection>
                                        <AddDeleteThemeTransition />
                                        <RepositionThemeTransition />
                                    </TransitionCollection>
                                </ListView.ItemContainerTransitions>
                                <ListView.Header>
                                    <Grid Padding="12,8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.8*" />
                                            <ColumnDefinition Width="4*" />
                                            <ColumnDefinition Width="1.5*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Category" FontWeight="Bold" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                        <TextBlock Grid.Column="1" Text="Check Name" FontWeight="Bold" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                        <TextBlock Grid.Column="2" Text="Description" FontWeight="Bold" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                        <TextBlock Grid.Column="3" Text="Status" FontWeight="Bold" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Left" />
                                    </Grid>
                                </ListView.Header>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="12,10" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="1.8*" />
                                                <ColumnDefinition Width="4*" />
                                                <ColumnDefinition Width="1.5*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayCategory}" VerticalAlignment="Center" FontSize="12.5" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayCheckName}" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Text="{Binding DisplayDescription}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Margin="0,0,16,0" LineHeight="16"/>
                                            <Grid Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <Border Background="{Binding StatusBadgeBg}" CornerRadius="6" Padding="10,5" Visibility="{Binding StatusBadgeVisibility}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="{Binding StatusIcon}" Foreground="{Binding StatusColor}" FontSize="11" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding DisplayStatusLabel}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <Button Content="Fix Now" Style="{StaticResource DefaultButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" Padding="12,5" Height="28" CornerRadius="6" FontSize="11" FontWeight="Bold" Visibility="{Binding FixButtonVisibility}" Click="OnFixItemClick" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Operations Timeline -->
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEC92;" FontSize="16" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Operations &amp; Optimization Timeline" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.ActionLogs, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="10,10" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="30" Height="30" Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="15" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="MediumSeaGreen" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding DisplayAction}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding DisplayModule}" FontSize="10.5" Foreground="{StaticResource PrimaryAccentBrush}" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                                <TextBlock Text="{Binding CreatedAtFormatted}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding DisplayStatus}" FontSize="11" Foreground="MediumSeaGreen" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>



