<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinCarePro.ViewModels"
    xmlns:local="using:WinCarePro.Views"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    xmlns:db="using:WinCarePro.Database"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid Padding="20,16" HorizontalAlignment="Stretch">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutVisualStates">
                <!-- Wide Layout: Viewport Width >= 1200px -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1200" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- Medium Layout: Viewport Width >= 768px and < 1200px (Default Windowed Mode) -->
                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="768" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- Narrow Layout: Viewport Width < 768px -->
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="GaugeRingGrid.(Grid.Row)" Value="0" />
                        <Setter Target="GaugeRingGrid.(Grid.Column)" Value="0" />
                        <Setter Target="GaugeRingGrid.HorizontalAlignment" Value="Center" />
                        <Setter Target="GaugeRingGrid.Margin" Value="0,0,0,16" />

                        <Setter Target="GaugeDescPanel.(Grid.Row)" Value="1" />
                        <Setter Target="GaugeDescPanel.(Grid.Column)" Value="0" />
                        <Setter Target="GaugeDescPanel.HorizontalAlignment" Value="Center" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="{StaticResource PrimaryAccentGradient}" CornerRadius="8" Padding="7">
                        <FontIcon Glyph="&#xE80F;" FontSize="16" Foreground="White" />
                    </Border>
                    <TextBlock Text="System Dashboard" Style="{StaticResource PageHeaderTitleStyle}" VerticalAlignment="Center" />
                    <Border Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="6" Padding="7,2.5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="6" Height="6" Fill="{ThemeResource AppBadgeGoodFg}" />
                            <TextBlock Text="Live Telemetry" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppBadgeGoodFg}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource AppBadgeNeutralBg}" BorderBrush="{ThemeResource AppBadgeNeutralBorder}" BorderThickness="1" CornerRadius="6" Padding="7,2.5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource PrimaryAccentBrush}"/>
                            <TextBlock Text="Kernel Engine Active" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="Real-time hardware telemetry &amp; intelligent system care." Style="{StaticResource PageHeaderSubtitleStyle}" />
            </StackPanel>

            <!-- Fast Action Navigation Deck in Header Top Right -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="OnLaunchOptimizerClick" Style="{StaticResource StandardSecondaryButtonStyle}" Height="32" Padding="12,0" VerticalAlignment="Center" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7FC;" FontSize="12" Foreground="#FFF59E0B"/>
                        <TextBlock Text="System Optimizer" FontSize="11.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Button Click="OnLaunchDesktopWidgetClick" Style="{StaticResource StandardSecondaryButtonStyle}" Height="32" Padding="12,0" VerticalAlignment="Center" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A7;" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}"/>
                        <TextBlock Text="Widget HUD" FontSize="11.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10">

                <!-- Main Content Grid combining Core and Extended layers -->
                <Grid x:Name="MainContentGrid" ColumnSpacing="0" RowSpacing="0" Padding="0">
                    <Grid.RowDefinitions>
                        <!-- Wide Layout Rows -->
                        <RowDefinition x:Name="Row0" Height="Auto" />
                        <RowDefinition x:Name="Row1" Height="Auto" />
                        <RowDefinition x:Name="Row2" Height="Auto" />
                        <RowDefinition x:Name="Row3" Height="Auto" />
                        <!-- Extra rows for Narrow Layout stacking -->
                        <RowDefinition x:Name="Row4" Height="Auto" />
                        <RowDefinition x:Name="Row5" Height="Auto" />
                        <RowDefinition x:Name="Row6" Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftCol" Width="1*" />
                        <ColumnDefinition x:Name="RightCol" Width="1*" />
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left Side Column 0: System Health Overview Hero Card -->
                    <Border x:Name="HealthGaugeCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource ModernCardStyle}" Margin="6" Padding="18,16" MinHeight="185">
                        <Grid x:Name="HealthGaugeGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="HealthGaugeRow0" Height="Auto" />
                                <RowDefinition x:Name="HealthGaugeRow1" Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="HealthGaugeCol0" Width="Auto" />
                                <ColumnDefinition x:Name="HealthGaugeCol1" Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <!-- Clean High-Definition System Health Gauge -->
                            <Grid x:Name="GaugeRingGrid" Grid.Column="0" Width="130" Height="130" Margin="0,0,18,0" VerticalAlignment="Center">
                                <!-- Background Track Ring -->
                                <Ellipse Width="120" Height="120" Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="7" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3"/>

                                <!-- Main Health Progress Ring -->
                                <ProgressRing Value="{x:Bind ViewModel.HealthScore, Mode=OneWay}" Width="120" Height="120" Foreground="{x:Bind GetHealthScoreBrush(ViewModel.HealthScore), Mode=OneWay}" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <!-- Centerpiece Typography HUD -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{x:Bind ViewModel.HealthScore, Mode=OneWay}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{x:Bind GetHealthScoreBrush(ViewModel.HealthScore), Mode=OneWay}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                    <TextBlock Text="HEALTH SCORE" FontSize="8.5" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center" CharacterSpacing="8"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="GaugeDescPanel" Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                <TextBlock Text="System Health Overview" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <Border Background="{x:Bind GetHealthScoreBadgeBackground(ViewModel.HealthScore), Mode=OneWay}" HorizontalAlignment="Left" Padding="8,3" CornerRadius="6">
                                    <TextBlock Text="{x:Bind GetStatusText(ViewModel.HealthScore), Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{x:Bind GetHealthScoreBrush(ViewModel.HealthScore), Mode=OneWay}" TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Text="{x:Bind ViewModel.HealthBreakdownText, Mode=OneWay}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" LineHeight="16" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                
                                <Grid x:Name="GaugeActionButtonsGrid" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Button x:Name="ScanSystemBtn" Grid.Row="0" Grid.Column="0" Content="Scan System" Style="{StaticResource VibrantPrimaryButtonStyle}" Click="OnScanClick" IsEnabled="{x:Bind IsNot(ViewModel.IsScanning), Mode=OneWay}" Height="32" Padding="16,0" CornerRadius="6" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                    
                                    <!-- Split Button for Tiered Optimization -->
                                    <SplitButton x:Name="OptimizeSplitBtn" Grid.Row="0" Grid.Column="1" Content="Optimize System" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" Click="OnOptimizeClick" Visibility="{x:Bind GetOptimizeVisibility(ViewModel.HasScanned, ViewModel.IsScanning), Mode=OneWay}" IsEnabled="{x:Bind IsNot(ViewModel.IsOptimizing), Mode=OneWay}" Margin="0,0,8,0"
                                                 CornerRadius="6" FontWeight="SemiBold" Height="32">
                                        <SplitButton.Resources>
                                            <SolidColorBrush x:Key="SplitButtonButtonBackground" Color="#FF0284C7" />
                                            <SolidColorBrush x:Key="SplitButtonButtonBackgroundPointerOver" Color="#FF0F6CBD" />
                                            <SolidColorBrush x:Key="SplitButtonButtonBackgroundPressed" Color="#FF2563EB" />
                                            <SolidColorBrush x:Key="SplitButtonButtonBackgroundDisabled" Color="#FFE0E0E0" />
                                            
                                            <SolidColorBrush x:Key="SplitButtonButtonForeground" Color="White" />
                                            <SolidColorBrush x:Key="SplitButtonButtonForegroundPointerOver" Color="White" />
                                            <SolidColorBrush x:Key="SplitButtonButtonForegroundPressed" Color="#FFE0E7FF" />
                                            <SolidColorBrush x:Key="SplitButtonButtonForegroundDisabled" Color="#FF9E9E9E" />

                                            <SolidColorBrush x:Key="SplitButtonBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="SplitButtonBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="SplitButtonBorderBrushPressed" Color="Transparent" />

                                            <SolidColorBrush x:Key="SplitButtonSeparatorBrush" Color="#30FFFFFF" />
                                            <SolidColorBrush x:Key="SplitButtonSeparatorBrushPointerOver" Color="#50FFFFFF" />
                                        </SplitButton.Resources>
                                        <SplitButton.Flyout>
                                            <MenuFlyout Placement="Bottom">
                                                <MenuFlyoutItem Text="Safe Mode (Temp &amp; DNS)" Click="OnSafeOptimizeClick" />
                                                <MenuFlyoutItem Text="Recommended Mode (Caches &amp; Startup)" Click="OnRecommendedOptimizeClick" />
                                                <MenuFlyoutItem Text="Advanced Mode (Registry &amp; Tweaks)" Click="OnAdvancedOptimizeClick" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Undo Last Optimization" Click="OnUndoOptimizeClick" />
                                            </MenuFlyout>
                                        </SplitButton.Flyout>
                                    </SplitButton>
                                    
                                    <ProgressRing x:Name="GaugeActionProgressRing" Grid.Row="0" Grid.Column="2" IsActive="{x:Bind GetProgressRingActive(ViewModel.IsScanning, ViewModel.IsOptimizing), Mode=OneWay}" Width="18" Height="18" VerticalAlignment="Center" />
                                </Grid>
                                
                                <StackPanel Visibility="{x:Bind GetProgressVisibility(ViewModel.IsScanning), Mode=OneWay}" Spacing="4" Margin="0,2,0,0">
                                    <ProgressBar Value="{x:Bind ViewModel.ScanProgress, Mode=OneWay}" Maximum="100" Height="4" Foreground="{StaticResource PrimaryAccentGradient}" CornerRadius="2" />
                                </StackPanel>
                                
                                <TextBlock Text="{x:Bind ViewModel.ScanStatus, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Margin="0,1,0,0" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right Side Row 0 Column 1: WinCare AI Engine Card -->
                    <Border x:Name="AiWinCareEngineEmbeddedPanel" Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernCardStyle}" Margin="6" Padding="18,16" MinHeight="185">
                        <StackPanel Spacing="8">
                            <!-- AI Header Row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="{StaticResource PrimaryAccentGradient}" CornerRadius="6" Padding="6,2.5">
                                            <FontIcon Glyph="&#xE99A;" FontSize="11" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="AI Assistant" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Border Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="6" Padding="5,1" VerticalAlignment="Center">
                                            <TextBlock Text="Active" FontSize="9" FontWeight="ExtraBold" Foreground="{ThemeResource AppBadgeGoodFg}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="AiSummaryText" Text="{x:Bind ViewModel.AiSummaryText, Mode=OneWay}" FontSize="11" 
                                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- AI Score Mini Ring -->
                                <Grid Grid.Column="1" Width="48" Height="48" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Ellipse Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="3.5" Opacity="0.3"/>
                                    <ProgressRing Value="{x:Bind ViewModel.AiHealthScore, Mode=OneWay}" Width="44" Height="44" 
                                                  Foreground="{StaticResource PrimaryAccentBrush}" Background="Transparent" IsIndeterminate="False"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="AiScoreText" Text="{x:Bind ViewModel.AiHealthScore, Mode=OneWay}" 
                                                   FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" 
                                                   Foreground="{StaticResource PrimaryAccentBrush}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                        <TextBlock Text="AI Score" FontSize="7" FontWeight="SemiBold" 
                                                   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- Predictive Insights Chips (inline 2-column balanced) -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource QuickStatCardStyle}" Padding="10,6" MinHeight="0">
                                    <StackPanel Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE7F1;" FontSize="10" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                            <TextBlock Text="Storage Outlook" FontSize="9.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.AiPredictiveStorageText, Mode=OneWay}" FontSize="12.5" FontWeight="Bold" Foreground="#FF10B981" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource QuickStatCardStyle}" Padding="10,6" MinHeight="0">
                                    <StackPanel Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE7B5;" FontSize="10" Foreground="#FFF59E0B"/>
                                            <TextBlock Text="Boot Speed" FontSize="9.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.AiPredictiveBootText, Mode=OneWay}" FontSize="12.5" FontWeight="Bold" Foreground="#FFF59E0B" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Bottom AI Recommendation & Scan Strip -->
                            <Border x:Name="TopAiRecommendationCard" Style="{StaticResource QuickStatCardStyle}" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="{ThemeResource AppStatChipBackground}" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE99A;" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="0,0,8,0">
                                        <TextBlock x:Name="TopRecommendationTitle" Text="Run AI Scan for insights" FontWeight="SemiBold" FontSize="11" 
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TopRecommendationDesc" Text="Click 'AI Scan' to analyze system health." FontSize="10" 
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                    </StackPanel>

                                    <!-- AI Scan Button on Far Right -->
                                    <Button Grid.Column="2" Click="OnEmbeddedAiScanClick" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="28" Padding="12,0" CornerRadius="6" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE721;" FontSize="10"/>
                                            <TextBlock Text="AI Scan" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 2. CPU & RAM Mini cards -->
                    <Grid x:Name="CpuRamGrid" Grid.Row="1" Grid.Column="0" ColumnSpacing="0" RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="CpuRamRow0" Height="Auto" />
                            <RowDefinition x:Name="CpuRamRow1" Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="CpuRamCol0" Width="*" />
                            <ColumnDefinition x:Name="CpuRamCol1" Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- CPU Card with overload indicator border glow -->
                        <Border x:Name="CpuCard" Grid.Column="0" Style="{StaticResource GlassmorphismCardStyle}" Margin="6" Padding="14"
                                BorderBrush="{x:Bind GetCpuCardBorderBrush(ViewModel.CpuUsage), Mode=OneWay}"
                                helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="6.5" helpers:Animation3DHelper.DepthZ="16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="6" Grid.Column="0">
                                        <TextBlock Text="CPU Processor Load" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                        <TextBlock Text="{x:Bind FormatPercent(ViewModel.CpuUsage), Mode=OneWay}" FontSize="24" FontWeight="ExtraBold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                        <ProgressBar Value="{x:Bind ViewModel.CpuUsage, Mode=OneWay}" Maximum="100" Height="6" Foreground="{StaticResource CpuAccentBrush}" Background="{StaticResource CpuTrackBrush}" CornerRadius="3" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="44" Height="44" Background="#15F59E0B" CornerRadius="22" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0,0,0">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="18" Foreground="{StaticResource CpuAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,8,0,0" Height="28">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Grid.Column="0" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE9CA;" FontSize="12" Foreground="{StaticResource CpuAccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.CpuTempFormatted, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- RAM Card with overload indicator background glow/pulse -->
                        <Border x:Name="RamCard" Grid.Column="1" Style="{StaticResource GlassmorphismCardStyle}" Margin="6" Padding="14"
                                Background="{x:Bind GetRamCardBackground(ViewModel.RamUsage), Mode=OneWay}"
                                helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="6.5" helpers:Animation3DHelper.DepthZ="16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="6" Grid.Column="0">
                                        <TextBlock Text="Memory (RAM) Footprint" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                        <TextBlock Text="{x:Bind FormatPercent(ViewModel.RamUsage), Mode=OneWay}" FontSize="24" FontWeight="ExtraBold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                        <ProgressBar Value="{x:Bind ViewModel.RamUsage, Mode=OneWay}" Maximum="100" Height="6" Foreground="{StaticResource RamAccentBrush}" Background="{StaticResource RamTrackBrush}" CornerRadius="3" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="44" Height="44" Background="#153B82F6" CornerRadius="22" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0,0,0">
                                        <FontIcon Glyph="&#xE950;" FontSize="18" Foreground="{StaticResource RamAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,8,0,0" Height="28">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Grid.Column="0" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE950;" FontSize="12" Foreground="{StaticResource RamAccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.RamCapacityFormatted, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Boost" Style="{StaticResource DefaultButtonStyle}" Padding="12,4" Height="28" CornerRadius="6" FontSize="11" FontWeight="Bold" Click="OnBoostRamClick" IsEnabled="{x:Bind IsNot(ViewModel.IsOptimizing), Mode=OneWay}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Right Side Column 1 -->
                    
                    <!-- 1. Bottleneck Advisor widget (Placed on Row 1 Column 1) -->
                    <Border x:Name="BottleneckCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource GlassmorphismCardStyle}" Margin="6" Padding="14"
                            helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="6.5" helpers:Animation3DHelper.DepthZ="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Bottleneck Detection" FontSize="15" FontWeight="Bold"/>
                            <Border Background="{x:Bind GetBottleneckBadgeBg(ViewModel.HasBottleneck), Mode=OneWay}" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left">
                                <TextBlock Text="{x:Bind ViewModel.BottleneckStatus, Mode=OneWay}" FontSize="11.5" FontWeight="Bold" Foreground="{x:Bind GetBottleneckBadgeFg(ViewModel.HasBottleneck), Mode=OneWay}"/>
                            </Border>
                            <TextBlock Text="Weighted analysis of CPU, RAM and Disk constraints." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. Quick Stats Grid (Clickable navigation cards) -->
                    <Grid x:Name="QuickStatsGrid" Grid.Row="2" Grid.Column="1" RowSpacing="0" ColumnSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                          <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource TransparentWrapperButtonStyle}" Click="OnQuickStatUptimeClick">
                            <Border Style="{StaticResource QuickStatCardStyle}" Margin="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="56" Padding="10,8">
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE916;" FontSize="11" Foreground="{StaticResource GpuAccentBrush}"/>
                                        <TextBlock Text="Uptime" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.SystemUptime, Mode=OneWay}" FontSize="12.5" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource TransparentWrapperButtonStyle}" Click="OnQuickStatNetworkClick">
                            <Border Style="{StaticResource QuickStatCardStyle}" Margin="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="56" Padding="10,8">
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE774;" FontSize="11" Foreground="DodgerBlue"/>
                                        <TextBlock Text="Network" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.NetworkStatus, Mode=OneWay}" FontSize="12.5" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource TransparentWrapperButtonStyle}" Click="OnQuickStatJunkClick">
                            <Border Style="{StaticResource QuickStatCardStyle}" Margin="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="56" Padding="10,8">
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xEA99;" FontSize="11" Foreground="Orange"/>
                                        <TextBlock Text="Junk Size" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.JunkFileSize, Mode=OneWay}" FontSize="12.5" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource TransparentWrapperButtonStyle}" Click="OnQuickStatAppsClick">
                            <Border Style="{StaticResource QuickStatCardStyle}" Margin="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="56" Padding="10,8">
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE71D;" FontSize="11" Foreground="MediumPurple"/>
                                        <TextBlock Text="Apps" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.InstalledAppsCount, Mode=OneWay}" FontSize="12.5" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Button>
                    </Grid>

                    <!-- Row 2: GPU and Disk Cards (Lazy Loaded) -->
                    <Grid x:Name="GpuDiskGrid" Grid.Row="2" Grid.Column="0" x:Load="{x:Bind ViewModel.IsExtendedLayerLoaded, Mode=OneWay}" Loaded="OnExtendedLayerPanelLoaded" ColumnSpacing="0" RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="GpuDiskRow0" Height="Auto" />
                            <RowDefinition x:Name="GpuDiskRow1" Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="GpuDiskCol0" Width="*" />
                            <ColumnDefinition x:Name="GpuDiskCol1" Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- GPU Card -->
                        <Border x:Name="GpuCard" Grid.Column="0" Style="{StaticResource GlassmorphismCardStyle}" Margin="6" Padding="14"
                                helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="6.5" helpers:Animation3DHelper.DepthZ="16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="6" Grid.Column="0">
                                        <TextBlock Text="Graphics Card (GPU) Load" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                        <TextBlock Text="{x:Bind FormatPercent(ViewModel.GpuUsage), Mode=OneWay}" FontSize="24" FontWeight="ExtraBold" />
                                        <ProgressBar Value="{x:Bind ViewModel.GpuUsage, Mode=OneWay}" Maximum="100" Height="6" Foreground="{StaticResource GpuAccentBrush}" Background="{StaticResource GpuTrackBrush}" CornerRadius="3" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="44" Height="44" Background="#158B5CF6" CornerRadius="22" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0,0,0">
                                        <FontIcon Glyph="&#xE9F5;" FontSize="18" Foreground="{StaticResource GpuAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,8,0,0" Height="28">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Grid.Column="0" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE9F5;" FontSize="12" Foreground="{StaticResource GpuAccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Active Monitoring" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Storage Card with warning state glow -->
                        <Border x:Name="DiskCard" Grid.Column="1" Style="{StaticResource GlassmorphismCardStyle}" Margin="6" Padding="14"
                                helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="6.5" helpers:Animation3DHelper.DepthZ="16"
                                BorderBrush="{x:Bind GetDiskCardBorderBrush(ViewModel.DiskUsage), Mode=OneWay}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="6" Grid.Column="0">
                                        <TextBlock Text="System Disk Activity" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                        <TextBlock Text="{x:Bind FormatPercent(ViewModel.DiskUsage), Mode=OneWay}" FontSize="24" FontWeight="ExtraBold" />
                                        <ProgressBar Value="{x:Bind ViewModel.DiskUsage, Mode=OneWay}" Maximum="100" Height="6" Foreground="{StaticResource DiskAccentBrush}" Background="{StaticResource DiskTrackBrush}" CornerRadius="3" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="44" Height="44" Background="#1510B981" CornerRadius="22" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0,0,0">
                                        <FontIcon Glyph="&#xE7F1;" FontSize="18" Foreground="{StaticResource DiskAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,8,0,0" Height="28">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Grid.Column="0" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xEA99;" FontSize="12" Foreground="{StaticResource DiskAccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.JunkFileSize, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Clean" Style="{StaticResource DefaultButtonStyle}" Padding="12,4" Height="28" CornerRadius="6" FontSize="11" FontWeight="Bold" Click="OnCleanDiskClick" IsEnabled="{x:Bind IsNot(ViewModel.IsOptimizing), Mode=OneWay}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 3: Performance Trend Chart Card with Series Toggles (Lazy Loaded) -->
                    <Border x:Name="PerformanceChartCard" Grid.Row="3" Grid.Column="0" x:Load="{x:Bind ViewModel.IsExtendedLayerLoaded, Mode=OneWay}" Loaded="OnExtendedLayerPanelLoaded" Style="{StaticResource GlassmorphismCardStyle}" Margin="6" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            
                            <StackPanel x:Name="PerformanceHeaderGrid" Grid.Row="0" Margin="0,0,0,16" Spacing="8">
                                <StackPanel x:Name="PerformanceTitlePanel" Spacing="4">
                                    <TextBlock Text="Performance Trend History" FontSize="16" FontWeight="Bold" />
                                    <TextBlock Text="Rolling history of resource load levels (CPU, RAM, GPU, Disk)" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                </StackPanel>
                                <VariableSizedWrapGrid x:Name="PerformanceFiltersPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="CpuFilterCheck" Content="CPU" IsChecked="True" Checked="OnChartFilterChanged" Unchecked="OnChartFilterChanged" Margin="0,0,16,8" />
                                    <CheckBox x:Name="RamFilterCheck" Content="RAM" IsChecked="True" Checked="OnChartFilterChanged" Unchecked="OnChartFilterChanged" Margin="0,0,16,8" />
                                    <CheckBox x:Name="GpuFilterCheck" Content="GPU" IsChecked="True" Checked="OnChartFilterChanged" Unchecked="OnChartFilterChanged" Margin="0,0,16,8" />
                                    <CheckBox x:Name="DiskFilterCheck" Content="Disk" IsChecked="True" Checked="OnChartFilterChanged" Unchecked="OnChartFilterChanged" Margin="0,0,0,8" />
                                </VariableSizedWrapGrid>
                            </StackPanel>

                            <lvc:CartesianChart
                                Grid.Row="1"
                                Height="200"
                                Series="{x:Bind ViewModel.PerformanceSeries, Mode=OneWay}"
                                XAxes="{x:Bind ViewModel.XAxes, Mode=OneWay}"
                                YAxes="{x:Bind ViewModel.YAxes, Mode=OneWay}"
                                FindingStrategy="CompareAll" />
                        </Grid>
                    </Border>

                    <!-- Row 2-3 (Span 2): Smart AI Advice Card (Actionable layout) (Lazy Loaded) -->
                    <Border x:Name="RecommendationsCard" Grid.Row="2" Grid.Column="1" Grid.RowSpan="2" x:Load="{x:Bind ViewModel.IsExtendedLayerLoaded, Mode=OneWay}" Loaded="OnExtendedLayerPanelLoaded" Style="{StaticResource GlassmorphismCardStyle}" Margin="6" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,12" Spacing="4">
                                <TextBlock Text="Smart AI Advice" FontSize="18" FontWeight="Bold" />
                                <TextBlock Text="Suggested actions based on diagnostics:" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="No recommendations. Run a full scan to evaluate your PC health." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Visibility="{x:Bind GetVisibility(ViewModel.Recommendations.Count), Mode=OneWay}" Margin="0,16,0,0" TextAlignment="Center" />
                                    
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.Recommendations, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource ControlAltFillColorSecondaryBrush}" CornerRadius="10" Margin="0,0,0,10" Padding="14">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" Spacing="12" Grid.Column="0">
                                                            <Border Width="28" Height="28" Background="#157F56D9" CornerRadius="14" VerticalAlignment="Center">
                                                                <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Text="{x:Bind}" TextWrapping="Wrap" FontSize="12" LineHeight="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                        </StackPanel>
                                                        <!-- Actionable Quick Fix button in the card -->
                                                        <Button Grid.Column="1" Content="Fix" Style="{StaticResource DefaultButtonStyle}" VerticalAlignment="Center" Padding="12,6" Height="30" CornerRadius="6" FontSize="11.5" FontWeight="Bold" Click="OnRecommendationFixClick"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Clean Advanced Details & History Log Toggle Banner Deck -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Padding="14,10" 
                        Margin="6,4,6,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                <FontIcon Glyph="&#xE9D9;" FontSize="15" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="System Deep Layer Diagnostics" FontWeight="SemiBold" FontSize="13.5"/>
                                <TextBlock Text="Detailed audits, itemized discoveries &amp; operation logs" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <ToggleButton Grid.Column="2" 
                                      x:Name="ShowDetailedInsightsBtn" 
                                      Content="Advanced Details &amp; History Log" 
                                      Checked="OnShowDeepLayerChecked" 
                                      Unchecked="OnShowDeepLayerUnchecked" 
                                      Style="{StaticResource DefaultToggleButtonStyle}" 
                                      Background="{StaticResource PrimaryAccentGradient}" 
                                      Foreground="White" 
                                      FontWeight="SemiBold" 
                                      CornerRadius="6" 
                                      Padding="14,6" 
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 3. DEEP LAYER (Loaded on Demand) -->
                <StackPanel x:Name="DeepLayerPanel" x:Load="False" Spacing="16">
                    
                    <!-- Row 1: Detailed Audits Table -->
                    <Border x:Name="AuditsCard" Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE721;" FontSize="16" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Diagnostics Discoveries" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <!-- Export Report controls -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="ExportFormatCombo" SelectedIndex="0" Width="100" CornerRadius="6">
                                        <ComboBoxItem Content="TXT" />
                                        <ComboBoxItem Content="JSON" />
                                        <ComboBoxItem Content="CSV" />
                                    </ComboBox>
                                    <Button Content="Export Report" Style="{StaticResource DefaultButtonStyle}" Click="OnExportReportClick" CornerRadius="6" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="0" Margin="0,0,0,16" VerticalAlignment="Bottom">
                                <TextBlock x:Name="ExportStatusText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="MediumSeaGreen" Visibility="Collapsed"/>
                            </StackPanel>

                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.DiagnosticItems, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="False">
                                <ListView.ItemContainerTransitions>
                                    <TransitionCollection>
                                        <AddDeleteThemeTransition />
                                        <RepositionThemeTransition />
                                    </TransitionCollection>
                                </ListView.ItemContainerTransitions>
                                <ListView.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid Padding="12,8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="1.8*" />
                                                <ColumnDefinition Width="4*" />
                                                <ColumnDefinition Width="1.5*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Category" FontWeight="Bold" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                            <TextBlock Grid.Column="1" Text="Check Name" FontWeight="Bold" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                        <TextBlock Grid.Column="2" Text="Description" FontWeight="Bold" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                            <TextBlock Grid.Column="3" Text="Status" FontWeight="Bold" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Left" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.HeaderTemplate>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="12,10" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="1.8*" />
                                                <ColumnDefinition Width="4*" />
                                                <ColumnDefinition Width="1.5*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayCategory}" VerticalAlignment="Center" FontSize="12.5" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayCheckName}" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Text="{Binding DisplayDescription}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Margin="0,0,16,0" LineHeight="16"/>
                                            <Grid Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <Border Background="{Binding StatusBadgeBg}" CornerRadius="6" Padding="10,5" Visibility="{Binding StatusBadgeVisibility}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="{Binding StatusIcon}" Foreground="{Binding StatusColor}" FontSize="11" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding DisplayStatusLabel}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <Button Content="Fix Now" Style="{StaticResource DefaultButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" Padding="12,5" Height="28" CornerRadius="6" FontSize="11" FontWeight="Bold" Visibility="{Binding FixButtonVisibility}" Click="OnFixItemClick" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Operations Timeline -->
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEC92;" FontSize="16" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Operations &amp; Optimization Timeline" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.ActionLogs, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="10,10" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <Border Width="30" Height="30" Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="15" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="MediumSeaGreen" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                            
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding DisplayAction}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding DisplayModule}" FontSize="10.5" Foreground="{StaticResource PrimaryAccentBrush}" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                                <TextBlock Text="{Binding CreatedAtFormatted}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding DisplayStatus}" FontSize="11" Foreground="MediumSeaGreen" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>



