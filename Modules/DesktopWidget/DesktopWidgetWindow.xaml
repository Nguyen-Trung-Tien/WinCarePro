<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinCarePro.Modules.DesktopWidget.DesktopWidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    Title="WinCare Desktop HUD">
    
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="WidgetRootGrid" Padding="14,12" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Widget Header Drag Bar -->
        <Grid x:Name="WidgetDragArea" Grid.Row="0" Background="Transparent" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource CyberAccentGradient}">
                    <FontIcon Glyph="&#xE9D9;" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="WinCare HUD" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                <Border Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Ellipse Width="6" Height="6" Fill="#FF10B981" VerticalAlignment="Center"/>
                        <TextBlock Text="TOPMOST" FontSize="8.5" FontWeight="Bold" Foreground="#FF10B981" CharacterSpacing="50"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,45,0">
                <Button x:Name="PinButton" Click="OnTogglePinClick" Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Padding="6,4" ToolTipService.ToolTip="Ghim Trên Cùng (Always On Top)"
                        helpers:AnimationHelper.HoverScale="1.1" helpers:AnimationHelper.PressedScale="0.9">
                    <FontIcon x:Name="PinIcon" Glyph="&#xE718;" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 1: CPU, RAM, & Boost Button -->
            <Grid Grid.Row="0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- CPU Telemetry Card -->
                <Border Grid.Column="0" Background="{ThemeResource AppCardBackground}" BorderBrush="{ThemeResource AppCardBorder}" BorderThickness="1" CornerRadius="10" Padding="10,8"
                        helpers:AnimationHelper.HoverScale="1.02" helpers:AnimationHelper.PressedScale="0.98">
                    <StackPanel Spacing="4">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE9D9;" FontSize="11" Foreground="{ThemeResource AppCpuChipFg}"/>
                                <TextBlock Text="CPU" FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="CpuText" Text="-- %" FontSize="11.5" FontWeight="ExtraBold" Foreground="{ThemeResource AppCpuChipFg}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar x:Name="CpuProgressBar" Value="20" Maximum="100" Height="4" Foreground="{ThemeResource AppCpuChipFg}" CornerRadius="2" Background="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                        <TextBlock x:Name="CpuDetailText" Text="-- Procs" FontSize="9.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- RAM Telemetry Card -->
                <Border Grid.Column="1" Background="{ThemeResource AppCardBackground}" BorderBrush="{ThemeResource AppCardBorder}" BorderThickness="1" CornerRadius="10" Padding="10,8"
                        helpers:AnimationHelper.HoverScale="1.02" helpers:AnimationHelper.PressedScale="0.98">
                    <StackPanel Spacing="4">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="{ThemeResource AppRamChipFg}"/>
                                <TextBlock Text="RAM" FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="RamText" Text="-- %" FontSize="11.5" FontWeight="ExtraBold" Foreground="{ThemeResource AppRamChipFg}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar x:Name="RamProgressBar" Value="45" Maximum="100" Height="4" Foreground="{ThemeResource AppRamChipFg}" CornerRadius="2" Background="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                        <TextBlock x:Name="RamDetailText" Text="-- / -- GB" FontSize="9.5" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Boost Button -->
                <Button Grid.Column="2" Click="OnFastCleanClick" 
                        Style="{StaticResource VibrantPrimaryButtonStyle}" Width="72" VerticalAlignment="Stretch" 
                        CornerRadius="10" Padding="0" ToolTipService.ToolTip="Giải phóng RAM lập tức (1-Click Boost)"
                        helpers:AnimationHelper.HoverScale="1.05" helpers:AnimationHelper.PressedScale="0.95">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                        <FontIcon Glyph="&#xE74C;" FontSize="14" Foreground="White"/>
                        <TextBlock Text="BOOST" FontSize="10" FontWeight="ExtraBold" Foreground="White" CharacterSpacing="30"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Row 2: Disk C: & Network Traffic -->
            <Grid Grid.Row="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <!-- Disk C: Usage Card -->
                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="9" Padding="9,6"
                        helpers:AnimationHelper.HoverScale="1.02" helpers:AnimationHelper.PressedScale="0.98">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7F1;" FontSize="12" Foreground="#FF3B82F6" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <Grid>
                                <TextBlock Text="Disk (C:)" FontSize="9.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DiskPercentText" Text="--%" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="DiskProgressBar" Value="50" Maximum="100" Height="3.5" Foreground="#FF3B82F6" CornerRadius="2" Background="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Network Speed Card -->
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="9" Padding="9,6"
                        helpers:AnimationHelper.HoverScale="1.02" helpers:AnimationHelper.PressedScale="0.98">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE556;" FontSize="11" Foreground="#FF10B981"/>
                            <TextBlock x:Name="NetDownText" Text="↓ 0 KB/s" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <FontIcon Glyph="&#xE557;" FontSize="11" Foreground="#FF8B5CF6"/>
                            <TextBlock x:Name="NetUpText" Text="↑ 0 KB/s" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
