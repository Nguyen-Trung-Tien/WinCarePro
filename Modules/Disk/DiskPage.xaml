<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.DiskPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinCarePro.Models"
    xmlns:vm="using:WinCarePro.ViewModels"
    xmlns:views="using:WinCarePro.Views"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    mc:Ignorable="d">

    <Grid Padding="24,18" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutVisualStates">
                <!-- Wide Layout: Viewport Width >= 1150px -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1150" />
                    </VisualState.StateTriggers>
                </VisualState>

                <!-- Medium Layout: Viewport Width between 768px and 1150px (Default Window Mode) -->
                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="768" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderCol1.Width" Value="0" />
                        <Setter Target="HeaderTitlePanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderActionsPanel.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderActionsPanel.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderActionsPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderActionsPanel.HorizontalAlignment" Value="Left" />
                        <Setter Target="HeaderActionsPanel.Margin" Value="0,10,0,0" />
                        <Setter Target="StatCol0.Width" Value="*" />
                        <Setter Target="StatCol1.Width" Value="*" />
                        <Setter Target="StatCol2.Width" Value="0" />
                        <Setter Target="StatCard3.(Grid.Row)" Value="1" />
                        <Setter Target="StatCard3.(Grid.Column)" Value="0" />
                        <Setter Target="StatCard3.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>

                <!-- Narrow Layout: Viewport Width < 720px -->
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderCol1.Width" Value="0" />
                        <Setter Target="HeaderTitlePanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderActionsPanel.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderActionsPanel.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderActionsPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderActionsPanel.HorizontalAlignment" Value="Left" />
                        <Setter Target="HeaderActionsPanel.Margin" Value="0,10,0,0" />
                        <Setter Target="StatCol0.Width" Value="*" />
                        <Setter Target="StatCol1.Width" Value="0" />
                        <Setter Target="StatCol2.Width" Value="0" />
                        <Setter Target="StatCard2.(Grid.Row)" Value="1" />
                        <Setter Target="StatCard2.(Grid.Column)" Value="0" />
                        <Setter Target="StatCard3.(Grid.Row)" Value="2" />
                        <Setter Target="StatCard3.(Grid.Column)" Value="0" />
                        <Setter Target="SpaceAnalyzerHeaderActions.(Grid.Row)" Value="1" />
                        <Setter Target="SpaceAnalyzerHeaderActions.(Grid.Column)" Value="0" />
                        <Setter Target="SpaceAnalyzerHeaderActions.Margin" Value="0,10,0,0" />
                        <Setter Target="DuplicateFinderHeaderActions.(Grid.Row)" Value="1" />
                        <Setter Target="DuplicateFinderHeaderActions.(Grid.Column)" Value="0" />
                        <Setter Target="DuplicateFinderHeaderActions.Margin" Value="0,10,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="20" />
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0. Header -->
            <RowDefinition Height="Auto" /> <!-- 1. Stat Ribbon -->
            <RowDefinition Height="*" />    <!-- 2. Tabs / Workspace -->
        </Grid.RowDefinitions>

        <!-- ==================== 0. MODERN HEADER ==================== -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow0" Height="Auto" />
                <RowDefinition x:Name="HeaderRow1" Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HeaderCol0" Width="*" />
                <ColumnDefinition x:Name="HeaderCol1" Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Title & Subtitle with Gradient Icon Badge -->
            <StackPanel x:Name="HeaderTitlePanel" Grid.Row="0" Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Style="{StaticResource PageHeaderIconBadgeStyle}" Background="{StaticResource CyberAccentGradient}">
                        <FontIcon Glyph="&#xE7F1;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Disk &amp; Storage Center" Style="{StaticResource PageHeaderTitleStyle}" />
                        <TextBlock Text="S.M.A.R.T telemetry, storage &amp; duplicate finder." Style="{StaticResource PageHeaderSubtitleStyle}" />
                    </StackPanel>
                    <!-- S.M.A.R.T Shield Pill -->
                    <Border Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="8" Padding="8,3" VerticalAlignment="Center" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="6" Height="6" Fill="{ThemeResource AppBadgeGoodFg}"/>
                            <TextBlock Text="S.M.A.R.T Shield Active" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppBadgeGoodFg}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Right: Clean Empty Folders Action -->
            <StackPanel x:Name="HeaderActionsPanel" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="OnCleanEmptyFoldersClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" Style="{StaticResource StandardSecondaryButtonStyle}" Height="34" CornerRadius="8" Padding="14,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}"/>
                        <TextBlock Text="Clean Empty Folders" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== 1. 3-CARD STAT RIBBON ==================== -->
        <Grid Grid.Row="1" Margin="0,0,0,14" ColumnSpacing="12" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="StatCol0" Width="*" />
                <ColumnDefinition x:Name="StatCol1" Width="*" />
                <ColumnDefinition x:Name="StatCol2" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 0: Storage Hardware Drives -->
            <Border Grid.Column="0" Style="{StaticResource QuickStatCardStyle}"
                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="6.5" helpers:Animation3DHelper.DepthZ="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{StaticResource PrimaryAccentLightBrush}" BorderBrush="{StaticResource PrimaryAccentBorderBrush}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7F1;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Drives &amp; Volumes" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.Drives.Count, Mode=OneWay}" FontSize="15" FontWeight="ExtraBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                            <TextBlock Text="Physical Devices" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 1: Storage Scanner Status -->
            <Border x:Name="StatCard2" Grid.Column="1" Style="{StaticResource QuickStatCardStyle}"
                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="6.5" helpers:Animation3DHelper.DepthZ="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{ThemeResource AppStatusInfoBackground}" BorderBrush="{ThemeResource AppStatusInfoBorder}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource AppStatusInfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Storage Items Analyzed" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.StorageItems.Count, Mode=OneWay}" FontSize="15" FontWeight="ExtraBold" Foreground="{ThemeResource AppStatusInfoBrush}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                            <TextBlock Text="Directories &amp; Files" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 2: Duplicate File Groups Identified -->
            <Border x:Name="StatCard3" Grid.Column="2" Style="{StaticResource QuickStatCardStyle}"
                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="6.5" helpers:Animation3DHelper.DepthZ="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{ThemeResource AppStatusWarningBackground}" BorderBrush="{ThemeResource AppStatusWarningBorder}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7C3;" FontSize="16" Foreground="{ThemeResource AppStatusWarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Duplicate File Groups" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.DuplicateGroups.Count, Mode=OneWay}" FontSize="15" FontWeight="ExtraBold" Foreground="{ThemeResource AppStatusWarningBrush}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                            <TextBlock Text="Reclaimable Clusters" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 2. TABS CONTENT WORKSPACE ==================== -->
        <Pivot x:Name="DiskPivot" Grid.Row="2" SelectionChanged="OnPivotSelectionChanged">
            
            <!-- Tab 1: Disk Hardware Overview -->
            <PivotItem Header="Disk Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="0,12,0,0">
                        <!-- Section 1: Logical Storage Volumes -->
                        <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="16,14">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xEDA2;" FontSize="15" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                    <TextBlock Text="Logical Volumes &amp; Partitions" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Space distribution and predictive storage exhaustion forecast" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>

                                <ItemsControl ItemsSource="{x:Bind ViewModel.Volumes, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:LogicalVolumeInfo">
                                            <Border Style="{StaticResource Tilt3DCardStyle}" Margin="0,0,0,10" Padding="16,14"
                                                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="3.5" helpers:Animation3DHelper.DepthZ="10">
                                                <Grid RowSpacing="10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Volume Icon Badge -->
                                                    <Border Grid.Row="0" Grid.Column="0" Width="44" Height="44" Background="{StaticResource PrimaryAccentLightBrush}" BorderBrush="{StaticResource PrimaryAccentBorderBrush}" BorderThickness="1.2" CornerRadius="12" VerticalAlignment="Center" Margin="0,0,14,0">
                                                        <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="20" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Volume Info -->
                                                    <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{x:Bind DisplayName}" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                            <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind FileSystem}" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                            </Border>
                                                            <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind DriveType}" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                                            <TextBlock Text="{x:Bind ExhaustionForecast}" FontSize="11.5" Foreground="{StaticResource PrimaryAccentBrush}" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Status Badge & Quick Action -->
                                                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Border Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind StatusBadge}" Foreground="{ThemeResource AppBadgeGoodFg}" FontWeight="Bold" FontSize="11"/>
                                                        </Border>
                                                        <Button Content="Analyze Space" Click="OnAnalyzeVolumeClick" Style="{StaticResource VibrantPrimaryButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" Height="32" CornerRadius="8" Padding="12,0" FontSize="11.5" FontWeight="SemiBold"/>
                                                    </StackPanel>

                                                    <!-- Space Allocation Bar -->
                                                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ColumnSpacing="12" Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Spacing="4">
                                                            <ProgressBar Value="{x:Bind PercentUsed}" Maximum="100" Height="6" CornerRadius="3" Foreground="{StaticResource PrimaryAccentGradient}" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                                            <Grid>
                                                                <TextBlock Text="{x:Bind UsedDisplay, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                                                <TextBlock Text="{x:Bind FreeDisplay, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                                            </Grid>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                                                            <TextBlock Text="{x:Bind CapacityDisplay, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Section 2: Physical Hardware & SMART Telemetry -->
                        <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="16,14">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE7F1;" FontSize="15" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                    <TextBlock Text="Physical Drives &amp; S.M.A.R.T Hardware Telemetry" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Controller telemetry, hardware temperature, and wear estimation" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>

                                <ListView ItemsSource="{x:Bind ViewModel.Drives, Mode=OneWay}" SelectionMode="None" ItemContainerStyle="{StaticResource ModernCardListViewItemStyle}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Tilt3DCardStyle}" Margin="0,0,0,8" Padding="16,14"
                                                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="3.5" helpers:Animation3DHelper.DepthZ="10">
                                                <Grid ColumnSpacing="14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Drive Icon Badge with 3D Elevation -->
                                                    <Border Grid.Column="0" Width="42" Height="42" Background="{StaticResource PrimaryAccentLightBrush}" BorderBrush="{StaticResource PrimaryAccentBorderBrush}" BorderThickness="1.2" CornerRadius="12" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE7F1;" FontSize="18" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Drive Info -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                        <TextBlock Text="{Binding Model}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="14">
                                                            <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                                            <TextBlock Text="{Binding Interface}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                                            <TextBlock Text="{Binding DriveType}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding TemperatureFormatted}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding SsdWearDisplay}" FontSize="11" Foreground="{StaticResource PrimaryAccentBrush}" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Status Badge & Tools -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <Border Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="8" Padding="10,4">
                                                            <TextBlock Text="{Binding HealthStatus}" Foreground="{ThemeResource AppBadgeGoodFg}" FontWeight="Bold" FontSize="11.5"/>
                                                        </Border>
                                                        <Button Content="CHKDSK" Click="OnRunChkdskClick" Height="30" CornerRadius="6" Padding="10,0" FontSize="11" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- Tab 2: Disk Space Analyzer -->
            <PivotItem Header="Space Analyzer">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,0,0,12" Style="{StaticResource GlassmorphismCardStyle}" Padding="14,10">
                        <Grid x:Name="SpaceAnalyzerHeaderGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="SpaceAnalyzerHeaderRow0" Height="Auto" />
                                <RowDefinition x:Name="SpaceAnalyzerHeaderRow1" Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="SpaceAnalyzerHeaderCol0" Width="*" />
                                <ColumnDefinition x:Name="SpaceAnalyzerHeaderCol1" Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <!-- Breadcrumb Navigation Bar -->
                            <StackPanel x:Name="SpaceAnalyzerHeaderText" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Analyze disk space allocation across large directories and user folders." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Target:" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center"/>
                                    <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="6" Padding="8,2">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentAnalysisPath, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                                    </Border>
                                    <Button Content="Go Up ⮥" Click="OnGoUpDirectoryClick" Visibility="{x:Bind ViewModel.CanGoUp, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="10.5" Padding="8,3" CornerRadius="6" Height="26" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Scan Actions -->
                            <StackPanel x:Name="SpaceAnalyzerHeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Click="OnBrowseFolderClick" Style="{StaticResource StandardSecondaryButtonStyle}" Height="34" CornerRadius="8" Padding="12,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8DA;" FontSize="12" />
                                        <TextBlock Text="Browse..." FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource VibrantPrimaryButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" Click="OnAnalyzeSpaceClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" Height="34" CornerRadius="8" Padding="16,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE721;" FontSize="12" Foreground="White" />
                                        <TextBlock Text="Scan Directory" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Allocation Directory Weight (Double-click folder card to Zoom In)" FontSize="13" FontWeight="Bold" Margin="0,0,0,10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <!-- Empty / Ready State -->
                            <StackPanel Grid.Row="1" Visibility="{x:Bind views:DiskPage.IsListEmpty(ViewModel.StorageItems.Count, ViewModel.IsBusy), Mode=OneWay}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="0,40,0,40">
                                <Border Width="56" Height="56" CornerRadius="28" Background="{ThemeResource AppStatChipBackground}" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="24" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <TextBlock Text="Ready to analyze storage distribution" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Browse or select a directory above and click [Scan Directory] to visualize folder sizes." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.StorageItems, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnStorageItemClick" ItemContainerStyle="{StaticResource ModernCardListViewItemStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="10,8" Margin="0,0,0,4">
                                            <Grid Padding="4,2" Background="Transparent" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="{Binding IconGlyph}" FontSize="15" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0" Spacing="1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" AutomationProperties.Name="{Binding Name}"/>
                                                    <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Path}"/>
                                                </StackPanel>
                                                
                                                <!-- Storage Visual Weight Progress Bar -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                    <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="5" CornerRadius="2" Foreground="{StaticResource PrimaryAccentGradient}" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                                    <TextBlock Text="{Binding PercentageFormatted}" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Right" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="3" Text="{Binding SizeFormatted}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>

                                                <!-- Explicit Drill-down Folder Button -->
                                                <Button Grid.Column="4" Visibility="{Binding IsDirectory, Converter={StaticResource BooleanToVisibilityConverter}}" Click="OnStorageItemDrillDownClick" Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Width="28" Height="28" CornerRadius="14" ToolTipService.ToolTip="Browse this directory" AutomationProperties.Name="Browse directory">
                                                    <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </PivotItem>

            <!-- Tab 3: Duplicate File Finder -->
            <PivotItem Header="Duplicate Finder">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,0,0,12" Style="{StaticResource GlassmorphismCardStyle}" Padding="14,10">
                        <Grid x:Name="DuplicateFinderHeaderGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="DuplicateFinderHeaderRow0" Height="Auto" />
                                <RowDefinition x:Name="DuplicateFinderHeaderRow1" Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="DuplicateFinderHeaderCol0" Width="*" />
                                <ColumnDefinition x:Name="DuplicateFinderHeaderCol1" Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="DuplicateFinderHeaderText" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Find identical files using 2-stage verification (Head Hash + SHA-256)." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <!-- Quick Selection Tools Bar -->
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                    <TextBlock Text="Quick Tools:" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Button Content="Select All" Click="OnSelectAllClick" FontSize="10.5" Padding="8,2" CornerRadius="6" Height="26"/>
                                    <Button Content="Deselect All" Click="OnDeselectAllClick" FontSize="10.5" Padding="8,2" CornerRadius="6" Height="26"/>
                                    <Button Content="Keep Newest" Click="OnKeepNewestClick" FontSize="10.5" Padding="8,2" CornerRadius="6" Height="26"/>
                                    <Button Content="Keep Oldest" Click="OnKeepOldestClick" FontSize="10.5" Padding="8,2" CornerRadius="6" Height="26"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="DuplicateFinderHeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Scan Duplicates" Click="OnScanDuplicatesClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" Height="34" CornerRadius="8" Padding="14,0"/>
                                <Button Content="Delete Selected" Style="{StaticResource DangerButtonStyle}" Click="OnDeleteDuplicatesClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" Height="34" CornerRadius="8" Padding="16,0" FontWeight="Bold" ToolTipService.ToolTip="Permanently delete checked duplicate files" AutomationProperties.Name="Delete Selected Duplicate Files" AutomationProperties.HelpText="Permanently removes all checked duplicate files from storage."/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,12">
                        <Grid>
                            <!-- Empty / Ready State -->
                            <StackPanel Visibility="{x:Bind views:DiskPage.IsListEmpty(ViewModel.DuplicateGroups.Count, ViewModel.IsBusy), Mode=OneWay}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="0,40,0,40">
                                <Border Width="56" Height="56" CornerRadius="28" Background="{ThemeResource AppStatChipBackground}" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE7F1;" FontSize="24" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <TextBlock Text="No duplicate files detected" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Click [Scan Duplicates] to search storage for byte-by-byte identical files." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <ListView ItemsSource="{x:Bind ViewModel.DuplicateGroups, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,14">
                                            <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding SizeFormatted}" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Padding="12,6" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding IsSelectedForDeletion, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="20" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"/>
                                                                <TextBlock Text="{Binding Path}" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding LastModifiedFormatted}" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </PivotItem>

            <!-- Tab 4: Large File Analyzer -->
            <PivotItem Header="Large Files">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,0,0,12" Style="{StaticResource GlassmorphismCardStyle}" Padding="14,10">
                        <Grid x:Name="LargeFilesHeaderGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Identify and safely clean space-consuming large files (videos, archives, ISO disk images)." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Target:" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center"/>
                                    <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="6" Padding="8,2">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentAnalysisPath, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Min Size:" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <ComboBox x:Name="MinSizeCombo" SelectionChanged="OnMinSizeSelectionChanged" SelectedIndex="1" Height="28" FontSize="11" CornerRadius="6" Padding="8,2">
                                        <ComboBoxItem Content="50 MB" Tag="50"/>
                                        <ComboBoxItem Content="100 MB" Tag="100"/>
                                        <ComboBoxItem Content="500 MB" Tag="500"/>
                                        <ComboBoxItem Content="1 GB" Tag="1000"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ToggleSwitch x:Name="RecycleBinToggle" IsOn="{x:Bind ViewModel.SendToRecycleBin, Mode=TwoWay}" OnContent="Recycle Bin (Safe)" OffContent="Permanent Delete" Margin="0,0,8,0" FontSize="11"/>
                                <Button Content="Scan Large Files" Click="OnScanLargeFilesClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" Style="{StaticResource VibrantPrimaryButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" Height="34" CornerRadius="8" Padding="14,0" FontWeight="Bold"/>
                                <Button Content="Delete Selected" Style="{StaticResource DangerButtonStyle}" Click="OnDeleteLargeFilesClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" Height="34" CornerRadius="8" Padding="14,0" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- Category Filter Chips -->
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                                <Button Content="Select All" Click="OnSelectAllLargeFilesClick" Style="{StaticResource StandardSecondaryButtonStyle}" Height="26" FontSize="10.5" Padding="8,2" CornerRadius="6"/>
                                <Button Content="Deselect All" Click="OnDeselectAllLargeFilesClick" Style="{StaticResource StandardSecondaryButtonStyle}" Height="26" FontSize="10.5" Padding="8,2" CornerRadius="6"/>
                                <AppBarSeparator Margin="4,0"/>
                                <TextBlock Text="Category:" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center"/>
                                <Button Content="All" Click="OnCategoryFilterClick" Tag="All" Height="26" FontSize="10.5" Padding="8,2" CornerRadius="6"/>
                                <Button Content="Media" Click="OnCategoryFilterClick" Tag="Media" Height="26" FontSize="10.5" Padding="8,2" CornerRadius="6"/>
                                <Button Content="Archives" Click="OnCategoryFilterClick" Tag="Archive" Height="26" FontSize="10.5" Padding="8,2" CornerRadius="6"/>
                                <Button Content="Disk Images" Click="OnCategoryFilterClick" Tag="Disk Image" Height="26" FontSize="10.5" Padding="8,2" CornerRadius="6"/>
                                <Button Content="Installers" Click="OnCategoryFilterClick" Tag="Installer" Height="26" FontSize="10.5" Padding="8,2" CornerRadius="6"/>
                                <Button Content="Documents" Click="OnCategoryFilterClick" Tag="Document" Height="26" FontSize="10.5" Padding="8,2" CornerRadius="6"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,12">
                        <Grid>
                            <!-- Empty / Ready State -->
                            <StackPanel Visibility="{x:Bind views:DiskPage.IsListEmpty(ViewModel.LargeFiles.Count, ViewModel.IsBusy), Mode=OneWay}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="0,40,0,40">
                                <Border Width="56" Height="56" CornerRadius="28" Background="{ThemeResource AppStatChipBackground}" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="24" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <TextBlock Text="No large files currently listed" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Click [Scan Large Files] to locate large storage items across the selected directory." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <ListView ItemsSource="{x:Bind ViewModel.LargeFiles, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="10,8" Margin="0,0,0,4">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="20"/>
                                                <FontIcon Grid.Column="1" Glyph="{Binding IconGlyph}" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Border Grid.Column="3" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category}" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </Border>
                                                <TextBlock Grid.Column="4" Text="{Binding LastModifiedFormatted}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" Margin="8,0"/>
                                                <TextBlock Grid.Column="5" Text="{Binding SizeFormatted}" FontWeight="ExtraBold" FontSize="13" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
