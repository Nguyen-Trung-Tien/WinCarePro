<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.DiskPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinCarePro.Engines"
    xmlns:vm="using:WinCarePro.ViewModels"
    xmlns:views="using:WinCarePro.Views"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
        <Grid Padding="24,20" HorizontalAlignment="Stretch">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="LayoutVisualStates">
                    <!-- Wide Layout: Viewport Width >= 800px -->
                    <VisualState x:Name="WideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="800" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <!-- Narrow Layout: Viewport Width < 800px -->
                    <VisualState x:Name="NarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <!-- Space Analyzer Header Stacking -->
                            <Setter Target="SpaceAnalyzerHeaderCol0.Width" Value="*" />
                            <Setter Target="SpaceAnalyzerHeaderCol1.Width" Value="0" />
                            <Setter Target="SpaceAnalyzerPathGrid.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="SpaceAnalyzerBtn.(Grid.Row)" Value="1" />
                            <Setter Target="SpaceAnalyzerBtn.(Grid.Column)" Value="0" />
                            <Setter Target="SpaceAnalyzerBtn.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="SpaceAnalyzerBtn.Margin" Value="0,8,0,0" />
                            <Setter Target="SpaceAnalyzerBtn.HorizontalAlignment" Value="Left" />

                            <!-- Duplicate Finder Header Stacking -->
                            <Setter Target="DuplicateFinderHeaderCol0.Width" Value="*" />
                            <Setter Target="DuplicateFinderHeaderCol1.Width" Value="0" />
                            <Setter Target="DuplicateFinderHeaderText.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="DuplicateFinderHeaderActions.(Grid.Row)" Value="1" />
                            <Setter Target="DuplicateFinderHeaderActions.(Grid.Column)" Value="0" />
                            <Setter Target="DuplicateFinderHeaderActions.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="DuplicateFinderHeaderActions.Margin" Value="0,12,0,0" />
                            <Setter Target="DuplicateFinderHeaderActions.HorizontalAlignment" Value="Left" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Page Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Disk &amp; Storage Center" Style="{StaticResource PageHeaderTitleStyle}" />
                    <TextBlock Text="Monitor drive SMART attributes, analyze allocation weight, and safely clean duplicate files." FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Click="OnCleanEmptyFoldersClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                        <TextBlock Text="Clean Empty Folders" />
                    </StackPanel>
                </Button>
            </Grid>

            <Pivot x:Name="DiskPivot" Grid.Row="1" SelectionChanged="OnPivotSelectionChanged">
                <!-- Tab 1: Disk Overview -->
                <PivotItem Header="Disk Overview">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Margin="0,0,0,16" Style="{StaticResource GlassmorphismCardStyle}" Padding="16">
                            <TextBlock Text="Local storage volumes health, physical S.M.A.R.T attributes, and hardware controllers status." FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        </Border>

                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Drives, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:DriveHealthInfo">
                                    <Border Style="{StaticResource GlassmorphismCardStyle}" Margin="0,0,0,12" Padding="20">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="44" Height="44" Background="#1510B981" CornerRadius="22" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <FontIcon Glyph="&#xE7F1;" FontSize="18" Foreground="{ThemeResource SystemAccentColor}" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="{x:Bind Model}" FontWeight="Bold" FontSize="15" />
                                                <StackPanel Orientation="Horizontal" Spacing="16">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                                    <TextBlock Text="{x:Bind Interface}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                                    <TextBlock Text="{x:Bind TemperatureFormatted}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="8">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                                    <Border Background="{x:Bind views:DiskPage.GetHealthBadgeBg(HealthStatus)}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Right">
                                                        <TextBlock Text="{x:Bind HealthStatus}" FontWeight="Bold" FontSize="11" Foreground="{x:Bind views:DiskPage.GetHealthColor(HealthStatus)}" />
                                                    </Border>
                                                    <Button Content="Run CHKDSK" Click="OnRunChkdskClick" FontSize="11" Padding="8,4" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="S.M.A.R.T Status: Monitored" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </PivotItem>

                <!-- Tab 2: Disk Space Analyzer -->
                <PivotItem Header="Space Analyzer">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Margin="0,0,0,16" Style="{StaticResource GlassmorphismCardStyle}" Padding="16">
                            <Grid x:Name="SpaceAnalyzerHeaderGrid">
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="SpaceAnalyzerHeaderRow0" Height="Auto" />
                                    <RowDefinition x:Name="SpaceAnalyzerHeaderRow1" Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="SpaceAnalyzerHeaderCol0" Width="*" />
                                    <ColumnDefinition x:Name="SpaceAnalyzerHeaderCol1" Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel x:Name="SpaceAnalyzerPathGrid" Spacing="6" VerticalAlignment="Bottom" Margin="0,0,16,0">
                                    <TextBlock Text="Analysis Target Folder" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    <Grid Height="36">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SpaceAnalyzerPathBox" Text="{x:Bind ViewModel.StorageScanPath, Mode=TwoWay}" CornerRadius="6,0,0,6" Height="36" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                                        <Button Grid.Column="1" Click="OnBrowseFolderClick" CornerRadius="0,6,6,0" Height="36" VerticalAlignment="Stretch" Padding="14,0" Margin="-1,0,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                                <TextBlock Text="Browse" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <Button x:Name="SpaceAnalyzerBtn" Grid.Column="1" Height="36" Content="Analyze Folder" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" Click="OnAnalyzeClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Border>

                        <Grid x:Name="SpaceAnalyzerSplitGrid" Grid.Row="1">
                            <Border x:Name="SpaceAnalyzerListBorder" Style="{StaticResource GlassmorphismCardStyle}" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Allocation Directory Weight (Double-click folder card to Zoom In)" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />

                                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.StorageItems, Mode=OneWay}" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:StorageItem">
                                                <Grid Padding="8,10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" DoubleTapped="StorageItem_DoubleTapped" Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="16" Foreground="{ThemeResource SystemAccentColor}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="13"/>
                                                        <TextBlock Text="{x:Bind Path}" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    
                                                    <!-- Storage Visual Weight Progress Bar -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0" Spacing="2">
                                                        <ProgressBar Value="{x:Bind Percentage}" Maximum="100" Height="6" CornerRadius="3" Foreground="{ThemeResource SystemAccentColor}" />
                                                        <TextBlock Text="{x:Bind PercentageFormatted}" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Right" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="3" Text="{x:Bind SizeFormatted}" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </PivotItem>

                <!-- Tab 3: Duplicate Finder -->
                <PivotItem Header="Duplicate Finder">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Margin="0,0,0,16" Style="{StaticResource GlassmorphismCardStyle}" Padding="16">
                            <Grid x:Name="DuplicateFinderHeaderGrid">
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="DuplicateFinderHeaderRow0" Height="Auto" />
                                    <RowDefinition x:Name="DuplicateFinderHeaderRow1" Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="DuplicateFinderHeaderCol0" Width="*" />
                                    <ColumnDefinition x:Name="DuplicateFinderHeaderCol1" Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="DuplicateFinderHeaderText" VerticalAlignment="Center">
                                    <TextBlock Text="Find identical files using 2-stage verification (Head Hash + SHA-256)." FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    <!-- Quick Selection Tools Bar -->
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                        <TextBlock Text="Selection Tools:" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <Button Content="Select All" Click="OnSelectAllClick" FontSize="11" Padding="6,2"/>
                                        <Button Content="Deselect All" Click="OnDeselectAllClick" FontSize="11" Padding="6,2"/>
                                        <Button Content="Keep Newest" Click="OnKeepNewestClick" FontSize="11" Padding="6,2"/>
                                        <Button Content="Keep Oldest" Click="OnKeepOldestClick" FontSize="11" Padding="6,2"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="DuplicateFinderHeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                    <Button Content="Scan Duplicates" Click="OnScanDuplicatesClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}"/>
                                    <Button Content="Delete Selected" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" Click="OnDeleteDuplicatesClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource GlassmorphismCardStyle}" Padding="16">
                            <ListView ItemsSource="{x:Bind ViewModel.DuplicateGroups, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StorageDuplicateGroup">
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="{x:Bind SizeFormatted}" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource SystemAccentColor}" Margin="4,0,0,6"/>
                                            <ItemsControl ItemsSource="{x:Bind Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:StorageDuplicateItem">
                                                        <Grid Padding="24,4" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{x:Bind IsSelectedForDeletion, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="20" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="12"/>
                                                                <TextBlock Text="{x:Bind Path}" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{x:Bind LastModified}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Grid>
                </PivotItem>
            </Pivot>

            <!-- Activity Log & Diagnostics Console Expander -->
            <Expander Grid.Row="2" Header="Disk Tools Operations Console" HorizontalAlignment="Stretch" Margin="0,16,0,0" IsExpanded="False">
                <Border Background="{ThemeResource AppTerminalBackground}" CornerRadius="6" Padding="12" Height="140">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBlock Text="{x:Bind ViewModel.ConsoleOutput, Mode=OneWay}" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11.5" Foreground="{ThemeResource AppTerminalForeground}" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </Expander>
        </Grid>
    </ScrollViewer>
</Page>
