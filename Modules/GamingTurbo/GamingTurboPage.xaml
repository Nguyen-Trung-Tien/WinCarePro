<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Modules.GamingTurbo.GamingTurboPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="28,24" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Background="{StaticResource CyberAccentGradient}" CornerRadius="10" Padding="8">
                        <FontIcon Glyph="&#xE7FC;" FontSize="20" Foreground="White"/>
                    </Border>
                    <TextBlock Text="Gaming Turbo 2.0 Suite" Style="{StaticResource PageHeaderTitleStyle}" VerticalAlignment="Center"/>
                    <Border Background="#25F59E0B" BorderBrush="#60F59E0B" BorderThickness="1" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="Ultra Low-Latency" FontSize="11" FontWeight="ExtraBold" Foreground="#FFF59E0B"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Optimize physical RAM Working Set &amp; release CPU resources during gaming." Style="{StaticResource PageHeaderSubtitleStyle}"/>
            </StackPanel>
        </Grid>

        <!-- Main Gaming Dashboard -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">

                <!-- Turbo Toggle Banner Card -->
                <Border Style="{StaticResource AuraGlassCardStyle}" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE9D9;" FontSize="22" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock Text="Gaming Turbo 2.0 Mode" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="StatusMessageText" Text="Ready to boost! Click the button to release system resources." FontSize="13" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Toggle Button -->
                        <Button x:Name="TurboToggleButton" Grid.Column="1" Click="OnToggleTurboClick" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="40" Padding="20,0" VerticalAlignment="Center" Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEA3B;" FontSize="16"/>
                                <TextBlock x:Name="ButtonText" Text="ENABLE TURBO NOW" FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Quick Stats Grid -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Stat 1: Freed RAM -->
                    <Border Grid.Column="0" Style="{StaticResource QuickStatCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Freed RAM" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="FreedRamText" Text="0 MB" FontSize="22" FontWeight="ExtraBold" Foreground="{ThemeResource AppRamChipFg}"/>
                        </StackPanel>
                    </Border>

                    <!-- Stat 2: Optimized Processes -->
                    <Border Grid.Column="1" Style="{StaticResource QuickStatCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Optimized Processes" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="ProcCountText" Text="0 Processes" FontSize="22" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Stat 3: Power Profile -->
                    <Border Grid.Column="2" Style="{StaticResource QuickStatCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Power Mode" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="Ultimate Performance" FontSize="16" FontWeight="Bold" Foreground="#FF10B981"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
