<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.JunkPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinCarePro.Models"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    mc:Ignorable="d">

    <Grid Padding="24,20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="LayoutVisualStates">
                    <!-- Wide Layout: Viewport Width >= 1100px -->
                    <VisualState x:Name="WideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1100" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <!-- Narrow Layout: Viewport Width < 800px -->
                    <VisualState x:Name="NarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HeaderCol0.Width" Value="*" />
                            <Setter Target="HeaderCol1.Width" Value="0" />
                            <Setter Target="HeaderStatsPanel.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="HeaderActionsPanel.(Grid.Row)" Value="1" />
                            <Setter Target="HeaderActionsPanel.(Grid.Column)" Value="0" />
                            <Setter Target="HeaderActionsPanel.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="HeaderActionsPanel.Margin" Value="0,16,0,0" />
                            <Setter Target="HeaderActionsPanel.HorizontalAlignment" Value="Left" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Page Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid x:Name="HeaderGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="HeaderRow0" Height="Auto" />
                        <RowDefinition x:Name="HeaderRow1" Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="HeaderCol0" Width="*" />
                        <ColumnDefinition x:Name="HeaderCol1" Width="Auto" />
                    </Grid.ColumnDefinitions>

                <!-- Left: Info & Badges Display -->
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Background="{StaticResource CyberAccentGradient}" CornerRadius="10" Padding="8">
                            <FontIcon Glyph="&#xEA99;" FontSize="20" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Junk Cleaner &amp; System Cache" Style="{StaticResource PageHeaderTitleStyle}" VerticalAlignment="Center"/>
                        <Border Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="6" Height="6" Fill="{ThemeResource AppBadgeGoodFg}"/>
                                <TextBlock Text="Junk:" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.TotalJunkSize, Mode=OneWay}" FontSize="11" FontWeight="ExtraBold" Foreground="{ThemeResource AppBadgeGoodFg}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource AppBadgeCriticalBg}" BorderBrush="{ThemeResource AppBadgeCriticalBorder}" BorderThickness="1" CornerRadius="8" Padding="8,3" VerticalAlignment="Center" Visibility="{x:Bind GetWarningVisibility(ViewModel.HasLockingApps), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="6" Height="6" Fill="{ThemeResource AppBadgeCriticalFg}"/>
                                <TextBlock Text="Locked:" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.TotalLockedSize, Mode=OneWay}" FontSize="11" FontWeight="ExtraBold" Foreground="{ThemeResource AppBadgeCriticalFg}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Reclaim gigabytes of storage by sweeping system caches, browser debris, temporary files &amp; memory dumps." Style="{StaticResource PageHeaderSubtitleStyle}"/>
                </StackPanel>

                <!-- Right: Scan & Clean Actions -->
                <StackPanel x:Name="HeaderActionsPanel" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button x:Name="ScanJunkBtn" Style="{StaticResource DefaultButtonStyle}" Click="OnScanJunkClick" IsEnabled="{x:Bind IsNot(ViewModel.IsScanning), Mode=OneWay}" MinWidth="150" Padding="16,8" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="ScanJunkRing" IsActive="False" Visibility="Collapsed" Width="14" Height="14" VerticalAlignment="Center"/>
                            <FontIcon x:Name="ScanJunkIcon" Glyph="&#xE721;" FontSize="13" />
                            <TextBlock x:Name="ScanJunkText" Text="Scan Directories" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CleanJunkBtn" Style="{StaticResource VibrantPrimaryButtonStyle}" Click="OnCleanJunkClick" IsEnabled="{x:Bind CanClean(ViewModel.IsCleaning, ViewModel.Categories.Count), Mode=OneWay}" Padding="18,8" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="CleanJunkRing" IsActive="False" Visibility="Collapsed" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                            <FontIcon x:Name="CleanJunkIcon" Glyph="&#xE74D;" FontSize="13" Foreground="White" />
                            <TextBlock x:Name="CleanJunkText" Text="Clean Now" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Storage Visualizer & Locking Apps Container -->
        <StackPanel Grid.Row="1" Spacing="16" Margin="0,0,0,16">
            <!-- Storage Visualizer Hero Deck -->
            <Border Style="{StaticResource AuraGlassCardStyle}" Padding="18,14">
                <StackPanel Spacing="10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7F1;" FontSize="14" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <TextBlock Text="Storage Distribution Breakdown" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.TotalJunkSize, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="ExtraBold" FontSize="13.5" Foreground="#FF10B981"/>
                    </Grid>
                    <!-- Horizontal Visual Storage Bar -->
                    <Grid Height="10" CornerRadius="5" Background="{ThemeResource AppStatChipBackground}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#FFA78BFA" CornerRadius="5,0,0,5"/>
                        <Border Grid.Column="1" Background="#FF3B82F6"/>
                        <Border Grid.Column="2" Background="#FF10B981"/>
                        <Border Grid.Column="3" Background="#FFF59E0B" CornerRadius="0,5,5,0"/>
                    </Grid>
                    <!-- Legend Chips -->
                    <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="#FFA78BFA" VerticalAlignment="Center"/>
                            <TextBlock Text="System Cache" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="#FF3B82F6" VerticalAlignment="Center"/>
                            <TextBlock Text="Temp Files" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="#FF10B981" VerticalAlignment="Center"/>
                            <TextBlock Text="Browser Data" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="#FFF59E0B" VerticalAlignment="Center"/>
                            <TextBlock Text="Logs &amp; Trash" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Warning Banner for Locking Applications -->
            <Border Background="#1EEF4444" 
                    BorderBrush="#48EF4444" 
                    BorderThickness="1" 
                    CornerRadius="12" 
                    Padding="16,12" 
                    Visibility="{x:Bind GetWarningVisibility(ViewModel.HasLockingApps), Mode=OneWay}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <FontIcon Grid.Column="0" Glyph="&#xE7BA;" Foreground="#FFEF4444" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="Running Applications Locking Cache Files" FontWeight="Bold" FontSize="13" Foreground="#FFEF4444" />
                        <TextBlock Text="These apps lock cache files and prevent them from being cleaned. Please close them before cleaning:" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ActiveLockingApps, Mode=OneWay}" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Background="{ThemeResource AppStatChipBackground}" Padding="8,4" CornerRadius="6">
                                        <!-- App Icon -->
                                        <Grid Width="20" Height="20" VerticalAlignment="Center">
                                            <Image Source="{Binding IconImageSource}" Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" Stretch="Uniform" />
                                            <FontIcon Glyph="&#xE7BA;" Foreground="#FFEF4444" FontSize="14" Visibility="{Binding HasIcon, Converter={StaticResource InverseBooleanToVisibilityConverter}}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Grid>
                                        <!-- App Name -->
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseHighBrush}" VerticalAlignment="Center" />
                                        <!-- Size -->
                                        <TextBlock Text="{Binding LockedSizeFormatted}" FontSize="10" Foreground="#FFEF4444" VerticalAlignment="Center" Opacity="0.8" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    
                    <Button Grid.Column="2" 
                            Content="Close Apps &amp; Re-scan" 
                            Click="OnCloseAppsClick" 
                            Background="#FFEF4444" 
                            Foreground="White" 
                            FontWeight="SemiBold" 
                            CornerRadius="6" 
                            Padding="14,6" 
                            VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="1.2*" />
                <ColumnDefinition x:Name="RightColumn" Width="0.8*" />
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Categories List -->
            <Border Grid.Column="0" Style="{StaticResource GlassmorphismCardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Junk Categories" FontSize="16" FontWeight="Bold" Margin="4,0,0,12" />
                    
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" SelectionMode="Single" ItemContainerStyle="{StaticResource ModernCardListViewItemStyle}">
                        
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="12,10" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />  <!-- CheckBox -->
                                            <ColumnDefinition Width="Auto" />  <!-- Circle Icon -->
                                            <ColumnDefinition Width="*" />     <!-- Label Details -->
                                            <ColumnDefinition Width="Auto" />  <!-- Size & File Count -->
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="OnJunkSelectionChanged" Unchecked="OnJunkSelectionChanged" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="0" />
                                        
                                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#157F56D9" Margin="0,0,12,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <FontIcon Glyph="{Binding IconGlyph}" Foreground="{Binding IconColor}" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Visibility="{Binding ElementName=PageRoot, Path=WideLayoutVisibility}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="1" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding CleanableSizeFormatted}" FontWeight="Bold" FontSize="13" Foreground="#FF10B981" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding LockedSizeFormatted}" FontSize="10" Foreground="#FFEF4444" FontWeight="SemiBold" HorizontalAlignment="Right" Visibility="{Binding LockedSizeVisibility}" />
                                            <TextBlock Text="{Binding FileCountFormatted}" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Right Pane: Switchable Details, Progress or Empty State -->
            <Grid Grid.Column="1" Visibility="{Binding ElementName=PageRoot, Path=WideLayoutVisibility}">
                
                 <!-- STATE 1: Empty state (Initial state before scan) -->
                <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="24" Visibility="{x:Bind GetEmptyVisibility(ViewModel.SelectedCategory, ViewModel.IsScanning, ViewModel.IsCleaning), Mode=OneWay}">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel Spacing="16" HorizontalAlignment="Center">
                            <Border Width="72" Height="72" CornerRadius="36" Background="#107F56D9" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xEA99;" Foreground="#FF7F56D9" FontSize="32" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="Scan system to find junk files." FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" />
                                <TextBlock Text="Perform a quick scan of directories to evaluate safe-to-clean junk files and system caching logs." FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280" />
                            </StackPanel>
                            
                            <Button Style="{StaticResource AccentButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" Click="OnScanJunkClick" Padding="20,10" CornerRadius="6" HorizontalAlignment="Center" FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" FontSize="13" Foreground="White" />
                                    <TextBlock Text="Scan Directories" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- STATE 2: Detailed File Inspector (Idle and item selected) -->
                <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="20" Visibility="{x:Bind GetDetailVisibility(ViewModel.SelectedCategory, ViewModel.IsScanning, ViewModel.IsCleaning), Mode=OneWay}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />  <!-- Category details header -->
                            <RowDefinition Height="Auto" />  <!-- Section heading: Top Files -->
                            <RowDefinition Height="*" />     <!-- Files ListView -->
                        </Grid.RowDefinitions>

                        <!-- Header Info Card -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="{x:Bind ViewModel.SelectedCategory.IconGlyph, Mode=OneWay}" Foreground="{x:Bind ViewModel.SelectedCategory.IconColor, Mode=OneWay}" FontSize="16" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedCategory.Name, Mode=OneWay}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedCategory.Description, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedCategory.FolderPath, Mode=OneWay}" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" Opacity="0.8" />
                                </StackPanel>

                                <Button Grid.Column="1" Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Width="36" Height="36" CornerRadius="18" Padding="0" ToolTipService.ToolTip="Open Folder Location" Click="OnOpenFolderClick" VerticalAlignment="Top" HorizontalAlignment="Right">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="15" />
                                </Button>
                            </Grid>

                            <!-- Modern cleanable vs locked breakdown bar -->
                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10" Padding="12" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Cleanable -->
                                    <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Center">
                                        <TextBlock Text="Cleanable Space" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedCategory.CleanableSizeFormatted, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="#FF10B981" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Divider -->
                                    <Border Grid.Column="1" Width="1" Height="22" Background="{ThemeResource ControlStrokeColorDefaultBrush}" VerticalAlignment="Center" />

                                    <!-- Locked -->
                                    <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Center">
                                        <TextBlock Text="Locked / In Use" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedCategory.LockedSizeFormatted, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="#FFEF4444" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Top Largest Files" FontSize="13" FontWeight="Bold" Margin="4,0,0,8" />

                        <!-- File list scroll viewer -->
                        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.SelectedCategory.TopFiles, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="4,6" />
                                    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />  <!-- File icon -->
                                            <ColumnDefinition Width="*" />     <!-- Path info -->
                                            <ColumnDefinition Width="Auto" />  <!-- Size -->
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="{Binding IconGlyph}" Foreground="{Binding IconColor}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <Border Background="{Binding StatusBgColor}" CornerRadius="4" Padding="5,1.5" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding StatusForegroundColor}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Path}" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding SizeFormatted}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- STATE 3: Progress (Visible during scanning or cleaning) — smooth fade in/out -->
                <Grid x:Name="ProgressOverlayGrid" Visibility="Collapsed" Opacity="0">
                    <Grid.Resources>
                        <Storyboard x:Name="FadeInProgress">
                            <DoubleAnimation Storyboard.TargetName="ProgressOverlayGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                        <Storyboard x:Name="FadeOutProgress" Completed="FadeOutProgress_Completed">
                            <DoubleAnimation Storyboard.TargetName="ProgressOverlayGrid" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </Grid.Resources>
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="28,24" VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
                        <StackPanel Spacing="16" HorizontalAlignment="Center">
                            <!-- Glowing Icon Badge -->
                            <Grid Width="64" Height="64" HorizontalAlignment="Center">
                                <Border Width="64" Height="64" CornerRadius="18" Background="#1510B981" BorderBrush="#4010B981" BorderThickness="1.5">
                                    <FontIcon Glyph="&#xE74D;" FontSize="24" Foreground="#FF10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="Junk Sweeper Operation" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.ProgressMessage, Mode=OneWay}" TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" MaxWidth="320" HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Percentage Progress Bar -->
                            <StackPanel Spacing="8" Width="300" HorizontalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="Progress" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind ViewModel.ProgressPercentFormatted, Mode=OneWay}" FontSize="13" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Right" FontWeight="Bold" FontFamily="Segoe UI Variable Display"/>
                                </Grid>
                                <Border Background="#1AFFFFFF" CornerRadius="4" Height="8" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="1">
                                    <ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Maximum="100" Height="4" CornerRadius="2" Foreground="{StaticResource PrimaryAccentGradient}" Background="Transparent" HorizontalAlignment="Stretch" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>


