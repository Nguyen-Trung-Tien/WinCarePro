<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinCarePro.Models"
    xmlns:components="using:WinCarePro.Shared.Components"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    mc:Ignorable="d">

    <Grid Padding="24,18" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutVisualStates">
                <!-- Wide Layout: Viewport Width >= 1150px -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1150" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- Narrow Layout: Viewport Width < 1150px -->
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- Tab 1 Stacking -->
                        <Setter Target="SpeedGridCol0.Width" Value="*" />
                        <Setter Target="SpeedGridCol1.Width" Value="0" />
                        <Setter Target="SpeedGridLeft.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="SpeedGridRight.(Grid.Row)" Value="1" />
                        <Setter Target="SpeedGridRight.(Grid.Column)" Value="0" />
                        <Setter Target="SpeedGridRight.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="SpeedGridRight.Margin" Value="0,14,0,0" />

                        <!-- Tab 4 Stacking -->
                        <Setter Target="RepairPaneCol0.Width" Value="*" />
                        <Setter Target="RepairPaneCol1.Width" Value="0" />
                        <Setter Target="RepairPaneLeft.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="RepairPaneRight.(Grid.Row)" Value="1" />
                        <Setter Target="RepairPaneRight.(Grid.Column)" Value="0" />
                        <Setter Target="RepairPaneRight.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="RepairPaneRight.Margin" Value="0,14,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header -->
            <RowDefinition Height="Auto"/> <!-- 1: Nav Tabs -->
            <RowDefinition Height="*"/>    <!-- 2: Content Viewport -->
        </Grid.RowDefinitions>

        <!-- ==================== 0. MODERN HEADER ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title & Status Chips Inline -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Background="{StaticResource CyberAccentGradient}" CornerRadius="10" Padding="8">
                    <FontIcon Glyph="&#xE701;" FontSize="18" Foreground="White"/>
                </Border>
                <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="Network Center &amp; Diagnostics" Style="{StaticResource PageHeaderTitleStyle}" FontSize="20"/>
                    <TextBlock Text="Real-time network telemetry, low-latency DNS optimizer, socket traffic &amp; TCP/IP repair." FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>
                
                <!-- Live Internet Connection Status Pill -->
                <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="7" Height="7" Fill="#FF10B981"/>
                        <TextBlock Text="{x:Bind ViewModel.InternetStatus, Mode=OneWay}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Public IP Pill with Quick Copy -->
                <Button Click="OnCopyPublicIpClick" Style="{StaticResource DefaultButtonStyle}" Padding="10,4" CornerRadius="8" ToolTipService.ToolTip="Click to copy Public IP">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE774;" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}"/>
                        <TextBlock Text="IP:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.PublicIpAddress, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                        <FontIcon Glyph="&#xE8C8;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Quick Auto-Diagnose Button -->
            <Button x:Name="RefreshBtn" Grid.Column="1" Click="OnRefreshClick" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="36" Padding="16,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                    <FontIcon Glyph="&#xE72C;" FontSize="12" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    <TextBlock Text="Run Diagnostics" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ==================== 1. CYBER SEGMENTED TABS ==================== -->
        <Border Grid.Row="1" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,0,0,12">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnTabQuality" Grid.Column="0" Content="🚀 Quality &amp; Speed" Click="OnTabQualityClick" Style="{StaticResource VibrantPrimaryButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8" FontWeight="Bold" FontSize="12.5" Padding="0,8"/>
                <Button x:Name="BtnTabDns" Grid.Column="1" Content="🌐 DNS Optimizer" Click="OnTabDnsClick" Style="{StaticResource DefaultButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8" FontWeight="SemiBold" FontSize="12.5" Padding="0,8"/>
                <Button x:Name="BtnTabPorts" Grid.Column="2" Content="🔍 Active Sockets" Click="OnTabPortsClick" Style="{StaticResource DefaultButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8" FontWeight="SemiBold" FontSize="12.5" Padding="0,8"/>
                <Button x:Name="BtnTabRepairs" Grid.Column="3" Content="🛠 TCP/IP Repair Suite" Click="OnTabRepairsClick" Style="{StaticResource DefaultButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8" FontWeight="SemiBold" FontSize="12.5" Padding="0,8"/>
            </Grid>
        </Border>

        <!-- ==================== 2. MAIN CONTENT AREA (FIT TO VIEWPORT) ==================== -->
        <Grid Grid.Row="2">

            <!-- ++++++++++++++++++++ TAB 1: QUALITY & SPEED (NO EXCESSIVE SCROLL) ++++++++++++++++++++ -->
            <Grid x:Name="SectionQuality" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: 4 Stats -->
                    <RowDefinition Height="*"/>    <!-- 1: Main Split -->
                </Grid.RowDefinitions>

                <!-- Top Row: 4 Telemetry Cards -->
                <Grid Grid.Row="0" ColumnSpacing="12" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Latency / Ping -->
                    <Border Grid.Column="0" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Latency (Ping)" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind FormatMs(ViewModel.LatencyMs), Mode=OneWay}" FontSize="22" FontWeight="ExtraBold" Foreground="#FF10B981"/>
                                <TextBlock Text="Round-trip echo" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#2010B981" CornerRadius="8" Padding="9" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE701;" FontSize="17" Foreground="#FF10B981"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Card 2: Jitter -->
                    <Border Grid.Column="1" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Jitter Stability" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind FormatMs(ViewModel.JitterMs), Mode=OneWay}" FontSize="22" FontWeight="ExtraBold" Foreground="#FF8B5CF6"/>
                                <TextBlock Text="Buffer variation" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#208B5CF6" CornerRadius="8" Padding="9" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE945;" FontSize="17" Foreground="#FF8B5CF6"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Card 3: Packet Loss -->
                    <Border Grid.Column="2" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Packet Loss" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind FormatPercent(ViewModel.PacketLossPercent), Mode=OneWay}" FontSize="22" FontWeight="ExtraBold" Foreground="#FFF59E0B"/>
                                <TextBlock Text="Dropped frames ratio" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#20F59E0B" CornerRadius="8" Padding="9" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7BA;" FontSize="17" Foreground="#FFF59E0B"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Card 4: Connection Quality Rating -->
                    <Border Grid.Column="3" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Quality Rating" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.ConnectionQuality, Mode=OneWay}" FontSize="21" FontWeight="ExtraBold" Foreground="#FF06B6D4"/>
                                <TextBlock Text="{x:Bind ViewModel.IpStatus, Mode=OneWay}" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#2006B6D4" CornerRadius="8" Padding="9" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE774;" FontSize="17" Foreground="#FF06B6D4"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Middle Row: Speedometer + Interfaces Split (Speedtest gets primary focus) -->
                <Grid Grid.Row="1" x:Name="SpeedGrid" ColumnSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SpeedGridCol0" Width="1.2*"/>
                        <ColumnDefinition x:Name="SpeedGridCol1" Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Prominent Cyber Speedometer & Live Telemetry -->
                    <Border x:Name="SpeedGridLeft" Grid.Row="0" Grid.Column="0" Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- 0: Header with View History Button -->
                                <RowDefinition Height="Auto"/> <!-- 1: Gauge & Metrics Deck -->
                                <RowDefinition Height="Auto"/> <!-- 2: Progress Bar -->
                                <RowDefinition Height="Auto"/> <!-- 3: Action Button -->
                            </Grid.RowDefinitions>

                            <!-- Speedometer Header with View History Button & Live Phase Badge -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource CyberAccentGradient}" CornerRadius="8" Padding="7" Margin="0,0,10,0">
                                    <FontIcon Glyph="&#xEB42;" FontSize="14" Foreground="White"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Bandwidth Speedometer" FontSize="14.5" FontWeight="Bold"/>
                                    <TextBlock Text="Live throughput benchmark &amp; latency analysis" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Click="OnViewSpeedHistoryClick" Style="{StaticResource DefaultButtonStyle}" Padding="8,4" Height="28" CornerRadius="7" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE81C;" FontSize="11" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                            <TextBlock Text="View History ↗" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource PrimaryAccentBrush}"/>
                                            <TextBlock Text="{x:Bind ViewModel.SpeedTestPhase, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Cyber Speedometer + 3-Card Telemetry Deck -->
                            <Grid Grid.Row="1" Margin="0,2,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="138"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Holographic Cyber Speedometer Gauge -->
                                <Grid Grid.Column="0" Width="132" Height="132" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="130" Height="130" Opacity="0.2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#FF8B5CF6" Offset="0"/>
                                                <GradientStop Color="#FF06B6D4" Offset="0.75"/>
                                                <GradientStop Color="Transparent" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse Width="124" Height="124" Stroke="{StaticResource PrimaryAccentBrush}" StrokeThickness="2" StrokeDashArray="5 3" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                                    <Ellipse Width="104" Height="104" Fill="{ThemeResource AppStatChipBackground}" Stroke="{ThemeResource AppStatChipBorder}" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{x:Bind ViewModel.DisplaySpeedLabel, Mode=OneWay}" FontSize="8.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind FormatSpeedValue(ViewModel.DisplaySpeed), Mode=OneWay}" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center"/>
                                        <Border Background="#258B5CF6" CornerRadius="4" Padding="6,1" HorizontalAlignment="Center">
                                            <TextBlock Text="{x:Bind FormatSpeedUnit(ViewModel.DisplaySpeed), Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- 3 Compact Telemetry Metric Tiles -->
                                <Grid Grid.Column="1" Margin="12,0,0,0" RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Download Card -->
                                    <Border Grid.Row="0" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#2010B981" CornerRadius="5" Padding="5" Margin="0,0,10,0">
                                                <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="#FF10B981"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="DOWNLOAD" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="Inbound throughput" FontSize="9" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{x:Bind FormatMbps(ViewModel.DownloadSpeed), Mode=OneWay}" FontSize="15" FontWeight="ExtraBold" Foreground="#FF10B981" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Upload Card -->
                                    <Border Grid.Row="1" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#208B5CF6" CornerRadius="5" Padding="5" Margin="0,0,10,0">
                                                <FontIcon Glyph="&#xE898;" FontSize="12" Foreground="#FF8B5CF6"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="UPLOAD" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="Outbound throughput" FontSize="9" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{x:Bind FormatMbps(ViewModel.UploadSpeed), Mode=OneWay}" FontSize="15" FontWeight="ExtraBold" Foreground="#FF8B5CF6" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Latency / Ping Card -->
                                    <Border Grid.Row="2" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#2006B6D4" CornerRadius="5" Padding="5" Margin="0,0,10,0">
                                                <FontIcon Glyph="&#xE774;" FontSize="12" Foreground="#FF06B6D4"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="PING LATENCY" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="Round-trip echo" FontSize="9" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{x:Bind FormatMs(ViewModel.LatencyMs), Mode=OneWay}" FontSize="15" FontWeight="ExtraBold" Foreground="#FF06B6D4" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Live Progress Gauge -->
                            <StackPanel Grid.Row="2" Spacing="2" Margin="0,0,0,10">
                                <ProgressBar Value="{x:Bind ViewModel.SpeedProgress, Mode=OneWay}" Maximum="100" Height="6" CornerRadius="3" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            </StackPanel>

                            <!-- Hero Speed Test Action Button -->
                            <Button Grid.Row="3" Click="OnSpeedTestClick" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" Style="{StaticResource VibrantPrimaryButtonStyle}" HorizontalAlignment="Stretch" Height="38" CornerRadius="9">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                                    <FontIcon Glyph="&#xE768;" FontSize="12" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    <TextBlock Text="Start Speed Test" FontSize="12.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Right: Hardware Network Interfaces & Quick Fixes -->
                    <Grid x:Name="SpeedGridRight" Grid.Row="0" Grid.Column="1" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>    <!-- Adapters List -->
                            <RowDefinition Height="Auto"/> <!-- Quick 1-Click Tools -->
                        </Grid.RowDefinitions>

                        <!-- Hardware Network Interfaces -->
                        <Border Grid.Row="0" Style="{StaticResource GlassmorphismCardStyle}" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Hardware Network Interfaces" FontSize="14" FontWeight="Bold"/>
                                        <TextBlock Text="Physical network controllers and active IP routing" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#2010B981" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Ellipse Width="6" Height="6" Fill="#FF10B981"/>
                                            <TextBlock Text="Active Link" FontSize="10.5" FontWeight="Bold" Foreground="#FF10B981"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Adapters, Mode=OneWay}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:NetworkAdapterInfo">
                                            <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="14,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Background="#208B5CF6" CornerRadius="8" Padding="9" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE701;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="13.5"/>
                                                            <Border Background="#2006B6D4" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind Speed}" FontSize="10" Foreground="#FF06B6D4" FontWeight="Bold"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,2,0,0">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Text="IPv4:" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                <TextBlock Text="{x:Bind IpAddress}" FontSize="11" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Text="MAC:" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                <TextBlock Text="{x:Bind MacAddress}" FontSize="11" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Background="{x:Bind StatusBadgeBg}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Status}" Foreground="{x:Bind StatusBadgeFg}" FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- Quick 1-Click Fix Actions Strip -->
                        <Border Grid.Row="1" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,12">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Click="OnRepairClick" Tag="flushdns" Style="{StaticResource StandardSecondaryButtonStyle}" Height="36" HorizontalAlignment="Stretch" Padding="4,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE72C;" FontSize="11.5"/>
                                        <TextBlock Text="Flush DNS" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1" Click="OnRepairClick" Tag="resettcp" Style="{StaticResource StandardSecondaryButtonStyle}" Height="36" HorizontalAlignment="Stretch" Padding="4,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE896;" FontSize="11.5"/>
                                        <TextBlock Text="Reset TCP/IP" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2" Click="OnRepairClick" Tag="renewdhcp" Style="{StaticResource StandardSecondaryButtonStyle}" Height="36" HorizontalAlignment="Stretch" Padding="4,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE8D7;" FontSize="11.5"/>
                                        <TextBlock Text="Renew DHCP" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="3" Click="OnDnsBenchmarkClick" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="36" HorizontalAlignment="Stretch" Padding="4,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xEC1B;" FontSize="11.5"/>
                                        <TextBlock Text="Optimize DNS" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ++++++++++++++++++++ TAB 2: DNS OPTIMIZER (NO EXCESSIVE SCROLL) ++++++++++++++++++++ -->
            <Grid x:Name="SectionDns" Visibility="Collapsed" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Combined Active DNS & DoH Settings Card -->
                    <RowDefinition Height="*"/>    <!-- DNS Benchmark Table -->
                </Grid.RowDefinitions>

                <!-- Combined Active DNS & DoH Banner -->
                <Border Grid.Row="0" Style="{StaticResource AuraGlassCardStyle}" Padding="18,14">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Active DNS Status & Quick Action Buttons -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Background="{StaticResource CyberAccentGradient}" CornerRadius="7" Padding="6">
                                    <FontIcon Glyph="&#xEC1B;" FontSize="14" Foreground="White"/>
                                </Border>
                                <TextBlock Text="Active DNS:" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border Background="#2010B981" CornerRadius="6" Padding="10,3" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.CurrentDnsText, Mode=OneWay}" FontSize="11.5" FontWeight="Bold" Foreground="#FF10B981"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Click="OnRestoreDefaultDnsClick" Style="{StaticResource StandardSecondaryButtonStyle}" Height="34" Padding="12,0" ToolTipService.ToolTip="Revert adapter DNS to automatic DHCP assigned by router">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE777;" FontSize="11.5"/>
                                        <TextBlock Text="Restore DHCP" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="OnRepairClick" Tag="flushdns" Style="{StaticResource StandardSecondaryButtonStyle}" Height="34" Padding="12,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="11.5"/>
                                        <TextBlock Text="Flush Cache" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="OnDnsBenchmarkClick" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="34" Padding="14,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE768;" FontSize="11.5"/>
                                        <TextBlock Text="Benchmark All DNS" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: DoH (DNS-over-HTTPS) Quick Setup -->
                        <Grid Grid.Row="1" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="8" Padding="14,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                                <FontIcon Glyph="&#xE72E;" FontSize="13" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock Text="DoH Encrypted DNS" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ToggleSwitch Grid.Column="1" x:Name="ToggleDoh" IsOn="{x:Bind ViewModel.IsDohEnabled, Mode=TwoWay}" OffContent="Disabled" OnContent="Enabled" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Provider:" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CmbDohProvider" ItemsSource="{x:Bind DohProviders, Mode=OneTime}" SelectedItem="{x:Bind ViewModel.SelectedDohProvider, Mode=TwoWay}" SelectionChanged="OnDohProviderSelectionChanged" Width="150" Height="34" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="3" Click="OnApplyDohClick" Style="{StaticResource StandardSecondaryButtonStyle}" Height="34" Padding="14,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE73E;" FontSize="11.5"/>
                                    <TextBlock Text="Apply DoH" FontSize="11.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- DNS Benchmark Results Table -->
                <Border Grid.Row="1" Style="{StaticResource GlassmorphismCardStyle}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="DNS Server Latency Benchmark" FontSize="14" FontWeight="Bold"/>
                                <Border Background="#208B5CF6" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Fastest:" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.FastestDnsText, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.DnsServers, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:DnsServerInfo">
                                    <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="14,10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Provider Name -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="{x:Bind Provider}" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                            </StackPanel>

                                            <!-- IP Endpoints -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind PrimaryIp}" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Text="{x:Bind SecondaryIp}" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                            </StackPanel>

                                            <!-- Latency Gauge Bar -->
                                            <ProgressBar Grid.Column="2" Value="{x:Bind AverageQueryMs}" Maximum="150" Height="6" CornerRadius="3" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <!-- Response Time Badge -->
                                            <Border Grid.Column="3" Background="#208B5CF6" CornerRadius="6" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind LatencyFormatted}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                            </Border>

                                            <!-- Apply DNS Button -->
                                            <Button Grid.Column="4" Click="OnApplyDnsClick" Tag="{x:Bind}" Style="{StaticResource StandardSecondaryButtonStyle}" Height="32" Padding="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="Apply DNS" FontSize="11" FontWeight="SemiBold"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- ++++++++++++++++++++ TAB 3: ACTIVE SOCKETS (FIXED HEADER & VIRTUALIZED TABLE) ++++++++++++++++++++ -->
            <Grid x:Name="SectionPorts" Visibility="Collapsed" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: Filter Bar -->
                    <RowDefinition Height="*"/>    <!-- 1: Table with Fixed Header -->
                </Grid.RowDefinitions>

                <!-- Search, Category Filter & Actions Bar -->
                <Border Grid.Row="0" Style="{StaticResource GlassmorphismCardStyle}" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBox Text="{x:Bind ViewModel.ConnectionSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search process, port (e.g. 443), IP..." Width="280" Height="34"/>
                            <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind FormatConnectionCount(ViewModel.Connections.Count), Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Socket Category Filters -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="BtnFilterAll" Content="All" Click="OnFilterSocketCategoryClick" Tag="All" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="32" Padding="12,0" CornerRadius="6" FontSize="11.5" FontWeight="SemiBold"/>
                            <Button x:Name="BtnFilterEstablished" Content="Established" Click="OnFilterSocketCategoryClick" Tag="Established" Style="{StaticResource DefaultButtonStyle}" Height="32" Padding="12,0" CornerRadius="6" FontSize="11.5"/>
                            <Button x:Name="BtnFilterListening" Content="Listening" Click="OnFilterSocketCategoryClick" Tag="Listening" Style="{StaticResource DefaultButtonStyle}" Height="32" Padding="12,0" CornerRadius="6" FontSize="11.5"/>
                            <Button x:Name="BtnFilterTcp" Content="TCP" Click="OnFilterSocketCategoryClick" Tag="TCP" Style="{StaticResource DefaultButtonStyle}" Height="32" Padding="12,0" CornerRadius="6" FontSize="11.5"/>
                            <Button x:Name="BtnFilterUdp" Content="UDP" Click="OnFilterSocketCategoryClick" Tag="UDP" Style="{StaticResource DefaultButtonStyle}" Height="32" Padding="12,0" CornerRadius="6" FontSize="11.5"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Click="OnRefreshConnectionsClick" Style="{StaticResource StandardSecondaryButtonStyle}" Height="34" Padding="14,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="11.5"/>
                                    <TextBlock Text="Refresh Sockets" FontSize="11.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Active Sockets Table with Sticky Header -->
                <Border Grid.Row="1" Style="{StaticResource GlassmorphismCardStyle}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Table Header (Sticky) -->
                        <Grid Grid.Row="0" Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Process / PID" FontWeight="Bold" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            <TextBlock Grid.Column="1" Text="Protocol" FontWeight="Bold" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            <TextBlock Grid.Column="2" Text="Local Endpoint" FontWeight="Bold" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            <TextBlock Grid.Column="3" Text="Remote Endpoint" FontWeight="Bold" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            <TextBlock Grid.Column="4" Text="State (Right-click for options)" FontWeight="Bold" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        </Grid>

                        <!-- Connection Rows Virtualized ListView -->
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Connections, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ActiveConnectionInfo">
                                    <Grid Padding="10,8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                                        <!-- Right-click Context Menu on Socket Row -->
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Copy Socket Info" Click="OnCopySocketClick">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8C8;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Open Process Location" Click="OnOpenProcessLocationClick">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8DA;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem Text="Terminate Process (Kill)" Click="OnKillProcessClick" Foreground="#FFEF4444">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" Foreground="#FFEF4444"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{x:Bind ProcessName}" FontWeight="Bold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind ProcessId}" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="#208B5CF6" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Protocol}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        </Border>

                                        <TextBlock Grid.Column="2" Text="{x:Bind LocalAddress}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind RemoteAddress}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        <Border Grid.Column="4" Background="{x:Bind StateBadgeBg}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind State}" FontSize="10" FontWeight="Bold" Foreground="{x:Bind StateBadgeFg}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- ++++++++++++++++++++ TAB 4: REPAIR & DIAGNOSTICS SUITE (2-PANE WORKSPACE) ++++++++++++++++++++ -->
            <Grid x:Name="SectionRepairs" Visibility="Collapsed" ColumnSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RepairPaneCol0" Width="1.15*"/>
                    <ColumnDefinition x:Name="RepairPaneCol1" Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Pane: 10 Tools categorized into Core Repairs & Performance Tweaks -->
                <Grid x:Name="RepairPaneLeft" Grid.Row="0" Grid.Column="0" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.25*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section 1: 1-Click TCP/IP & Winsock Repair Suite (6 Tiles) -->
                    <Border Grid.Row="0" Style="{StaticResource GlassmorphismCardStyle}" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="1-Click TCP/IP &amp; Winsock Repairs" FontSize="14.5" FontWeight="Bold"/>
                                    <TextBlock Text="Resolve DNS failures, socket corruption &amp; IP lease timeouts" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#2010B981" CornerRadius="6" Padding="10,3" VerticalAlignment="Center">
                                    <TextBlock Text="Core Repairs" FontSize="10.5" FontWeight="Bold" Foreground="#FF10B981"/>
                                </Border>
                            </Grid>

                            <!-- 3x2 Grid of Core Fix Tiles (Stretched to match pane height) -->
                            <Grid Grid.Row="1" RowSpacing="10" ColumnSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Fix 1: Reset TCP/IP -->
                                <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="10" Padding="12,10" VerticalAlignment="Stretch">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Reset TCP/IP" FontWeight="Bold" FontSize="12.5"/>
                                        <TextBlock Grid.Row="1" Text="Rebuild TCP/IP stack." FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                        <Button Grid.Row="2" Click="OnRepairClick" Tag="resettcp" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="36" HorizontalAlignment="Stretch" Padding="0,0">
                                            <TextBlock Text="Reset TCP" FontSize="11.5" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Fix 2: Reset Winsock -->
                                <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="10" Padding="12,10" VerticalAlignment="Stretch">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Reset Winsock" FontWeight="Bold" FontSize="12.5"/>
                                        <TextBlock Grid.Row="1" Text="Restore Sockets API." FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                        <Button Grid.Row="2" Click="OnRepairClick" Tag="resetwinsock" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="36" HorizontalAlignment="Stretch" Padding="0,0">
                                            <TextBlock Text="Reset Winsock" FontSize="11.5" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Fix 3: Renew DHCP Lease -->
                                <Border Grid.Row="0" Grid.Column="2" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="10" Padding="12,10" VerticalAlignment="Stretch">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Renew DHCP" FontWeight="Bold" FontSize="12.5"/>
                                        <TextBlock Grid.Row="1" Text="Re-request IP lease." FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                        <Button Grid.Row="2" Click="OnRepairClick" Tag="renewdhcp" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="36" HorizontalAlignment="Stretch" Padding="0,0">
                                            <TextBlock Text="Renew DHCP" FontSize="11.5" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Fix 4: Flush DNS & ARP -->
                                <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="10" Padding="12,10" VerticalAlignment="Stretch">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Flush DNS/ARP" FontWeight="Bold" FontSize="12.5"/>
                                        <TextBlock Grid.Row="1" Text="Purge cache table." FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                        <Button Grid.Row="2" Click="OnRepairClick" Tag="flushdns" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="36" HorizontalAlignment="Stretch" Padding="0,0">
                                            <TextBlock Text="Flush Cache" FontSize="11.5" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Fix 5: Reset Network Adapters -->
                                <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="10" Padding="12,10" VerticalAlignment="Stretch">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Reset Adapters" FontWeight="Bold" FontSize="12.5"/>
                                        <TextBlock Grid.Row="1" Text="Restart NIC devices." FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                        <Button Grid.Row="2" Click="OnRepairClick" Tag="resetadapters" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="36" HorizontalAlignment="Stretch" Padding="0,0">
                                            <TextBlock Text="Restart NICs" FontSize="11.5" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Fix 6: Repair Windows Firewall -->
                                <Border Grid.Row="1" Grid.Column="2" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="10" Padding="12,10" VerticalAlignment="Stretch">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Repair Firewall" FontWeight="Bold" FontSize="12.5"/>
                                        <TextBlock Grid.Row="1" Text="Restore default rules." FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                        <Button Grid.Row="2" Click="OnRepairClick" Tag="repairfirewall" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="36" HorizontalAlignment="Stretch" Padding="0,0">
                                            <TextBlock Text="Fix Firewall" FontSize="11.5" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Section 2: Gaming & Latency Optimization Suite (4 Advanced Tiles) -->
                    <Border Grid.Row="1" Style="{StaticResource AuraGlassCardStyle}" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Gaming &amp; Performance Latency Boost" FontSize="14.5" FontWeight="Bold"/>
                                    <TextBlock Text="Reduce bufferbloat, lower game ping &amp; clean routing" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#208B5CF6" CornerRadius="6" Padding="10,3" VerticalAlignment="Center">
                                    <TextBlock Text="Performance Boost" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1" RowSpacing="10" ColumnSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Advanced Fix 1: Optimize TCP Auto-Tuning -->
                                <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" VerticalAlignment="Stretch">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="TCP Auto-Tuning" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Grid.Row="1" Text="Unlock max throughput &amp; window size." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                        <Button Grid.Row="2" Click="OnRepairClick" Tag="optimizetcp" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="36" HorizontalAlignment="Stretch" Padding="0,0">
                                            <TextBlock Text="Enable TCP Tuning" FontSize="12" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Advanced Fix 2: Disable Energy-Efficient Ethernet -->
                                <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" VerticalAlignment="Stretch">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Disable EEE (Lower Ping)" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Grid.Row="1" Text="Prevents Ethernet sleep in gaming." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                        <Button Grid.Row="2" Click="OnRepairClick" Tag="disableeee" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="36" HorizontalAlignment="Stretch" Padding="0,0">
                                            <TextBlock Text="Disable EEE" FontSize="12" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Advanced Fix 3: Reset Proxy & WinHTTP -->
                                <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" VerticalAlignment="Stretch">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Reset WinHTTP &amp; Proxy" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Grid.Row="1" Text="Purge corrupt proxy redirects." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                        <Button Grid.Row="2" Click="OnRepairClick" Tag="resetproxy" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="36" HorizontalAlignment="Stretch" Padding="0,0">
                                            <TextBlock Text="Reset Proxy" FontSize="12" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Advanced Fix 4: Reset Hosts File -->
                                <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" VerticalAlignment="Stretch">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Reset Windows Hosts" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Grid.Row="1" Text="Restore default hosts file." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                        <Button Grid.Row="2" Click="OnRepairClick" Tag="resethosts" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="36" HorizontalAlignment="Stretch" Padding="0,0">
                                            <TextBlock Text="Reset Hosts" FontSize="12" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Right Pane: Diagnostic Terminal Console & Ping/Trace/DNS/Port Tools -->
                <Border x:Name="RepairPaneRight" Grid.Row="0" Grid.Column="1" Style="{StaticResource GlassmorphismCardStyle}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Console Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Network Diagnostic Terminal" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="Live command output and instant network test tools" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button Click="OnCopyConsoleClick" Style="{StaticResource DefaultButtonStyle}" Height="30" Padding="10,0" ToolTipService.ToolTip="Copy Console Output">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="11"/>
                                </Button>
                                <Button Click="OnClearConsoleClick" Style="{StaticResource DefaultButtonStyle}" Height="30" Padding="10,0" ToolTipService.ToolTip="Clear Console">
                                    <FontIcon Glyph="&#xE74D;" FontSize="11"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Tool Input & Trigger Buttons -->
                        <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,10">
                            <TextBox Text="{x:Bind ViewModel.TestHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnHostKeyDown" PlaceholderText="Target host (e.g. 8.8.8.8, google.com) - Press Enter to Ping..." Height="34"/>
                            
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Click="OnPingClick" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="32" HorizontalAlignment="Stretch" Padding="0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="11"/>
                                        <TextBlock Text="Ping" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button Grid.Column="1" Click="OnTraceClick" Style="{StaticResource StandardSecondaryButtonStyle}" Height="32" HorizontalAlignment="Stretch" Padding="0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE756;" FontSize="11"/>
                                        <TextBlock Text="Traceroute" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button Grid.Column="2" Click="OnDnsLookupClick" Style="{StaticResource StandardSecondaryButtonStyle}" Height="32" HorizontalAlignment="Stretch" Padding="0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xEC1B;" FontSize="11"/>
                                        <TextBlock Text="DNS" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button Grid.Column="3" Click="OnPortScanClick" Style="{StaticResource StandardSecondaryButtonStyle}" Height="32" HorizontalAlignment="Stretch" Padding="0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE71E;" FontSize="11"/>
                                        <TextBlock Text="Port Scan" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Terminal Console Output Screen -->
                        <Border Grid.Row="2" Background="{ThemeResource AppTerminalBackground}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <ScrollViewer x:Name="TerminalScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock Text="{x:Bind ViewModel.ConsoleOutput, Mode=OneWay}" FontFamily="Cascadia Code, Consolas, Courier New" FontSize="12" Foreground="{ThemeResource AppTerminalForeground}" TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="18"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
