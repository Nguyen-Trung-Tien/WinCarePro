<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinCarePro.Models"
    xmlns:components="using:WinCarePro.Shared.Components"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    mc:Ignorable="d">

    <Grid Padding="24,18" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header -->
            <RowDefinition Height="Auto"/> <!-- 1: Nav Tabs -->
            <RowDefinition Height="*"/>    <!-- 2: Content Area (Stretches & Fills Viewport) -->
        </Grid.RowDefinitions>

        <!-- ==================== 0. MODERN HEADER ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title & Status Chips Inline -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Background="{StaticResource CyberAccentGradient}" CornerRadius="10" Padding="8">
                    <FontIcon Glyph="&#xE701;" FontSize="18" Foreground="White"/>
                </Border>
                <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="Network Center &amp; Diagnostics" Style="{StaticResource PageHeaderTitleStyle}" FontSize="20"/>
                    <TextBlock Text="Real-time network telemetry, low-latency DNS optimizer, socket traffic &amp; TCP/IP repair." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>
                
                <!-- Live Internet Connection Status Pill -->
                <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="7" Height="7" Fill="#FF10B981"/>
                        <TextBlock Text="{x:Bind ViewModel.InternetStatus, Mode=OneWay}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Public IP Pill with Quick Copy -->
                <Button Click="OnCopyPublicIpClick" Style="{StaticResource DefaultButtonStyle}" Padding="10,4" CornerRadius="8" ToolTipService.ToolTip="Click to copy Public IP">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE774;" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}"/>
                        <TextBlock Text="IP:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.PublicIpAddress, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                        <FontIcon Glyph="&#xE8C8;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Quick Auto-Diagnose Button -->
            <Button x:Name="RefreshBtn" Grid.Column="1" Click="OnRefreshClick" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="36" Padding="16,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                    <FontIcon Glyph="&#xE72C;" FontSize="12" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    <TextBlock Text="Run Diagnostics" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ==================== 1. CYBER SEGMENTED TABS ==================== -->
        <Border Grid.Row="1" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,0,0,14">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnTabQuality" Grid.Column="0" Content="🚀 Quality &amp; Speed" Click="OnTabQualityClick" Style="{StaticResource VibrantPrimaryButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8" FontWeight="Bold" FontSize="12.5" Padding="0,8"/>
                <Button x:Name="BtnTabDns" Grid.Column="1" Content="🌐 DNS Optimizer" Click="OnTabDnsClick" Style="{StaticResource DefaultButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8" FontWeight="SemiBold" FontSize="12.5" Padding="0,8"/>
                <Button x:Name="BtnTabPorts" Grid.Column="2" Content="🔍 Active Sockets" Click="OnTabPortsClick" Style="{StaticResource DefaultButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8" FontWeight="SemiBold" FontSize="12.5" Padding="0,8"/>
                <Button x:Name="BtnTabRepairs" Grid.Column="3" Content="🛠 TCP/IP Repair Suite" Click="OnTabRepairsClick" Style="{StaticResource DefaultButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8" FontWeight="SemiBold" FontSize="12.5" Padding="0,8"/>
            </Grid>
        </Border>

        <!-- ==================== 2. MAIN CONTENT AREA ==================== -->
        <Grid Grid.Row="2">

            <!-- ++++++++++++++++++++ TAB 1: QUALITY & SPEED (FULL DASHBOARD) ++++++++++++++++++++ -->
            <ScrollViewer x:Name="SectionQuality" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Visible">
                <StackPanel Spacing="14">

                    <!-- Top Row: 4 Real-Time Telemetry Stat Cards -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Latency / Ping -->
                        <Border Grid.Column="0" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Latency (Ping)" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind FormatMs(ViewModel.LatencyMs), Mode=OneWay}" FontSize="24" FontWeight="ExtraBold" Foreground="#FF10B981"/>
                                    <TextBlock Text="Round-trip echo" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#2010B981" CornerRadius="8" Padding="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE701;" FontSize="18" Foreground="#FF10B981"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Card 2: Jitter -->
                        <Border Grid.Column="1" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Jitter Stability" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind FormatMs(ViewModel.JitterMs), Mode=OneWay}" FontSize="24" FontWeight="ExtraBold" Foreground="#FF8B5CF6"/>
                                    <TextBlock Text="Buffer variation" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#208B5CF6" CornerRadius="8" Padding="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE945;" FontSize="18" Foreground="#FF8B5CF6"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Card 3: Packet Loss -->
                        <Border Grid.Column="2" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Packet Loss" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind FormatPercent(ViewModel.PacketLossPercent), Mode=OneWay}" FontSize="24" FontWeight="ExtraBold" Foreground="#FFF59E0B"/>
                                    <TextBlock Text="Dropped frames ratio" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#20F59E0B" CornerRadius="8" Padding="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="18" Foreground="#FFF59E0B"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Card 4: Connection Quality Rating -->
                        <Border Grid.Column="3" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Quality Rating" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.ConnectionQuality, Mode=OneWay}" FontSize="22" FontWeight="ExtraBold" Foreground="#FF06B6D4"/>
                                    <TextBlock Text="{x:Bind ViewModel.IpStatus, Mode=OneWay}" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#2006B6D4" CornerRadius="8" Padding="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE774;" FontSize="18" Foreground="#FF06B6D4"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Middle Row: Speed Test Hub & Hardware Interfaces Split -->
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Futuristic Bandwidth Speedometer -->
                        <Border Grid.Column="0" Style="{StaticResource AuraGlassCardStyle}" Padding="20">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource CyberAccentGradient}" CornerRadius="8" Padding="7" Margin="0,0,10,0">
                                        <FontIcon Glyph="&#xEB42;" FontSize="14" Foreground="White"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Bandwidth Speed Benchmark" FontSize="14" FontWeight="Bold"/>
                                        <TextBlock Text="Real-time multi-stream socket throughput" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Cyber Speedometer Centerpiece -->
                                <Grid Height="130" Margin="0,2">
                                    <Ellipse Width="126" Height="126" Opacity="0.18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#FF8B5CF6" Offset="0"/>
                                                <GradientStop Color="#FF06B6D4" Offset="0.7"/>
                                                <GradientStop Color="Transparent" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <Ellipse Width="120" Height="120" Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="3.5" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.35"/>
                                    <Ellipse Width="100" Height="100" Fill="{ThemeResource AppStatChipBackground}" Stroke="{StaticResource CyberGlassBorderBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind FormatSpeedValue(ViewModel.DownloadSpeed), Mode=OneWay}" FontSize="30" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" CharacterSpacing="-15"/>
                                        <Border Background="#258B5CF6" CornerRadius="4" Padding="6,1" HorizontalAlignment="Center">
                                            <TextBlock Text="{x:Bind FormatSpeedUnit(ViewModel.DownloadSpeed), Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Live Progress Gauge -->
                                <StackPanel Spacing="3">
                                    <ProgressBar Value="{x:Bind ViewModel.SpeedProgress, Mode=OneWay}" Maximum="100" Height="5" CornerRadius="2.5" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                    <Grid>
                                        <TextBlock Text="0%" FontSize="9.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{x:Bind FormatPercent(ViewModel.SpeedProgress), Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="100%" FontSize="9.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Download & Upload Metric Chips -->
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE896;" FontSize="11" Foreground="#FF10B981"/>
                                                <TextBlock Text="Download" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind FormatMbps(ViewModel.DownloadSpeed), Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#FF10B981"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE898;" FontSize="11" Foreground="#FF8B5CF6"/>
                                                <TextBlock Text="Upload" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind FormatMbps(ViewModel.UploadSpeed), Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#FF8B5CF6"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Speed Test Action Button -->
                                <Button Click="OnSpeedTestClick" Style="{StaticResource VibrantPrimaryButtonStyle}" HorizontalAlignment="Stretch" Height="38" CornerRadius="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="12"/>
                                        <TextBlock Text="Start Speed Test" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Right: Hardware Network Interfaces Showcase -->
                        <Border Grid.Column="1" Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Hardware Network Interfaces" FontSize="14" FontWeight="Bold"/>
                                        <TextBlock Text="Physical network controllers and active IP routing" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#2010B981" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Ellipse Width="6" Height="6" Fill="#FF10B981"/>
                                            <TextBlock Text="Connected" FontSize="10.5" FontWeight="Bold" Foreground="#FF10B981"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Adapters, Mode=OneWay}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:NetworkAdapterInfo">
                                            <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="16,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Background="#208B5CF6" CornerRadius="8" Padding="10" Margin="0,0,14,0" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE701;" FontSize="18" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                            <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="14"/>
                                                            <Border Background="#2006B6D4" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind Speed}" FontSize="10.5" Foreground="#FF06B6D4" FontWeight="Bold"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,2,0,0">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <TextBlock Text="IPv4:" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                <TextBlock Text="{x:Bind IpAddress}" FontSize="11" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <TextBlock Text="MAC:" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                <TextBlock Text="{x:Bind MacAddress}" FontSize="11" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Background="{x:Bind StatusBadgeBg}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Status}" Foreground="{x:Bind StatusBadgeFg}" FontSize="11.5" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Bottom Row: Speed Test History & Quick Network Optimization Suite (Completely Fills the Page) -->
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Speed Test History Card -->
                        <Border Grid.Column="0" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,14">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE81C;" FontSize="13" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                    <TextBlock Text="Recent Speed Benchmark Results" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>

                                <ListView ItemsSource="{x:Bind ViewModel.SpeedTestHistory, Mode=OneWay}" SelectionMode="None" MaxHeight="120">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:SpeedTestResult">
                                            <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,6" Padding="10,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind TimeFormatted}" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind DownloadFormatted}" FontSize="11" FontWeight="Bold" Foreground="#FF10B981"/>
                                                        <TextBlock Text="{x:Bind UploadFormatted}" FontSize="11" FontWeight="Bold" Foreground="#FF8B5CF6"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="#2006B6D4" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind PingFormatted}" FontSize="10" FontWeight="Bold" Foreground="#FF06B6D4"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- 1-Click Quick Network Optimization Actions Strip -->
                        <Border Grid.Column="1" Style="{StaticResource GlassmorphismCardStyle}" Padding="18,14">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Quick Network Optimization Suite" FontSize="13.5" FontWeight="Bold"/>
                                        <TextBlock Text="Instant 1-click tools for DNS clearing, TCP stack renewal and adapter restart" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#208B5CF6" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Text="Instant Fixes" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                    </Border>
                                </Grid>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Quick Tool 1: Flush DNS -->
                                    <Button Grid.Column="0" Click="OnRepairClick" Tag="flushdns" Style="{StaticResource StandardSecondaryButtonStyle}" Height="40" HorizontalAlignment="Stretch" Padding="4,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                                            <TextBlock Text="Flush DNS" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Quick Tool 2: Reset TCP/IP -->
                                    <Button Grid.Column="1" Click="OnRepairClick" Tag="resettcp" Style="{StaticResource StandardSecondaryButtonStyle}" Height="40" HorizontalAlignment="Stretch" Padding="4,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE896;" FontSize="12"/>
                                            <TextBlock Text="Reset TCP/IP" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Quick Tool 3: Renew DHCP -->
                                    <Button Grid.Column="2" Click="OnRepairClick" Tag="renewdhcp" Style="{StaticResource StandardSecondaryButtonStyle}" Height="40" HorizontalAlignment="Stretch" Padding="4,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE8D7;" FontSize="12"/>
                                            <TextBlock Text="Renew DHCP" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Quick Tool 4: Benchmark DNS -->
                                    <Button Grid.Column="3" Click="OnDnsBenchmarkClick" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="40" HorizontalAlignment="Stretch" Padding="4,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xEC1B;" FontSize="12"/>
                                            <TextBlock Text="Optimize DNS" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ++++++++++++++++++++ TAB 2: DNS OPTIMIZER ++++++++++++++++++++ -->
            <ScrollViewer x:Name="SectionDns" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Spacing="14">

                    <!-- Active DNS Configuration Card -->
                    <Border Style="{StaticResource AuraGlassCardStyle}" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Background="{StaticResource CyberAccentGradient}" CornerRadius="8" Padding="6">
                                        <FontIcon Glyph="&#xEC1B;" FontSize="14" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="Active DNS Configuration" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Border Background="#2010B981" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentDnsText, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#FF10B981"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Lowest-latency DNS servers reduce web browsing lag and enhance anti-phishing protection." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Button Click="OnRepairClick" Tag="flushdns" Style="{StaticResource StandardSecondaryButtonStyle}" Height="36" Padding="14,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                                        <TextBlock Text="Flush Cache" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="OnDnsBenchmarkClick" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="36" Padding="16,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE768;" FontSize="12"/>
                                        <TextBlock Text="Benchmark All DNS" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- DNS Benchmark Results & Recommendation -->
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                <TextBlock Text="DNS Speed Benchmark Comparison" FontSize="14" FontWeight="Bold"/>
                                <Border Background="#208B5CF6" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Recommended:" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.FastestDnsText, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- DNS Server Benchmark List -->
                            <ListView ItemsSource="{x:Bind ViewModel.DnsServers, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:DnsServerInfo">
                                        <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="14,10">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Provider Name -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="13"/>
                                                    <TextBlock Text="{x:Bind Provider}" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                                </StackPanel>

                                                <!-- IP Endpoints -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{x:Bind PrimaryIp}" FontSize="11" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{x:Bind SecondaryIp}" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                                </StackPanel>

                                                <!-- Latency Gauge Bar -->
                                                <ProgressBar Grid.Column="2" Value="{x:Bind AverageQueryMs}" Maximum="150" Height="6" CornerRadius="3" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                                <!-- Response Time Badge -->
                                                <Border Grid.Column="3" Background="#208B5CF6" CornerRadius="6" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind LatencyFormatted}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                                </Border>

                                                <!-- Apply DNS Button -->
                                                <Button Grid.Column="4" Click="OnApplyDnsClick" Tag="{x:Bind}" Style="{StaticResource StandardSecondaryButtonStyle}" Height="32" Padding="12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Apply DNS" FontSize="11" FontWeight="SemiBold"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ++++++++++++++++++++ TAB 3: ACTIVE SOCKETS ++++++++++++++++++++ -->
            <ScrollViewer x:Name="SectionPorts" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Spacing="14">

                    <!-- Search & Actions Bar -->
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBox Text="{x:Bind ViewModel.ConnectionSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search by Process Name, IP address or Port..." Width="360" Height="34"/>
                                <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind FormatConnectionCount(ViewModel.Connections.Count), Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Click="OnRefreshConnectionsClick" Style="{StaticResource StandardSecondaryButtonStyle}" Height="34" Padding="14,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="11"/>
                                        <TextBlock Text="Refresh Sockets" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Active Sockets Table -->
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Table Header -->
                            <Grid Grid.Row="0" Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Process / PID" FontWeight="Bold" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <TextBlock Grid.Column="1" Text="Protocol" FontWeight="Bold" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <TextBlock Grid.Column="2" Text="Local Endpoint" FontWeight="Bold" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <TextBlock Grid.Column="3" Text="Remote Endpoint" FontWeight="Bold" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <TextBlock Grid.Column="4" Text="State" FontWeight="Bold" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </Grid>

                            <!-- Connection Rows ListView -->
                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Connections, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ActiveConnectionInfo">
                                        <Grid Padding="10,8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{x:Bind ProcessName}" FontWeight="Bold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind ProcessId}" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                            </StackPanel>

                                            <Border Grid.Column="1" Background="#208B5CF6" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Protocol}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                            </Border>

                                            <TextBlock Grid.Column="2" Text="{x:Bind LocalAddress}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="3" Text="{x:Bind RemoteAddress}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                            <Border Grid.Column="4" Background="{x:Bind StateBadgeBg}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind State}" FontSize="10" FontWeight="Bold" Foreground="{x:Bind StateBadgeFg}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ++++++++++++++++++++ TAB 4: REPAIR & DIAGNOSTICS SUITE ++++++++++++++++++++ -->
            <ScrollViewer x:Name="SectionRepairs" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Spacing="14">

                    <!-- 1-Click TCP/IP & Network Fix Tiles -->
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="2">
                                <TextBlock Text="1-Click TCP/IP &amp; Winsock Repair Suite" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="Instantly resolve DNS lookup failures, socket corruption, and IP lease timeouts." FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>

                            <!-- 3x2 Grid of Fix Tiles -->
                            <Grid RowSpacing="12" ColumnSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Fix 1: Reset TCP/IP -->
                                <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Reset TCP/IP Stack" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="Rebuilds TCP/IP registry configuration." FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        <Button Click="OnRepairClick" Tag="resettcp" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="34" HorizontalAlignment="Stretch" Padding="0,6">
                                            <TextBlock Text="Reset TCP/IP" FontSize="11.5" FontWeight="SemiBold"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Fix 2: Reset Winsock -->
                                <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Reset Winsock Catalog" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="Restores Windows Sockets API state." FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        <Button Click="OnRepairClick" Tag="resetwinsock" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="34" HorizontalAlignment="Stretch" Padding="0,6">
                                            <TextBlock Text="Reset Winsock" FontSize="11.5" FontWeight="SemiBold"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Fix 3: Renew DHCP Lease -->
                                <Border Grid.Row="0" Grid.Column="2" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Renew DHCP Lease" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="Re-requests IPv4/IPv6 from router." FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        <Button Click="OnRepairClick" Tag="renewdhcp" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="34" HorizontalAlignment="Stretch" Padding="0,6">
                                            <TextBlock Text="Renew Lease" FontSize="11.5" FontWeight="SemiBold"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Fix 4: Flush DNS & ARP -->
                                <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Flush DNS &amp; ARP Cache" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="Purges DNS &amp; MAC ARP cache." FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        <Button Click="OnRepairClick" Tag="flushdns" Style="{StaticResource StandardSecondaryButtonStyle}" Height="34" HorizontalAlignment="Stretch" Padding="0,6">
                                            <TextBlock Text="Flush Cache" FontSize="11.5" FontWeight="SemiBold"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Fix 5: Reset Network Adapters -->
                                <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Reset Network Adapters" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="Restarts NICs and clears buffers." FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        <Button Click="OnRepairClick" Tag="resetadapters" Style="{StaticResource StandardSecondaryButtonStyle}" Height="34" HorizontalAlignment="Stretch" Padding="0,6">
                                            <TextBlock Text="Reset Adapters" FontSize="11.5" FontWeight="SemiBold"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Fix 6: Repair Windows Firewall -->
                                <Border Grid.Row="1" Grid.Column="2" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Repair Firewall Rules" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="Restores Defender firewall rules." FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        <Button Click="OnRepairClick" Tag="repairfirewall" Style="{StaticResource StandardSecondaryButtonStyle}" Height="34" HorizontalAlignment="Stretch" Padding="0,6">
                                            <TextBlock Text="Repair Firewall" FontSize="11.5" FontWeight="SemiBold"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Diagnostic Terminal Console & Ping/Trace Tools -->
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" Text="{x:Bind ViewModel.TestHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Target host (e.g. 8.8.8.8, google.com)..." Height="36"/>
                                <Button Grid.Column="1" Click="OnPingClick" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="36" Padding="16,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="12"/>
                                        <TextBlock Text="Ping" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Click="OnTraceClick" Style="{StaticResource StandardSecondaryButtonStyle}" Height="36" Padding="16,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE756;" FontSize="12"/>
                                        <TextBlock Text="Traceroute" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Click="OnClearConsoleClick" Style="{StaticResource DefaultButtonStyle}" Height="36" Padding="12,0" ToolTipService.ToolTip="Clear Terminal Console">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                </Button>
                            </Grid>

                            <Border Background="{ThemeResource AppTerminalBackground}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Height="220">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                    <TextBlock Text="{x:Bind ViewModel.ConsoleOutput, Mode=OneWay}" FontFamily="Cascadia Code, Consolas, Courier New" FontSize="12" Foreground="{ThemeResource AppTerminalForeground}" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
