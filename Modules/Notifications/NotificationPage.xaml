<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.NotificationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:WinCarePro.Views"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    mc:Ignorable="d">

    <Page.Resources>
        <CollectionViewSource x:Name="GroupedNotificationsCVS" IsSourceGrouped="True" />
    </Page.Resources>

    <Grid Padding="20,14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutVisualStates">
                <!-- Wide Layout: Viewport Width >= 1050px -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1050" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- Medium Layout: Viewport Width >= 720px and < 1050px -->
                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- Narrow Layout: Viewport Width < 720px -->
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeroBentoGrid.(Grid.ColumnDefinitions)[1].Width" Value="0" />
                        <Setter Target="HeroBentoGrid.(Grid.ColumnDefinitions)[2].Width" Value="0" />
                        <Setter Target="CardOperations.Visibility" Value="Collapsed" />
                        <Setter Target="CardTelemetry.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Dynamic Header & Segmented Pill Deck -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Title & Subtitle with Badge -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="PageTitleTextBlock" Text="Notifications &amp; Activity Log" Style="{StaticResource PageHeaderTitleStyle}"/>
                        <Border Background="{ThemeResource AppBadgeNeutralBg}" BorderBrush="{ThemeResource AppBadgeNeutralBorder}" BorderThickness="1" CornerRadius="6" Padding="6,1.5" VerticalAlignment="Center">
                            <TextBlock Text="Aura Sentinel" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="PageSubtitleTextBlock" Text="System telemetry alerts, diagnostic logs &amp; operation records." Style="{StaticResource PageHeaderSubtitleStyle}"/>
                </StackPanel>
            </StackPanel>

            <!-- Center/Right: Segmented Tabs in a sleek compact pill deck -->
            <Border Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,10,0" Style="{StaticResource AuraGlassCardStyle}" Padding="3" CornerRadius="10"
                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="4.0" helpers:Animation3DHelper.DepthZ="8">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="BtnTabAlerts" Click="OnTabAlertsClick" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="32" Padding="14,0" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7BA;" FontSize="12.5"/>
                            <TextBlock Text="System Alerts" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnTabLogs" Click="OnTabLogsClick" Style="{StaticResource DefaultButtonStyle}" Height="32" Padding="14,0" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE81C;" FontSize="12.5"/>
                            <TextBlock Text="Activity History" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Quick Action Controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="HeaderRefreshBtn" Click="OnRefreshClick" Style="{StaticResource DefaultButtonStyle}" Height="34" Padding="12,0" CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}"/>
                        <TextBlock Text="Refresh" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Smart Hero Deck: 3-Card Bento Metric Grid -->
        <Grid x:Name="HeroBentoGrid" Grid.Row="1" Margin="0,0,0,12" ColumnSpacing="10" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Active Alerts Sentinel -->
            <Border x:Name="CardAlerts" Grid.Column="0" Style="{StaticResource AuraGlassCardStyle}" Padding="14,10" CornerRadius="12"
                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="3.0" helpers:Animation3DHelper.DepthZ="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="12" Background="{ThemeResource AppBadgeWarningBg}" BorderBrush="{ThemeResource AppBadgeWarningBorder}" BorderThickness="1">
                        <FontIcon Glyph="&#xE7BA;" FontSize="15" Foreground="{ThemeResource AppBadgeWarningFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Active Alerts" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="DeckAlertsCountText" Text="0" FontSize="18" FontWeight="ExtraBold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextFillColorPrimaryBrush}" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <Border Grid.Column="2" x:Name="DeckAlertsPill" Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                        <TextBlock x:Name="DeckAlertsPillText" Text="All clear" FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource AppBadgeGoodFg}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 2: Shield Operations Today -->
            <Border x:Name="CardOperations" Grid.Column="1" Style="{StaticResource AuraGlassCardStyle}" Padding="14,10" CornerRadius="12"
                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="3.0" helpers:Animation3DHelper.DepthZ="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="12" Background="#1810B981" BorderBrush="#3010B981" BorderThickness="1">
                        <FontIcon Glyph="&#xEA1F;" FontSize="15" Foreground="#FF10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Operations Today" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="DeckOperationsCountText" Text="0" FontSize="18" FontWeight="ExtraBold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextFillColorPrimaryBrush}" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="6" Height="6" Fill="#FF10B981" VerticalAlignment="Center"/>
                            <TextBlock Text="Sentinel Active" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 3: Live Telemetry Pulse -->
            <Border x:Name="CardTelemetry" Grid.Column="2" Style="{StaticResource AuraGlassCardStyle}" Padding="14,10" CornerRadius="12"
                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="3.0" helpers:Animation3DHelper.DepthZ="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="12" Background="#183B82F6" BorderBrush="#303B82F6" BorderThickness="1">
                        <FontIcon Glyph="&#xE916;" FontSize="15" Foreground="#FF3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Live Telemetry Pulse" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="DeckRecentPulseText" Text="Just Now" FontSize="13.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Typography.NumeralAlignment="Tabular" AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock x:Name="DeckRecentModuleText" Text="• System Idle" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <!-- SECTION 1: SYSTEM NOTIFICATIONS & ALERTS -->
            <Grid x:Name="SectionAlerts" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Alert Controls Filter Bar -->
                <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}" Padding="10,6" CornerRadius="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <TextBox x:Name="NotificationSearchBox" PlaceholderText="Search alerts by title or description..." TextChanged="OnNotificationSearchChanged" VerticalAlignment="Center" Height="32" CornerRadius="6" FontSize="12" AutomationProperties.Name="Search Alerts"/>
                        
                        <ComboBox x:Name="NotificationLevelFilter" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnNotificationFilterChanged" SelectedIndex="0" VerticalAlignment="Center" Height="32" CornerRadius="6" FontSize="12" AutomationProperties.Name="Filter by Alert Level">
                            <ComboBoxItem x:Name="LevelAllItem" Content="All Levels" Tag="All"/>
                            <ComboBoxItem x:Name="LevelInfoItem" Content="Info" Tag="Info"/>
                            <ComboBoxItem x:Name="LevelWarningItem" Content="Warning" Tag="Warning"/>
                            <ComboBoxItem x:Name="LevelCriticalItem" Content="Critical" Tag="Critical"/>
                        </ComboBox>
                        
                        <Button x:Name="BtnMarkAllRead" Grid.Column="2" Content="Mark All Read" Click="OnMarkAllReadClick" Style="{StaticResource DefaultButtonStyle}" VerticalAlignment="Center" Padding="12,0" Height="32" CornerRadius="6" FontSize="12" AutomationProperties.Name="Mark All Read"/>
                        <Button x:Name="ClearAlertsBtn" Grid.Column="3" Content="Clear All Alerts" Click="OnClearNotificationsClick" Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center" Padding="12,0" Height="32" CornerRadius="6" FontSize="12" AutomationProperties.Name="Clear All Alerts" AutomationProperties.HelpText="Permanently purge all notifications and alerts from history."/>
                    </Grid>
                </Border>

                <!-- System Notifications List -->
                <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}" Padding="10" CornerRadius="12">
                    <Grid>
                        <ListView x:Name="NotificationsListView" ItemsSource="{x:Bind GroupedNotificationsCVS.View, Mode=OneWay}" SelectionMode="None">
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Grid Padding="6,10,6,6">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource PrimaryAccentBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,3,0,6" Padding="14,12" CornerRadius="12"
                                            Background="{ThemeResource AppCardBackground}"
                                            BorderBrush="{ThemeResource AppCardBorder}"
                                            BorderThickness="1"
                                            helpers:Animation3DHelper.Is3DTiltEnabled="True"
                                            helpers:Animation3DHelper.MaxTiltAngle="2.0"
                                            helpers:Animation3DHelper.DepthZ="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Glowing Status Icon -->
                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="{Binding LevelBadgeBg}" BorderBrush="{Binding LevelBrush}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <FontIcon Glyph="{Binding LevelGlyph}" FontSize="13" Foreground="{Binding LevelColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Title & Message -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" AutomationProperties.Name="{Binding Title}"/>
                                                    <!-- Source Tag -->
                                                    <Border Background="{ThemeResource AppBadgeNeutralBg}" BorderBrush="{ThemeResource AppBadgeNeutralBorder}" BorderThickness="1" CornerRadius="5" Padding="6,1.5" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Source}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AppBadgeNeutralFg}"/>
                                                    </Border>
                                                    <!-- NEW Badge with 3D Glow -->
                                                    <Border Visibility="{Binding UnreadVisibility}" Background="#FFEF4444" CornerRadius="5" Padding="6,1.5" VerticalAlignment="Center">
                                                        <TextBlock Text="NEW" FontSize="9" FontWeight="ExtraBold" Foreground="White"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="17"/>
                                            </StackPanel>

                                            <!-- Contextual Quick Action Button -->
                                            <Button Grid.Column="2" Click="OnQuickActionClick" DataContext="{Binding}" Visibility="{Binding QuickActionVisibility}"
                                                    Style="{StaticResource VibrantPrimaryButtonStyle}" Height="30" Padding="10,0" CornerRadius="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <FontIcon Glyph="{Binding QuickActionGlyph}" FontSize="11.5"/>
                                                    <TextBlock Text="{Binding QuickActionText}" FontSize="11.5" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Relative Timestamp -->
                                            <TextBlock Grid.Column="3" Text="{Binding RelativeTimeAgo}" ToolTipService.ToolTip="{Binding CreatedAtFormatted}" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" Margin="0,0,12,0" Typography.NumeralAlignment="Tabular"/>

                                            <!-- Action: Delete button -->
                                            <Button Grid.Column="4" Click="OnDeleteSingleNotificationClick" DataContext="{Binding}" Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Width="30" Height="30" CornerRadius="15" VerticalAlignment="Center" ToolTipService.ToolTip="Delete Notification" AutomationProperties.Name="Delete Notification">
                                                <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="#FFEF4444"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
                
                <!-- Empty State (Cyber Zen Shield) -->
                <StackPanel x:Name="NotificationsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Visibility="Collapsed" Margin="0,40,0,40">
                    <Border Width="72" Height="72" CornerRadius="36" Background="#1510B981" BorderBrush="#3010B981" BorderThickness="1.5" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="32" Foreground="#FF10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="NotificationsEmptyText" Text="All clear! No active system alerts." FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="WinCare Pro Sentinel is continuously monitoring your system health." FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- SECTION 2: ACTIVITY LOGS & OPERATIONS TIMELINE -->
            <Grid x:Name="SectionLogs" Visibility="Collapsed" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Filters Bar (Compact 34px) -->
                <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}" Padding="10,6" CornerRadius="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <TextBox x:Name="SearchBox" PlaceholderText="Search logs by action or status..." TextChanged="OnSearchChanged" VerticalAlignment="Center" Height="32" CornerRadius="6" FontSize="12"/>
                        
                        <ComboBox x:Name="ModuleFilter" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnFilterChanged" SelectedIndex="0" VerticalAlignment="Center" Height="32" CornerRadius="6" FontSize="12">
                            <ComboBoxItem x:Name="ModAllItem" Content="All Modules" Tag="All" IsSelected="True"/>
                            <ComboBoxItem x:Name="ModDashItem" Content="Dashboard" Tag="Dashboard"/>
                            <ComboBoxItem x:Name="ModJunkItem" Content="Junk Cleaner" Tag="Junk Cleaner"/>
                            <ComboBoxItem x:Name="ModRegItem" Content="Registry Cleaner" Tag="Registry Cleaner"/>
                            <ComboBoxItem x:Name="ModStartItem" Content="Startup Manager" Tag="Startup Manager"/>
                            <ComboBoxItem x:Name="ModDiskItem" Content="Disk Analyzer" Tag="Disk Analyzer"/>
                            <ComboBoxItem x:Name="ModNetItem" Content="Network Service" Tag="Network Service"/>
                            <ComboBoxItem x:Name="ModSecItem" Content="Security Shield" Tag="Security Shield"/>
                            <ComboBoxItem x:Name="ModUninstItem" Content="Uninstaller" Tag="Uninstaller"/>
                            <ComboBoxItem x:Name="ModDrvItem" Content="Driver Manager" Tag="Driver Manager"/>
                            <ComboBoxItem x:Name="ModOptItem" Content="System Optimizer" Tag="System Optimizer"/>
                            <ComboBoxItem x:Name="ModRepItem" Content="Repair Tools" Tag="Repair Tools"/>
                        </ComboBox>
                        
                        <Button x:Name="RefreshLogsBtn" Grid.Column="2" Content="Refresh" Click="OnRefreshClick" VerticalAlignment="Center" Height="32" Padding="12,0" CornerRadius="6" FontSize="12"/>
                        <Button x:Name="ClearLogsBtn" Grid.Column="3" Content="Clear Logs" Click="OnClearOldLogsClick" Style="{StaticResource DefaultButtonStyle}" VerticalAlignment="Center" Height="32" Padding="12,0" CornerRadius="6" FontSize="12"/>
                        <Button x:Name="ExportLogsBtn" Grid.Column="4" Content="Export Logs" Click="OnExportLogsClick" Style="{StaticResource VibrantPrimaryButtonStyle}" VerticalAlignment="Center" Height="32" Padding="12,0" CornerRadius="6" FontSize="12"/>
                    </Grid>
                </Border>

                <!-- Logs List / Timeline -->
                <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}" Padding="10" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Static Header Grid -->
                        <Grid Grid.Row="0" Padding="12,8" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ColHeaderAction" Grid.Column="1" Text="Action / Operation" FontWeight="Bold" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ColHeaderModule" Grid.Column="2" Text="Module" FontWeight="Bold" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ColHeaderStatus" Grid.Column="3" Text="Status" FontWeight="Bold" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ColHeaderTime" Grid.Column="4" Text="Time Logged" FontWeight="Bold" Style="{ThemeResource CaptionTextBlockStyle}" HorizontalAlignment="Right" TextWrapping="Wrap" />
                        </Grid>

                        <ListView x:Name="LogsListView" Grid.Row="1" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,2" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="160" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Icon Node -->
                                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="8" Background="{Binding StatusTintBrush}" BorderBrush="{Binding StatusBrush}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <FontIcon Glyph="{Binding StatusGlyph}" FontSize="12" Foreground="{Binding StatusBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Action}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Module}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        </Border>
                                        
                                        <Border Grid.Column="3" Background="{Binding StatusTintBrush}" BorderBrush="{Binding StatusBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusBrush}"/>
                                        </Border>

                                        <StackPanel Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RelativeTimeAgo}" ToolTipService.ToolTip="{Binding CreatedAtFormatted}" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                            <TextBlock Text="{Binding CreatedAtFormatted}" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        
                        <!-- Activity Log Empty State -->
                        <StackPanel x:Name="LogsEmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Visibility="Collapsed" Margin="0,40,0,40">
                            <Border Width="72" Height="72" CornerRadius="36" Background="#158B5CF6" BorderBrush="#308B5CF6" BorderThickness="1.5" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE9D9;" FontSize="32" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="LogsEmptyText" Text="No activity logs found." FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="System optimizations and actions will appear here in chronological order." FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>

