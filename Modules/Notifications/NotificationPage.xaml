<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.NotificationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:WinCarePro.Views"
    mc:Ignorable="d">

    <Page.Resources>
        <CollectionViewSource x:Name="GroupedNotificationsCVS" IsSourceGrouped="True" />
    </Page.Resources>

    <Grid Padding="24,20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Background="{StaticResource CyberAccentGradient}" CornerRadius="10" Padding="8">
                        <FontIcon Glyph="&#xEA8F;" FontSize="20" Foreground="White"/>
                    </Border>
                    <TextBlock x:Name="PageTitleTextBlock" Text="Notifications &amp; Activity Log" Style="{StaticResource PageHeaderTitleStyle}" VerticalAlignment="Center"/>
                    <Border Background="{ThemeResource AppBadgeNeutralBg}" BorderBrush="{ThemeResource AppBadgeNeutralBorder}" BorderThickness="1" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="6" Height="6" Fill="{ThemeResource AppBadgeGoodFg}"/>
                            <TextBlock Text="Live Telemetry Sentinel" FontSize="11" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="PageSubtitleTextBlock" Text="Review real-time system alerts, critical health warnings, and background optimization history." Style="{StaticResource PageHeaderSubtitleStyle}"/>
            </StackPanel>

            <!-- Quick Action: Refresh -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="HeaderRefreshBtn" Click="OnRefreshClick" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="36" Padding="14,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" Foreground="White"/>
                        <TextBlock Text="Refresh Logs" FontSize="12.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Segmented Tab Bar -->
        <Border Grid.Row="1" Style="{StaticResource AuraGlassCardStyle}" Padding="6" Margin="0,0,0,18">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnTabAlerts" Grid.Column="0" Content="System Alerts &amp; Advisories" Click="OnTabAlertsClick" Style="{StaticResource VibrantPrimaryButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8" FontWeight="Bold" Padding="0,10"/>
                <Button x:Name="BtnTabLogs" Grid.Column="1" Content="Operations &amp; Optimization Timeline" Click="OnTabLogsClick" Style="{StaticResource DefaultButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8" FontWeight="SemiBold" Padding="0,10"/>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            
            <!-- SECTION 1: SYSTEM ALERTS -->
            <Grid x:Name="SectionAlerts" Visibility="Visible" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Alert Controls Filter Bar -->
                <Border Grid.Row="0" Style="{StaticResource GlassmorphismCardStyle}" Padding="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <TextBox x:Name="NotificationSearchBox" PlaceholderText="Search alerts by title or description..." TextChanged="OnNotificationSearchChanged" VerticalAlignment="Center" Height="34" CornerRadius="6"/>
                        
                        <ComboBox x:Name="NotificationLevelFilter" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnNotificationFilterChanged" SelectedIndex="0" VerticalAlignment="Center" Height="34" CornerRadius="6">
                            <ComboBoxItem x:Name="LevelAllItem" Content="All Levels" Tag="All"/>
                            <ComboBoxItem x:Name="LevelInfoItem" Content="Info" Tag="Info"/>
                            <ComboBoxItem x:Name="LevelWarningItem" Content="Warning" Tag="Warning"/>
                            <ComboBoxItem x:Name="LevelCriticalItem" Content="Critical" Tag="Critical"/>
                        </ComboBox>
                        
                        <Button x:Name="ClearAlertsBtn" Grid.Column="2" Content="Clear All Alerts" Click="OnClearNotificationsClick" Style="{StaticResource DefaultButtonStyle}" VerticalAlignment="Center" Padding="16,6" CornerRadius="6"/>
                    </Grid>
                </Border>

                <!-- System Notifications List -->
                <Border Grid.Row="1" Style="{StaticResource GlassmorphismCardStyle}" Padding="14">
                    <Grid>
                        <ListView x:Name="NotificationsListView" ItemsSource="{x:Bind GroupedNotificationsCVS.View, Mode=OneWay}" SelectionMode="None">
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Grid Padding="6,12,6,6">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryAccentBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,3" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="16,12" Margin="0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Status Indicator -->
                                            <Border Background="{Binding LevelBrush}" CornerRadius="3" Width="5" Height="38" Margin="0,0,16,0" VerticalAlignment="Center"/>

                                            <!-- Text Stack -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
                                                    <!-- NEW Badge -->
                                                    <Border Visibility="{Binding UnreadVisibility}" Background="#FFEF4444" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="NEW" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Message}" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                            </StackPanel>

                                            <!-- Timestamp -->
                                            <TextBlock Grid.Column="2" Text="{Binding CreatedAtFormatted}" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                            <!-- Action: Delete button -->
                                            <Button Grid.Column="3" Click="OnDeleteSingleNotificationClick" DataContext="{Binding}" Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Width="30" Height="30" CornerRadius="15" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="#FFEF4444"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        
                        <!-- Empty State -->
                        <StackPanel x:Name="NotificationsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Visibility="Collapsed" Margin="0,40,0,40">
                            <Border Width="64" Height="64" CornerRadius="32" Background="#2010B981" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE73E;" FontSize="28" Foreground="#FF10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="NotificationsEmptyText" Text="All clear! No active system alerts." FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="WinCare Sentinel is actively monitoring system health in the background." FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- SECTION 2: ACTIVITY LOGS & OPERATIONS TIMELINE -->
            <Grid x:Name="SectionLogs" Visibility="Collapsed" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Filters -->
                <Border Grid.Row="0" Style="{StaticResource GlassmorphismCardStyle}" Padding="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <TextBox x:Name="SearchBox" PlaceholderText="Search logs by action or status..." TextChanged="OnSearchChanged" VerticalAlignment="Center" Height="34" CornerRadius="6"/>
                        
                        <ComboBox x:Name="ModuleFilter" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnFilterChanged" SelectedIndex="0" VerticalAlignment="Center" Height="34" CornerRadius="6">
                            <ComboBoxItem x:Name="ModAllItem" Content="All Modules" Tag="All" IsSelected="True"/>
                            <ComboBoxItem x:Name="ModDashItem" Content="Dashboard" Tag="Dashboard"/>
                            <ComboBoxItem x:Name="ModJunkItem" Content="Junk Cleaner" Tag="Junk Cleaner"/>
                            <ComboBoxItem x:Name="ModRegItem" Content="Registry Cleaner" Tag="Registry Cleaner"/>
                            <ComboBoxItem x:Name="ModStartItem" Content="Startup Manager" Tag="Startup Manager"/>
                            <ComboBoxItem x:Name="ModDiskItem" Content="Disk Analyzer" Tag="Disk Analyzer"/>
                            <ComboBoxItem x:Name="ModNetItem" Content="Network Service" Tag="Network Service"/>
                            <ComboBoxItem x:Name="ModSecItem" Content="Security Shield" Tag="Security Shield"/>
                            <ComboBoxItem x:Name="ModUninstItem" Content="Uninstaller" Tag="Uninstaller"/>
                            <ComboBoxItem x:Name="ModDrvItem" Content="Driver Manager" Tag="Driver Manager"/>
                            <ComboBoxItem x:Name="ModOptItem" Content="System Optimizer" Tag="System Optimizer"/>
                            <ComboBoxItem x:Name="ModRepItem" Content="Repair Tools" Tag="Repair Tools"/>
                        </ComboBox>
                        
                        <Button x:Name="RefreshLogsBtn" Grid.Column="2" Content="Refresh" Click="OnRefreshClick" VerticalAlignment="Center" Height="34" Padding="14,0" CornerRadius="6"/>
                        <Button x:Name="ClearLogsBtn" Grid.Column="3" Content="Clear Logs" Click="OnClearOldLogsClick" Style="{StaticResource DefaultButtonStyle}" VerticalAlignment="Center" Height="34" Padding="14,0" CornerRadius="6"/>
                        <Button x:Name="ExportLogsBtn" Grid.Column="4" Content="Export Logs" Click="OnExportLogsClick" Style="{StaticResource VibrantPrimaryButtonStyle}" VerticalAlignment="Center" Height="34" Padding="14,0" CornerRadius="6"/>
                    </Grid>
                </Border>

                <!-- Logs List -->
                <Border Grid.Row="1" Style="{StaticResource GlassmorphismCardStyle}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Static Header Grid -->
                        <Grid Grid.Row="0" Padding="12,8" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ColHeaderAction" Grid.Column="1" Text="Action / Operation" FontWeight="Bold" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ColHeaderModule" Grid.Column="2" Text="Module" FontWeight="Bold" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ColHeaderStatus" Grid.Column="3" Text="Status" FontWeight="Bold" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ColHeaderTime" Grid.Column="4" Text="Time Logged" FontWeight="Bold" Style="{ThemeResource CaptionTextBlockStyle}" HorizontalAlignment="Right" TextWrapping="Wrap" />
                        </Grid>

                        <ListView x:Name="LogsListView" Grid.Row="1" SelectionMode="None">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <AddDeleteThemeTransition />
                                    <RepositionThemeTransition />
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="6,10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Indicator -->
                                        <Border Background="{Binding StatusBrush}" CornerRadius="3" Width="5" Height="22" Margin="0,0,14,0" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Action}" FontWeight="Bold" FontSize="13.5"/>
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Module}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        </Border>
                                        
                                        <TextBlock Grid.Column="3" Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding CreatedAtFormatted}" FontSize="11.5" FontFamily="Consolas" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        
                        <!-- Activity Log Empty State -->
                        <StackPanel x:Name="LogsEmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Visibility="Collapsed" Margin="0,40,0,40">
                            <Border Width="64" Height="64" CornerRadius="32" Background="#208B5CF6" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE9D9;" FontSize="28" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="LogsEmptyText" Text="No activity logs found." FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="System optimizations and actions will appear here in chronological order." FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
