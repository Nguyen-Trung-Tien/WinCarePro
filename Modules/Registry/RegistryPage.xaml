<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.RegistryPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinCarePro.Models"
    xmlns:vm="using:WinCarePro.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel Spacing="4">
                <TextBlock Text="Registry Center" FontSize="26" FontWeight="ExtraBold" CharacterSpacing="-0.5" />
                <TextBlock Text="Safely backup, restore registry hives, and access the official Windows Registry Editor." FontSize="13" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCol" Width="*" />
                <ColumnDefinition x:Name="RightCol" Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Left: Registry Editor Redirect (replaces Registry Cleaner) -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">

                    <!-- Warning/Info Banner -->
                    <Border Background="#15F59E0B" BorderBrush="#30F59E0B" BorderThickness="1" CornerRadius="12" Padding="20">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="22" Background="#25F59E0B" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7BA;" FontSize="20" Foreground="#FFF59E0B"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Registry Cleaner tools are not recommended" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="Microsoft advises against using third-party registry cleaners. Incorrect registry changes can cause system instability. Use the official Registry Editor (regedit) for manual edits, or create a backup first." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" LineHeight="18"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Open Registry Editor -->
                    <Border Style="{StaticResource NeonGlowBorderStyle}" Padding="20">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="10" Background="#15EDA20E">
                                <FontIcon Glyph="&#xEDA2;" FontSize="20" Foreground="#FFEDA20E"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Registry Editor (regedit)" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="Official Windows tool to browse, search, edit, and export registry keys. Always create a backup before making changes." FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Open →" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" VerticalAlignment="Center" Click="OnOpenRegeditClick" CornerRadius="8" Padding="16,8"/>
                        </Grid>
                    </Border>

                    <!-- Open System Restore -->
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="10" Background="#158B5CF6">
                                <FontIcon Glyph="&#xE7A7;" FontSize="20" Foreground="#FF8B5CF6"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="System Restore (rstrui)" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="Roll back Windows to a previous restore point if a registry or system change causes problems." FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Open →" VerticalAlignment="Center" Click="OnOpenSystemRestoreClick" CornerRadius="8" Padding="16,8"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>


            <!-- Right: Backup & Restore -->
            <Border x:Name="RightPanel" Grid.Column="1" Style="{StaticResource GlassmorphismCardStyle}" Padding="20" Visibility="{Binding ElementName=PageRoot, Path=WideLayoutVisibility}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Registry Backup &amp; Restore" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />
                    
                    <Button Grid.Row="1" Content="Create Full Backup" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" Margin="0,0,0,20" Click="OnCreateBackupClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" />

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Backup History" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Margin="0,0,0,10" />
                        
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Backups, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:RegistryBackupItem">
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Padding="8,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="12.5" />
                                                <TextBlock Text="{x:Bind FilePath}" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>


