<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.SecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinCarePro.ViewModels"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    xmlns:components="using:WinCarePro.Shared.Components"
    mc:Ignorable="d">

    <Grid Padding="24,18" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutVisualStates">
                <!-- Wide Layout: Viewport Width >= 960px -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="960" />
                    </VisualState.StateTriggers>
                </VisualState>

                <!-- Narrow Layout: Viewport Width < 960px -->
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PrivLeftPanel.(Grid.Row)" Value="0" />
                        <Setter Target="PrivLeftPanel.(Grid.Column)" Value="0" />
                        <Setter Target="PrivLeftPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="PrivLeftPanel.(Grid.RowSpan)" Value="1" />
                        <Setter Target="PrivRightPanel.(Grid.Row)" Value="1" />
                        <Setter Target="PrivRightPanel.(Grid.Column)" Value="0" />
                        <Setter Target="PrivRightPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="PrivRightPanel.(Grid.RowSpan)" Value="1" />
                        <Setter Target="StatCol0.Width" Value="*" />
                        <Setter Target="StatCol1.Width" Value="*" />
                        <Setter Target="StatCol2.Width" Value="0" />
                        <Setter Target="StatCol3.Width" Value="0" />
                        <Setter Target="StatCard0.(Grid.Row)" Value="0" />
                        <Setter Target="StatCard0.(Grid.Column)" Value="0" />
                        <Setter Target="StatCard1.(Grid.Row)" Value="0" />
                        <Setter Target="StatCard1.(Grid.Column)" Value="1" />
                        <Setter Target="StatCard2.(Grid.Row)" Value="1" />
                        <Setter Target="StatCard2.(Grid.Column)" Value="0" />
                        <Setter Target="StatCard3.(Grid.Row)" Value="1" />
                        <Setter Target="StatCard3.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="20" />
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0. Modern Header -->
            <RowDefinition Height="Auto" /> <!-- 1. 4-Card Stat Ribbon -->
            <RowDefinition Height="*" />    <!-- 2. Main Body Pivots -->
            <RowDefinition Height="Auto" /> <!-- 3. Status Footer -->
        </Grid.RowDefinitions>

        <!-- ==================== 0. MODERN HEADER ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Title & Subtitle with Gradient Icon Badge -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Style="{StaticResource PageHeaderIconBadgeStyle}" Background="{StaticResource PrimaryAccentGradient}">
                    <FontIcon Glyph="&#xE727;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Security &amp; Privacy Shield" Style="{StaticResource PageHeaderTitleStyle}" />
                    <TextBlock Text="Hardware trust, credential safety &amp; privacy." Style="{StaticResource PageHeaderSubtitleStyle}" />
                </StackPanel>
            </StackPanel>

            <!-- Right: Scan Now Button -->
            <Button Grid.Column="1" Click="OnScanSecurityClick" IsEnabled="{x:Bind IsNot(ViewModel.IsScanning), Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" CornerRadius="8" Padding="16,7" FontWeight="Bold" FontSize="12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsScanning, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" Width="13" Height="13" Foreground="White" VerticalAlignment="Center" />
                    <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="White" Visibility="{x:Bind ViewModel.IsScanning, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}" />
                    <TextBlock Text="Scan Security" FontWeight="Bold" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ==================== 1. 4-CARD FROSTED STAT RIBBON ==================== -->
        <Grid x:Name="StatRibbonGrid" Grid.Row="1" Margin="0,0,0,14" ColumnSpacing="12" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="StatRow0" Height="Auto" />
                <RowDefinition x:Name="StatRow1" Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="StatCol0" Width="*" />
                <ColumnDefinition x:Name="StatCol1" Width="*" />
                <ColumnDefinition x:Name="StatCol2" Width="*" />
                <ColumnDefinition x:Name="StatCol3" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 0: Security Health Score -->
            <Border x:Name="StatCard0" Grid.Row="0" Grid.Column="0" Style="{StaticResource QuickStatCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Ellipse Stroke="{StaticResource PrimaryAccentGradient}" StrokeThickness="3" Opacity="0.25" />
                        <ProgressRing Value="{x:Bind ViewModel.SecurityScore, Mode=OneWay}" Width="38" Height="38" 
                                      Foreground="{StaticResource PrimaryAccentBrush}" Background="Transparent" />
                        <TextBlock Text="{x:Bind ViewModel.SecurityScore, Mode=OneWay}" 
                                   FontSize="13" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource PrimaryAccentBrush}" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Security Health Score" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <Border Style="{StaticResource StatusBadgeGoodStyle}" HorizontalAlignment="Left">
                            <TextBlock Text="SECURE" FontSize="9.5" FontWeight="ExtraBold" Foreground="#FF10B981" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 1: Firewall Status -->
            <Border x:Name="StatCard1" Grid.Row="0" Grid.Column="1" Style="{StaticResource QuickStatCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{StaticResource PrimaryAccentLightBrush}" BorderBrush="{StaticResource PrimaryAccentBorderBrush}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE83D;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Windows Firewall" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.FirewallStatusText, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 2: Antivirus Protection -->
            <Border x:Name="StatCard2" Grid.Row="0" Grid.Column="2" Style="{StaticResource QuickStatCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="#2010B981" BorderBrush="#5010B981" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73A;" FontSize="16" Foreground="#FF10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Antivirus Shield" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.AntivirusStatus, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 3: Hardware Trust -->
            <Border x:Name="StatCard3" Grid.Row="0" Grid.Column="3" Style="{StaticResource QuickStatCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="#203B82F6" BorderBrush="#503B82F6" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE950;" FontSize="16" Foreground="#FF3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Hardware Trust" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TpmStatusText, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 2. MAIN BODY PIVOTS ==================== -->
        <Pivot Grid.Row="2" Margin="0,-6,0,0">
            <Pivot.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,8,0" />
                </DataTemplate>
            </Pivot.HeaderTemplate>

            <!-- ==================== TAB 1: SECURITY CENTER ==================== -->
            <PivotItem Header="Security Center">
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="0,16,16,16" Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch">

                            <!-- Section Title: Core Management Tools -->
                            <TextBlock Text="Management Tools" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,0,-4"/>

                            <!-- 2x2 Grid of Core Security & Diagnostic Tools -->
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Tool 1: Windows Security -->
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,14">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="12" Background="#1510B981" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE73A;" FontSize="20" Foreground="#FF10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="Windows Security" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="Threat protection &amp; firewall." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Open →" Style="{StaticResource DefaultButtonStyle}" VerticalAlignment="Center" Click="OnOpenWindowsSecurityClick" CornerRadius="7" Padding="12,5" FontSize="11"/>
                                    </Grid>
                                </Border>

                                <!-- Tool 2: System Information (msinfo32) -->
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,14">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="12" Background="#153B82F6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7EF;" FontSize="20" Foreground="#FF3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="System Info" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="Hardware, BIOS &amp; drivers." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Open →" Style="{StaticResource DefaultButtonStyle}" VerticalAlignment="Center" Click="OnOpenMsinfoClick" CornerRadius="7" Padding="12,5" FontSize="11"/>
                                    </Grid>
                                </Border>

                                <!-- Tool 3: Windows Update Manager -->
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,14">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="12" Background="#158B5CF6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE895;" FontSize="20" Foreground="#FF8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="Windows Update" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="Patches &amp; security updates." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Open →" Style="{StaticResource DefaultButtonStyle}" VerticalAlignment="Center" Click="OnOpenWindowsUpdateClick" CornerRadius="7" Padding="12,5" FontSize="11"/>
                                    </Grid>
                                </Border>

                                <!-- Tool 4: Task Manager Monitor -->
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,14">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="12" Background="#15F59E0B" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE9D9;" FontSize="20" Foreground="#FFF59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="Task Manager" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="CPU/RAM load &amp; processes." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Open →" Style="{StaticResource DefaultButtonStyle}" VerticalAlignment="Center" Click="OnOpenTaskManagerClick" CornerRadius="7" Padding="12,5" FontSize="11"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Section Title: Advanced Management Consoles -->
                            <TextBlock Text="Management Consoles" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,4,0,-6"/>

                            <!-- 2x2 Grid of Advanced Consoles -->
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Tool 5: Advanced Firewall -->
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,14">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="12" Background="#1506B6D4" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE83D;" FontSize="20" Foreground="#FF06B6D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="Firewall Rules" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="Inbound &amp; outbound rules." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Open →" Style="{StaticResource DefaultButtonStyle}" VerticalAlignment="Center" Click="OnOpenFirewallClick" CornerRadius="7" Padding="12,5" FontSize="11"/>
                                    </Grid>
                                </Border>

                                <!-- Tool 6: Event Viewer Security Logs -->
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,14">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="12" Background="#15EC4899" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="20" Foreground="#FFEC4899" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="Event Viewer" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="Audit events &amp; system logs." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Open →" Style="{StaticResource DefaultButtonStyle}" VerticalAlignment="Center" Click="OnOpenEventViewerClick" CornerRadius="7" Padding="12,5" FontSize="11"/>
                                    </Grid>
                                </Border>

                                <!-- Tool 7: Windows Services Manager -->
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,14">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="12" Background="#156366F1" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE713;" FontSize="20" Foreground="#FF6366F1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="Windows Services" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="Background services control." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Open →" Style="{StaticResource DefaultButtonStyle}" VerticalAlignment="Center" Click="OnOpenServicesClick" CornerRadius="7" Padding="12,5" FontSize="11"/>
                                    </Grid>
                                </Border>

                                <!-- Tool 8: Windows Registry Editor -->
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,14">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="12" Background="#1514B8A6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE946;" FontSize="20" Foreground="#FF14B8A6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="Registry Editor" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="System configuration hives &amp; keys." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Open →" Style="{StaticResource DefaultButtonStyle}" VerticalAlignment="Center" Click="OnOpenRegistryEditorClick" CornerRadius="7" Padding="12,5" FontSize="11"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Active Security Alerts & Audits Section -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Security Alerts" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                
                                <ListView ItemsSource="{x:Bind ViewModel.SecurityAlerts, Mode=OneWay}" SelectionMode="None" ItemContainerStyle="{StaticResource ModernCardListViewItemStyle}">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsStackPanel />
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="12,8" Margin="0,0,0,4">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE783;" Foreground="#FFEF4444" FontSize="15" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind}" FontSize="11.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </PivotItem>

            <!-- ==================== TAB 2: PRIVACY TUNING ==================== -->
            <PivotItem Header="Privacy Tuning">
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="0,16,16,16" Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid ColumnSpacing="16" RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" x:Name="PrivCol0" />
                                <ColumnDefinition Width="340" x:Name="PrivCol1" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Privacy Controls & Anti-Telemetry Toggles -->
                            <StackPanel x:Name="PrivLeftPanel" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Spacing="10">
                                <TextBlock Text="Telemetry &amp; Privacy" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>

                                <!-- Diagnostic Telemetry -->
                                <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" Spacing="2">
                                            <TextBlock Text="Diagnostic Telemetry" FontWeight="Bold" FontSize="12.5" />
                                            <TextBlock Text="Send diagnostic data to Microsoft." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <components:LoadingToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.TelemetryEnabled, Mode=TwoWay}" Toggled="OnTelemetryToggled" VerticalAlignment="Center" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" />
                                    </Grid>
                                </Border>

                                <!-- Advertising ID -->
                                <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" Spacing="2">
                                            <TextBlock Text="Advertising ID" FontWeight="Bold" FontSize="12.5" />
                                            <TextBlock Text="App tracking &amp; targeted ads." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <components:LoadingToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AdvertisingIdEnabled, Mode=TwoWay}" Toggled="OnAdvertisingIdToggled" VerticalAlignment="Center" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" />
                                    </Grid>
                                </Border>

                                <!-- Clipboard History -->
                                <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" Spacing="2">
                                            <TextBlock Text="Clipboard History" FontWeight="Bold" FontSize="12.5" />
                                            <TextBlock Text="Cache copied items and credentials." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <components:LoadingToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ClipboardHistoryEnabled, Mode=TwoWay}" Toggled="OnClipboardToggled" VerticalAlignment="Center" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" />
                                    </Grid>
                                </Border>

                                <!-- Input Tracking -->
                                <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" Spacing="2">
                                            <TextBlock Text="Input &amp; Typing Tracking" FontWeight="Bold" FontSize="12.5" />
                                            <TextBlock Text="Log typing history &amp; input telemetry." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <components:LoadingToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.InputTrackingEnabled, Mode=TwoWay}" Toggled="OnInputTrackingToggled" VerticalAlignment="Center" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Right: Activity Trace Cleaning Card -->
                            <Grid x:Name="PrivRightPanel" Grid.Row="0" Grid.Column="1" Grid.RowSpan="2">
                                <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="16,14" VerticalAlignment="Top">
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="16" Background="#2010B981" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#FF10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Clear Activity Traces" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Erase cached activity logs and history:" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" />

                                        <Button x:Name="WipeClipboardBtn" Click="OnClearClipboardClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" CornerRadius="8" HorizontalAlignment="Stretch" Padding="12,8" FontSize="11.5">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <ProgressRing x:Name="WipeClipboardRing" IsActive="False" Visibility="Collapsed" Width="12" Height="12" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="WipeClipboardText" Text="Wipe Clipboard"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="ClearRecentBtn" Click="OnClearRecentClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" CornerRadius="8" HorizontalAlignment="Stretch" Padding="12,8" FontSize="11.5">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <ProgressRing x:Name="ClearRecentRing" IsActive="False" Visibility="Collapsed" Width="12" Height="12" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="ClearRecentText" Text="Clear Recent Files &amp; History"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </PivotItem>
        </Pivot>

        <!-- Status Footer -->
        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Margin="0,8,0,0" />

        <!-- Loading Overlay Indicator -->
        <Grid x:Name="LoadingOverlayGrid" Grid.Row="0" Grid.RowSpan="4" Background="#60000000" Visibility="Collapsed" Opacity="0" Canvas.ZIndex="999" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.Resources>
                <Storyboard x:Name="FadeInLoading">
                    <DoubleAnimation Storyboard.TargetName="LoadingOverlayGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
                <Storyboard x:Name="FadeOutLoading" Completed="FadeOutLoading_Completed">
                    <DoubleAnimation Storyboard.TargetName="LoadingOverlayGrid" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </Grid.Resources>
            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1.5" CornerRadius="16" Padding="36,24" HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                <StackPanel Spacing="14" HorizontalAlignment="Center">
                    <Grid Width="50" Height="50" HorizontalAlignment="Center">
                        <Border Width="50" Height="50" CornerRadius="15" Background="#1510B981" BorderBrush="#4010B981" BorderThickness="1.5">
                            <FontIcon Glyph="&#xE72E;" FontSize="20" Foreground="#FF10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="Applying Privacy &amp; Protection Settings..." FontSize="13" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                    <Border Background="#1AFFFFFF" CornerRadius="4" Height="6" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="1" Width="220">
                        <ProgressBar IsIndeterminate="True" Height="4" CornerRadius="2" Foreground="#FF10B981" Background="Transparent" HorizontalAlignment="Stretch"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
