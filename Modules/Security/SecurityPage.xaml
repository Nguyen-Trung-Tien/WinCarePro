<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.SecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinCarePro.ViewModels"
    xmlns:local="using:WinCarePro.Views"
    mc:Ignorable="d">

    <Grid Padding="24">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutVisualStates">
                <!-- Wide Layout: Viewport Width >= 960px -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="960" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- Narrow Layout: Viewport Width < 960px -->
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- Privacy Tuning Tab Stacking -->
                        <Setter Target="PrivLeftPanel.(Grid.Row)" Value="0" />
                        <Setter Target="PrivLeftPanel.(Grid.Column)" Value="0" />
                        <Setter Target="PrivLeftPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="PrivLeftPanel.(Grid.RowSpan)" Value="1" />
                        <Setter Target="PrivRightPanel.(Grid.Row)" Value="1" />
                        <Setter Target="PrivRightPanel.(Grid.Column)" Value="0" />
                        <Setter Target="PrivRightPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="PrivRightPanel.(Grid.RowSpan)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="20" />
            </TransitionCollection>
        </Grid.ChildrenTransitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Security &amp; Privacy Shield" FontSize="28" FontWeight="ExtraBold" CharacterSpacing="-10" />
                <TextBlock Text="Monitor local security components, verify hardware platform trust levels, and tune privacy profiles." Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- Main Body Pivots -->
        <Pivot Grid.Row="1">
            <!-- Security Center Tab — Redirects to built-in Windows Security -->
            <PivotItem Header="Security Center">
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="0,16,16,16" Padding="24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="20" MaxWidth="680" HorizontalAlignment="Left">

                            <!-- Info banner -->
                            <Border Background="#1007C3EE" BorderBrush="#3007C3EE" BorderThickness="1" CornerRadius="12" Padding="20">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="24" Background="#2007C3EE" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE727;" FontSize="22" Foreground="#FF07C3EE"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="Windows Security is the best tool for this" FontSize="15" FontWeight="Bold"/>
                                        <TextBlock Text="Windows Security (built-in) provides real-time antivirus, firewall, BitLocker, Secure Boot and TPM status monitoring — more accurate and always up-to-date than any third-party dashboard." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" LineHeight="18"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Open Windows Security -->
                            <Border Style="{StaticResource GradientBorderCardStyle}" Padding="20">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="10" Background="#1510B981">
                                        <FontIcon Glyph="&#xE73A;" FontSize="20" Foreground="#FF10B981"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Windows Security" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="Real-time antivirus, firewall, virus &amp; threat protection, account protection." FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Open →" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" VerticalAlignment="Center" Click="OnOpenWindowsSecurityClick" CornerRadius="8" Padding="16,8"/>
                                </Grid>
                            </Border>

                            <!-- Open Device Manager -->
                            <Border Style="{StaticResource ModernCardStyle}" Padding="20">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="10" Background="#153B82F6">
                                        <FontIcon Glyph="&#xE7EF;" FontSize="20" Foreground="#FF3B82F6"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="System Information (msinfo32)" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="Complete hardware inventory: CPU, GPU, RAM, BIOS, drivers, system summary." FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Open →" VerticalAlignment="Center" Click="OnOpenMsinfoClick" CornerRadius="8" Padding="16,8"/>
                                </Grid>
                            </Border>

                            <!-- Open Windows Update for Drivers -->
                            <Border Style="{StaticResource ModernCardStyle}" Padding="20">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="10" Background="#158B5CF6">
                                        <FontIcon Glyph="&#xE895;" FontSize="20" Foreground="#FF8B5CF6"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Windows Update (Driver Updates)" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="Microsoft-verified driver updates, Windows security patches and feature updates." FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Open →" VerticalAlignment="Center" Click="OnOpenWindowsUpdateClick" CornerRadius="8" Padding="16,8"/>
                                </Grid>
                            </Border>

                            <!-- Open Task Manager -->
                            <Border Style="{StaticResource ModernCardStyle}" Padding="20">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="10" Background="#15F59E0B">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="20" Foreground="#FFF59E0B"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Task Manager" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="Monitor CPU, RAM, Disk, Network per-process. End tasks, change priority, manage startup apps." FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Open →" VerticalAlignment="Center" Click="OnOpenTaskManagerClick" CornerRadius="8" Padding="16,8"/>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </PivotItem>

            <!-- Privacy Tuning Tab -->
            <PivotItem Header="Privacy Tuning">
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="0,16,16,16" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid ColumnSpacing="24" RowSpacing="24" x:Name="PrivacyGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" x:Name="PrivCol0" />
                                <ColumnDefinition Width="2*" x:Name="PrivCol1" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Toggle Switches -->
                            <StackPanel x:Name="PrivLeftPanel" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Spacing="16">
                                <TextBlock Text="Windows Privacy Toggles" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />

                                <!-- Advertising ID -->
                                <Border Style="{StaticResource ModernCardStyle}" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Personalized Ads (Advertising ID)" FontWeight="Bold" FontSize="13.5" />
                                            <TextBlock Text="Disable to block applications from tracking your app usage for targeted ads." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" LineHeight="14" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AdvertisingIdEnabled, Mode=TwoWay}" Toggled="OnAdvertisingIdToggled" VerticalAlignment="Center" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" />
                                    </Grid>
                                </Border>

                                <!-- Telemetry -->
                                <Border Style="{StaticResource ModernCardStyle}" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="System Diagnostic Telemetry" FontWeight="Bold" FontSize="13.5" />
                                            <TextBlock Text="Restrict telemetry reports sent to Microsoft to Security-only levels." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" LineHeight="14" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.TelemetryEnabled, Mode=TwoWay}" Toggled="OnTelemetryToggled" VerticalAlignment="Center" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" />
                                    </Grid>
                                </Border>

                                <!-- Clipboard History -->
                                <Border Style="{StaticResource ModernCardStyle}" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Windows Clipboard History" FontWeight="Bold" FontSize="13.5" />
                                            <TextBlock Text="Saves multiple copied items to clipboard for later use. Disable to prevent caching copied credentials." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" LineHeight="14" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ClipboardHistoryEnabled, Mode=TwoWay}" Toggled="OnClipboardToggled" VerticalAlignment="Center" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" />
                                    </Grid>
                                </Border>

                                <!-- Input Tracking / RestrictImplicitConsent -->
                                <Border Style="{StaticResource ModernCardStyle}" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Personalization &amp; Typing Input Tracking" FontWeight="Bold" FontSize="13.5" />
                                            <TextBlock Text="Restrict Windows from logging typing history and personalization telemetry." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" LineHeight="14" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.InputTrackingEnabled, Mode=TwoWay}" Toggled="OnInputTrackingToggled" VerticalAlignment="Center" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Right: Actions & Trace Cleaning -->
                            <Grid x:Name="PrivRightPanel" Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" RowSpacing="24">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}" Padding="24">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="Clear Activity Traces" FontSize="18" FontWeight="Bold" />
                                        <TextBlock Text="Manually erase cached system activity logs and clipboard files:" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />

                                        <Button Content="Wipe Clipboard Cache" Click="OnClearClipboardClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" CornerRadius="6" HorizontalAlignment="Stretch" Padding="14,8" />
                                        <Button Content="Clear Recent Files &amp; Run History" Click="OnClearRecentClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" CornerRadius="6" HorizontalAlignment="Stretch" Padding="14,8" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}" Padding="24">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Privacy Guard Summary" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
                                        <TextBlock Text="• WinCare Pro privacy settings configure official Windows Registry parameters. These apply instantly and do not run third party agent daemons." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" LineHeight="16" />
                                        <TextBlock Text="• Disabling telemetry restricts Windows updates from monitoring usage diagnostics, which may reduce background data usage." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" LineHeight="16" />
                                        <TextBlock Text="• Traces clearing deletes temporary shortcuts inside Explorer Recent files history." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" LineHeight="16" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
