<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:WinCarePro.Views"
    xmlns:components="using:WinCarePro.Shared.Components"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    mc:Ignorable="d">

    <Page.Resources>
        <Storyboard x:Name="PulsingUpdateGlowAnimation" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="UpdateCardGlow" Storyboard.TargetProperty="Opacity" From="0.08" To="0.32" Duration="0:0:1.8">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid Padding="24,20" HorizontalAlignment="Stretch" x:Name="SettingsRootGrid">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutVisualStates">
                <!-- Wide Layout: Viewport Width >= 820px -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="820" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- Narrow Layout: Viewport Width < 820px -->
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarBorder.(Grid.Row)" Value="0" />
                        <Setter Target="SidebarBorder.(Grid.Column)" Value="0" />
                        <Setter Target="SidebarBorder.(Grid.RowSpan)" Value="1" />
                        <Setter Target="SidebarBorder.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="SidebarBorder.BorderThickness" Value="0,0,0,1" />
                        <Setter Target="SidebarBorder.Padding" Value="0,0,0,12" />
                        
                        <Setter Target="SettingsNavStackPanel.Orientation" Value="Horizontal" />
                        <Setter Target="SettingsNavList.ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                        <Setter Target="SettingsNavList.ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                        
                        <Setter Target="ContentScrollViewer.(Grid.Row)" Value="1" />
                        <Setter Target="ContentScrollViewer.(Grid.Column)" Value="0" />
                        <Setter Target="ContentScrollViewer.(Grid.RowSpan)" Value="1" />
                        <Setter Target="ContentScrollViewer.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="ContentScrollViewer.Padding" Value="0,16,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" x:Name="Row0" />
            <RowDefinition Height="*" x:Name="Row1" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" x:Name="Col0" /> <!-- Secondary Sidebar -->
            <ColumnDefinition Width="*" x:Name="Col1" />   <!-- Content Area -->
        </Grid.ColumnDefinitions>

        <!-- Vertical Navigation Panel (Secondary Sidebar) -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="0,0,16,0">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- In-Settings Quick Search Box -->
                <AutoSuggestBox x:Name="SettingsSearchBox" 
                                Grid.Row="0"
                                PlaceholderText="Find a setting..."
                                QueryIcon="Find"
                                TextChanged="OnSettingsSearchTextChanged"
                                SuggestionChosen="OnSettingsSearchSuggestionChosen"
                                QuerySubmitted="OnSettingsSearchQuerySubmitted"
                                Height="34"
                                CornerRadius="6"
                                HorizontalAlignment="Stretch">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="10" Padding="4,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{Binding IconGlyph}" FontSize="13" Foreground="{ThemeResource PrimaryAccentBrush}" VerticalAlignment="Center" Grid.Column="0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>

                <ListView x:Name="SettingsNavList" Grid.Row="1" SelectedIndex="0" SelectionChanged="SettingsNavList_SelectionChanged" SelectionMode="Single">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel x:Name="SettingsNavStackPanel" Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                
                <ListViewItem Height="40" Padding="8,0" CornerRadius="6" Margin="0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE713;" FontSize="15" Width="20" Foreground="{ThemeResource PrimaryAccentBrush}" />
                        <TextBlock Text="General Configuration" VerticalAlignment="Center" FontSize="12.5"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Height="40" Padding="8,0" CornerRadius="6" Margin="0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE790;" FontSize="15" Width="20" Foreground="{ThemeResource PrimaryAccentBrush}" />
                        <TextBlock Text="Appearance &amp; Theme" VerticalAlignment="Center" FontSize="12.5"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Height="40" Padding="8,0" CornerRadius="6" Margin="0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE812;" FontSize="15" Width="20" Foreground="{ThemeResource PrimaryAccentBrush}" />
                        <TextBlock Text="Auto Maintenance" VerticalAlignment="Center" FontSize="12.5"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Height="40" Padding="8,0" CornerRadius="6" Margin="0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xEA8F;" FontSize="15" Width="20" Foreground="{ThemeResource PrimaryAccentBrush}" />
                        <TextBlock Text="Telemetry &amp; Alert Policy" VerticalAlignment="Center" FontSize="12.5"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Height="40" Padding="8,0" CornerRadius="6" Margin="0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE727;" FontSize="15" Width="20" Foreground="{ThemeResource PrimaryAccentBrush}" />
                        <TextBlock Text="Safety &amp; Rollback" VerticalAlignment="Center" FontSize="12.5"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Height="40" Padding="8,0" CornerRadius="6" Margin="0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE7F1;" FontSize="15" Width="20" Foreground="{ThemeResource PrimaryAccentBrush}" />
                        <TextBlock Text="Database &amp; Storage" VerticalAlignment="Center" FontSize="12.5"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Height="40" Padding="8,0" CornerRadius="6" Margin="0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE75C;" FontSize="15" Width="20" Foreground="{ThemeResource PrimaryAccentBrush}" />
                        <TextBlock Text="Software Updates" VerticalAlignment="Center" FontSize="12.5"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Height="40" Padding="8,0" CornerRadius="6" Margin="0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE7B4;" FontSize="15" Width="20" Foreground="{ThemeResource PrimaryAccentBrush}" />
                        <TextBlock Text="Advanced &amp; Sandbox" VerticalAlignment="Center" FontSize="12.5"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Height="40" Padding="8,0" CornerRadius="6" Margin="0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8AC;" FontSize="15" Width="20" Foreground="{ThemeResource PrimaryAccentBrush}" />
                        <TextBlock Text="Backup &amp; Reset" VerticalAlignment="Center" FontSize="12.5"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Height="40" Padding="8,0" CornerRadius="6" Margin="0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE946;" FontSize="15" Width="20" Foreground="{ThemeResource PrimaryAccentBrush}" />
                        <TextBlock Text="About &amp; Developer" VerticalAlignment="Center" FontSize="12.5"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Height="40" Padding="8,0" CornerRadius="6" Margin="0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE897;" FontSize="15" Width="20" Foreground="{ThemeResource PrimaryAccentBrush}" />
                        <TextBlock Text="Feature Guide &amp; Manual" VerticalAlignment="Center" FontSize="12.5"/>
                    </StackPanel>
                </ListViewItem>
            </ListView>
            </Grid>
        </Border>

        <!-- Content Area -->
        <ScrollViewer x:Name="ContentScrollViewer" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="1" Padding="20,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <!-- Section 0: General Configuration -->
                <StackPanel Spacing="20" Visibility="{x:Bind GetSectionVisibility(SettingsNavList.SelectedIndex, 0), Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="General Configurations" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Variable Display" />
                        <TextBlock Text="Manage startup behaviors, language settings, and window minimization policies." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                    </StackPanel>
                    
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="22">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Language Selection / Lựa chọn Ngôn ngữ" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Switch instant application UI locale without restarting." FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <ComboBox x:Name="LanguageComboBox" SelectedIndex="0" Width="180" CornerRadius="6" SelectionChanged="OnLanguageSelectionChanged" Margin="0,4,0,0">
                                    <ComboBoxItem Content="English"/>
                                    <ComboBoxItem Content="Tiếng Việt"/>
                                </ComboBox>
                            </StackPanel>

                            <MenuFlyoutSeparator />

                            <components:LoadingToggleSwitch x:Name="AutoScanToggle" Toggled="OnAutoScanToggled" HeaderText="Launch WinCare Pro automatically upon Windows OS startup" />
                            <components:LoadingToggleSwitch x:Name="MinimizeToTrayToggle" Toggled="OnSettingsChanged" IsOn="True" HeaderText="Minimize application to System Tray instead of terminating process" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Section 1: Appearance & Personalization -->
                <StackPanel Spacing="20" Visibility="{x:Bind GetSectionVisibility(SettingsNavList.SelectedIndex, 1), Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Appearance &amp; Theme Customization" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Variable Display" />
                        <TextBlock Text="Customize color theme modes, accent palettes, acrylic transparency, and fluid animations." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                    </StackPanel>
                    
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="22">
                        <StackPanel Spacing="18">
                            <TextBlock Text="Application Color Theme Mode" FontSize="13.5" FontWeight="Bold" />
                            
                            <!-- Segmented cards for theme selection -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <Border x:Name="LightThemeCard" Grid.Column="0" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1.5" CornerRadius="12" Padding="16" PointerPressed="OnLightModeCardClick" Style="{StaticResource QuickStatCardStyle}"
                                        helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="5.0" helpers:Animation3DHelper.DepthZ="12">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="#20F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE706;" FontSize="18" Foreground="#FFF59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="Light Theme" FontWeight="Bold" FontSize="13" />
                                            <TextBlock Text="Clean and bright interface" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                
                                <Border x:Name="DarkThemeCard" Grid.Column="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1.5" CornerRadius="12" Padding="16" PointerPressed="OnDarkModeCardClick" Style="{StaticResource QuickStatCardStyle}"
                                        helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="5.0" helpers:Animation3DHelper.DepthZ="12">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="#208B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE708;" FontSize="18" Foreground="#FF8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="Dark Theme" FontWeight="Bold" FontSize="13" />
                                            <TextBlock Text="Deep space &amp; neon dark tones" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <MenuFlyoutSeparator />

                            <StackPanel Spacing="6">
                                <TextBlock Text="Window Accent Colors Palette" FontSize="13.5" FontWeight="Bold" />
                                <TextBlock Text="Choose system-wide brand gradient and highlight color tone." FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                
                                <StackPanel Orientation="Horizontal" Spacing="14" x:Name="AccentSelectorPanel" Margin="0,6,0,0">
                                    <!-- Default Purple -->
                                    <Grid Width="32" Height="32" PointerPressed="OnAccentClick" Tag="Default" Background="Transparent" ToolTipService.ToolTip="Default Indigo-Purple">
                                        <Ellipse x:Name="AccentDefault" Width="32" Height="32" Fill="#FF7F56D9"/>
                                        <FontIcon x:Name="CheckDefault" Glyph="&#xE73E;" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                    <!-- Green -->
                                    <Grid Width="32" Height="32" PointerPressed="OnAccentClick" Tag="Green" Background="Transparent" ToolTipService.ToolTip="Emerald Green">
                                        <Ellipse x:Name="AccentGreen" Width="32" Height="32" Fill="#FF10B981"/>
                                        <FontIcon x:Name="CheckGreen" Glyph="&#xE73E;" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                    <!-- Purple -->
                                    <Grid Width="32" Height="32" PointerPressed="OnAccentClick" Tag="Purple" Background="Transparent" ToolTipService.ToolTip="Royal Purple">
                                        <Ellipse x:Name="AccentPurple" Width="32" Height="32" Fill="#FF8B5CF6"/>
                                        <FontIcon x:Name="CheckPurple" Glyph="&#xE73E;" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                    <!-- Pink -->
                                    <Grid Width="32" Height="32" PointerPressed="OnAccentClick" Tag="Pink" Background="Transparent" ToolTipService.ToolTip="Cyber Pink">
                                        <Ellipse x:Name="AccentPink" Width="32" Height="32" Fill="#FFEC4899"/>
                                        <FontIcon x:Name="CheckPink" Glyph="&#xE73E;" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                    <!-- Amber -->
                                    <Grid Width="32" Height="32" PointerPressed="OnAccentClick" Tag="Amber" Background="Transparent" ToolTipService.ToolTip="Amber Gold">
                                        <Ellipse x:Name="AccentAmber" Width="32" Height="32" Fill="#FFF59E0B"/>
                                        <FontIcon x:Name="CheckAmber" Glyph="&#xE73E;" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <MenuFlyoutSeparator />

                            <StackPanel Spacing="8">
                                <Grid Width="320" HorizontalAlignment="Left">
                                    <TextBlock Text="Mica / Acrylic Background Transparency Level" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    <Border Background="{ThemeResource PrimaryAccentLightBrush}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right">
                                        <TextBlock x:Name="TransparencyValueLabel" Text="10%" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource PrimaryAccentBrush}"/>
                                    </Border>
                                </Grid>
                                <Slider x:Name="TransparencySlider" ValueChanged="OnTransparencyChanged" Minimum="10" Maximum="100" Value="10" Width="320" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <components:LoadingToggleSwitch x:Name="EnableAnimationsToggle" Toggled="OnSettingsChanged" IsOn="True" HeaderText="Enable UI fluid translation and hover animations" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Section 2: Auto Maintenance & Scheduler -->
                <StackPanel Spacing="20" Visibility="{x:Bind GetSectionVisibility(SettingsNavList.SelectedIndex, 2), Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Auto Maintenance Task Schedulers" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Variable Display" />
                        <TextBlock Text="Automate background junk cleaning and intelligent RAM working set flushing." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                    </StackPanel>
                    
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="22">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="8">
                                <Grid Width="320" HorizontalAlignment="Left">
                                    <TextBlock Text="Automated Cleanup Trigger Threshold" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    <Border Background="{ThemeResource PrimaryAccentLightBrush}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right">
                                        <TextBlock x:Name="CleanupSizeLabel" Text="5.0 GB" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource PrimaryAccentBrush}"/>
                                    </Border>
                                </Grid>
                                <Slider x:Name="AutoCleanupSlider" ValueChanged="OnAutoCleanupSliderChanged" Minimum="1" Maximum="50" Value="5" StepFrequency="0.5" Width="320" HorizontalAlignment="Left"/>
                                <TextBlock Text="WinCare Pro silently cleans junk if accumulated cache exceeds this limit." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>

                            <MenuFlyoutSeparator />

                            <components:LoadingToggleSwitch x:Name="TriggerSmartBoostToggle" Toggled="OnSettingsChanged" IsOn="True" HeaderText="Trigger Smart Boost optimization automatically if free RAM falls below 10%" />
                            
                            <MenuFlyoutSeparator />

                            <StackPanel Spacing="6">
                                <TextBlock Text="Automated Maintenance Schedule Frequency" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Configure Windows Task Scheduler execution interval." FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <ComboBox x:Name="MaintenanceFrequencyComboBox" SelectionChanged="OnMaintenanceFrequencyChanged" SelectedIndex="1" Width="180" CornerRadius="6" Margin="0,4,0,0">
                                    <ComboBoxItem Content="Daily run"/>
                                    <ComboBoxItem Content="Weekly scan"/>
                                    <ComboBoxItem Content="Monthly execution"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Section 3: Telemetry & Alert Policy -->
                <StackPanel Spacing="20" Visibility="{x:Bind GetSectionVisibility(SettingsNavList.SelectedIndex, 3), Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Telemetry &amp; Notification Center Policy" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Variable Display" />
                        <TextBlock Text="Configure real-time monitoring polling speed, health score alert thresholds, and audio alerts." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                    </StackPanel>
                    
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="22">
                        <StackPanel Spacing="18">
                            <TextBlock Text="Notification Center Policy" FontSize="13.5" FontWeight="Bold" />
                            <components:LoadingToggleSwitch x:Name="ShowNotificationsToggle" Toggled="OnSettingsChanged" IsOn="True" HeaderText="Show dynamic in-app Toast Notifications" />
                            
                            <StackPanel Spacing="8" MaxWidth="460" HorizontalAlignment="Left">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="PC Health Rating Severity Trigger Limit" TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    <Border Grid.Column="1" Background="{ThemeResource PrimaryAccentLightBrush}" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock x:Name="NotificationThresholdLabel" Text="10%" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource PrimaryAccentBrush}"/>
                                    </Border>
                                </Grid>
                                <Slider x:Name="NotificationThresholdSlider" ValueChanged="OnNotificationThresholdSliderChanged" Minimum="5" Maximum="30" Value="10" StepFrequency="1" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <components:LoadingToggleSwitch x:Name="NotifyOnLowHealthToggle" Toggled="OnSettingsChanged" IsOn="True" HeaderText="Notify when system overall health score drops below threshold" />
                            <components:LoadingToggleSwitch x:Name="NotifyOnMaintenanceToggle" Toggled="OnSettingsChanged" IsOn="True" HeaderText="Notify when system automated cleaners finish background runs" />
                            <components:LoadingToggleSwitch x:Name="ShowUpdateNotificationsToggle" Toggled="OnSettingsChanged" IsOn="True" HeaderText="Notify when newer version packages are available" />
                            <components:LoadingToggleSwitch x:Name="NotificationSoundToggle" Toggled="OnSettingsChanged" IsOn="True" HeaderText="Play subtle system audio alert upon notification arrival" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="22">
                        <StackPanel Spacing="18">
                            <TextBlock Text="Hardware Sensors Telemetry" FontSize="13.5" FontWeight="Bold" />
                            
                            <StackPanel Spacing="6">
                                <TextBlock Text="Sensors Telemetry Update Interval" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <ComboBox x:Name="TelemetryIntervalComboBox" SelectionChanged="OnSettingsChanged" SelectedIndex="1" Width="160" CornerRadius="6">
                                    <ComboBoxItem Content="0.5 seconds (Fast)"/>
                                    <ComboBoxItem Content="1.0 seconds (Normal)"/>
                                    <ComboBoxItem Content="2.0 seconds (Eco)"/>
                                    <ComboBoxItem Content="5.0 seconds (Low power)"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Performance History Logging Duration" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <ComboBox x:Name="PerformanceHistoryComboBox" SelectionChanged="OnSettingsChanged" SelectedIndex="0" Width="160" CornerRadius="6">
                                    <ComboBoxItem Content="7 Days logs"/>
                                    <ComboBoxItem Content="30 Days logs"/>
                                    <ComboBoxItem Content="90 Days logs"/>
                                </ComboBox>
                            </StackPanel>

                            <components:LoadingToggleSwitch x:Name="EnableHardwareSensorsToggle" Toggled="OnSettingsChanged" IsOn="True" HeaderText="Enable continuous low-overhead hardware sensors scanning thread" ToolTipService.ToolTip="Runs a background worker thread to poll CPU/GPU temperature and loading metrics." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Section 4: Safety & Rollback -->
                <StackPanel Spacing="20" Visibility="{x:Bind GetSectionVisibility(SettingsNavList.SelectedIndex, 4), Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Rollback &amp; Safety Registries" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Variable Display" />
                        <TextBlock Text="Configure restore points, registry backups, and modification confirmation levels." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                    </StackPanel>
                    
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="22">
                        <StackPanel Spacing="18">
                            <components:LoadingToggleSwitch x:Name="CreateRestorePointToggle" Toggled="OnSettingsChanged" IsOn="True" HeaderText="Automatically create a System Restore Point before major updates" ToolTipService.ToolTip="Saves a system restore point so you can roll back changes if optimizing causes issues." />
                            <components:LoadingToggleSwitch x:Name="BackupRegistryToggle" Toggled="OnSettingsChanged" IsOn="True" HeaderText="Automatically backup system registry hive partitions before repair" ToolTipService.ToolTip="Automatically backs up HKCU and modified HKLM keys before tweaking registry settings." />
                            
                            <MenuFlyoutSeparator />

                            <StackPanel Spacing="8">
                                <TextBlock Text="Modification Confirmation Alerts Level" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <Grid Width="320" HorizontalAlignment="Left">
                                    <Slider x:Name="AlertsLevelSlider" ValueChanged="OnSettingsChanged" Minimum="1" Maximum="3" Value="2" TickFrequency="1" SnapsTo="Ticks"/>
                                </Grid>
                                <TextBlock Text="Level 2 (Balanced): Prompts confirmation warnings before major file tree and registry mutations." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Section 5: Database & Storage Footprint -->
                <StackPanel Spacing="20" Visibility="{x:Bind GetSectionVisibility(SettingsNavList.SelectedIndex, 5), Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Database &amp; Storage Footprint Manager" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Variable Display" />
