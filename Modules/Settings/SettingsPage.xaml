                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE715;" FontSize="12.5" Foreground="{ThemeResource PrimaryAccentBrush}"/>
                                            <TextBlock Text="Email Developer" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Copy Contact Email -->
                                    <Button Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnCopyEmailClick" Style="{StaticResource StandardSecondaryButtonStyle}" CornerRadius="6" Padding="12,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="12.5" Foreground="#FF10B981"/>
                                            <TextBlock Text="Copy Contact Email" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- GitHub Repository -->
                                    <Button Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" Click="OnOpenGitHubClick" Style="{StaticResource StandardSecondaryButtonStyle}" CornerRadius="6" Padding="12,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8A7;" FontSize="12.5" Foreground="#FF6366F1"/>
                                            <TextBlock Text="GitHub Repository" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Report Bug / Issue -->
                                    <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnReportIssueClick" Style="{StaticResource StandardSecondaryButtonStyle}" CornerRadius="6" Padding="12,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="12.5" Foreground="#FFF59E0B"/>
                                            <TextBlock Text="Report Bug / Issue" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 3. Security & Zero-Telemetry Privacy Pledge Card -->
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="22">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE727;" FontSize="16" Foreground="#FF10B981"/>
                                <TextBlock Text="Zero-Telemetry &amp; Privacy Guarantee Pledge" FontSize="13.5" FontWeight="Bold" />
                            </StackPanel>
                            
                            <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Pledge 1 -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                    <TextBlock Text="🔒 100% On-Device Processing" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Text="All diagnostics, system scans, and cleanups execute locally with zero cloud telemetry transmission." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Pledge 2 -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                    <TextBlock Text="💾 Local Encrypted Storage" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Text="Activity logs, configurations, and rollback snapshots reside in high-speed local database files." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Pledge 3 -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                    <TextBlock Text="🛡️ Cryptographic Payload Audit" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Text="Update payloads are audited for valid PE headers, file integrity, and digital certificate validation." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Pledge 4 -->
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                    <TextBlock Text="⏪ Transactional Safety Rollbacks" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Text="Integrates Windows System Restore Points and registry backup snapshots prior to modifications." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 4. Security & Trust Architecture -->
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="System Integrity &amp; Security Certifications" FontSize="13" FontWeight="Bold" />
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72E;" FontSize="11.5" Foreground="{ThemeResource AppBadgeGoodFg}"/>
                                            <TextBlock Text="100% Offline Processing" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8D7;" FontSize="11.5" Foreground="#FF6366F1"/>
                                            <TextBlock Text="Zero Cloud Telemetry" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72B;" FontSize="11.5" Foreground="{ThemeResource PrimaryAccentBrush}"/>
                                            <TextBlock Text="Local Cryptographic Storage" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE7B7;" FontSize="11.5" Foreground="#FFF59E0B"/>
                                            <TextBlock Text="Binary Integrity Verified" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE777;" FontSize="11.5" Foreground="#FF10B981"/>
                                            <TextBlock Text="Hardware Acceleration" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE895;" FontSize="11.5" Foreground="#FFEC4899"/>
                                            <TextBlock Text="Safe State Rollbacks" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Section 10: Feature Guide & System Manual -->
                <local:UserGuideView Visibility="{x:Bind GetSectionVisibility(SettingsNavList.SelectedIndex, 10), Mode=OneWay}" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
