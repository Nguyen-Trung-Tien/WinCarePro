<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:WinCarePro.Views"
    xmlns:components="using:WinCarePro.Shared.Components"
    mc:Ignorable="d">

    <Page.Resources>
        <Storyboard x:Name="PulsingUpdateGlowAnimation" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="UpdateCardGlow" Storyboard.TargetProperty="Opacity" From="0.08" To="0.32" Duration="0:0:1.8">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid Padding="24,20" HorizontalAlignment="Stretch" x:Name="SettingsRootGrid">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutVisualStates">
                <!-- Wide Layout: Viewport Width >= 820px -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="820" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- Narrow Layout: Viewport Width < 820px -->
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarBorder.(Grid.Row)" Value="0" />
                        <Setter Target="SidebarBorder.(Grid.Column)" Value="0" />
                        <Setter Target="SidebarBorder.(Grid.RowSpan)" Value="1" />
                        <Setter Target="SidebarBorder.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="SidebarBorder.BorderThickness" Value="0,0,0,1" />
                        <Setter Target="SidebarBorder.Padding" Value="0,0,0,12" />
                        
                        <Setter Target="SettingsNavStackPanel.Orientation" Value="Horizontal" />
                        <Setter Target="SettingsNavList.ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                        <Setter Target="SettingsNavList.ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                        
                        <Setter Target="ContentScrollViewer.(Grid.Row)" Value="1" />
                        <Setter Target="ContentScrollViewer.(Grid.Column)" Value="0" />
                        <Setter Target="ContentScrollViewer.(Grid.RowSpan)" Value="1" />
                        <Setter Target="ContentScrollViewer.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="ContentScrollViewer.Padding" Value="0,16,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" x:Name="Row0" />
            <RowDefinition Height="*" x:Name="Row1" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" x:Name="Col0" /> <!-- Secondary Sidebar -->
            <ColumnDefinition Width="*" x:Name="Col1" />   <!-- Content Area -->
        </Grid.ColumnDefinitions>

        <!-- Vertical Navigation Panel (Secondary Sidebar) -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="0,0,16,0">
            <ListView x:Name="SettingsNavList" SelectedIndex="0" SelectionChanged="SettingsNavList_SelectionChanged" SelectionMode="Single">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel x:Name="SettingsNavStackPanel" Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                
                <ListViewItem Height="40" Padding="8,0" CornerRadius="6" Margin="0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE713;" FontSize="15" Width="20" Foreground="{ThemeResource PrimaryAccentBrush}" />
                        <TextBlock Text="General Configuration" VerticalAlignment="Center" FontSize="12.5"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Height="40" Padding="8,0" CornerRadius="6" Margin="0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE790;" FontSize="15" Width="20" Foreground="{ThemeResource PrimaryAccentBrush}" />
                        <TextBlock Text="Appearance &amp; Theme" VerticalAlignment="Center" FontSize="12.5"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Height="40" Padding="8,0" CornerRadius="6" Margin="0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE812;" FontSize="15" Width="20" Foreground="{ThemeResource PrimaryAccentBrush}" />
                        <TextBlock Text="Auto Maintenance" VerticalAlignment="Center" FontSize="12.5"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Height="40" Padding="8,0" CornerRadius="6" Margin="0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xEA8F;" FontSize="15" Width="20" Foreground="{ThemeResource PrimaryAccentBrush}" />
                        <TextBlock Text="Telemetry &amp; Alert Policy" VerticalAlignment="Center" FontSize="12.5"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Height="40" Padding="8,0" CornerRadius="6" Margin="0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE727;" FontSize="15" Width="20" Foreground="{ThemeResource PrimaryAccentBrush}" />
                        <TextBlock Text="Safety &amp; Rollback" VerticalAlignment="Center" FontSize="12.5"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Height="40" Padding="8,0" CornerRadius="6" Margin="0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE7F1;" FontSize="15" Width="20" Foreground="{ThemeResource PrimaryAccentBrush}" />
                        <TextBlock Text="Database &amp; Storage" VerticalAlignment="Center" FontSize="12.5"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Height="40" Padding="8,0" CornerRadius="6" Margin="0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE75C;" FontSize="15" Width="20" Foreground="{ThemeResource PrimaryAccentBrush}" />
                        <TextBlock Text="Software Updates" VerticalAlignment="Center" FontSize="12.5"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Height="40" Padding="8,0" CornerRadius="6" Margin="0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE7B4;" FontSize="15" Width="20" Foreground="{ThemeResource PrimaryAccentBrush}" />
                        <TextBlock Text="Advanced &amp; Sandbox" VerticalAlignment="Center" FontSize="12.5"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Height="40" Padding="8,0" CornerRadius="6" Margin="0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8AC;" FontSize="15" Width="20" Foreground="{ThemeResource PrimaryAccentBrush}" />
                        <TextBlock Text="Backup &amp; Reset" VerticalAlignment="Center" FontSize="12.5"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Height="40" Padding="8,0" CornerRadius="6" Margin="0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE946;" FontSize="15" Width="20" Foreground="{ThemeResource PrimaryAccentBrush}" />
                        <TextBlock Text="About &amp; Developer" VerticalAlignment="Center" FontSize="12.5"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Height="40" Padding="8,0" CornerRadius="6" Margin="0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE897;" FontSize="15" Width="20" Foreground="{ThemeResource PrimaryAccentBrush}" />
                        <TextBlock Text="Feature Guide &amp; Manual" VerticalAlignment="Center" FontSize="12.5"/>
                    </StackPanel>
                </ListViewItem>
            </ListView>
        </Border>

        <!-- Content Area -->
        <ScrollViewer x:Name="ContentScrollViewer" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="1" Padding="20,0,0,0" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Section 0: General Configuration -->
                <StackPanel Spacing="20" Visibility="{x:Bind GetSectionVisibility(SettingsNavList.SelectedIndex, 0), Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="General Configurations" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Variable Display" />
                        <TextBlock Text="Manage startup behaviors, language settings, and window minimization policies." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                    </StackPanel>
                    
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="22">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Language Selection / Lựa chọn Ngôn ngữ" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Switch instant application UI locale without restarting." FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <ComboBox x:Name="LanguageComboBox" SelectedIndex="0" Width="180" CornerRadius="6" SelectionChanged="OnLanguageSelectionChanged" Margin="0,4,0,0">
                                    <ComboBoxItem Content="English"/>
                                    <ComboBoxItem Content="Tiếng Việt"/>
                                </ComboBox>
                            </StackPanel>

                            <MenuFlyoutSeparator />

                            <components:LoadingToggleSwitch x:Name="AutoScanToggle" Toggled="OnAutoScanToggled" HeaderText="Launch WinCare Pro automatically upon Windows OS startup" />
                            <components:LoadingToggleSwitch x:Name="MinimizeToTrayToggle" Toggled="OnSettingsChanged" IsOn="True" HeaderText="Minimize application to System Tray instead of terminating process" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Section 1: Appearance & Personalization -->
                <StackPanel Spacing="20" Visibility="{x:Bind GetSectionVisibility(SettingsNavList.SelectedIndex, 1), Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Appearance &amp; Theme Customization" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Variable Display" />
                        <TextBlock Text="Customize color theme modes, accent palettes, acrylic transparency, and fluid animations." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                    </StackPanel>
                    
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="22">
                        <StackPanel Spacing="18">
                            <TextBlock Text="Application Color Theme Mode" FontSize="13.5" FontWeight="Bold" />
                            
                            <!-- Segmented cards for theme selection -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <Border x:Name="LightThemeCard" Grid.Column="0" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1.5" CornerRadius="12" Padding="16" PointerPressed="OnLightModeCardClick" Style="{StaticResource QuickStatCardStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="#20F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE706;" FontSize="18" Foreground="#FFF59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="Light Theme" FontWeight="Bold" FontSize="13" />
                                            <TextBlock Text="Clean and bright interface" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                
                                <Border x:Name="DarkThemeCard" Grid.Column="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1.5" CornerRadius="12" Padding="16" PointerPressed="OnDarkModeCardClick" Style="{StaticResource QuickStatCardStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="#208B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE708;" FontSize="18" Foreground="#FF8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="Dark Theme" FontWeight="Bold" FontSize="13" />
                                            <TextBlock Text="Deep space &amp; neon dark tones" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <MenuFlyoutSeparator />

                            <StackPanel Spacing="6">
                                <TextBlock Text="Window Accent Colors Palette" FontSize="13.5" FontWeight="Bold" />
                                <TextBlock Text="Choose system-wide brand gradient and highlight color tone." FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                
                                <StackPanel Orientation="Horizontal" Spacing="14" x:Name="AccentSelectorPanel" Margin="0,6,0,0">
                                    <!-- Default Purple -->
                                    <Grid Width="32" Height="32" PointerPressed="OnAccentClick" Tag="Default" Background="Transparent" ToolTipService.ToolTip="Default Indigo-Purple">
                                        <Ellipse x:Name="AccentDefault" Width="32" Height="32" Fill="#FF7F56D9"/>
                                        <FontIcon x:Name="CheckDefault" Glyph="&#xE73E;" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                    <!-- Green -->
                                    <Grid Width="32" Height="32" PointerPressed="OnAccentClick" Tag="Green" Background="Transparent" ToolTipService.ToolTip="Emerald Green">
                                        <Ellipse x:Name="AccentGreen" Width="32" Height="32" Fill="#FF10B981"/>
                                        <FontIcon x:Name="CheckGreen" Glyph="&#xE73E;" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                    <!-- Purple -->
                                    <Grid Width="32" Height="32" PointerPressed="OnAccentClick" Tag="Purple" Background="Transparent" ToolTipService.ToolTip="Royal Purple">
                                        <Ellipse x:Name="AccentPurple" Width="32" Height="32" Fill="#FF8B5CF6"/>
                                        <FontIcon x:Name="CheckPurple" Glyph="&#xE73E;" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                    <!-- Pink -->
                                    <Grid Width="32" Height="32" PointerPressed="OnAccentClick" Tag="Pink" Background="Transparent" ToolTipService.ToolTip="Cyber Pink">
                                        <Ellipse x:Name="AccentPink" Width="32" Height="32" Fill="#FFEC4899"/>
                                        <FontIcon x:Name="CheckPink" Glyph="&#xE73E;" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                    <!-- Amber -->
                                    <Grid Width="32" Height="32" PointerPressed="OnAccentClick" Tag="Amber" Background="Transparent" ToolTipService.ToolTip="Amber Gold">
                                        <Ellipse x:Name="AccentAmber" Width="32" Height="32" Fill="#FFF59E0B"/>
                                        <FontIcon x:Name="CheckAmber" Glyph="&#xE73E;" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <MenuFlyoutSeparator />

                            <StackPanel Spacing="8">
                                <Grid Width="320" HorizontalAlignment="Left">
                                    <TextBlock Text="Mica / Acrylic Background Transparency Level" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    <Border Background="{ThemeResource PrimaryAccentLightBrush}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right">
                                        <TextBlock x:Name="TransparencyValueLabel" Text="10%" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource PrimaryAccentBrush}"/>
                                    </Border>
                                </Grid>
                                <Slider x:Name="TransparencySlider" ValueChanged="OnTransparencyChanged" Minimum="10" Maximum="100" Value="10" Width="320" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <components:LoadingToggleSwitch x:Name="EnableAnimationsToggle" Toggled="OnSettingsChanged" IsOn="True" HeaderText="Enable UI fluid translation and hover animations" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Section 2: Auto Maintenance & Scheduler -->
                <StackPanel Spacing="20" Visibility="{x:Bind GetSectionVisibility(SettingsNavList.SelectedIndex, 2), Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Auto Maintenance Task Schedulers" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Variable Display" />
                        <TextBlock Text="Automate background junk cleaning and intelligent RAM working set flushing." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                    </StackPanel>
                    
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="22">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="8">
                                <Grid Width="320" HorizontalAlignment="Left">
                                    <TextBlock Text="Automated Cleanup Trigger Threshold" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    <Border Background="{ThemeResource PrimaryAccentLightBrush}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right">
                                        <TextBlock x:Name="CleanupSizeLabel" Text="5.0 GB" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource PrimaryAccentBrush}"/>
                                    </Border>
                                </Grid>
                                <Slider x:Name="AutoCleanupSlider" ValueChanged="OnAutoCleanupSliderChanged" Minimum="1" Maximum="50" Value="5" StepFrequency="0.5" Width="320" HorizontalAlignment="Left"/>
                                <TextBlock Text="WinCare Pro silently cleans junk if accumulated cache exceeds this limit." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>

                            <MenuFlyoutSeparator />

                            <components:LoadingToggleSwitch x:Name="TriggerSmartBoostToggle" Toggled="OnSettingsChanged" IsOn="True" HeaderText="Trigger Smart Boost optimization automatically if free RAM falls below 10%" />
                            
                            <MenuFlyoutSeparator />

                            <StackPanel Spacing="6">
                                <TextBlock Text="Automated Maintenance Schedule Frequency" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Configure Windows Task Scheduler execution interval." FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <ComboBox x:Name="MaintenanceFrequencyComboBox" SelectionChanged="OnMaintenanceFrequencyChanged" SelectedIndex="1" Width="180" CornerRadius="6" Margin="0,4,0,0">
                                    <ComboBoxItem Content="Daily run"/>
                                    <ComboBoxItem Content="Weekly scan"/>
                                    <ComboBoxItem Content="Monthly execution"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Section 3: Telemetry & Alert Policy -->
                <StackPanel Spacing="20" Visibility="{x:Bind GetSectionVisibility(SettingsNavList.SelectedIndex, 3), Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Telemetry &amp; Notification Center Policy" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Variable Display" />
                        <TextBlock Text="Configure real-time monitoring polling speed, health score alert thresholds, and audio alerts." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                    </StackPanel>
                    
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="22">
                        <StackPanel Spacing="18">
                            <TextBlock Text="Notification Center Policy" FontSize="13.5" FontWeight="Bold" />
                            <components:LoadingToggleSwitch x:Name="ShowNotificationsToggle" Toggled="OnSettingsChanged" IsOn="True" HeaderText="Show dynamic in-app Toast Notifications" />
                            
                            <StackPanel Spacing="8">
                                <Grid Width="320" HorizontalAlignment="Left">
                                    <TextBlock Text="PC Health Rating Severity Trigger Limit" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    <Border Background="{ThemeResource PrimaryAccentLightBrush}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right">
                                        <TextBlock x:Name="NotificationThresholdLabel" Text="10%" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource PrimaryAccentBrush}"/>
                                    </Border>
                                </Grid>
                                <Slider x:Name="NotificationThresholdSlider" ValueChanged="OnNotificationThresholdSliderChanged" Minimum="5" Maximum="30" Value="10" StepFrequency="1" Width="320" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <components:LoadingToggleSwitch x:Name="NotifyOnLowHealthToggle" Toggled="OnSettingsChanged" IsOn="True" HeaderText="Notify when system overall health score drops below threshold" />
                            <components:LoadingToggleSwitch x:Name="NotifyOnMaintenanceToggle" Toggled="OnSettingsChanged" IsOn="True" HeaderText="Notify when system automated cleaners finish background runs" />
                            <components:LoadingToggleSwitch x:Name="ShowUpdateNotificationsToggle" Toggled="OnSettingsChanged" IsOn="True" HeaderText="Notify when newer version packages are available" />
                            <components:LoadingToggleSwitch x:Name="NotificationSoundToggle" Toggled="OnSettingsChanged" IsOn="True" HeaderText="Play subtle system audio alert upon notification arrival" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="22">
                        <StackPanel Spacing="18">
                            <TextBlock Text="Hardware Sensors Telemetry" FontSize="13.5" FontWeight="Bold" />
                            
                            <StackPanel Spacing="6">
                                <TextBlock Text="Sensors Telemetry Update Interval" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <ComboBox x:Name="TelemetryIntervalComboBox" SelectionChanged="OnSettingsChanged" SelectedIndex="1" Width="160" CornerRadius="6">
                                    <ComboBoxItem Content="0.5 seconds (Fast)"/>
                                    <ComboBoxItem Content="1.0 seconds (Normal)"/>
                                    <ComboBoxItem Content="2.0 seconds (Eco)"/>
                                    <ComboBoxItem Content="5.0 seconds (Low power)"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Performance History Logging Duration" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <ComboBox x:Name="PerformanceHistoryComboBox" SelectionChanged="OnSettingsChanged" SelectedIndex="0" Width="160" CornerRadius="6">
                                    <ComboBoxItem Content="7 Days logs"/>
                                    <ComboBoxItem Content="30 Days logs"/>
                                    <ComboBoxItem Content="90 Days logs"/>
                                </ComboBox>
                            </StackPanel>

                            <components:LoadingToggleSwitch x:Name="EnableHardwareSensorsToggle" Toggled="OnSettingsChanged" IsOn="True" HeaderText="Enable continuous low-overhead hardware sensors scanning thread" ToolTipService.ToolTip="Runs a background worker thread to poll CPU/GPU temperature and loading metrics." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Section 4: Safety & Rollback -->
                <StackPanel Spacing="20" Visibility="{x:Bind GetSectionVisibility(SettingsNavList.SelectedIndex, 4), Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Rollback &amp; Safety Registries" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Variable Display" />
                        <TextBlock Text="Configure restore points, registry backups, and modification confirmation levels." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                    </StackPanel>
                    
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="22">
                        <StackPanel Spacing="18">
                            <components:LoadingToggleSwitch x:Name="CreateRestorePointToggle" Toggled="OnSettingsChanged" IsOn="True" HeaderText="Automatically create a System Restore Point before major updates" ToolTipService.ToolTip="Saves a system restore point so you can roll back changes if optimizing causes issues." />
                            <components:LoadingToggleSwitch x:Name="BackupRegistryToggle" Toggled="OnSettingsChanged" IsOn="True" HeaderText="Automatically backup system registry hive partitions before repair" ToolTipService.ToolTip="Automatically backs up HKCU and modified HKLM keys before tweaking registry settings." />
                            
                            <MenuFlyoutSeparator />

                            <StackPanel Spacing="8">
                                <TextBlock Text="Modification Confirmation Alerts Level" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <Grid Width="320" HorizontalAlignment="Left">
                                    <Slider x:Name="AlertsLevelSlider" ValueChanged="OnSettingsChanged" Minimum="1" Maximum="3" Value="2" TickFrequency="1" SnapsTo="Ticks"/>
                                </Grid>
                                <TextBlock Text="Level 2 (Balanced): Prompts confirmation warnings before major file tree and registry mutations." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Section 5: Database & Storage Footprint -->
                <StackPanel Spacing="20" Visibility="{x:Bind GetSectionVisibility(SettingsNavList.SelectedIndex, 5), Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Database &amp; Storage Footprint Manager" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Variable Display" />
                        <TextBlock Text="Inspect and reclaim storage consumed by diagnostic logs, assessment reports, and update packages." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                    </StackPanel>
                    
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="22">
                        <StackPanel Spacing="18">
                            <Grid>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Storage Utilization Statistics" FontSize="13.5" FontWeight="Bold" />
                                    <TextBlock Text="Live breakdown of local SQLite logs and temporary cache folders." FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" Click="OnRefreshStorageClick" Style="{StaticResource StandardSecondaryButtonStyle}" Padding="10,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{ThemeResource PrimaryAccentBrush}"/>
                                        <TextBlock Text="Refresh Stats" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            
                            <!-- DB statistics cards -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource QuickStatCardStyle}" Padding="14">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{ThemeResource PrimaryAccentBrush}"/>
                                            <TextBlock Text="Activity Logs" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="LogsDbSizeLabel" Text="Calculating..." FontSize="13.5" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource QuickStatCardStyle}" Padding="14">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="13" Foreground="{ThemeResource PrimaryAccentBrush}"/>
                                            <TextBlock Text="Reports Files" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ReportsDbSizeLabel" Text="Calculating..." FontSize="13.5" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource QuickStatCardStyle}" Padding="14">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="{ThemeResource PrimaryAccentBrush}"/>
                                            <TextBlock Text="Updates Cache" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="CacheDbSizeLabel" Text="Calculating..." FontSize="13.5" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <MenuFlyoutSeparator />

                            <StackPanel Spacing="10">
                                <TextBlock Text="Selective Purge Targets" FontSize="13" FontWeight="SemiBold"/>
                                <CheckBox x:Name="PurgeLogsCheckbox" Content="Purge SQLite Activity History Logs" IsChecked="True" FontSize="12.5"/>
                                <CheckBox x:Name="PurgeReportsCheckbox" Content="Wipe Saved Diagnostic Assessment Report Files" IsChecked="True" FontSize="12.5"/>
                                <CheckBox x:Name="PurgeCacheCheckbox" Content="Clear Temporary Updates Installation Packages" IsChecked="True" FontSize="12.5"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                <Button x:Name="PurgeStorageBtn" Click="OnPurgeDatabaseClick" Foreground="#FFE81123" CornerRadius="8" Padding="16,8" FontWeight="Bold">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressRing x:Name="PurgeProgressRing" IsActive="False" Visibility="Collapsed" Width="14" Height="14" VerticalAlignment="Center"/>
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#FFE81123"/>
                                        <TextBlock x:Name="PurgeStorageText" Text="Purge Selected Storage" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Section 6: Software Updates -->
                <StackPanel Spacing="20" Visibility="{x:Bind GetSectionVisibility(SettingsNavList.SelectedIndex, 6), Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Software Update Policies &amp; CDN Stream" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Variable Display" />
                        <TextBlock Text="Manage background version checks, live percentage telemetry stream, and automated installer delivery." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                    </StackPanel>
                    
                    <!-- 1. Live Update Data Progress & Status Card -->
                    <Border Style="{StaticResource AuraGlassCardStyle}" Padding="20">
                        <Grid>
                            <!-- Ambient Pulsing Glow Reactor -->
                            <Ellipse x:Name="UpdateCardGlow" Fill="{StaticResource PrimaryAccentGradient}" Opacity="0.18" HorizontalAlignment="Right" VerticalAlignment="Top" Width="260" Height="160" Margin="0,-40,-40,0" IsHitTestVisible="False"/>

                            <StackPanel Spacing="16">
                            <!-- Card Header with version and trigger -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Version & Status -->
                                <Grid Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,0,4">
                                        <Border Background="{StaticResource PrimaryAccentGradient}" CornerRadius="6" Padding="6,2">
                                            <TextBlock Text="v4.2.0" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="WinCare Pro Distribution Channel" FontSize="13.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <Border x:Name="UpdateChannelBadgeBorder" Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="6" Padding="6,2">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Ellipse x:Name="UpdateChannelBadgeDot" Width="5.5" Height="5.5" Fill="{ThemeResource AppBadgeGoodFg}"/>
                                                <TextBlock x:Name="UpdateChannelBadgeText" Text="CDN Connected" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AppBadgeGoodFg}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" x:Name="UpdateStatusLabel" Text="System is up to date with the latest security and optimization definitions." FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <!-- Right: Action Buttons (Compact & Sleek) -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button x:Name="CancelUpdatesBtn" Click="OnCancelUpdateClick" Style="{StaticResource StandardSecondaryButtonStyle}" Height="32" Padding="8,0" CornerRadius="6" ToolTipService.ToolTip="Cancel current update operation" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE711;" FontSize="10.5" Foreground="#FFEF4444"/>
                                            <TextBlock Text="Cancel" FontSize="11" FontWeight="SemiBold" Foreground="#FFEF4444"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="CheckUpdatesBtn" Click="OnCheckUpdatesClick" Style="{StaticResource StandardSecondaryButtonStyle}" Height="32" Padding="12,0" CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ProgressRing x:Name="UpdateProgressRing" IsActive="False" Visibility="Collapsed" Width="13" Height="13" VerticalAlignment="Center"/>
                                            <FontIcon x:Name="CheckUpdatesIcon" Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                            <TextBlock x:Name="CheckUpdatesText" Text="Check for Updates" FontSize="11.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Live % Data Stream Bar & Readout -->
                            <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE895;" FontSize="13" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                            <TextBlock x:Name="UpdateProgressStepLabel" Text="Data Synchronization Status" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" x:Name="UpdatePercentText" Text="100%" FontSize="13" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Modern Data Progress Bar -->
                                    <ProgressBar x:Name="UpdateProgressBar" Maximum="100" Value="100" Height="8" CornerRadius="4" Background="{ThemeResource ControlStrokeColorDefaultBrush}" Foreground="{StaticResource PrimaryAccentGradient}" />

                                    <!-- Bottom Telemetry Detail -->
                                    <Grid>
                                        <TextBlock x:Name="UpdateDetailsText" Text="CDN Manifest Sync: Complete • Channel: Stable • Digital Signature: Verified" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        <TextBlock x:Name="UpdateDataRateText" Text="Ready" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
                    
                    <!-- 2. Update Configuration Settings -->
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="22">
                        <StackPanel Spacing="18">
                            <components:LoadingToggleSwitch x:Name="AutoUpdateToggle" Toggled="OnSettingsChanged" IsOn="True" HeaderText="Check for updates automatically in the background" />
                            <components:LoadingToggleSwitch x:Name="AutoInstallUpdatesToggle" Toggled="OnSettingsChanged" IsOn="False" HeaderText="Auto download &amp; install updates silently (Requires background check)" />
                            <components:LoadingToggleSwitch x:Name="BetaUpdatesToggle" Toggled="OnSettingsChanged" IsOn="False" HeaderText="Enroll in the pre-release channel (Beta updates)" ToolTipService.ToolTip="Receive early updates with new features before public release." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Section 7: Advanced Developer Configurations -->
                <StackPanel Spacing="20" Visibility="{x:Bind GetSectionVisibility(SettingsNavList.SelectedIndex, 7), Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Advanced &amp; Sandbox Options" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Variable Display" />
                        <TextBlock Text="Developer debugging flags, verified plugin manager, and experimental modules." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                    </StackPanel>
                    
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="22">
                        <StackPanel Spacing="18">
                            <components:LoadingToggleSwitch x:Name="EnableVerboseLogsToggle" Toggled="OnSettingsChanged" HeaderText="Enable verbose debug log trace files" />
                            
                            <MenuFlyoutSeparator />

                            <StackPanel Spacing="8">
                                <TextBlock Text="Plugin &amp; Sandbox Modules Manager" FontSize="13" FontWeight="Bold" />
                                <TextBlock Text="No custom external plugins are currently loaded in the sandbox runtime." FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <Button Content="Browse Verified Plugins" CornerRadius="6" Click="OnBrowsePluginsClick" Style="{StaticResource StandardSecondaryButtonStyle}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <MenuFlyoutSeparator />

                            <components:LoadingToggleSwitch x:Name="EnableExperimentalAiToggle" Toggled="OnSettingsChanged" HeaderText="Enable experimental AI diagnostics auto-remediations (Pre-release)" ToolTipService.ToolTip="Uses heuristic rules to automatically attempt fixing found system issues without user confirmation." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Section 8: Backup & Reset Settings -->
                <StackPanel Spacing="20" Visibility="{x:Bind GetSectionVisibility(SettingsNavList.SelectedIndex, 8), Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Backup &amp; Reset Configurations" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Variable Display" />
                        <TextBlock Text="Export configurations to JSON, restore profiles, or revert to pristine factory settings." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                    </StackPanel>
                    
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="22">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Configuration Profiles Backup &amp; Restore" FontSize="13.5" FontWeight="Bold" />
                                <TextBlock Text="Save your entire personalization, scheduler, and security preferences to a portable JSON file." FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                                    <Button Click="OnExportSettingsClick" Style="{StaticResource StandardSecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE898;" FontSize="13" Foreground="{ThemeResource PrimaryAccentBrush}"/>
                                            <TextBlock Text="Export Backup (JSON)" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnImportSettingsClick" Style="{StaticResource StandardSecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE896;" FontSize="13" Foreground="{ThemeResource PrimaryAccentBrush}"/>
                                            <TextBlock Text="Import Restore (JSON)" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <MenuFlyoutSeparator />

                            <StackPanel Spacing="6">
                                <TextBlock Text="Factory Reset Preferences" FontSize="13.5" FontWeight="Bold" Foreground="#FFE81123"/>
                                <TextBlock Text="Reset all settings, theme customizations, schedulers, and thresholds to pristine factory defaults." FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                
                                <Button Click="OnResetDefaultsClick" Foreground="#FFE81123" CornerRadius="8" Padding="14,8" Margin="0,8,0,0" FontWeight="Bold">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE777;" FontSize="13" Foreground="#FFE81123"/>
                                        <TextBlock Text="Reset to Factory Defaults" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Section 9: About & Developer Info -->
                <StackPanel Spacing="20" Visibility="{x:Bind GetSectionVisibility(SettingsNavList.SelectedIndex, 9), Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="About WinCare Pro" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Variable Display" />
                        <TextBlock Text="Software build specifications, developer contact, and open-source repository." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                    </StackPanel>
                    
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="24">
                        <StackPanel Spacing="18">
                            <!-- Logo and name -->
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <Border Width="64" Height="64" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="18" VerticalAlignment="Center">
                                    <Image Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="WinCare Pro" FontSize="20" FontWeight="ExtraBold" />
                                    <TextBlock Text="System Optimizer, Security Shield &amp; Care Suite" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                    <TextBlock Text="Version 4.2.0 (Evolution Suite Release)" FontSize="11.5" Foreground="{ThemeResource PrimaryAccentBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>

                            <MenuFlyoutSeparator />

                            <!-- Developer info -->
                            <Grid RowSpacing="12" ColumnSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Author row -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Lead Developer:" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Nguyen Trung Tien" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>

                                <!-- Contact row -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Contact Support:" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center"/>
                                <HyperlinkButton Grid.Row="1" Grid.Column="1" Content="trungtiennguyen910@gmail.com" NavigateUri="mailto:trungtiennguyen910@gmail.com" Padding="0" VerticalAlignment="Center"/>
                            </Grid>

                            <MenuFlyoutSeparator />

                            <!-- Code repository -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Source Code Repository &amp; Feedback" FontSize="13" FontWeight="Bold" />
                                <TextBlock Text="Contributions, bug reports, and feature requests are welcome on GitHub." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                <HyperlinkButton Content="https://github.com/Nguyen-Trung-Tien/WinCarePro" NavigateUri="https://github.com/Nguyen-Trung-Tien/WinCarePro" Padding="0" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Section 10: Feature Guide & System Manual -->
                <local:UserGuideView Visibility="{x:Bind GetSectionVisibility(SettingsNavList.SelectedIndex, 10), Mode=OneWay}" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
