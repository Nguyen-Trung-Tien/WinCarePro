<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinCarePro.Views.UserGuideView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="20">
        <!-- ==================== 1. HERO KNOWLEDGE DECK ==================== -->
        <Border Style="{StaticResource ElevatedGlassCardStyle}" Padding="22,18">
            <StackPanel Spacing="14">
                <!-- Top Row: Title + Version Badge + Stats -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Style="{StaticResource PageHeaderIconBadgeStyle}">
                                <FontIcon Glyph="&#xE82D;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Feature Guide &amp; System Manual" Style="{StaticResource PageHeaderTitleStyle}" VerticalAlignment="Center" FontSize="20"/>
                            <Border Background="{StaticResource PrimaryAccentLightBrush}" BorderBrush="{StaticResource PrimaryAccentBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                                <TextBlock Text="Evolution Suite" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Comprehensive documentation, step-by-step feature guides, and best practices." 
                                   Style="{StaticResource PageHeaderSubtitleStyle}"/>
                    </StackPanel>

                    <!-- Right Knowledge Badges -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="8" Padding="10,5">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AppBadgeGoodFg}"/>
                                <TextBlock Text="100% Safe Guidelines" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppBadgeGoodFg}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="8" Padding="10,5">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7BE;" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock Text="15 Core Modules" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Search Input Box -->
                <AutoSuggestBox x:Name="GuideSearchBox" 
                                PlaceholderText="Search guide (e.g., RAM, DNS, SFC, game, junk)..."
                                QueryIcon="Find"
                                CornerRadius="8"
                                Height="36"
                                HorizontalAlignment="Stretch"
                                TextChanged="OnGuideSearchTextChanged"/>

                <!-- Category Filter Segmented Deck (Responsive 5-Column Grid, Zero Horizontal Scrolling!) -->
                <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="9" Padding="4">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="FilterBtnAll" Grid.Column="0" Click="OnCategoryFilterClick" Tag="All" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="32" HorizontalAlignment="Stretch" Padding="2,0" CornerRadius="6" ToolTipService.ToolTip="Xem tất cả 15 phân hệ hướng dẫn">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE80F;" FontSize="11" Foreground="White"/>
                                <TextBlock Text="All Modules" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="FilterBtnCare" Grid.Column="1" Click="OnCategoryFilterClick" Tag="Care" Style="{StaticResource StandardSecondaryButtonStyle}" Height="32" HorizontalAlignment="Stretch" Padding="2,0" CornerRadius="6" ToolTipService.ToolTip="Chăm sóc &amp; Dọn dẹp hệ thống">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xEA99;" FontSize="11" Foreground="Orange"/>
                                <TextBlock Text="Care" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="FilterBtnTuning" Grid.Column="2" Click="OnCategoryFilterClick" Tag="Tuning" Style="{StaticResource StandardSecondaryButtonStyle}" Height="32" HorizontalAlignment="Stretch" Padding="2,0" CornerRadius="6" ToolTipService.ToolTip="Tối ưu hóa hiệu năng &amp; Chơi game">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE7FC;" FontSize="11" Foreground="#FFF59E0B"/>
                                <TextBlock Text="Tuning" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="FilterBtnSecurity" Grid.Column="3" Click="OnCategoryFilterClick" Tag="Security" Style="{StaticResource StandardSecondaryButtonStyle}" Height="32" HorizontalAlignment="Stretch" Padding="2,0" CornerRadius="6" ToolTipService.ToolTip="Bảo mật, Quyền riêng tư &amp; Sửa lỗi Windows">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE90F;" FontSize="11" Foreground="Teal"/>
                                <TextBlock Text="Security" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="FilterBtnSystem" Grid.Column="4" Click="OnCategoryFilterClick" Tag="System" Style="{StaticResource StandardSecondaryButtonStyle}" Height="32" HorizontalAlignment="Stretch" Padding="2,0" CornerRadius="6" ToolTipService.ToolTip="Công cụ hệ thống &amp; Quản lý Windows">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE713;" FontSize="11" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock Text="System" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Search Status / Empty State Notification -->
        <Border x:Name="NoResultsCard" Style="{StaticResource GlassmorphismCardStyle}" Padding="32,24" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xE721;" FontSize="32" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="No matching modules found" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Try searching for another keyword like 'clean', 'speed', 'ram', 'game', 'restore', or select 'All Modules'." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center"/>
                <Button Click="OnResetSearchClick" Style="{StaticResource StandardSecondaryButtonStyle}" Content="Clear Search &amp; Show All" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- ==================== 2. INTERACTIVE GUIDE CARDS CONTAINER ==================== -->
        <StackPanel x:Name="CardsContainer" Spacing="16">

            <!-- 1. Dashboard -->
            <Border x:Name="Card_Dashboard" Tag="Care|All|Dashboard|monitor|health|score" Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{StaticResource PrimaryAccentGradient}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE80F;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="10,0,0,0">
                            <TextBlock Text="1. Dashboard &amp; System Health Monitor" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Live Telemetry • Quick RAM Boost • Kernel Diagnostics" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="100% Safe (No System Impact)" FontSize="10.5" Foreground="{ThemeResource AppBadgeGoodFg}" FontWeight="Bold"/>
                            </Border>
                            <Button Click="OnLaunchModuleClick" Tag="Dashboard" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="32" Padding="12,0" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE80F;" FontSize="11" Foreground="White"/>
                                    <TextBlock Text="Launch Module" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="14" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource QuickStatCardStyle}" Padding="14,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Purpose &amp; Overview" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock Text="Provides real-time system monitoring for CPU, RAM, GPU, and Disk utilization, along with continuous Health Score tracking and one-click Quick Boost optimization." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource QuickStatCardStyle}" Padding="14,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Key Capabilities" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock Text="• Real-time animated hardware telemetry meters.&#x0a;• Instant RAM &amp; CPU Working Set flushing via Quick Boost.&#x0a;• Dynamic system health status alert indicators." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Step-by-Step Guide" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="1. Open Dashboard from the top of the left navigation pane." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <TextBlock Text="2. Observe hardware loads and current Health Score." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <TextBlock Text="3. Click [Quick Boost] to instantly reclaim RAM and optimize system processes." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2. AI WinCare Engine -->
            <Border x:Name="Card_AiAssistant" Tag="Care|All|AiWinCareEngine|ai|diagnostics|wincare|engine" Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{StaticResource AiWinCareEngineGradient}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE99A;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="10,0,0,0">
                            <TextBlock Text="2. AI WinCare Engine &amp; Diagnostics" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Intelligent Health Engine • Predictive Storage • Kernel Analysis" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="100% Safe (No System Impact)" FontSize="10.5" Foreground="{ThemeResource AppBadgeGoodFg}" FontWeight="Bold"/>
                            </Border>
                            <Button Click="OnLaunchModuleClick" Tag="aiwincareengine" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="32" Padding="12,0" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE99A;" FontSize="11" Foreground="White"/>
                                    <TextBlock Text="Launch Module" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="14" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource QuickStatCardStyle}" Padding="14,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Purpose &amp; Overview" FontSize="11.5" FontWeight="Bold" Foreground="#FF06B6D4"/>
                                <TextBlock Text="Leverages intelligent AI algorithms to comprehensively scan Windows, analyze health indicators, detect accumulated junk, bottlenecks, and security risks." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource QuickStatCardStyle}" Padding="14,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Key Capabilities" FontSize="11.5" FontWeight="Bold" Foreground="#FF06B6D4"/>
                                <TextBlock Text="• Real-time Health Score calculation based on system telemetry.&#x0a;• Predictive analysis for C: drive storage and boot speed trends.&#x0a;• One-click automated recommendations for system optimizations." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Step-by-Step Guide" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="1. Navigate to the AI Assistant module from the main sidebar." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <TextBlock Text="2. Click [Run AI Diagnostics] to start deep system analysis." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <TextBlock Text="3. Review findings and click [Apply Recommended Tweaks] to automatically optimize." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3. Junk Cleaner -->
            <Border x:Name="Card_Junk" Tag="Care|All|Junk|clean|temp|cache" Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="Orange" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEA99;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="10,0,0,0">
                            <TextBlock Text="3. Junk Cleaner &amp; System Debris" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Temp Cache • Browser Cache • Windows Update Debris • Memory Dumps" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="100% Safe (No System Impact)" FontSize="10.5" Foreground="{ThemeResource AppBadgeGoodFg}" FontWeight="Bold"/>
                            </Border>
                            <Button Click="OnLaunchModuleClick" Tag="Junk" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="32" Padding="12,0" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xEA99;" FontSize="11" Foreground="White"/>
                                    <TextBlock Text="Launch Module" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="14" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource QuickStatCardStyle}" Padding="14,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Purpose &amp; Overview" FontSize="11.5" FontWeight="Bold" Foreground="Orange"/>
                                <TextBlock Text="Deeply scans storage drives to locate and wipe redundant junk files created by Windows OS, web browsers, and third-party applications during daily usage." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource QuickStatCardStyle}" Padding="14,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Key Capabilities" FontSize="11.5" FontWeight="Bold" Foreground="Orange"/>
                                <TextBlock Text="• Cleans Windows temporary files (%TEMP%, Prefetch, Log files).&#x0a;• Wipes browser caches (Chrome, Edge, Firefox, Brave).&#x0a;• Clears Windows Update download cache and installer artifacts." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Step-by-Step Guide" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="1. Select [Junk Cleaner] on the main navigation panel." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <TextBlock Text="2. Click [Scan Directories] to scan for removable system clutter." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <TextBlock Text="3. Check target categories and click [Clean Now] to free up disk space." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 4. App Uninstaller -->
            <Border x:Name="Card_Uninstall" Tag="Care|All|Uninstall|app|software" Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="Red" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE74D;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="10,0,0,0">
                            <TextBlock Text="4. App Uninstaller &amp; Leftovers Purge" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Batch Uninstall • Leftover File &amp; Registry Sweeper • Bloatware Removal" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="Safe (Recommended)" FontSize="10.5" Foreground="{ThemeResource AppBadgeGoodFg}" FontWeight="Bold"/>
                            </Border>
                            <Button Click="OnLaunchModuleClick" Tag="Uninstall" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="32" Padding="12,0" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="White"/>
                                    <TextBlock Text="Launch Module" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="14" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource QuickStatCardStyle}" Padding="14,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Purpose &amp; Overview" FontSize="11.5" FontWeight="Bold" Foreground="Red"/>
                                <TextBlock Text="Uninstalls installed applications and default Windows Bloatware, followed by deep residual registry and directory cleanup." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource QuickStatCardStyle}" Padding="14,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Key Capabilities" FontSize="11.5" FontWeight="Bold" Foreground="Red"/>
                                <TextBlock Text="• Batch uninstall multiple applications simultaneously.&#x0a;• Deep leftover scanner purges AppData, ProgramData, and Registry traces.&#x0a;• Complete removal of unused Windows Store packages." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Step-by-Step Guide" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="1. Launch [App Uninstaller] module." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <TextBlock Text="2. Select software applications to remove." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <TextBlock Text="3. Click [Uninstall] and choose [Wipe Leftovers] to clean all residual data." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 5. Network Center -->
            <Border x:Name="Card_Network" Tag="Care|All|Network|ping|dns|speed" Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="DodgerBlue" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE774;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="10,0,0,0">
                            <TextBlock Text="5. Network Center &amp; Speed Diagnostics" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Bandwidth Speed Test • Flush DNS Cache • TCP Auto-Tuning" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="100% Safe (No System Impact)" FontSize="10.5" Foreground="{ThemeResource AppBadgeGoodFg}" FontWeight="Bold"/>
                            </Border>
                            <Button Click="OnLaunchModuleClick" Tag="Network" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="32" Padding="12,0" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE774;" FontSize="11" Foreground="White"/>
                                    <TextBlock Text="Launch Module" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="14" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource QuickStatCardStyle}" Padding="14,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Purpose &amp; Overview" FontSize="11.5" FontWeight="Bold" Foreground="DodgerBlue"/>
