<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinCarePro.Views.UserGuideView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="18">
        <!-- Header -->
        <StackPanel Spacing="4">
            <TextBlock Text="Feature Guide &amp; System Manual" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="Comprehensive documentation explaining the purpose, detailed features, step-by-step usage, and safety guidelines for each WinCare Pro module." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 1. Dashboard -->
        <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
            <StackPanel Spacing="12">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE80F;" FontSize="18" Foreground="{StaticResource PrimaryAccentBrush}"/>
                        <TextBlock Text="1. Dashboard &amp; System Health Monitor" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                    <Border Background="#1A10B981" BorderBrush="#FF10B981" BorderThickness="1" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                        <TextBlock Text="100% Safe (No System Impact)" FontSize="11" Foreground="#FF10B981" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="Purpose &amp; Overview" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    <TextBlock Text="Provides real-time system monitoring for CPU, RAM, GPU, and Disk utilization, along with continuous Health Score tracking and one-click Quick Boost optimization." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Key Capabilities" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    <TextBlock Text="• Real-time animated hardware telemetry meters.&#x0a;• Instant RAM &amp; CPU Working Set flushing via Quick Boost.&#x0a;• Dynamic system health status alert indicators." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Step-by-Step Guide" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    <TextBlock Text="1. Open Dashboard from the top of the left navigation pane.&#x0a;2. Observe hardware loads and current Health Score.&#x0a;3. Click [Quick Boost] to instantly reclaim RAM and optimize system processes." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 2. AI Assistant -->
        <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
            <StackPanel Spacing="12">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE99A;" FontSize="18" Foreground="{StaticResource PrimaryAccentBrush}"/>
                        <TextBlock Text="2. AI Assistant &amp; Diagnostics" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                    <Border Background="#1A10B981" BorderBrush="#FF10B981" BorderThickness="1" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                        <TextBlock Text="100% Safe (No System Impact)" FontSize="11" Foreground="#FF10B981" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="Purpose &amp; Overview" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    <TextBlock Text="Leverages intelligent AI algorithms to comprehensively scan the Windows system, analyze real-time health indicators, detect accumulated junk files, RAM bottlenecks, slowing background services, and potential security risks." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Key Capabilities" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    <TextBlock Text="• Real-time Health Score calculation based on system telemetry.&#x0a;• Predictive analysis for C: drive storage and boot speed trends.&#x0a;• One-click automated recommendations for system optimizations." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Step-by-Step Guide" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    <TextBlock Text="1. Navigate to the AI Assistant module from the main sidebar.&#x0a;2. Click [Run AI Diagnostics] to start deep system analysis.&#x0a;3. Review findings and click [Apply Recommended Tweaks] to automatically optimize." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 3. Junk Cleaner -->
        <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
            <StackPanel Spacing="12">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEA99;" FontSize="18" Foreground="Orange"/>
                        <TextBlock Text="3. Junk Cleaner &amp; Debris" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                    <Border Background="#1A10B981" BorderBrush="#FF10B981" BorderThickness="1" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                        <TextBlock Text="100% Safe (No System Impact)" FontSize="11" Foreground="#FF10B981" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="Purpose &amp; Overview" FontSize="12" FontWeight="Bold" Foreground="Orange"/>
                    <TextBlock Text="Deeply scans all storage drives to locate and wipe redundant junk files created by Windows OS, web browsers, and third-party applications during daily usage." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Key Capabilities" FontSize="12" FontWeight="Bold" Foreground="Orange"/>
                    <TextBlock Text="• Cleans Windows temporary files (%TEMP%, C:\Windows\Temp, Prefetch, Log files).&#x0a;• Wipes web browser cache (Chrome, Edge, Firefox, Brave).&#x0a;• Clears Windows Update download cache and installer temporary files." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Step-by-Step Guide" FontSize="12" FontWeight="Bold" Foreground="Orange"/>
                    <TextBlock Text="1. Select [Junk Cleaner] on the main navigation panel.&#x0a;2. Click [Scan Directories] to scan for removable system clutter.&#x0a;3. Check target categories and click [Clean Now] to free up disk space." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 4. App Uninstaller -->
        <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
            <StackPanel Spacing="12">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE74D;" FontSize="18" Foreground="Red"/>
                        <TextBlock Text="4. App Uninstaller &amp; Leftovers" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                    <Border Background="#1A10B981" BorderBrush="#FF10B981" BorderThickness="1" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                        <TextBlock Text="Safe (Recommended)" FontSize="11" Foreground="#FF10B981" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="Purpose &amp; Overview" FontSize="12" FontWeight="Bold" Foreground="Red"/>
                    <TextBlock Text="Uninstalls installed applications and default Windows Bloatware, followed by deep residual registry and directory cleanup." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Key Capabilities" FontSize="12" FontWeight="Bold" Foreground="Red"/>
                    <TextBlock Text="• Batch uninstall multiple applications simultaneously.&#x0a;• Deep leftover scanner purges AppData, ProgramData, and Registry traces.&#x0a;• Complete removal of unused Windows Store packages." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Step-by-Step Guide" FontSize="12" FontWeight="Bold" Foreground="Red"/>
                    <TextBlock Text="1. Launch [App Uninstaller] module.&#x0a;2. Select software applications to remove.&#x0a;3. Click [Uninstall] and choose [Wipe Leftovers] to clean all residual data." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 5. Network Center -->
        <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
            <StackPanel Spacing="12">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE774;" FontSize="18" Foreground="DodgerBlue"/>
                        <TextBlock Text="5. Network Center" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                    <Border Background="#1A10B981" BorderBrush="#FF10B981" BorderThickness="1" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                        <TextBlock Text="100% Safe (No System Impact)" FontSize="11" Foreground="#FF10B981" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="Purpose &amp; Overview" FontSize="12" FontWeight="Bold" Foreground="DodgerBlue"/>
                    <TextBlock Text="Diagnoses internet connection health, tests bandwidth speeds, and resolves network connectivity issues or latency spikes." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Key Capabilities" FontSize="12" FontWeight="Bold" Foreground="DodgerBlue"/>
                    <TextBlock Text="• Precision Speed Test for Download, Upload, and Latency/Ping metrics.&#x0a;• One-click Flush DNS Resolver Cache.&#x0a;• TCP Auto-Tuning optimization and Secure DoH (DNS over HTTPS) toggles." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Step-by-Step Guide" FontSize="12" FontWeight="Bold" Foreground="DodgerBlue"/>
                    <TextBlock Text="1. Open [Network Center].&#x0a;2. Click [Run Speed Test] to analyze latency and bandwidth.&#x0a;3. Click [Flush DNS Cache] or [Reset TCP/IP Stack] to resolve network issues." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 6. System Repair -->
        <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
            <StackPanel Spacing="12">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE90F;" FontSize="18" Foreground="Teal"/>
                        <TextBlock Text="6. System Repair Center" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                    <Border Background="#1A3B82F6" BorderBrush="#FF3B82F6" BorderThickness="1" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                        <TextBlock Text="Requires Administrator Privileges" FontSize="11" Foreground="#FF3B82F6" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="Purpose &amp; Overview" FontSize="12" FontWeight="Bold" Foreground="Teal"/>
                    <TextBlock Text="Integrates advanced Windows diagnostic and repair utilities to automatically repair corrupt system files, component store corruption, and Windows Update errors." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Key Capabilities" FontSize="12" FontWeight="Bold" Foreground="Teal"/>
                    <TextBlock Text="• SFC Repair (sfc /scannow): Scans and restores corrupted Windows system binaries.&#x0a;• DISM Component Restore: Repairs damaged Windows Component Store packages.&#x0a;• Windows Update Repair: Resets update cache and stuck service states.&#x0a;• Network Repair: Resets Winsock catalog and TCP/IP stack." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Step-by-Step Guide" FontSize="12" FontWeight="Bold" Foreground="Teal"/>
                    <TextBlock Text="1. Go to [System Repair] section.&#x0a;2. Select [SFC Repair] or [DISM Restore] based on system issues.&#x0a;3. Allow process to complete and restart Windows if prompted." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 7. Security Shield -->
        <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
            <StackPanel Spacing="12">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE727;" FontSize="18" Foreground="MediumSpringGreen"/>
                        <TextBlock Text="7. Security Shield &amp; Privacy" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                    <Border Background="#1A10B981" BorderBrush="#FF10B981" BorderThickness="1" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                        <TextBlock Text="100% Safe (No System Impact)" FontSize="11" Foreground="#FF10B981" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="Purpose &amp; Overview" FontSize="12" FontWeight="Bold" Foreground="MediumSpringGreen"/>
                    <TextBlock Text="Protects personal privacy by purging activity histories, temporary clipboard data, and disabling Windows telemetry tracking." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Key Capabilities" FontSize="12" FontWeight="Bold" Foreground="MediumSpringGreen"/>
                    <TextBlock Text="• Wipes sensitive data stored in clipboard cache (Wipe Clipboard).&#x0a;• Clears Recent Files and application launch history.&#x0a;• Disables telemetry and diagnostic tracking services." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Step-by-Step Guide" FontSize="12" FontWeight="Bold" Foreground="MediumSpringGreen"/>
                    <TextBlock Text="1. Open [Security Shield] section.&#x0a;2. Click [Wipe Clipboard Cache] to secure clipboard contents.&#x0a;3. Click [Clear Recent Files] to remove personal activity traces." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 8. System Optimizer -->
        <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
            <StackPanel Spacing="12">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7FC;" FontSize="18" Foreground="#FFF59E0B"/>
                        <TextBlock Text="8. System Optimizer &amp; RAM Booster" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                    <Border Background="#1A10B981" BorderBrush="#FF10B981" BorderThickness="1" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                        <TextBlock Text="Safe (Recommended)" FontSize="11" Foreground="#FF10B981" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="Purpose &amp; Overview" FontSize="12" FontWeight="Bold" Foreground="#FFF59E0B"/>
                    <TextBlock Text="Applies Microsoft-compliant Registry tweaks to optimize CPU scheduling, disable unnecessary services, and reclaim active physical RAM memory." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Key Capabilities" FontSize="12" FontWeight="Bold" Foreground="#FFF59E0B"/>
                    <TextBlock Text="• Gaming Turbo 2.0 Mode: Flushes process working sets and prioritizes CPU for active games.&#x0a;• Windows Registry latency tweaks for ultra-responsive system performance.&#x0a;• Automatic creation of System Restore Points prior to applying tweaks." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Step-by-Step Guide" FontSize="12" FontWeight="Bold" Foreground="#FFF59E0B"/>
                    <TextBlock Text="1. Open the [System Optimizer] page.&#x0a;2. Toggle [Enable Gaming Turbo] for instant gaming acceleration.&#x0a;3. Select desired system tweaks and click [Apply Tweaks]." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 9. Context Menu -->
        <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
            <StackPanel Spacing="12">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE71D;" FontSize="18" Foreground="Thistle"/>
                        <TextBlock Text="9. Context Menu Manager" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                    <Border Background="#1A10B981" BorderBrush="#FF10B981" BorderThickness="1" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                        <TextBlock Text="Safe (Recommended)" FontSize="11" Foreground="#FF10B981" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="Purpose &amp; Overview" FontSize="12" FontWeight="Bold" Foreground="Thistle"/>
                    <TextBlock Text="Manages shortcuts and background shell extensions displayed in the Windows Explorer right-click Context Menu for cleaner, faster File Explorer operation." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Key Capabilities" FontSize="12" FontWeight="Bold" Foreground="Thistle"/>
                    <TextBlock Text="• Easily enable or disable third-party context menu entries.&#x0a;• Removes legacy or broken shell extension links.&#x0a;• Prevents Explorer freeze when right-clicking files or folders." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Step-by-Step Guide" FontSize="12" FontWeight="Bold" Foreground="Thistle"/>
                    <TextBlock Text="1. Navigate to [Context Menu] from the sidebar.&#x0a;2. Review registered shell menu items.&#x0a;3. Toggle off items you do not use to speed up File Explorer." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 10. Startup & Services -->
        <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
            <StackPanel Spacing="12">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7B5;" FontSize="18" Foreground="Gold"/>
                        <TextBlock Text="10. Startup &amp; Services Manager" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                    <Border Background="#1A10B981" BorderBrush="#FF10B981" BorderThickness="1" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                        <TextBlock Text="Safe (Recommended)" FontSize="11" Foreground="#FF10B981" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="Purpose &amp; Overview" FontSize="12" FontWeight="Bold" Foreground="Gold"/>
                    <TextBlock Text="Controls software configured to start automatically with Windows and manages background system services to deliver rapid boot times." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Key Capabilities" FontSize="12" FontWeight="Bold" Foreground="Gold"/>
                    <TextBlock Text="• Analyzes startup impact on boot performance (High/Medium/Low Impact).&#x0a;• Toggle enable/disable status for background applications.&#x0a;• Built-in Safety Guard protects core Microsoft system services from accidental disabling." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Step-by-Step Guide" FontSize="12" FontWeight="Bold" Foreground="Gold"/>
                    <TextBlock Text="1. Open the [Startup &amp; Services] module.&#x0a;2. Review auto-starting items and disable unnecessary High Impact entries.&#x0a;3. Click [Boost Boot Speed] to let AI optimize boot sequence." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 11. Disk Tools -->
        <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
            <StackPanel Spacing="12">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7F1;" FontSize="18" Foreground="SkyBlue"/>
                        <TextBlock Text="11. Disk Tools &amp; Storage Sustainability" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                    <Border Background="#1A10B981" BorderBrush="#FF10B981" BorderThickness="1" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                        <TextBlock Text="100% Safe (No System Impact)" FontSize="11" Foreground="#FF10B981" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="Purpose &amp; Overview" FontSize="12" FontWeight="Bold" Foreground="SkyBlue"/>
                    <TextBlock Text="Analyzes disk space consumption, predicts storage sustainability timelines, and provides drive optimization tools." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Key Capabilities" FontSize="12" FontWeight="Bold" Foreground="SkyBlue"/>
                    <TextBlock Text="• Disk space analyzer with folder size visualization.&#x0a;• AI-driven Storage Sustainability timeline prediction.&#x0a;• TRIM optimization for SSDs and defragmentation trigger for HDDs." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Step-by-Step Guide" FontSize="12" FontWeight="Bold" Foreground="SkyBlue"/>
                    <TextBlock Text="1. Select [Disk Tools] from menu.&#x0a;2. View storage breakdown and sustainability report.&#x0a;3. Run TRIM or Clean Drive to reclaim space." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 12. Registry Center -->
        <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
            <StackPanel Spacing="12">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEDA2;" FontSize="18" Foreground="Tomato"/>
                        <TextBlock Text="12. Registry Center &amp; Registry Cleaner" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                    <Border Background="#1A10B981" BorderBrush="#FF10B981" BorderThickness="1" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                        <TextBlock Text="Safe (Recommended)" FontSize="11" Foreground="#FF10B981" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="Purpose &amp; Overview" FontSize="12" FontWeight="Bold" Foreground="Tomato"/>
                    <TextBlock Text="Scans for invalid registry keys, orphaned file extensions, and broken installation entries while backing up HKLM and HKCU partitions for absolute safety." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Key Capabilities" FontSize="12" FontWeight="Bold" Foreground="Tomato"/>
                    <TextBlock Text="• Deep Registry error scanner targeting file associations &amp; CLSIDs.&#x0a;• Automatic 1-Click Registry Backup before cleaning operations.&#x0a;• Instant roll-back restore for created registry backups." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Step-by-Step Guide" FontSize="12" FontWeight="Bold" Foreground="Tomato"/>
                    <TextBlock Text="1. Open [Registry Center].&#x0a;2. Click [Scan Registry] to detect invalid registry keys.&#x0a;3. Click [Clean Selected] (automatic backup will be created)." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 13. Software Updater -->
        <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
            <StackPanel Spacing="12">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE75C;" FontSize="18" Foreground="Crimson"/>
                        <TextBlock Text="13. Software Updater &amp; Package Manager" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                    <Border Background="#1A10B981" BorderBrush="#FF10B981" BorderThickness="1" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                        <TextBlock Text="100% Safe (No System Impact)" FontSize="11" Foreground="#FF10B981" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="Purpose &amp; Overview" FontSize="12" FontWeight="Bold" Foreground="Crimson"/>
                    <TextBlock Text="Scans installed third-party applications for available security patches and software updates, enabling silent 1-click batch updates." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Key Capabilities" FontSize="12" FontWeight="Bold" Foreground="Crimson"/>
                    <TextBlock Text="• Automatic background checks for outdated software packages.&#x0a;• Silent installer execution without manual wizard clicking.&#x0a;• Direct integration with official winget package repositories." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Step-by-Step Guide" FontSize="12" FontWeight="Bold" Foreground="Crimson"/>
                    <TextBlock Text="1. Select [Software Updater].&#x0a;2. Click [Check for Updates] to scan installed apps.&#x0a;3. Click [Update All] to upgrade software automatically." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 14. Desktop Mini Widget -->
        <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
            <StackPanel Spacing="12">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE70F;" FontSize="18" Foreground="{StaticResource PrimaryAccentBrush}"/>
                        <TextBlock Text="14. Desktop Mini Widget &amp; System Tray Bar" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                    <Border Background="#1A10B981" BorderBrush="#FF10B981" BorderThickness="1" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                        <TextBlock Text="100% Safe (No System Impact)" FontSize="11" Foreground="#FF10B981" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="Purpose &amp; Overview" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    <TextBlock Text="Offers a compact floating desktop toolbar displaying live CPU/RAM usage meters, quick boost trigger, and system tray notification controls." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Key Capabilities" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    <TextBlock Text="• Compact floating widget with customizable opacity.&#x0a;• 1-Click Quick RAM boost directly from desktop without opening main window.&#x0a;• Minimize to System Tray support for low resource overhead." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Step-by-Step Guide" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    <TextBlock Text="1. Enable [Desktop Widget] from Settings or System Tray menu.&#x0a;2. Position widget anywhere on screen.&#x0a;3. Click the rocket icon on widget to flush RAM anytime." TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
