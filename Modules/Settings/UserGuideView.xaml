                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="10,0,0,0">
                            <TextBlock Text="12. Registry Center &amp; Cleaner" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Invalid Keys Scanner • 1-Click Rollback Backup • Orphaned Traces" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="Safe (Recommended)" FontSize="10.5" Foreground="{ThemeResource AppBadgeGoodFg}" FontWeight="Bold"/>
                            </Border>
                            <Button Click="OnLaunchModuleClick" Tag="Registry" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="32" Padding="12,0" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xEDA2;" FontSize="11" Foreground="White"/>
                                    <TextBlock Text="Launch Module" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="14" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource QuickStatCardStyle}" Padding="14,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Purpose &amp; Overview" FontSize="11.5" FontWeight="Bold" Foreground="Tomato"/>
                                <TextBlock Text="Scans for invalid registry keys, orphaned file extensions, and broken installation entries while backing up HKLM and HKCU partitions for absolute safety." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource QuickStatCardStyle}" Padding="14,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Key Capabilities" FontSize="11.5" FontWeight="Bold" Foreground="Tomato"/>
                                <TextBlock Text="• Deep Registry error scanner targeting file associations &amp; CLSIDs.&#x0a;• Automatic 1-Click Registry Backup before cleaning operations.&#x0a;• Instant roll-back restore for created registry backups." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Step-by-Step Guide" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="1. Open [Registry Center]." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <TextBlock Text="2. Click [Scan Registry] to detect invalid registry keys." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <TextBlock Text="3. Click [Clean Selected] (automatic backup will be created)." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 13. Software Updater -->
            <Border x:Name="Card_Updater" Tag="System|All|Updater|packages" Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="Crimson" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE75C;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="10,0,0,0">
                            <TextBlock Text="13. Software Updater &amp; Package Manager" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Silent App Updates • Winget Integration • Security Patch Scanning" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="100% Safe (No System Impact)" FontSize="10.5" Foreground="{ThemeResource AppBadgeGoodFg}" FontWeight="Bold"/>
                            </Border>
                            <Button Click="OnLaunchModuleClick" Tag="Updater" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="32" Padding="12,0" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE895;" FontSize="11" Foreground="White"/>
                                    <TextBlock Text="Launch Module" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="14" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource QuickStatCardStyle}" Padding="14,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Purpose &amp; Overview" FontSize="11.5" FontWeight="Bold" Foreground="Crimson"/>
                                <TextBlock Text="Scans installed third-party applications for available security patches and software updates, enabling silent 1-click batch updates." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource QuickStatCardStyle}" Padding="14,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Key Capabilities" FontSize="11.5" FontWeight="Bold" Foreground="Crimson"/>
                                <TextBlock Text="• Automatic background checks for outdated software packages.&#x0a;• Silent installer execution without manual wizard clicking.&#x0a;• Direct integration with official winget package repositories." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Step-by-Step Guide" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="1. Select [Software Updater]." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <TextBlock Text="2. Click [Check for Updates] to scan installed apps." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <TextBlock Text="3. Click [Update All] to upgrade software automatically." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 14. Desktop Mini Widget -->
            <Border x:Name="Card_Widget" Tag="System|All|DesktopWidget|widget|tray" Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{StaticResource PrimaryAccentGradient}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8A7;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="10,0,0,0">
                            <TextBlock Text="14. Desktop Mini Widget &amp; System Tray Bar" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Floating HUD Overlay • 1-Click Desktop RAM Boost • Always-on-Top" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="100% Safe (No System Impact)" FontSize="10.5" Foreground="{ThemeResource AppBadgeGoodFg}" FontWeight="Bold"/>
                            </Border>
                            <Button Click="OnLaunchWidgetClick" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="32" Padding="12,0" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="11" Foreground="White"/>
                                    <TextBlock Text="Toggle HUD Widget" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="14" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource QuickStatCardStyle}" Padding="14,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Purpose &amp; Overview" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock Text="Offers a compact floating desktop toolbar displaying live CPU/RAM usage meters, quick boost trigger, and system tray notification controls." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource QuickStatCardStyle}" Padding="14,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Key Capabilities" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock Text="• Compact floating widget with customizable opacity.&#x0a;• 1-Click Quick RAM boost directly from desktop without opening main window.&#x0a;• Minimize to System Tray support for low resource overhead." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Step-by-Step Guide" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="1. Enable [Desktop Widget] from Settings or System Tray menu." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <TextBlock Text="2. Position widget anywhere on screen." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <TextBlock Text="3. Click the rocket icon on widget to flush RAM anytime." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 15. FAQ & Safe Operation Guidelines -->
            <Border x:Name="Card_SafetyFaq" Tag="All|Security|faq|safe|help" Style="{StaticResource ElevatedGlassCardStyle}" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#FF10B981" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE82F;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="10,0,0,0">
                            <TextBlock Text="15. FAQ &amp; Safe Operation Principles" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="System Restore Protection • Safe Deletion Standards • Reversible Optimization" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="14" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource QuickStatCardStyle}" Padding="14,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Zero Risk Guarantee" FontSize="11.5" FontWeight="Bold" Foreground="#FF10B981"/>
                                <TextBlock Text="WinCare Pro strictly adheres to official Microsoft APIs and Windows Service architectures. All operations create backups or restore points prior to execution." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource QuickStatCardStyle}" Padding="14,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Need Technical Support?" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock Text="Visit the GitHub repository or submit an issue via Settings > About WinCare Pro for rapid technical guidance." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </StackPanel>
</UserControl>
