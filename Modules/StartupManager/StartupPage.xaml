<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.StartupPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinCarePro.Models"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    mc:Ignorable="d">

    <Grid Padding="24,20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutVisualStates">
                <!-- Wide Layout: Viewport Width >= 1000px -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- Narrow Layout: Viewport Width < 1000px -->
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Page Header -->
            <RowDefinition Height="Auto" /> <!-- Top Dashboard -->
            <RowDefinition Height="Auto" /> <!-- Filter bar -->
            <RowDefinition Height="*" />    <!-- Content Area -->
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Style="{StaticResource PageHeaderIconBadgeStyle}" Background="{StaticResource CyberAccentGradient}">
                        <FontIcon Glyph="&#xE7B5;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Startup &amp; Services Manager" Style="{StaticResource PageHeaderTitleStyle}" VerticalAlignment="Center"/>
                    <Border Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="6" Height="6" Fill="{ThemeResource AppBadgeGoodFg}"/>
                            <TextBlock Text="Boot Optimizer Active" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppBadgeGoodFg}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="Control startup apps &amp; boot velocity." Style="{StaticResource PageHeaderSubtitleStyle}"/>
            </StackPanel>
        </Grid>

        <!-- 1. High-End Dashboard Section -->
        <!-- 1. High-End Dashboard Section (Unified Stat Ribbon Layout) -->
        <Border Grid.Row="1" Margin="0,0,0,18" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,12"
                helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="5.0" helpers:Animation3DHelper.DepthZ="14">
            <Grid x:Name="TopGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" /> <!-- Divider -->
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" /> <!-- Divider -->
                    <ColumnDefinition Width="1.8*" />
                </Grid.ColumnDefinitions>

                <!-- Section 1: Boot Performance Info -->
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="19" Background="{ThemeResource AppStatusWarningBackground}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE814;" FontSize="16" Foreground="{ThemeResource AppStatusWarningBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Last Boot Duration" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.BootTimeFormatted, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource SystemControlPageTextBaseHighBrush}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                </Grid>

                <!-- Vertical Divider 1 -->
                <Border Grid.Column="1" Width="1" Height="36" Background="{ThemeResource ControlStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.4" VerticalAlignment="Center"/>

                <!-- Section 2: Startup Health Score -->
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="42" Height="42" Margin="0,0,12,0" VerticalAlignment="Center">
                        <ProgressRing Value="{x:Bind ViewModel.OptimizationScore, Mode=OneWay}" 
                                      Minimum="0" Maximum="100" 
                                      Width="38" Height="38" 
                                      Background="{ThemeResource ControlStrokeColorDefaultBrush}" 
                                      Foreground="{x:Bind ScoreToBrush(ViewModel.OptimizationScore), Mode=OneWay}"
                                      IsIndeterminate="False"/>
                        <TextBlock Text="{x:Bind ScoreToString(ViewModel.OptimizationScore), Mode=OneWay}" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Startup Health" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <TextBlock Text="{x:Bind ScoreToStatusText(ViewModel.OptimizationScore), Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{x:Bind ScoreToBrush(ViewModel.OptimizationScore), Mode=OneWay}"/>
                    </StackPanel>
                </Grid>

                <!-- Vertical Divider 2 -->
                <Border Grid.Column="3" Width="1" Height="36" Background="{ThemeResource ControlStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.4" VerticalAlignment="Center"/>

                <!-- Section 3: Smart Optimizer Suggestions -->
                <Grid Grid.Column="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                        <TextBlock Text="Smart Insights" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.OptimizationSuggestions, Mode=OneWay}" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Name="QuickOptimizeBtn" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OnQuickOptimizeClick" VerticalAlignment="Center" Padding="12,6" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ProgressRing x:Name="BoostSpeedRing" IsActive="False" Visibility="Collapsed" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BoostSpeedText" Text="Boost Boot Speed" FontSize="12.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- 2. Filter & Actions Toolbar -->
        <Border Grid.Row="2" Margin="0,0,0,14" Style="{StaticResource GlassmorphismCardStyle}" Padding="12,8"
                helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="3.0" helpers:Animation3DHelper.DepthZ="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search box -->
                <TextBox x:Name="FilterBox" 
                         PlaceholderText="Search apps, services, or tasks..." 
                         Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="34" CornerRadius="6" VerticalAlignment="Center"/>

                <!-- Filter CheckBoxes -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center" Margin="16,0,0,0">
                    <CheckBox Content="Microsoft Items" IsChecked="{x:Bind ViewModel.FilterMicrosoft, Mode=TwoWay}" FontSize="12" CornerRadius="4"/>
                    <CheckBox Content="Third-Party Items" IsChecked="{x:Bind ViewModel.FilterThirdParty, Mode=TwoWay}" FontSize="12" CornerRadius="4"/>
                    <CheckBox Content="High Impact Only" IsChecked="{x:Bind ViewModel.FilterHighImpact, Mode=TwoWay}" FontSize="12" CornerRadius="4"/>
                </StackPanel>

                <!-- Scan Button -->
                <Button x:Name="ScanButton" Grid.Column="2" Click="OnReloadStartupClick" IsEnabled="{x:Bind IsNot(ViewModel.IsLoading), Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" Height="34" Padding="14,0" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ProgressRing x:Name="ScanSystemRing" IsActive="False" Visibility="Collapsed" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                        <FontIcon x:Name="ScanSystemIcon" Glyph="&#xE72C;" FontSize="13" Foreground="White" Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}"/>
                        <TextBlock x:Name="ScanSystemText" Text="Scan System" FontSize="12.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 3. Content Tabs Area (Pivot) -->
        <Pivot x:Name="ContentPivot" Grid.Row="3" SelectionChanged="OnPivotSelectionChanged">
            <!-- Tab 1: Startup Applications -->
            <PivotItem Header="Startup Applications">
                <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="12" Margin="0,10,0,0">
                    <Grid>
                        <ListView ItemsSource="{x:Bind ViewModel.StartupApps, Mode=OneWay}" SelectionMode="None">
                            <ListView.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,6" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3.2*" />
                                            <ColumnDefinition Width="{Binding ElementName=PageRoot, Path=PublisherColWidth}" />
                                            <ColumnDefinition Width="{Binding ElementName=PageRoot, Path=ImpactColWidth}" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Application" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="Publisher" FontWeight="Bold" FontSize="11" Visibility="{Binding ElementName=PageRoot, Path=WideLayoutVisibility}"/>
                                        <TextBlock Grid.Column="2" Text="Impact" FontWeight="Bold" FontSize="11" Visibility="{Binding ElementName=PageRoot, Path=WideLayoutVisibility}"/>
                                        <TextBlock Grid.Column="3" Text="State" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                        <TextBlock Grid.Column="4" Text="Action" FontWeight="Bold" FontSize="11" Margin="8,0,8,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.HeaderTemplate>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:StartupEntry">
                                    <Border Style="{StaticResource Tilt3DCardStyle}" Padding="10,8" Margin="0,0,0,4"
                                            helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="3.5" helpers:Animation3DHelper.DepthZ="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3.2*" />
                                                <ColumnDefinition Width="{Binding ElementName=PageRoot, Path=PublisherColWidth}" />
                                                <ColumnDefinition Width="{Binding ElementName=PageRoot, Path=ImpactColWidth}" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Application details -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- App Icon with 3D Elevation -->
                                                <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <Grid>
                                                        <Image Source="{x:Bind IconImageSource, Mode=OneWay}" Width="24" Height="24" Stretch="Uniform" Visibility="{x:Bind HasIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <FontIcon Glyph="&#xE71D;" FontSize="15" Foreground="{StaticResource PrimaryAccentBrush}" Visibility="{x:Bind HasIcon, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="12.5"/>
                                                    <TextBlock Text="{x:Bind Path}" FontSize="9.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="NoWrap" MaxWidth="320" ToolTipService.ToolTip="{x:Bind Path}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Publisher -->
                                            <TextBlock Grid.Column="1" Text="{x:Bind Publisher}" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="{Binding ElementName=PageRoot, Path=WideLayoutVisibility}"/>

                                            <!-- Impact Badge -->
                                            <Border Grid.Column="2" Background="{x:Bind ImpactBgBrush, Mode=OneWay}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="{Binding ElementName=PageRoot, Path=WideLayoutVisibility}">
                                                <TextBlock Text="{x:Bind StartupImpact}" FontSize="10.5" FontWeight="Bold" Foreground="{x:Bind ImpactFgBrush, Mode=OneWay}"/>
                                            </Border>

                                            <!-- State Switch -->
                                            <ToggleSwitch Grid.Column="3" IsOn="{x:Bind IsEnabled, Mode=OneWay}" Toggled="OnStartupToggled" CornerRadius="4" MinWidth="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>

                                            <!-- Action (Delete) -->
                                            <Button Grid.Column="4" Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Width="32" Height="32" Click="OnDeleteStartupClick" VerticalAlignment="Center" ToolTipService.ToolTip="Permanently delete from startup">
                                                <FontIcon Glyph="&#xE74D;" FontSize="13.5" Foreground="#FFEF4444" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </PivotItem>

            <!-- Tab 2: Background Services -->
            <PivotItem Header="Background Services">
                <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="24" Margin="0,10,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="24" HorizontalAlignment="Stretch">
                            
                            <!-- 2-Column Grid for Management Tool Shortcuts -->
                            <Grid ColumnSpacing="14" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Card 1: Services Manager (services.msc) -->
                                <Border Grid.Column="0" Style="{StaticResource Tilt3DCardStyle}" Padding="16,14"
                                        helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="3.5" helpers:Animation3DHelper.DepthZ="8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{ThemeResource AppStatusInfoBackground}" BorderBrush="{ThemeResource AppStatusInfoBorder}" BorderThickness="1.2" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="{ThemeResource AppStatusInfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="Services Manager" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="services.msc · Configure Windows services startup types" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        
                                        <Button Grid.Column="2" Click="OnOpenServicesMscClick" Style="{StaticResource DefaultButtonStyle}" CornerRadius="8" Height="32" Padding="12,0" VerticalAlignment="Center" ToolTipService.ToolTip="Open Windows Services Manager">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8A7;" FontSize="11"/>
                                                <TextBlock Text="Open" FontSize="11.5" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Card 2: Task Manager Services View -->
                                <Border Grid.Column="1" Style="{StaticResource Tilt3DCardStyle}" Padding="16,14"
                                        helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="3.5" helpers:Animation3DHelper.DepthZ="8">
                                     <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{ThemeResource AppStatusWarningBackground}" BorderBrush="{ThemeResource AppStatusWarningBorder}" BorderThickness="1.2" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE9D9;" FontSize="18" Foreground="{ThemeResource AppStatusWarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="Task Manager Services" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="taskmgr.exe · Monitor live service PIDs &amp; RAM usage" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        
                                        <Button Grid.Column="2" Click="OnOpenTaskMgrServicesClick" Style="{StaticResource DefaultButtonStyle}" CornerRadius="8" Height="32" Padding="12,0" VerticalAlignment="Center" ToolTipService.ToolTip="Open Task Manager Services View">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8A7;" FontSize="11"/>
                                                <TextBlock Text="Open" FontSize="11.5" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Service Safety Protection Notice Banner -->
                            <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="20" Background="{ThemeResource AppStatusGoodBackground}" BorderBrush="{ThemeResource AppStatusGoodBorder}" BorderThickness="1" CornerRadius="12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="22" Background="{ThemeResource AppStatusGoodBackground}" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE83D;" FontSize="20" Foreground="{ThemeResource AppStatusGoodBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="System Services Safety Guard" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <Border Style="{StaticResource StatusBadgeGoodStyle}" VerticalAlignment="Center">
                                                <TextBlock Text="14 Core Services Protected" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AppStatusGoodBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Protects vital Windows services (WinDefend, RpcSs, EventLog, Dhcp) against accidental termination." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </PivotItem>



            <!-- Tab 3: Scheduled Tasks -->
            <PivotItem Header="Scheduled Tasks">
                <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="12" Margin="0,10,0,0">
                    <Grid>
                        <ListView ItemsSource="{x:Bind ViewModel.ScheduledTasks, Mode=OneWay}" SelectionMode="None">
                            <ListView.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,6" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.8*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="1.8*" />
                                            <ColumnDefinition Width="1.8*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Task Name / Action" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="Author" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Grid.Column="2" Text="Last Execution Time" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Grid.Column="3" Text="Next Execution Time" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Grid.Column="4" Text="State" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                        <TextBlock Grid.Column="5" Text="Action" FontWeight="Bold" FontSize="11" Margin="8,0,8,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.HeaderTemplate>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ScheduledTaskEntry">
                                    <Grid Padding="8,8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.8*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="1.8*" />
                                            <ColumnDefinition Width="1.8*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Task details -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="30" Height="30" CornerRadius="6" Background="#1E8B5CF6" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE787;" FontSize="15" Foreground="#FF8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Width="230">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}"/>
                                                <TextBlock Text="{x:Bind Action}" FontSize="9.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Action}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Author -->
                                        <TextBlock Grid.Column="1" Text="{x:Bind Author}" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        <!-- Last Run -->
                                        <TextBlock Grid.Column="2" Text="{x:Bind DisplayLastRunTime, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center"/>

                                        <!-- Next Run -->
                                        <TextBlock Grid.Column="3" Text="{x:Bind DisplayNextRunTime, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center"/>

                                        <!-- State Switch -->
                                        <ToggleSwitch Grid.Column="4" IsOn="{x:Bind IsEnabled, Mode=OneWay}" Toggled="OnTaskToggled" CornerRadius="4" MinWidth="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>

                                        <!-- Action (Delete) -->
                                        <Button Grid.Column="5" Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Width="32" Height="32" Click="OnDeleteTaskClick" VerticalAlignment="Center" ToolTipService.ToolTip="Permanently delete scheduled task">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13.5" Foreground="#FFEF4444" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </PivotItem>
        </Pivot>

        <!-- 4. Loading Overlay Indicator — smooth fade in/out -->
        <Grid x:Name="LoadingOverlayGrid" Grid.Row="0" Grid.RowSpan="4" Background="#60000000" Visibility="Collapsed" Opacity="0" Canvas.ZIndex="999" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.Resources>
                <Storyboard x:Name="FadeInLoading">
                    <DoubleAnimation Storyboard.TargetName="LoadingOverlayGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
                <Storyboard x:Name="FadeOutLoading" Completed="FadeOutLoading_Completed">
                    <DoubleAnimation Storyboard.TargetName="LoadingOverlayGrid" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </Grid.Resources>
            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1.5" CornerRadius="16" Padding="36,24" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
                <StackPanel Spacing="14" HorizontalAlignment="Center">
                    <!-- Glowing Rocket Badge -->
                    <Grid Width="60" Height="60" HorizontalAlignment="Center">
                        <Border Width="60" Height="60" CornerRadius="18" Background="{StaticResource PrimaryAccentLightBrush}" BorderBrush="{StaticResource PrimaryAccentBorderBrush}" BorderThickness="1.5">
                            <FontIcon Glyph="&#xE7B5;" FontSize="22" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="14" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.LoadingStatus, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Linear Progress Bar -->
                    <Border Background="#1AFFFFFF" CornerRadius="4" Height="8" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="1" Width="280">
