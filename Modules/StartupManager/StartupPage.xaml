<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.StartupPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinCarePro.Models"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    mc:Ignorable="d">

    <Grid Padding="24,20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutVisualStates">
                <!-- Wide Layout: Viewport Width >= 1000px -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- Narrow Layout: Viewport Width < 1000px -->
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Page Header -->
            <RowDefinition Height="Auto" /> <!-- Filter bar -->
            <RowDefinition Height="*" />    <!-- Content Area -->
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Startup &amp; Services Manager" Style="{StaticResource PageHeaderTitleStyle}" VerticalAlignment="Center"/>
                    <Border Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="6" Height="6" Fill="{ThemeResource AppBadgeGoodFg}"/>
                            <TextBlock Text="Boot Optimizer Active" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppBadgeGoodFg}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="Control startup apps &amp; boot velocity." Style="{StaticResource PageHeaderSubtitleStyle}"/>
            </StackPanel>

            <!-- Live Boot Telemetry Summary Pill Strip -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="10" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEC4A;" FontSize="13" Foreground="{StaticResource PrimaryAccentBrush}"/>
                        <TextBlock Text="Boot Time" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.BootTimeFormatted, Mode=OneWay}" FontSize="12.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="10" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7B8;" FontSize="13" Foreground="{ThemeResource AppStatusPurpleBrush}"/>
                        <TextBlock Text="Startup Apps" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.TotalStartupApps, Mode=OneWay}" FontSize="12.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="10" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE912;" FontSize="13" Foreground="{ThemeResource AppStatusGoodBrush}"/>
                        <TextBlock Text="Services" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.TotalRunningServices, Mode=OneWay}" FontSize="12.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 1. Filter & Actions Toolbar -->
        <Border Grid.Row="1" Margin="0,0,0,14" Style="{StaticResource CockpitBentoCardStyle}" Padding="12,8"
                helpers:AnimationHelper.StaggerIndex="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search box -->
                <TextBox x:Name="FilterBox" 
                         PlaceholderText="Search apps, services, or tasks..." 
                         Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="34" CornerRadius="6" VerticalAlignment="Center"/>

                <!-- Filter CheckBoxes & Sort Selection -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center" Margin="14,0,0,0">
                    <CheckBox Content="Microsoft Items" IsChecked="{x:Bind ViewModel.FilterMicrosoft, Mode=TwoWay}" FontSize="12" CornerRadius="4"/>
                    <CheckBox Content="Third-Party Items" IsChecked="{x:Bind ViewModel.FilterThirdParty, Mode=TwoWay}" FontSize="12" CornerRadius="4"/>
                    <CheckBox Content="High Impact Only" IsChecked="{x:Bind ViewModel.FilterHighImpact, Mode=TwoWay}" FontSize="12" CornerRadius="4"/>
                    
                    <!-- Sort Selection Dropdown -->
                    <ComboBox Height="32" SelectionChanged="OnSortSelectionChanged" SelectedIndex="0" CornerRadius="6" VerticalAlignment="Center" MinWidth="130" FontSize="11.5">
                        <ComboBoxItem Content="Name (A-Z)"/>
                        <ComboBoxItem Content="Name (Z-A)"/>
                        <ComboBoxItem Content="Impact (High-Low)"/>
                        <ComboBoxItem Content="State (Active First)"/>
                    </ComboBox>
                </StackPanel>

                <!-- Action Button Cluster -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Export Report -->
                    <Button Click="OnExportReportClick" Style="{StaticResource DefaultButtonStyle}" CornerRadius="6" Height="34" Padding="10,0" ToolTipService.ToolTip="Export Startup &amp; Services Report (CSV)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEDE1;" FontSize="12.5"/>
                            <TextBlock Text="Export CSV" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <!-- Undo Change -->
                    <Button Click="OnUndoClick" IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}" Style="{StaticResource DefaultButtonStyle}" CornerRadius="6" Height="34" Padding="10,0" ToolTipService.ToolTip="Undo last configuration change">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7A7;" FontSize="12.5"/>
                            <TextBlock Text="Undo" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <!-- Scan Button -->
                    <Button x:Name="ScanButton" Click="OnReloadStartupClick" IsEnabled="{x:Bind IsNot(ViewModel.IsLoading), Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" Height="34" Padding="14,0" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ProgressRing x:Name="ScanSystemRing" IsActive="False" Visibility="Collapsed" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                            <FontIcon x:Name="ScanSystemIcon" Glyph="&#xE72C;" FontSize="13" Foreground="White" Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}"/>
                            <TextBlock x:Name="ScanSystemText" Text="Scan System" FontSize="12.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Content Tabs Area (Pivot) -->
        <Pivot x:Name="ContentPivot" Grid.Row="2" SelectionChanged="OnPivotSelectionChanged">
            <!-- Tab 1: Startup Applications -->
            <PivotItem Header="Startup Applications">
                <Border Style="{StaticResource CockpitBentoCardStyle}" Padding="12" Margin="0,10,0,0">
                    <Grid>
                        <ListView ItemsSource="{x:Bind ViewModel.StartupApps, Mode=OneWay}" SelectionMode="None">
                            <ListView.Header>
                                <Grid Padding="12,6" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3.2*" />
                                        <ColumnDefinition Width="{Binding ElementName=PageRoot, Path=PublisherColWidth}" />
                                        <ColumnDefinition Width="{Binding ElementName=PageRoot, Path=ImpactColWidth}" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Application" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="Publisher" FontWeight="Bold" FontSize="11" Visibility="{Binding ElementName=PageRoot, Path=WideLayoutVisibility}"/>
                                    <TextBlock Grid.Column="2" Text="Impact" FontWeight="Bold" FontSize="11" Visibility="{Binding ElementName=PageRoot, Path=WideLayoutVisibility}"/>
                                    <TextBlock Grid.Column="3" Text="State" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    <TextBlock Grid.Column="4" Text="Action" FontWeight="Bold" FontSize="11" Margin="8,0,8,0"/>
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:StartupEntry">
                                    <Border Style="{StaticResource Tilt3DCardStyle}" Padding="10,8" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3.2*" />
                                                <ColumnDefinition Width="{Binding ElementName=PageRoot, Path=PublisherColWidth}" />
                                                <ColumnDefinition Width="{Binding ElementName=PageRoot, Path=ImpactColWidth}" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Application details -->
                                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- App Icon with 3D Elevation -->
                                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <Grid>
                                                        <Image Source="{x:Bind IconImageSource, Mode=OneWay}" Width="24" Height="24" Stretch="Uniform" Visibility="{x:Bind HasIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <FontIcon Glyph="&#xE71D;" FontSize="15" Foreground="{StaticResource PrimaryAccentBrush}" Visibility="{x:Bind HasIcon, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}"/>
                                                    <TextBlock Text="{x:Bind Path}" FontSize="9.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Publisher -->
                                            <TextBlock Grid.Column="1" Text="{x:Bind Publisher}" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="{Binding ElementName=PageRoot, Path=WideLayoutVisibility}"/>

                                            <!-- Impact Badge -->
                                            <Border Grid.Column="2" Background="{x:Bind ImpactBgBrush, Mode=OneWay}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="{Binding ElementName=PageRoot, Path=WideLayoutVisibility}">
                                                <TextBlock Text="{x:Bind StartupImpact}" FontSize="10.5" FontWeight="Bold" Foreground="{x:Bind ImpactFgBrush, Mode=OneWay}"/>
                                            </Border>

                                            <!-- State Switch -->
                                            <ToggleSwitch Grid.Column="3" IsOn="{x:Bind IsEnabled, Mode=OneWay}" Toggled="OnStartupToggled" CornerRadius="4" MinWidth="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>

                                            <!-- Action (Open Location & Delete) -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0,8,0">
                                                <Button Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Width="30" Height="30" Click="OnOpenFileLocationClick" VerticalAlignment="Center" ToolTipService.ToolTip="Open File Location" AutomationProperties.Name="Open File Location">
                                                    <FontIcon Glyph="&#xED25;" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Button>
                                                <Button Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Width="30" Height="30" Click="OnDeleteStartupClick" VerticalAlignment="Center" ToolTipService.ToolTip="Permanently delete from startup" AutomationProperties.Name="Permanently delete from startup">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#FFEF4444" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </PivotItem>

            <!-- Tab 2: Background Services -->
            <PivotItem Header="Background Services">
                <Border Style="{StaticResource CockpitBentoCardStyle}" Padding="16" Margin="0,10,0,0">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header Control Bar with Quick Access Shortcuts & Guard Status -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Windows Services Directory" FontWeight="Bold" FontSize="13.5"/>
                                    <Border Background="{ThemeResource AppStatusGoodBackground}" BorderBrush="{ThemeResource AppStatusGoodBorder}" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="14 Core Protected" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AppStatusGoodBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Manage service execution states and boot modes directly." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Click="OnOpenServicesMscClick" Style="{StaticResource DefaultButtonStyle}" CornerRadius="6" Height="32" Padding="10,0" ToolTipService.ToolTip="Open Windows Services Manager (services.msc)">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE713;" FontSize="11"/>
                                        <TextBlock Text="services.msc" FontSize="11.5"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="OnOpenTaskMgrServicesClick" Style="{StaticResource DefaultButtonStyle}" CornerRadius="6" Height="32" Padding="10,0" ToolTipService.ToolTip="Open Task Manager Services View">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="11"/>
                                        <TextBlock Text="Task Manager" FontSize="11.5"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Service List Grid -->
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Services, Mode=OneWay}" SelectionMode="None">
                            <ListView.Header>
                                <Grid Padding="12,6" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Service Display Name" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="Company" FontWeight="Bold" FontSize="11" Visibility="{Binding ElementName=PageRoot, Path=WideLayoutVisibility}"/>
                                    <TextBlock Grid.Column="2" Text="Status / Category" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Grid.Column="3" Text="Startup Type" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="Service Control Commands" FontWeight="Bold" FontSize="11" Margin="8,0,8,0"/>
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ServiceEntry">
                                    <Border Style="{StaticResource Tilt3DCardStyle}" Padding="10,8" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1.4*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Service Title & ServiceName -->
                                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{ThemeResource AppStatusInfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="Bold" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind DisplayName}"/>
                                                    <TextBlock Text="{x:Bind Name}" FontSize="9.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Company Name -->
                                            <TextBlock Grid.Column="1" Text="{x:Bind CompanyName}" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="{Binding ElementName=PageRoot, Path=WideLayoutVisibility}"/>

                                            <!-- Status & Category -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Border Background="{x:Bind StatusBgBrush, Mode=OneWay}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{x:Bind Status, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Foreground="{x:Bind StatusFgBrush, Mode=OneWay}"/>
                                                </Border>
                                                <Border Background="{x:Bind CategoryBgBrush, Mode=OneWay}" CornerRadius="4" Padding="6,2" Visibility="{Binding ElementName=PageRoot, Path=WideLayoutVisibility}">
                                                    <TextBlock Text="{x:Bind CategoryText}" FontSize="10.5" FontWeight="Bold" Foreground="{x:Bind CategoryFgBrush, Mode=OneWay}"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Startup Type Selector -->
                                            <ComboBox Grid.Column="3" SelectedValue="{x:Bind StartupType, Mode=OneWay}" SelectedValuePath="Tag" SelectionChanged="OnServiceStartupTypeChanged" Height="30" FontSize="11" CornerRadius="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <ComboBoxItem Content="Automatic" Tag="Automatic"/>
                                                <ComboBoxItem Content="Manual" Tag="Manual"/>
                                                <ComboBoxItem Content="Disabled" Tag="Disabled"/>
                                            </ComboBox>

                                            <!-- Service Control Buttons (Start / Stop / Restart) -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0,4,0">
                                                <Button Click="OnServiceControlClick" Tag="Start" IsEnabled="{x:Bind IsNotRunning, Mode=OneWay}" Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Width="30" Height="30" ToolTipService.ToolTip="Start Service" AutomationProperties.Name="Start Service">
                                                    <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="{ThemeResource AppStatusGoodBrush}"/>
                                                </Button>
                                                <Button Click="OnServiceControlClick" Tag="Stop" IsEnabled="{x:Bind CanStop, Mode=OneWay}" Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Width="30" Height="30" ToolTipService.ToolTip="Stop Service" AutomationProperties.Name="Stop Service">
                                                    <FontIcon Glyph="&#xE71A;" FontSize="11" Foreground="#FFEF4444"/>
                                                </Button>
                                                <Button Click="OnServiceControlClick" Tag="Restart" IsEnabled="{x:Bind IsRunning, Mode=OneWay}" Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Width="30" Height="30" ToolTipService.ToolTip="Restart Service" AutomationProperties.Name="Restart Service">
                                                    <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="{ThemeResource AppStatusWarningBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </PivotItem>



            <!-- Tab 3: Scheduled Tasks -->
            <PivotItem Header="Scheduled Tasks">
                <Border Style="{StaticResource CockpitBentoCardStyle}" Padding="12" Margin="0,10,0,0">
                    <Grid>
                        <ListView ItemsSource="{x:Bind ViewModel.ScheduledTasks, Mode=OneWay}" SelectionMode="None">
                            <ListView.Header>
                                <Grid Padding="12,6" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.8*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1.8*" />
                                        <ColumnDefinition Width="1.8*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Task Name / Action" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="Author" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Grid.Column="2" Text="Last Execution Time" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Grid.Column="3" Text="Next Execution Time" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Grid.Column="4" Text="State" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    <TextBlock Grid.Column="5" Text="Action" FontWeight="Bold" FontSize="11" Margin="8,0,8,0"/>
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ScheduledTaskEntry">
                                    <Grid Padding="8,8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.8*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="1.8*" />
                                            <ColumnDefinition Width="1.8*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Task details -->
                                        <Grid Grid.Column="0" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6" Background="#1E8B5CF6" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE787;" FontSize="15" Foreground="#FF8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}"/>
                                                <TextBlock Text="{x:Bind Action}" FontSize="9.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Action}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Author -->
                                        <TextBlock Grid.Column="1" Text="{x:Bind Author}" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        <!-- Last Run -->
                                        <TextBlock Grid.Column="2" Text="{x:Bind DisplayLastRunTime, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center"/>

                                        <!-- Next Run -->
                                        <TextBlock Grid.Column="3" Text="{x:Bind DisplayNextRunTime, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center"/>

                                        <!-- State Switch -->
                                        <ToggleSwitch Grid.Column="4" IsOn="{x:Bind IsEnabled, Mode=OneWay}" Toggled="OnTaskToggled" CornerRadius="4" MinWidth="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>

                                        <!-- Action (Delete) -->
                                        <Button Grid.Column="5" Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Width="32" Height="32" Click="OnDeleteTaskClick" VerticalAlignment="Center" ToolTipService.ToolTip="Permanently delete scheduled task" AutomationProperties.Name="Permanently delete scheduled task">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13.5" Foreground="#FFEF4444" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </PivotItem>
        </Pivot>

        <!-- 3. Loading Overlay Indicator — smooth fade in/out -->
        <Grid x:Name="LoadingOverlayGrid" Grid.Row="0" Grid.RowSpan="3" Background="#60000000" Visibility="Collapsed" Opacity="0" Canvas.ZIndex="999" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.Resources>
                <Storyboard x:Name="FadeInLoading">
                    <DoubleAnimation Storyboard.TargetName="LoadingOverlayGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
                <Storyboard x:Name="FadeOutLoading" Completed="FadeOutLoading_Completed">
                    <DoubleAnimation Storyboard.TargetName="LoadingOverlayGrid" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </Grid.Resources>
            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1.5" CornerRadius="16" Padding="36,24" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
                <StackPanel Spacing="14" HorizontalAlignment="Center">
                    <!-- Glowing Rocket Badge -->
                    <Grid Width="60" Height="60" HorizontalAlignment="Center">
                        <Border Width="60" Height="60" CornerRadius="18" Background="{StaticResource PrimaryAccentLightBrush}" BorderBrush="{StaticResource PrimaryAccentBorderBrush}" BorderThickness="1.5">
                            <FontIcon Glyph="&#xE7B5;" FontSize="22" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="14" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.LoadingStatus, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Linear Progress Bar -->
                    <Border Background="#1AFFFFFF" CornerRadius="4" Height="8" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="1" Width="280">
                        <ProgressBar IsIndeterminate="True" Height="4" CornerRadius="2" Foreground="{StaticResource PrimaryAccentGradient}" Background="Transparent" HorizontalAlignment="Stretch"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
</Page>


