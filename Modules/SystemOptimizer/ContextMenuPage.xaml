<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.ContextMenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinCarePro.Models"
    xmlns:viewmodels="using:WinCarePro.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24,20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Context Menu Manager" Style="{StaticResource PageHeaderTitleStyle}" />
            </StackPanel>
            <Button x:Name="ScanBtn" Grid.Column="1" Click="OnScanClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" VerticalAlignment="Center" CornerRadius="8" Padding="16,8" FontWeight="SemiBold">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ProgressRing x:Name="ScanRing" IsActive="False" Visibility="Collapsed" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ScanText" Text="Scan Context Menus" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Left: Handlers List -->
            <Border Grid.Column="0" Style="{StaticResource GlassmorphismCardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Filter / Search Section -->
                    <Grid Grid.Row="0" Margin="0,0,0,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchBox" 
                                 PlaceholderText="Search handlers or registry paths..."
                                 Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Header="Search"
                                 CornerRadius="6" />

                        <ComboBox Grid.Column="1"
                                  Header="Filter by Category"
                                  HorizontalAlignment="Stretch"
                                  SelectedValue="{x:Bind ViewModel.FilterCategory, Mode=TwoWay}"
                                  SelectedValuePath="Content"
                                  CornerRadius="6">
                            <ComboBoxItem Content="All" IsSelected="True" />
                            <ComboBoxItem Content="All Files" />
                            <ComboBoxItem Content="Desktop Background" />
                            <ComboBoxItem Content="Folders" />
                        </ComboBox>
                    </Grid>

                    <!-- List View of Context Menu Handlers -->
                    <Grid Grid.Row="1">
                        <ListView ItemsSource="{x:Bind ViewModel.FilteredItems, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ContextMenuItem">
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Padding="8,12">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Type Icon Badge -->
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{ThemeResource SystemControlBackgroundAccentBrush}" Opacity="0.1" VerticalAlignment="Center" />
                                            <FontIcon Grid.Column="0" Glyph="&#xE7C5;" FontSize="16" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind RegistryPath}" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{x:Bind Type}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center" />

                                            <ToggleSwitch Grid.Column="3" 
                                                          IsOn="{x:Bind IsEnabled, Mode=OneWay}" 
                                                          Toggled="OnItemToggled" 
                                                          MinWidth="0"
                                                          VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Progress indicator -->
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Right: Instructions / Detail Panel -->
            <Border Grid.Column="1" Style="{StaticResource GlassmorphismCardStyle}" Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="About Context Menus" FontSize="15" FontWeight="Bold" />
                    
                    <TextBlock Text="When you install applications (such as WinRAR, Git, Photoshop, etc.), they register custom shell extensions to show up in the Windows right-click context menu."
                               TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" LineHeight="18" />

                    <TextBlock Text="If you have too many items, it can slow down file explorer or make it look cluttered."
                               TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" LineHeight="18" />

                    <Border Background="#15F59E0B" BorderBrush="#30F59E0B" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="#FFF59E0B" VerticalAlignment="Center" />
                                <TextBlock Text="Safe Mechanism" FontWeight="Bold" FontSize="12.5" Foreground="#FFF59E0B" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="WinCare Pro does not delete keys. It prefixes the active keys with '-' to safely disable them. Toggle back to re-enable anytime."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" LineHeight="16" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Log / Terminal Output -->
        <Border Grid.Row="2" Margin="0,18,0,0" Style="{StaticResource GlassmorphismCardStyle}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Activity Log" FontSize="12.5" FontWeight="Bold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Margin="4,0,0,6" />
                <ScrollViewer Grid.Row="1" Height="130" Background="#0C000000" CornerRadius="6" Padding="12,8" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{x:Bind ViewModel.LogText, Mode=OneWay}" FontFamily="Consolas" FontSize="11" Foreground="#FF10B981" TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Loading Overlay Indicator — smooth fade in/out -->
        <Grid x:Name="LoadingOverlayGrid" Grid.Row="0" Grid.RowSpan="3" Background="#60000000" Visibility="Collapsed" Opacity="0" Canvas.ZIndex="999" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.Resources>
                <Storyboard x:Name="FadeInLoading">
                    <DoubleAnimation Storyboard.TargetName="LoadingOverlayGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
                <Storyboard x:Name="FadeOutLoading" Completed="FadeOutLoading_Completed">
                    <DoubleAnimation Storyboard.TargetName="LoadingOverlayGrid" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </Grid.Resources>
            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1.5" CornerRadius="16" Padding="36,28" HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <ProgressRing Width="48" Height="48" IsActive="True" Foreground="{StaticResource PrimaryAccentBrush}" />
                    <TextBlock Text="Scanning Context Menus..." FontSize="14" FontWeight="Bold" TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>


