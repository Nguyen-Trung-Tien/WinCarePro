<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.ContextMenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinCarePro.Models"
    xmlns:viewmodels="using:WinCarePro.ViewModels"
    xmlns:components="using:WinCarePro.Shared.Components"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    mc:Ignorable="d">

    <Grid Padding="24,18" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutVisualStates">
                <!-- Wide Layout: Viewport Width >= 960px -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="960" />
                    </VisualState.StateTriggers>
                </VisualState>

                <!-- Narrow Layout: Viewport Width < 960px -->
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LeftPanel.(Grid.Row)" Value="0" />
                        <Setter Target="LeftPanel.(Grid.Column)" Value="0" />
                        <Setter Target="LeftPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="RightPanel.(Grid.Row)" Value="1" />
                        <Setter Target="RightPanel.(Grid.Column)" Value="0" />
                        <Setter Target="RightPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="StatCard1.(Grid.Row)" Value="1" />
                        <Setter Target="StatCard1.(Grid.Column)" Value="0" />
                        <Setter Target="StatCard2.(Grid.Row)" Value="2" />
                        <Setter Target="StatCard2.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="20" />
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0. Header -->
            <RowDefinition Height="Auto" /> <!-- 1. Stat Ribbon -->
            <RowDefinition Height="*" />    <!-- 2. Main Content Workspace -->
            <RowDefinition Height="Auto" /> <!-- 3. Status Footer -->
        </Grid.RowDefinitions>

        <!-- ==================== 0. MODERN HEADER ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Title & Subtitle with Gradient Icon Badge -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Style="{StaticResource PageHeaderIconBadgeStyle}" Background="{StaticResource PrimaryAccentGradient}">
                    <FontIcon Glyph="&#xE8EC;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Context Menu Manager" Style="{StaticResource PageHeaderTitleStyle}" />
                    <TextBlock Text="Manage shell extensions and declutter right-click menus." Style="{StaticResource PageHeaderSubtitleStyle}" />
                </StackPanel>
            </StackPanel>

            <!-- Right: Scan Button -->
            <Button x:Name="ScanBtn" Grid.Column="1" Click="OnScanClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" CornerRadius="8" Padding="16,7" FontWeight="Bold" FontSize="12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ProgressRing x:Name="ScanRing" IsActive="False" Visibility="Collapsed" Width="13" Height="13" Foreground="White" VerticalAlignment="Center"/>
                    <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="White" Visibility="{x:Bind ViewModel.IsBusy, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}" />
                    <TextBlock x:Name="ScanText" Text="Scan Context Menus" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ==================== 1. 3-CARD STAT RIBBON ==================== -->
        <Grid Grid.Row="1" Margin="0,0,0,14" ColumnSpacing="12" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 0: Total Handlers -->
            <Border Grid.Column="0" Style="{StaticResource QuickStatCardStyle}"
                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="6.5" helpers:Animation3DHelper.DepthZ="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{StaticResource PrimaryAccentLightBrush}" BorderBrush="{StaticResource PrimaryAccentBorderBrush}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8EC;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Total Handlers" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 1: Active & Enabled -->
            <Border x:Name="StatCard1" Grid.Column="1" Style="{StaticResource QuickStatCardStyle}"
                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="6.5" helpers:Animation3DHelper.DepthZ="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="#2010B981" BorderBrush="#5010B981" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="#FF10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Active in Context Menu" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ActiveCount, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="#FF10B981" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 2: Disabled & Optimized -->
            <Border x:Name="StatCard2" Grid.Column="2" Style="{StaticResource QuickStatCardStyle}"
                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="6.5" helpers:Animation3DHelper.DepthZ="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="#20F59E0B" BorderBrush="#50F59E0B" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="#FFF59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Disabled / Shelved" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.DisabledCount, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="#FFF59E0B" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 2. MAIN WORKSPACE ==================== -->
        <Grid Grid.Row="2" ColumnSpacing="16" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Left: Handlers List Card -->
            <Border x:Name="LeftPanel" Grid.Column="0" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Filters -->
                        <RowDefinition Height="*" />    <!-- List -->
                    </Grid.RowDefinitions>

                    <!-- Filter / Search Section -->
                    <Grid Grid.Row="0" Margin="0,0,0,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchBox" 
                                 PlaceholderText="Search handlers or registry paths..."
                                 Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 CornerRadius="8" Height="34" VerticalAlignment="Center" />

                        <ComboBox Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  SelectedValue="{x:Bind ViewModel.FilterCategory, Mode=TwoWay}"
                                  SelectedValuePath="Content"
                                  CornerRadius="8" Height="34" VerticalAlignment="Center">
                            <ComboBoxItem Content="All" IsSelected="True" />
                            <ComboBoxItem Content="All Files" />
                            <ComboBoxItem Content="Desktop Background" />
                            <ComboBoxItem Content="Folders" />
                        </ComboBox>
                    </Grid>

                    <!-- List View of Context Menu Handlers -->
                    <Grid Grid.Row="1">
                        <ListView ItemsSource="{x:Bind ViewModel.FilteredItems, Mode=OneWay}" SelectionMode="None" ItemContainerStyle="{StaticResource ModernCardListViewItemStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ContextMenuItem">
                                    <Border Style="{StaticResource Tilt3DCardStyle}" Padding="12,9" Margin="0,0,0,4"
                                            helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="3.5" helpers:Animation3DHelper.DepthZ="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Type Icon Badge with 3D Elevation -->
                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1.2" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE7C5;" FontSize="14" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Border>

                                            <!-- Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="10,0,10,0">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind RegistryPath}" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <!-- Type Tag Badge -->
                                            <Border Grid.Column="2" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{x:Bind Type}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                            </Border>

                                            <!-- Loading Toggle Switch -->
                                            <components:LoadingToggleSwitch Grid.Column="3" 
                                                                         IsOn="{x:Bind IsEnabled, Mode=OneWay}" 
                                                                         MinLoadingDurationMs="450"
                                                                         Toggled="OnItemToggled" 
                                                                         MinWidth="0"
                                                                         VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Progress indicator -->
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Right: Details & Guidelines Panel with 3D Depth -->
            <Border x:Name="RightPanel" Grid.Column="1" Style="{StaticResource SpatialDepthCardStyle}" Padding="16,14"
                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="3.0" helpers:Animation3DHelper.DepthZ="10">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource SystemAccentColor}" />
                        <TextBlock Text="Shell Guidelines" FontSize="13" FontWeight="Bold" />
                    </StackPanel>
                    
                    <TextBlock Text="Disabling unused shell extensions removes right-click popup delay and prevents File Explorer freezes."
                               TextWrapping="Wrap" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" LineHeight="16" />

                    <!-- Safe Mechanism Note -->
                    <Border Background="#1510B981" BorderBrush="#3010B981" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE727;" FontSize="13" Foreground="#FF10B981" VerticalAlignment="Center" />
                                <TextBlock Text="Safe Non-Destructive Mod" FontWeight="Bold" FontSize="11.5" Foreground="#FF10B981" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Disabled keys are safely prefixed with '-' rather than deleted, allowing instant restoration anytime."
                                       TextWrapping="Wrap" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" LineHeight="15" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 3. STATUS BAR FOOTER ==================== -->
        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Margin="0,8,0,0" />

        <!-- Loading Overlay Indicator — smooth fade in/out -->
        <Grid x:Name="LoadingOverlayGrid" Grid.Row="0" Grid.RowSpan="4" Background="#60000000" Visibility="Collapsed" Opacity="0" Canvas.ZIndex="999" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.Resources>
                <Storyboard x:Name="FadeInLoading">
                    <DoubleAnimation Storyboard.TargetName="LoadingOverlayGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
                <Storyboard x:Name="FadeOutLoading" Completed="FadeOutLoading_Completed">
                    <DoubleAnimation Storyboard.TargetName="LoadingOverlayGrid" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </Grid.Resources>
            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1.5" CornerRadius="16" Padding="36,24" HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                <StackPanel Spacing="14" HorizontalAlignment="Center">
                    <!-- Glowing Mouse Badge -->
                    <Grid Width="60" Height="60" HorizontalAlignment="Center">
                        <Border Width="60" Height="60" CornerRadius="18" Background="{StaticResource PrimaryAccentLightBrush}" BorderBrush="{StaticResource PrimaryAccentBorderBrush}" BorderThickness="1.5">
                            <FontIcon Glyph="&#xE8EC;" FontSize="22" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="Scanning Context Menus..." FontSize="14" FontWeight="Bold" TextAlignment="Center" />

                    <!-- Linear Progress Bar -->
                    <Border Background="#1AFFFFFF" CornerRadius="4" Height="8" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="1" Width="260">
                        <ProgressBar IsIndeterminate="True" Height="4" CornerRadius="2" Foreground="{StaticResource PrimaryAccentGradient}" Background="Transparent" HorizontalAlignment="Stretch"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
