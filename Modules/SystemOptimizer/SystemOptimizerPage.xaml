<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.SystemOptimizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinCarePro.Models"
    xmlns:viewmodels="using:WinCarePro.ViewModels"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    mc:Ignorable="d">

    <Grid Padding="24,20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutVisualStates">
            <!-- Wide Layout: Viewport Width >= 1200px -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1200" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- Medium Layout: Viewport Width between 650px and 1200px -->
                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="650" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TweaksCard.(Grid.Row)" Value="0" />
                        <Setter Target="TweaksCard.(Grid.Column)" Value="0" />
                        <Setter Target="TweaksCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="RightPanelScrollViewer.(Grid.Row)" Value="1" />
                        <Setter Target="RightPanelScrollViewer.(Grid.Column)" Value="0" />
                        <Setter Target="RightPanelScrollViewer.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="RightPanelScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                        <Setter Target="RightPanelScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                        <Setter Target="RightPanel.Orientation" Value="Horizontal" />
                        <Setter Target="GameBoostCard.Width" Value="350" />
                        <Setter Target="RamBoosterCard.Width" Value="350" />
                        <Setter Target="Col1.Width" Value="Auto" />
                        <Setter Target="Row1.Height" Value="*" />
                        <Setter Target="HeaderCol1.Width" Value="0" />
                        <Setter Target="HeaderTitlePanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderButtons.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderButtons.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderButtons.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderButtons.HorizontalAlignment" Value="Left" />
                        <Setter Target="HeaderButtons.Margin" Value="0,10,0,0" />
                    </VisualState.Setters>
                </VisualState>
                <!-- Narrow Layout: Viewport Width < 650px -->
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TweaksCard.(Grid.Row)" Value="0" />
                        <Setter Target="TweaksCard.(Grid.Column)" Value="0" />
                        <Setter Target="TweaksCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="RightPanelScrollViewer.(Grid.Row)" Value="1" />
                        <Setter Target="RightPanelScrollViewer.(Grid.Column)" Value="0" />
                        <Setter Target="RightPanelScrollViewer.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="RightPanelScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                        <Setter Target="RightPanelScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                        <Setter Target="RightPanel.Orientation" Value="Vertical" />
                        <Setter Target="GameBoostCard.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="RamBoosterCard.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="Col1.Width" Value="Auto" />
                        <Setter Target="HeaderCol1.Width" Value="0" />
                        <Setter Target="HeaderTitlePanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderButtons.Spacing" Value="4" />
                        <Setter Target="HeaderButtons.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderButtons.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderButtons.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderButtons.HorizontalAlignment" Value="Left" />
                        <Setter Target="HeaderButtons.Margin" Value="0,10,0,0" />
                        <Setter Target="Row1.Height" Value="*" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Page Header (Row 0) -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow0" Height="Auto" />
                <RowDefinition x:Name="HeaderRow1" Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HeaderCol0" Width="*" />
                <ColumnDefinition x:Name="HeaderCol1" Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="HeaderTitlePanel" Grid.Row="0" Grid.Column="0">
                <TextBlock Text="⚡ Optimizer &amp; Gaming Suite" Style="{StaticResource PageHeaderTitleStyle}" />
            </StackPanel>
            <StackPanel x:Name="HeaderButtons" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Scan Registry" Click="OnReloadTweaksClick" IsEnabled="{x:Bind IsNot(ViewModel.IsLoading), Mode=OneWay}" CornerRadius="6" Padding="12,8" FontSize="12.5" />
                <Button Content="Defaults" Click="OnRestoreDefaultsClick" IsEnabled="{x:Bind IsNot(ViewModel.IsLoading), Mode=OneWay}" CornerRadius="6" Padding="12,8" FontSize="12.5" />
                <Button Content="Apply Tweaks" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" Click="OnApplyTweaksClick" IsEnabled="{x:Bind IsNot(ViewModel.IsLoading), Mode=OneWay}" FontWeight="SemiBold" CornerRadius="6" Padding="16,8" FontSize="12.5" />
            </StackPanel>
        </Grid>

        <!-- v4.0.0 — GAMING TURBO 2.0 EMBEDDED SECTION (Row 1) -->
        <Border x:Name="GamingTurboSection" Grid.Row="1" Style="{StaticResource GamingTurboCardStyle}" Margin="0,0,0,16" Padding="20"
                helpers:AnimationHelper.EntranceDelay="60"
                helpers:AnimationHelper.HoverScale="1.008">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Background="{StaticResource GamingTurboGradient}" CornerRadius="8" Padding="6">
                            <FontIcon Glyph="&#xE7FC;" FontSize="16" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Gaming Turbo 2.0" FontSize="17" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <Border Background="#25F59E0B" BorderBrush="#60F59E0B" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="Ultra Low-Latency" FontSize="9" FontWeight="ExtraBold" Foreground="#FFF59E0B"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TurboStatusText" Text="Sẵn sàng. Bật Turbo để giải phóng RAM &amp; tối ưu CPU cho Game." 
                               FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                    
                    <!-- Quick stats row -->
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                        <Border Style="{StaticResource QuickStatCardStyle}" Padding="10,6" MinHeight="0">
                            <StackPanel Spacing="1">
                                <TextBlock Text="RAM Freed" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="TurboRamFreedText" Text="{x:Bind ViewModel.GamingRamFreedText, Mode=OneWay}" FontSize="16" FontWeight="ExtraBold" Foreground="{ThemeResource AppRamChipFg}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource QuickStatCardStyle}" Padding="10,6" MinHeight="0">
                            <StackPanel Spacing="1">
                                <TextBlock Text="Processes" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="TurboProcCountText" Text="{x:Bind ViewModel.GamingOptimizedProcessesCount, Mode=OneWay}" FontSize="16" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource QuickStatCardStyle}" Padding="10,6" MinHeight="0">
                            <StackPanel Spacing="1">
                                <TextBlock Text="Power Plan" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="Ultimate" FontSize="14" FontWeight="Bold" Foreground="#FF10B981"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Turbo Toggle -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8" Margin="16,0,0,0">
                    <ToggleSwitch x:Name="TurboToggle" Toggled="OnTurboToggled" 
                                  OnContent="ON" OffContent="OFF"
                                  helpers:AnimationHelper.HoverScale="1.05"/>
                    <TextBlock Text="Turbo Mode" FontSize="10" FontWeight="Bold" 
                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace Grid (Row 2) -->
        <Grid Grid.Row="2" ColumnSpacing="18" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" x:Name="Row0" />
                <RowDefinition Height="Auto" x:Name="Row1" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" x:Name="Col0" />
                <ColumnDefinition Width="330" x:Name="Col1" />
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Tweaks Pivot List -->
            <Border x:Name="TweaksCard" Grid.Column="0" Grid.Row="0" Style="{StaticResource GlassmorphismCardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Tweaks Summary Details Bar (Optimized Frosted Stat Card Layout) -->
                    <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <!-- Left: Title -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="14" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" />
                                    <TextBlock Text="System Tweaks Overview" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Right: Modern Colored Pill Badges -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <!-- Total Badge -->
                                    <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="6" Padding="6,3">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="Total:" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.TotalTweaksCount, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Optimized Badge -->
                                    <Border Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="6" Padding="6,3">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#FF10B981" VerticalAlignment="Center" />
                                            <TextBlock Text="Optimized:" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.OptimizedTweaksCount, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#FF10B981" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Available Badge -->
                                    <Border Background="{ThemeResource AppBadgeWarningBg}" BorderBrush="{ThemeResource AppBadgeWarningBorder}" BorderThickness="1" CornerRadius="6" Padding="6,3">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE946;" FontSize="10" Foreground="#FFF59E0B" VerticalAlignment="Center" />
                                            <TextBlock Text="Available:" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.AvailableTweaksCount, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#FFF59E0B" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Progress bar indicating ratio of optimized tweaks -->
                            <ProgressBar Value="{x:Bind ViewModel.OptimizedTweaksCount, Mode=OneWay}" Maximum="{x:Bind ViewModel.TotalTweaksCount, Mode=OneWay}" Height="4" CornerRadius="2" Foreground="{StaticResource PrimaryAccentGradient}" Background="{ThemeResource ControlStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Pivot Grid.Row="1" SelectionChanged="OnPivotSelectionChanged" Margin="0,0,0,10">
                        <PivotItem Header="All" Tag="All" />
                        <PivotItem Header="Performance" Tag="Performance" />
                        <PivotItem Header="Gaming" Tag="Gaming &amp; GPU" />
                        <PivotItem Header="System" Tag="System &amp; Disk" />
                        <PivotItem Header="Privacy" Tag="Privacy &amp; Logs" />
                    </Pivot>

                    <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.FilteredTweaks, Mode=OneWay}" SelectionMode="None" ItemContainerStyle="{StaticResource ModernCardListViewItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SystemTweak">
                                <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="12,10" Margin="0,0,0,4"
                                        helpers:AnimationHelper.HoverScale="1.012" helpers:AnimationHelper.PressedScale="0.988">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />  <!-- CheckBox -->
                                            <ColumnDefinition Width="Auto" />  <!-- Category Icon -->
                                            <ColumnDefinition Width="*" />     <!-- Label Details -->
                                            <ColumnDefinition Width="Auto" />  <!-- Status Badge -->
                                            <ColumnDefinition Width="Auto" />  <!-- Action Button -->
                                        </Grid.ColumnDefinitions>
                                        
                                        <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="0" />
                                        
                                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind IconGlyph}" Foreground="{ThemeResource SystemAccentColor}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Description}" />
                                                <FontIcon Glyph="&#xE946;" FontSize="11" Foreground="{ThemeResource SystemAccentColor}" ToolTipService.ToolTip="{x:Bind RegistryPath}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ComparisonText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource SystemAccentColor}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        
                                        <Border Grid.Column="3" Background="{x:Bind StatusBgColor, Mode=OneWay}" BorderBrush="{x:Bind StatusBorderColor, Mode=OneWay}" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{x:Bind StatusFormatted, Mode=OneWay}" Foreground="{x:Bind StatusForegroundColor, Mode=OneWay}" FontSize="10" FontWeight="Bold" />
                                        </Border>

                                        <!-- Apply Button (Visible when NOT optimized) -->
                                        <Button Grid.Column="4" Content="Apply" Visibility="{x:Bind IsOptimized, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" Click="OnToggleTweakClick" CornerRadius="6" Padding="12,5" FontSize="11" VerticalAlignment="Center" />
                                        
                                        <!-- Revert Button (Visible when optimized) -->
                                        <Button Grid.Column="4" Content="Revert" Visibility="{x:Bind IsOptimized, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" Click="OnToggleTweakClick" CornerRadius="6" Padding="12,5" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Right Pane: Boost Engine Cards (Wrapped in ScrollViewer to prevent cut-off on lower resolution screens) -->
            <ScrollViewer x:Name="RightPanelScrollViewer"
                          Grid.Column="1"
                          Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="RightPanel" Spacing="14" Margin="0,0,12,0">
                    
                    <!-- RAM Booster Card (Positioned FIRST for immediate visibility in default view) -->
                    <Border x:Name="RamBoosterCard" Style="{StaticResource GlassmorphismCardStyle}" Padding="16,14">
                        <StackPanel Spacing="12">
                            <!-- Card Header with Icon, Title, and Auto-Boost Toggle -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" Background="#253B82F6" CornerRadius="18" Grid.Column="0">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="#FF2563EB" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="Auto-Boost RAM" FontWeight="Bold" FontSize="13.5" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.AutoBoostEnabled, Mode=TwoWay}" VerticalAlignment="Center" OffContent="" OnContent="" MinWidth="0" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Compact RAM Gauge & Detailed Metrics Grid -->
                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="12,10">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Compact Progress Ring Gauge -->
                                    <Grid Grid.Column="0" Width="72" Height="72" VerticalAlignment="Center">
                                        <ProgressRing Value="{x:Bind ViewModel.RamUsagePercentage, Mode=OneWay}" IsIndeterminate="{x:Bind ViewModel.IsBoosting, Mode=OneWay}" Width="72" Height="72" Foreground="{StaticResource PrimaryAccentGradient}" Background="Transparent" />
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="0">
                                            <TextBlock Text="{x:Bind ViewModel.RamUsagePercentageText, Mode=OneWay}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" CharacterSpacing="-5" />
                                            <TextBlock Text="RAM" FontSize="8.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Detailed RAM metrics column -->
                                    <Grid Grid.Column="1" RowSpacing="3" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Total RAM:" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.TotalRamText, Mode=OneWay}" FontSize="11" FontWeight="Bold" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Used RAM:" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.UsedRamText, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Available RAM:" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.AvailableRamText, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#FF10B981" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <TextBlock Text="{x:Bind ViewModel.RamOptimizedText, Mode=OneWay}" FontSize="10.5" Foreground="{ThemeResource SystemAccentColor}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />

                            <Button Click="OnBoostRamClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBoosting), Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" HorizontalAlignment="Stretch" CornerRadius="6" Padding="10,8" FontWeight="SemiBold">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xF0AF;" FontSize="13" Foreground="White" />
                                            <TextBlock Text="Boost RAM Now" FontSize="12.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Game Boost Card -->
                    <Border x:Name="GameBoostCard" Style="{StaticResource NeonGlowBorderStyle}" Padding="16,14">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" Background="#257F56D9" CornerRadius="18" Grid.Column="0">
                                    <FontIcon Glyph="&#xE7FC;" FontSize="16" Foreground="#FF7C3AED" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="Game Boost Mode" FontWeight="Bold" FontSize="13.5" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.GameBoostActive, Mode=TwoWay}" VerticalAlignment="Center" OffContent="" OnContent="" MinWidth="0" HorizontalAlignment="Right" />
                            </Grid>

                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="8,6">
                                <TextBlock Text="{x:Bind ViewModel.GameBoostStatus, Mode=OneWay}" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" />
                            </Border>

                            <!-- Services Managed List -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Services Monitored:" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Margin="2,0,0,2" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.BackgroundServices, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:ServiceStatusItem">
                                            <Grid Padding="0,4" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="{x:Bind StatusGlyph}" Foreground="{x:Bind StatusColor}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" FontSize="11.5" VerticalAlignment="Center" />
                                                <Border Grid.Column="2" CornerRadius="4" Padding="5,1.5" VerticalAlignment="Center" Background="{x:Bind StatusColor}">
                                                    <TextBlock Text="{x:Bind Status}" FontSize="9" FontWeight="Bold" Foreground="White" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status Message Footer (Row 3) -->
        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Margin="0,10,0,0" />
    </Grid>
</Page>


