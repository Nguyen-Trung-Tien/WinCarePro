<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.SystemOptimizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinCarePro.Models"
    xmlns:viewmodels="using:WinCarePro.ViewModels"
    xmlns:components="using:WinCarePro.Shared.Components"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    mc:Ignorable="d">

    <Grid Padding="20,12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutVisualStates">
                <!-- Wide Layout: Viewport Width >= 1024px (1 neat row of 4 stat cards) -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1024" />
                    </VisualState.StateTriggers>
                </VisualState>

                <!-- Medium Layout: Viewport Width between 720px and 1024px -->
                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderCol1.Width" Value="0" />
                        <Setter Target="HeaderTitlePanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderButtons.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderButtons.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderButtons.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderButtons.HorizontalAlignment" Value="Left" />
                        <Setter Target="HeaderButtons.Margin" Value="0,8,0,0" />
                        
                        <Setter Target="StatCol0.Width" Value="*" />
                        <Setter Target="StatCol1.Width" Value="*" />
                        <Setter Target="StatCol2.Width" Value="0" />
                        <Setter Target="StatCol3.Width" Value="0" />
                        <Setter Target="StatCard0.(Grid.Row)" Value="0" />
                        <Setter Target="StatCard0.(Grid.Column)" Value="0" />
                        <Setter Target="StatCard1.(Grid.Row)" Value="0" />
                        <Setter Target="StatCard1.(Grid.Column)" Value="1" />
                        <Setter Target="StatCard2.(Grid.Row)" Value="1" />
                        <Setter Target="StatCard2.(Grid.Column)" Value="0" />
                        <Setter Target="StatCard3.(Grid.Row)" Value="1" />
                        <Setter Target="StatCard3.(Grid.Column)" Value="1" />
                        <Setter Target="Col1.Width" Value="310" />
                    </VisualState.Setters>
                </VisualState>

                <!-- Narrow Layout: Viewport Width < 720px -->
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderCol1.Width" Value="0" />
                        <Setter Target="HeaderTitlePanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderButtons.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderButtons.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderButtons.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderButtons.HorizontalAlignment" Value="Left" />
                        <Setter Target="HeaderButtons.Margin" Value="0,8,0,0" />
                        
                        <Setter Target="StatCol0.Width" Value="*" />
                        <Setter Target="StatCol1.Width" Value="0" />
                        <Setter Target="StatCol2.Width" Value="0" />
                        <Setter Target="StatCol3.Width" Value="0" />
                        <Setter Target="StatCard0.(Grid.Row)" Value="0" />
                        <Setter Target="StatCard0.(Grid.Column)" Value="0" />
                        <Setter Target="StatCard1.(Grid.Row)" Value="1" />
                        <Setter Target="StatCard1.(Grid.Column)" Value="0" />
                        <Setter Target="StatCard2.(Grid.Row)" Value="2" />
                        <Setter Target="StatCard2.(Grid.Column)" Value="0" />
                        <Setter Target="StatCard3.(Grid.Row)" Value="3" />
                        <Setter Target="StatCard3.(Grid.Column)" Value="0" />
                        
                        <Setter Target="TweaksCard.(Grid.Row)" Value="0" />
                        <Setter Target="TweaksCard.(Grid.Column)" Value="0" />
                        <Setter Target="TweaksCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="RightPanelScroll.(Grid.Row)" Value="1" />
                        <Setter Target="RightPanelScroll.(Grid.Column)" Value="0" />
                        <Setter Target="RightPanelScroll.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="Col1.Width" Value="Auto" />
                        <Setter Target="Row1.Height" Value="*" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="20" />
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0. Header & Presets -->
            <RowDefinition Height="Auto" /> <!-- 1. 4-Deck Stat Ribbon -->
            <RowDefinition Height="*" />    <!-- 2. Main Workspace -->
            <RowDefinition Height="Auto" /> <!-- 3. Status Bar -->
        </Grid.RowDefinitions>

        <!-- ==================== 0. MODERN HEADER & PRESETS ==================== -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow0" Height="Auto" />
                <RowDefinition x:Name="HeaderRow1" Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HeaderCol0" Width="*" />
                <ColumnDefinition x:Name="HeaderCol1" Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Title & Subtitle -->
            <StackPanel x:Name="HeaderTitlePanel" Grid.Row="0" Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Style="{StaticResource PageHeaderIconBadgeStyle}" Background="{StaticResource PrimaryAccentGradient}">
                        <FontIcon Glyph="&#xE7FC;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="System Optimizer &amp; Performance" Style="{StaticResource PageHeaderTitleStyle}" />
                        <TextBlock Text="Kernel tuning, process scheduling &amp; memory caching." Style="{StaticResource PageHeaderSubtitleStyle}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Right: Preset Profiles & Action Buttons -->
            <StackPanel x:Name="HeaderButtons" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Smart Auto-Tune Preset (Hero Primary Button) -->
                <Button x:Name="SmartTuneBtn" Click="OnSmartTuneClick" IsEnabled="{x:Bind IsNot(ViewModel.IsLoading), Mode=OneWay}" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="34" CornerRadius="8" Padding="14,0" FontSize="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE99A;" FontSize="12" Foreground="White" />
                        <TextBlock Text="Smart Auto-Tune" VerticalAlignment="Center" FontWeight="Bold" />
                    </StackPanel>
                </Button>

                <!-- Preset Profiles DropDown Menu (Compact & Never Overlaps Title) -->
                <DropDownButton x:Name="ProfilesDropDownBtn" Style="{StaticResource DefaultButtonStyle}" Height="34" CornerRadius="8" Padding="12,0" FontSize="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71D;" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}" />
                        <TextBlock Text="Profiles" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Gaming Mode" Click="OnGamingProfileClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7FC;" Foreground="#FFF59E0B"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Privacy Shield" Click="OnPrivacyProfileClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE727;" Foreground="#FF10B981"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Restore Defaults" Click="OnRestoreDefaultsClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE777;" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <!-- Apply Selected Tweaks -->
                <Button x:Name="ApplyTweaksBtn" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" Click="OnApplyTweaksClick" IsEnabled="{x:Bind IsNot(ViewModel.IsLoading), Mode=OneWay}" FontWeight="Bold" Height="34" CornerRadius="8" Padding="16,0" FontSize="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ProgressRing x:Name="ApplyTweaksRing" IsActive="False" Visibility="Collapsed" Width="13" Height="13" Foreground="White" VerticalAlignment="Center" />
                        <FontIcon x:Name="ApplyTweaksIcon" Glyph="&#xE8FB;" FontSize="12" Foreground="White" />
                        <TextBlock x:Name="ApplyTweaksText" Text="Apply Tweaks" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== 1. 4-CARD FROSTED STAT RIBBON ==================== -->
        <Grid x:Name="StatRibbonGrid" Grid.Row="1" Margin="0,0,0,10" ColumnSpacing="10" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="StatRibbonRow0" Height="Auto" />
                <RowDefinition x:Name="StatRibbonRow1" Height="Auto" />
                <RowDefinition x:Name="StatRibbonRow2" Height="Auto" />
                <RowDefinition x:Name="StatRibbonRow3" Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="StatCol0" Width="*" />
                <ColumnDefinition x:Name="StatCol1" Width="*" />
                <ColumnDefinition x:Name="StatCol2" Width="*" />
                <ColumnDefinition x:Name="StatCol3" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 0: AI Efficiency & Health Score -->
            <Border x:Name="StatCard0" Grid.Row="0" Grid.Column="0" Style="{StaticResource QuickStatCardStyle}"
                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="6.5" helpers:Animation3DHelper.DepthZ="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Ellipse Stroke="{StaticResource PrimaryAccentGradient}" StrokeThickness="3" Opacity="0.25" />
                        <ProgressRing Value="{x:Bind ViewModel.AiHealthScore, Mode=OneWay}" Width="38" Height="38" 
                                      Foreground="{StaticResource PrimaryAccentBrush}" Background="Transparent" />
                        <TextBlock Text="{x:Bind ViewModel.AiHealthScore, Mode=OneWay}" 
                                   FontSize="13" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource PrimaryAccentBrush}" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="AI System Efficiency" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <Border Background="{x:Bind ViewModel.EfficiencyGradeBadgeBg, Mode=OneWay}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind ViewModel.EfficiencyGradeText, Mode=OneWay}" FontSize="10" FontWeight="ExtraBold" Foreground="{x:Bind ViewModel.EfficiencyGradeBadgeFg, Mode=OneWay}" />
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="2" x:Name="RunAiScanBtn" Click="OnRunAiScanClick" Style="{StaticResource TransparentWrapperButtonStyle}" ToolTipService.ToolTip="Run AI Performance Diagnostics" VerticalAlignment="Center" Width="30" Height="30" CornerRadius="15">
                        <FontIcon x:Name="AiScanIcon" Glyph="&#xE721;" FontSize="13" Foreground="{ThemeResource SystemAccentColor}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Card 1: System Tweaks Active Ratio -->
            <Border x:Name="StatCard1" Grid.Row="0" Grid.Column="1" Style="{StaticResource QuickStatCardStyle}"
                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="6.5" helpers:Animation3DHelper.DepthZ="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{StaticResource PrimaryAccentLightBrush}" BorderBrush="{StaticResource PrimaryAccentBorderBrush}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tweaks Applied" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.OptimizedTweaksCount, Mode=OneWay}" FontSize="12" FontWeight="ExtraBold" Foreground="#FF10B981" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                <TextBlock Text="/" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.TotalTweaksCount, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                        </Grid>
                        <ProgressBar Value="{x:Bind ViewModel.OptimizedTweaksCount, Mode=OneWay}" Maximum="{x:Bind ViewModel.TotalTweaksCount, Mode=OneWay}" Height="4" CornerRadius="2" Foreground="{StaticResource PrimaryAccentGradient}" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 2: RAM Memory Utilization -->
            <Border x:Name="StatCard2" Grid.Row="0" Grid.Column="2" Style="{StaticResource QuickStatCardStyle}"
                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="6.5" helpers:Animation3DHelper.DepthZ="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="#203B82F6" BorderBrush="#503B82F6" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7F1;" FontSize="16" Foreground="#FF3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Memory In Use" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.RamUsageText, Mode=OneWay}" FontSize="12.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="QuickBoostBtn" Click="OnBoostRamClick" Style="{StaticResource TransparentWrapperButtonStyle}" ToolTipService.ToolTip="1-Click RAM Flush" VerticalAlignment="Center" Width="30" Height="30" CornerRadius="15">
                        <FontIcon Glyph="&#xF0AF;" FontSize="13" Foreground="#FF3B82F6" />
                    </Button>
                </Grid>
            </Border>

            <!-- Card 3: Gaming Turbo & CPU Mode -->
            <Border x:Name="StatCard3" Grid.Row="0" Grid.Column="3" Style="{StaticResource QuickStatCardStyle}"
                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="6.5" helpers:Animation3DHelper.DepthZ="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="#20F59E0B" BorderBrush="#50F59E0B" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7FC;" FontSize="16" Foreground="#FFF59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Turbo Mode" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.GamingRamFreedText, Mode=OneWay}" FontSize="12.5" FontWeight="Bold" Foreground="{ThemeResource AppRamChipFg}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                    <components:LoadingToggleSwitch Grid.Column="2" x:Name="TurboToggle" IsOn="{x:Bind ViewModel.IsTurboActive, Mode=TwoWay}" Toggled="OnTurboToggled" OnContent="" OffContent="" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 2. MAIN WORKSPACE GRID ==================== -->
        <Grid Grid.Row="2" ColumnSpacing="12" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" x:Name="Row0" />
                <RowDefinition Height="Auto" x:Name="Row1" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" x:Name="Col0" />
                <ColumnDefinition Width="340" x:Name="Col1" />
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Tweaks Management Center -->
            <Border x:Name="TweaksCard" Grid.Column="0" Grid.Row="0" Style="{StaticResource GlassmorphismCardStyle}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Category Filter & Search Bar -->
                        <RowDefinition Height="Auto" /> <!-- Quick Selection & Counters -->
                        <RowDefinition Height="*" />    <!-- Tweaks List -->
                    </Grid.RowDefinitions>

                    <!-- Category Segmented Filter & Search Box (Row 0) -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>

                        <!-- Category Segmented Pills (Pivot) -->
                        <Pivot Grid.Column="0" SelectionChanged="OnPivotSelectionChanged" Margin="0,-8,0,0">
                            <Pivot.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,6,0" />
                                </DataTemplate>
                            </Pivot.HeaderTemplate>
                            <PivotItem Header="All" Tag="All" />
                            <PivotItem Header="Performance" Tag="Performance" />
                            <PivotItem Header="Gaming &amp; GPU" Tag="Gaming &amp; GPU" />
                            <PivotItem Header="System &amp; Disk" Tag="System &amp; Disk" />
                            <PivotItem Header="Privacy &amp; Logs" Tag="Privacy &amp; Logs" />
                        </Pivot>

                        <!-- Instant Search Filter -->
                        <TextBox Grid.Column="1" x:Name="TweakSearchBox" 
                                 PlaceholderText="Search tweaks..." 
                                 TextChanged="OnSearchTextChanged"
                                 CornerRadius="8" Height="34" VerticalAlignment="Center">
                        </TextBox>
                    </Grid>

                    <!-- Quick Selection Bar (Row 1) -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Selection actions -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Content="Select All" Click="OnSelectAllClick" CornerRadius="6" Padding="10,4" FontSize="11" />
                            <Button Content="Deselect" Click="OnDeselectAllClick" CornerRadius="6" Padding="10,4" FontSize="11" />
                            <Button Content="Unapplied Only" Click="OnSelectUnappliedClick" CornerRadius="6" Padding="10,4" FontSize="11" />
                        </StackPanel>

                        <!-- Tweak Counter Badges -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="6" Padding="6,2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Total:" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.TotalTweaksCount, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="6" Padding="6,2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Optimized:" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.OptimizedTweaksCount, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Foreground="#FF10B981" />
                                </StackPanel>
                            </Border>
                            <Border Background="{ThemeResource AppBadgeWarningBg}" BorderBrush="{ThemeResource AppBadgeWarningBorder}" BorderThickness="1" CornerRadius="6" Padding="6,2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Available:" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.AvailableTweaksCount, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Foreground="#FFF59E0B" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Tweaks Virtualized List (Row 2) -->
                    <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.FilteredTweaks, Mode=OneWay}" SelectionMode="None" ItemContainerStyle="{StaticResource ModernCardListViewItemStyle}">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SystemTweak">
                                <Border Style="{StaticResource Tilt3DCardStyle}" Padding="12,9" Margin="0,0,0,4"
                                        helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="3.5" helpers:Animation3DHelper.DepthZ="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />  <!-- 0: CheckBox -->
                                            <ColumnDefinition Width="Auto" />  <!-- 1: Icon -->
                                            <ColumnDefinition Width="*" />     <!-- 2: Details -->
                                            <ColumnDefinition Width="Auto" />  <!-- 3: Status Badge -->
                                            <ColumnDefinition Width="Auto" />  <!-- 4: Action Button -->
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- CheckBox -->
                                        <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="0" />
                                        
                                        <!-- Category Icon with 3D Elevation -->
                                        <Border Grid.Column="1" Width="34" Height="34" CornerRadius="17" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1.2" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind IconGlyph}" Foreground="{ThemeResource SystemAccentColor}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        
                                        <!-- Details: Title, Registry Path & Comparison -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Description}" />
                                                <FontIcon Glyph="&#xE946;" FontSize="10.5" Foreground="{ThemeResource SystemAccentColor}" ToolTipService.ToolTip="{x:Bind RegistryPath}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ComparisonText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource SystemAccentColor}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        
                                        <!-- Status Badge -->
                                        <Border Grid.Column="3" Background="{x:Bind StatusBgColor, Mode=OneWay}" BorderBrush="{x:Bind StatusBorderColor, Mode=OneWay}" BorderThickness="1" CornerRadius="6" Padding="7,3" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{x:Bind StatusFormatted, Mode=OneWay}" Foreground="{x:Bind StatusForegroundColor, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" />
                                        </Border>

                                        <!-- Apply Button (Visible when NOT optimized) -->
                                        <Button Grid.Column="4" Content="Apply" Visibility="{x:Bind IsOptimized, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" Click="OnToggleTweakClick" CornerRadius="6" Padding="12,4" FontSize="11" VerticalAlignment="Center" />
                                        
                                        <!-- Revert Button (Visible when optimized) -->
                                        <Button Grid.Column="4" Content="Revert" Visibility="{x:Bind IsOptimized, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" Click="OnToggleTweakClick" CornerRadius="6" Padding="12,4" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Right Pane: Ergonomic Scrollable 3-Deck Control Stack -->
            <ScrollViewer x:Name="RightPanelScroll" Grid.Column="1" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
                <StackPanel x:Name="RightPanelGrid" Spacing="12">
                    
                    <!-- 1. RAM Booster 2.0 Card -->
                    <Border x:Name="RamBoosterCard" Style="{StaticResource NeonGlowBorderStyle}" Padding="14,12">
                        <StackPanel Spacing="8">
                            <!-- Header -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" Background="#253B82F6" CornerRadius="14" Grid.Column="0">
                                    <FontIcon Glyph="&#xE968;" FontSize="13" Foreground="#FF3B82F6" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="RAM Booster 2.0" FontWeight="Bold" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.AutoBoostEnabled, Mode=TwoWay}" VerticalAlignment="Center" OffContent="" OnContent="" MinWidth="0" HorizontalAlignment="Right" ToolTipService.ToolTip="Auto-purges RAM when load exceeds 85%" />
                            </Grid>

                            <!-- RAM Gauge & Metrics Breakdown -->
                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10" Padding="12,8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Gauge Ring -->
                                    <Grid Width="46" Height="46" Grid.Column="0" VerticalAlignment="Center">
                                        <ProgressRing Value="{x:Bind ViewModel.RamUsagePercentage, Mode=OneWay}" 
                                                      Minimum="0" Maximum="100" 
                                                      Width="44" Height="44" 
                                                      Background="{ThemeResource ControlStrokeColorDefaultBrush}" 
                                                      Foreground="{ThemeResource SystemAccentColor}"
                                                      IsIndeterminate="False"/>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.RamUsagePercentageText, Mode=OneWay}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock Text="RAM" FontSize="7" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Detailed metrics -->
                                    <Grid Grid.Column="1" RowSpacing="3" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Total:" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.TotalRamText, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Used:" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.UsedRamText, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Available:" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.AvailableRamText, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Foreground="#FF10B981" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Action Button -->
                            <Button x:Name="BoostRamBtn" Click="OnBoostRamClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBoosting), Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" HorizontalAlignment="Stretch" CornerRadius="8" Height="34" Padding="12,0" FontWeight="Bold">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <ProgressRing x:Name="BoostRamRing" IsActive="False" Visibility="Collapsed" Width="12" Height="12" Foreground="White" VerticalAlignment="Center"/>
                                    <FontIcon x:Name="BoostRamIcon" Glyph="&#xF0AF;" FontSize="11" Foreground="White" />
                                    <TextBlock x:Name="BoostRamText" Text="Purge RAM Cache" FontSize="11.5" VerticalAlignment="Center" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 2. Background Services Monitor Card -->
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="14,12">
                        <StackPanel Spacing="8">
                            <!-- Header -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" Background="{StaticResource PrimaryAccentLightBrush}" CornerRadius="14" Grid.Column="0">
                                    <FontIcon Glyph="&#xE713;" FontSize="13" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Monitored Services" FontWeight="Bold" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center">
                                    <TextBlock Text="Active" FontSize="8.5" FontWeight="Bold" Foreground="#FF10B981" />
                                </Border>
                            </Grid>

                            <!-- Services Items Control -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.BackgroundServices, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:ServiceStatusItem">
                                        <Grid Padding="0,3" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind StatusGlyph}" Foreground="{x:Bind StatusColor}" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="2" CornerRadius="4" Padding="5,1" VerticalAlignment="Center" Background="{x:Bind StatusColor}">
                                                <TextBlock Text="{x:Bind Status}" FontSize="7.5" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 3. Kernel & Latency Engine Profile Card -->
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="14,12">
                        <StackPanel Spacing="8">
                            <!-- Header -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" Background="{StaticResource PrimaryAccentLightBrush}" CornerRadius="14" Grid.Column="0">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="13" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Kernel &amp; Latency Tuning" FontWeight="Bold" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center">
                                    <TextBlock Text="Optimized" FontSize="8.5" FontWeight="Bold" Foreground="#FF10B981" />
                                </Border>
                            </Grid>

                            <!-- Profile Specs Grid -->
                            <Grid RowSpacing="4" Margin="0,2,0,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Multimedia Scheduling -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Multimedia Scheduling:" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" />
                                <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="{x:Bind ViewModel.MultimediaSchedulingStatus, Mode=OneWay}" FontSize="8.5" FontWeight="Bold" Foreground="#FF10B981" />
                                </Border>

                                <!-- Network Throttling -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Network Packet Rate:" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" />
                                <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="{x:Bind ViewModel.NetworkThrottlingStatus, Mode=OneWay}" FontSize="8.5" FontWeight="Bold" Foreground="#FF10B981" />
                                </Border>

                                <!-- Kernel Paging -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Kernel RAM Resident:" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" />
                                <Border Grid.Row="2" Grid.Column="1" Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="{x:Bind ViewModel.KernelPagingStatus, Mode=OneWay}" FontSize="8.5" FontWeight="Bold" Foreground="#FF10B981" />
                                </Border>
                            </Grid>

                            <!-- 1-Click Clean Delivery Cache Action -->
                            <Button x:Name="CleanCacheBtn" Click="OnCleanDeliveryCacheClick" IsEnabled="{x:Bind IsNot(ViewModel.IsCleaningCache), Mode=OneWay}" HorizontalAlignment="Stretch" CornerRadius="8" Height="32" Padding="12,0" FontSize="11" FontWeight="Bold">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <ProgressRing x:Name="CleanCacheRing" IsActive="False" Visibility="Collapsed" Width="12" Height="12" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center"/>
                                    <FontIcon x:Name="CleanCacheIcon" Glyph="&#xE74D;" FontSize="11" Foreground="{ThemeResource SystemAccentColor}" />
                                    <TextBlock x:Name="CleanCacheText" Text="Purge Delivery Cache" FontSize="11.5" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ==================== 3. STATUS BAR FOOTER ==================== -->
        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Margin="0,8,0,0" />
    </Grid>
</Page>
