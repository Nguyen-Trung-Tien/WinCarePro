<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.UpdaterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinCarePro.Models"
    xmlns:vm="using:WinCarePro.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24,20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutVisualStates">
                <!-- Wide Layout: Viewport Width >= 1080px -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1080" />
                    </VisualState.StateTriggers>
                </VisualState>

                <!-- Medium Layout: Viewport Width between 720px and 1080px -->
                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderCol1.Width" Value="0" />
                        <Setter Target="HeaderTitlePanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderActionsPanel.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderActionsPanel.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderActionsPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderActionsPanel.HorizontalAlignment" Value="Left" />
                        <Setter Target="HeaderActionsPanel.Margin" Value="0,10,0,0" />

                        <!-- Stats Grid Stacking to 2x2 layout -->
                        <Setter Target="StatsCol2.Width" Value="0" />
                        <Setter Target="StatsCol3.Width" Value="0" />
                        <Setter Target="StatCard3.(Grid.Row)" Value="1" />
                        <Setter Target="StatCard3.(Grid.Column)" Value="0" />
                        <Setter Target="StatCard4.(Grid.Row)" Value="1" />
                        <Setter Target="StatCard4.(Grid.Column)" Value="1" />

                        <Setter Target="ToolbarCol0.Width" Value="240" />
                    </VisualState.Setters>
                </VisualState>

                <!-- Narrow Layout: Viewport Width < 720px -->
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- Header Stacking -->
                        <Setter Target="HeaderCol1.Width" Value="0" />
                        <Setter Target="HeaderTitlePanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderActionsPanel.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderActionsPanel.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderActionsPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderActionsPanel.HorizontalAlignment" Value="Left" />
                        <Setter Target="HeaderActionsPanel.Margin" Value="0,10,0,0" />

                        <!-- Stats Grid Stacking to 1x4 layout -->
                        <Setter Target="StatsCol1.Width" Value="0" />
                        <Setter Target="StatsCol2.Width" Value="0" />
                        <Setter Target="StatsCol3.Width" Value="0" />
                        <Setter Target="StatCard2.(Grid.Row)" Value="1" />
                        <Setter Target="StatCard2.(Grid.Column)" Value="0" />
                        <Setter Target="StatCard3.(Grid.Row)" Value="2" />
                        <Setter Target="StatCard3.(Grid.Column)" Value="0" />
                        <Setter Target="StatCard4.(Grid.Row)" Value="3" />
                        <Setter Target="StatCard4.(Grid.Column)" Value="0" />

                        <!-- Toolbar Stacking -->
                        <Setter Target="ToolbarCol0.Width" Value="*" />
                        <Setter Target="ToolbarCol1.Width" Value="0" />
                        <Setter Target="ToolbarCol2.Width" Value="0" />
                        <Setter Target="SearchBox.(Grid.ColumnSpan)" Value="4" />
                        <Setter Target="SearchBox.Width" Value="NaN" />
                        <Setter Target="SearchBox.HorizontalAlignment" Value="Stretch" />
                        
                        <Setter Target="EngineStack.(Grid.Row)" Value="1" />
                        <Setter Target="EngineStack.(Grid.Column)" Value="0" />
                        <Setter Target="EngineStack.(Grid.ColumnSpan)" Value="4" />
                        <Setter Target="EngineStack.Margin" Value="0,8,0,0" />
                        
                        <Setter Target="SelectionStack.(Grid.Row)" Value="2" />
                        <Setter Target="SelectionStack.(Grid.Column)" Value="0" />
                        <Setter Target="SelectionStack.(Grid.ColumnSpan)" Value="4" />
                        <Setter Target="SelectionStack.Margin" Value="0,8,0,0" />

                        <Setter Target="StatusFilterStack.(Grid.Row)" Value="3" />
                        <Setter Target="StatusFilterStack.(Grid.ColumnSpan)" Value="4" />
                        <Setter Target="StatusFilterStack.Margin" Value="0,8,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="20" />
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0. Header -->
            <RowDefinition Height="Auto" /> <!-- 1. 4-Card Ribbon -->
            <RowDefinition Height="Auto" /> <!-- 2. Toolbar & Filters -->
            <RowDefinition Height="*" />    <!-- 3. Main Workspace -->
        </Grid.RowDefinitions>

        <!-- ==================== 0. MODERN HEADER ==================== -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow0" Height="Auto" />
                <RowDefinition x:Name="HeaderRow1" Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HeaderCol0" Width="*" />
                <ColumnDefinition x:Name="HeaderCol1" Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Title & Subtitle with Gradient Icon Badge -->
            <StackPanel x:Name="HeaderTitlePanel" Grid.Row="0" Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Style="{StaticResource PageHeaderIconBadgeStyle}" Background="{StaticResource PrimaryAccentGradient}">
                        <FontIcon Glyph="&#xE895;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Software Updater" Style="{StaticResource PageHeaderTitleStyle}" />
                        <TextBlock Text="Update installed applications and system packages via WinGet." Style="{StaticResource PageHeaderSubtitleStyle}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Right: Action Buttons -->
            <StackPanel x:Name="HeaderActionsPanel" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Cancel Button (Visible when busy) -->
                <Button x:Name="CancelBtn" Click="OnCancelClick" Visibility="{x:Bind ViewModel.CanCancel, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" CornerRadius="8" Padding="12,7" FontSize="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#FFEF4444" />
                        <TextBlock Text="Cancel" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#FFEF4444" />
                    </StackPanel>
                </Button>

                <!-- Scan Updates Button -->
                <Button x:Name="ScanUpdatesBtn" Click="OnScanUpdatesClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" CornerRadius="8" Padding="12,7" FontSize="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ProgressRing x:Name="ScanUpdatesRing" IsActive="False" Visibility="Collapsed" Width="13" Height="13" VerticalAlignment="Center"/>
                        <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}" />
                        <TextBlock x:Name="ScanUpdatesText" Text="Scan Updates" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Update Selected Button -->
                <Button x:Name="UpdateSelectedBtn" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" Click="OnUpdateSelectedClick" IsEnabled="{x:Bind CanUpdateSelected(ViewModel.HasSelectedUpdates, ViewModel.IsBusy), Mode=OneWay}" CornerRadius="8" Padding="16,7" FontWeight="Bold" FontSize="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ProgressRing x:Name="UpdateSelectedRing" IsActive="False" Visibility="Collapsed" Width="13" Height="13" Foreground="White" VerticalAlignment="Center"/>
                        <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="White" />
                        <TextBlock x:Name="UpdateSelectedText" Text="Update Selected" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <!-- Update All Button -->
                <Button x:Name="UpdateAllBtn" Click="OnUpdateAllClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" CornerRadius="8" Padding="12,7" FontSize="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ProgressRing x:Name="UpdateAllRing" IsActive="False" Visibility="Collapsed" Width="13" Height="13" VerticalAlignment="Center"/>
                        <FontIcon Glyph="&#xE777;" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <TextBlock x:Name="UpdateAllText" Text="Update All" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== 1. 4-CARD STAT RIBBON ==================== -->
        <Grid x:Name="StatsGrid" Grid.Row="1" Margin="0,0,0,14" ColumnSpacing="12" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="StatsRow0" Height="Auto" />
                <RowDefinition x:Name="StatsRow1" Height="Auto" />
                <RowDefinition x:Name="StatsRow2" Height="Auto" />
                <RowDefinition x:Name="StatsRow3" Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="StatsCol0" Width="*" />
                <ColumnDefinition x:Name="StatsCol1" Width="*" />
                <ColumnDefinition x:Name="StatsCol2" Width="*" />
                <ColumnDefinition x:Name="StatsCol3" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Pending Updates -->
            <Border x:Name="StatCard1" Grid.Column="0" Style="{StaticResource QuickStatCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#20F59E0B" Margin="0,0,12,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE787;" FontSize="20" Foreground="#FFF59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Pending Updates" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.PendingUpdatesCount, Mode=OneWay}" FontSize="20" FontWeight="ExtraBold" Foreground="#FFF59E0B"/>
                            <TextBlock Text="packages" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 2: Completed Updates -->
            <Border x:Name="StatCard2" Grid.Column="1" Style="{StaticResource QuickStatCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#2010B981" Margin="0,0,12,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="20" Foreground="#FF10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Up-to-Date Packages" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.CompletedCount, Mode=OneWay}" FontSize="20" FontWeight="ExtraBold" Foreground="#FF10B981"/>
                            <TextBlock Text="installed" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 3: Active Engine -->
            <Border x:Name="StatCard3" Grid.Column="2" Style="{StaticResource QuickStatCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#208B5CF6" Margin="0,0,12,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE945;" FontSize="20" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Active Package Engine" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ActiveEngineName, Mode=OneWay}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 4: System Update Health Rating -->
            <Border x:Name="StatCard4" Grid.Column="3" Style="{StaticResource QuickStatCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                        <ProgressRing Value="{x:Bind ViewModel.SystemHealthScore, Mode=OneWay}" IsActive="True" IsIndeterminate="False" Width="38" Height="38" Foreground="{x:Bind GetBrushFromHex(ViewModel.SystemHealthColor), Mode=OneWay}" />
                        <TextBlock Text="{x:Bind GetSecurityRatingText(ViewModel.PendingUpdatesCount), Mode=OneWay}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="System Update Health" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SystemHealthStatus, Mode=OneWay}" FontSize="12.5" FontWeight="Bold" Foreground="{x:Bind GetBrushFromHex(ViewModel.SystemHealthColor), Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 2. TOOLBAR & STATUS FILTER TABS ==================== -->
        <Grid x:Name="ToolbarGrid" Grid.Row="2" Margin="0,0,0,12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ToolbarRow0" Height="Auto" />
                <RowDefinition x:Name="ToolbarRow1" Height="Auto" />
                <RowDefinition x:Name="ToolbarRow2" Height="Auto" />
                <RowDefinition x:Name="ToolbarRow3" Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ToolbarCol0" Width="280" />
                <ColumnDefinition x:Name="ToolbarCol1" Width="Auto" />
                <ColumnDefinition x:Name="ToolbarCol2" Width="Auto" />
                <ColumnDefinition x:Name="ToolbarCol3" Width="*" />
            </Grid.ColumnDefinitions>
            
            <!-- Search Box -->
            <TextBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="Search package name or ID..." Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CornerRadius="8" Height="34" VerticalAlignment="Center"/>

            <!-- Engine Selector -->
            <StackPanel x:Name="EngineStack" Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Engine:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                <ComboBox SelectedValue="{x:Bind ViewModel.UpdateEngine, Mode=TwoWay}" SelectedValuePath="Tag" Width="220" Height="34" CornerRadius="8" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}">
                    <ComboBoxItem Content="Windows Package Manager" Tag="winget"/>
                    <ComboBoxItem Content="Direct Downloader" Tag="direct"/>
                </ComboBox>
            </StackPanel>

            <!-- Multi Selection Controls -->
            <StackPanel x:Name="SelectionStack" Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="8">
                <Button Content="Select All" Click="OnSelectAllClick" FontSize="11.5" Height="34" CornerRadius="8" Padding="12,0"/>
                <Button Content="Deselect All" Click="OnDeselectAllClick" FontSize="11.5" Height="34" CornerRadius="8" Padding="12,0"/>
            </StackPanel>

            <!-- Status Filter Tabs Row -->
            <StackPanel x:Name="StatusFilterStack" Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                <ToggleButton Content="All" IsChecked="{x:Bind IsFilterSelected(ViewModel.SelectedStatusFilter, 'All'), Mode=OneWay}" Click="OnFilterAllClick" CornerRadius="8" Padding="12,5" FontSize="11.5" FontWeight="SemiBold"/>
                
                <ToggleButton IsChecked="{x:Bind IsFilterSelected(ViewModel.SelectedStatusFilter, 'Pending'), Mode=OneWay}" Click="OnFilterPendingClick" CornerRadius="8" Padding="12,5" FontSize="11.5" FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Pending" />
                        <Border Background="#35F59E0B" Padding="6,1" CornerRadius="8">
                            <TextBlock Text="{x:Bind ViewModel.PendingUpdatesCount, Mode=OneWay}" FontSize="10" FontWeight="ExtraBold" Foreground="#FFF59E0B"/>
                        </Border>
                    </StackPanel>
                </ToggleButton>

                <ToggleButton IsChecked="{x:Bind IsFilterSelected(ViewModel.SelectedStatusFilter, 'Updating'), Mode=OneWay}" Click="OnFilterUpdatingClick" CornerRadius="8" Padding="12,5" FontSize="11.5" FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Updating" />
                        <Border Background="#353B82F6" Padding="6,1" CornerRadius="8">
                            <TextBlock Text="{x:Bind ViewModel.UpdatingCount, Mode=OneWay}" FontSize="10" FontWeight="ExtraBold" Foreground="#FF3B82F6"/>
                        </Border>
                    </StackPanel>
                </ToggleButton>

                <ToggleButton IsChecked="{x:Bind IsFilterSelected(ViewModel.SelectedStatusFilter, 'Completed'), Mode=OneWay}" Click="OnFilterCompletedClick" CornerRadius="8" Padding="12,5" FontSize="11.5" FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Completed" />
                        <Border Background="#3510B981" Padding="6,1" CornerRadius="8">
                            <TextBlock Text="{x:Bind ViewModel.CompletedCount, Mode=OneWay}" FontSize="10" FontWeight="ExtraBold" Foreground="#FF10B981"/>
                        </Border>
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- ==================== 3. MAIN WORKSPACE ==================== -->
        <Grid Grid.Row="3">
            <!-- Active Progress Banner Overlay -->
            <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="20" Height="96" VerticalAlignment="Top" HorizontalAlignment="Stretch" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,0,8">
                        <ProgressRing IsActive="True" Width="14" Height="14" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.ProgressMessage, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Grid.Row="0" Grid.Column="1" Click="OnCancelClick" Visibility="{x:Bind ViewModel.CanCancel, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Padding="10,4" CornerRadius="6" FontSize="11">
                        <TextBlock Text="Cancel" Foreground="#FFEF4444" FontWeight="SemiBold"/>
                    </Button>

                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Maximum="100" Height="6" CornerRadius="3" Foreground="{StaticResource PrimaryAccentGradient}" />
                </Grid>
            </Border>

            <!-- Updates List View -->
            <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="12" Visibility="{x:Bind IsListNotEmpty(ViewModel.Updates.Count, ViewModel.IsBusy), Mode=OneWay}">
                <ListView ItemsSource="{x:Bind ViewModel.Updates, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SoftwareUpdateInfo">
                            <Border Background="{x:Bind CardBackgroundBrush, Mode=OneWay}" BorderBrush="{x:Bind CardBorderBrush, Mode=OneWay}" BorderThickness="1.5" CornerRadius="10" Padding="16,12" Margin="0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Checkbox for multi selection -->
                                    <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanUpdate, Mode=OneWay}" Visibility="{x:Bind IsNotUpdatingVisibility, Mode=OneWay}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    
                                    <!-- Package Brand Icon -->
                                    <Border Grid.Column="1" Width="44" Height="44" Background="{x:Bind BrandBgBrush, Mode=OneWay}" BorderBrush="{x:Bind BrandBorderBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay}" FontSize="20" Foreground="{x:Bind BrandColorBrush, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Name, ID, Source, Completed Tag -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <Border Visibility="{x:Bind IsCompleted, Mode=OneWay}" Background="#2510B981" BorderBrush="#5010B981" BorderThickness="1" Padding="6,1" CornerRadius="4" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#FF10B981"/>
                                                    <TextBlock Text="Up to Date" FontSize="9.5" FontWeight="Bold" Foreground="#FF10B981"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                            <TextBlock Text="{x:Bind Id}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                            <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Padding="4,1" CornerRadius="4" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Source}" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Version Comparison Pill -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Padding="8,4" CornerRadius="6">
                                            <TextBlock Text="{x:Bind CurrentInstalledVersionDisplay, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        </Border>
                                        <FontIcon Glyph="&#xE72A;" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center"/>
                                        <Border Background="{x:Bind StatusBgColor, Mode=OneWay}" BorderBrush="{x:Bind StatusBorderColor, Mode=OneWay}" BorderThickness="1" Padding="8,4" CornerRadius="6">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{x:Bind AvailableVersion}" FontSize="11.5" FontWeight="Bold" Foreground="{x:Bind StatusForegroundColor, Mode=OneWay}"/>
                                                <FontIcon Glyph="{x:Bind StatusIconGlyph, Mode=OneWay}" FontSize="10" Foreground="{x:Bind StatusForegroundColor, Mode=OneWay}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Status Badge / Progress Bar Section -->
                                    <Grid Grid.Column="4" Margin="0,0,14,0" VerticalAlignment="Center" MinWidth="150">
                                        <StackPanel Visibility="{x:Bind IsUpdatingVisibility, Mode=OneWay}" Spacing="4">
                                            <ProgressBar Value="{x:Bind DownloadProgress, Mode=OneWay}" IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}" Maximum="100" Height="6" CornerRadius="3" Foreground="{StaticResource PrimaryAccentGradient}" />
                                            <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource SystemAccentColor}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Visibility="{x:Bind IsNotUpdatingVisibility, Mode=OneWay}" Background="{x:Bind StatusBgColor, Mode=OneWay}" BorderBrush="{x:Bind StatusBorderColor, Mode=OneWay}" BorderThickness="1" CornerRadius="8" Padding="10,4" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="{x:Bind StatusIconGlyph, Mode=OneWay}" FontSize="11" Foreground="{x:Bind StatusForegroundColor, Mode=OneWay}"/>
                                                <TextBlock Text="{x:Bind UpdateStatusDisplay, Mode=OneWay}" Foreground="{x:Bind StatusForegroundColor, Mode=OneWay}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Action Button / State Pill -->
                                    <Grid Grid.Column="5" VerticalAlignment="Center">
                                        <!-- Normal Update Button (Available) -->
                                        <Button Visibility="{x:Bind IsAvailable, Mode=OneWay}" Content="{x:Bind ActionBtnText, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" Click="OnUpdateSingleClick" IsEnabled="{x:Bind CanUpdate, Mode=OneWay}" VerticalAlignment="Center" Padding="16,6" CornerRadius="6" FontWeight="SemiBold"/>

                                        <!-- Retry Button (Failed) -->
                                        <Button Visibility="{x:Bind IsFailed, Mode=OneWay}" Click="OnUpdateSingleClick" Background="#20EF4444" Foreground="#FFEF4444" BorderBrush="#50EF4444" BorderThickness="1" VerticalAlignment="Center" Padding="14,6" CornerRadius="6" FontWeight="SemiBold">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="#FFEF4444"/>
                                                <TextBlock Text="Retry" FontSize="11.5" FontWeight="Bold" Foreground="#FFEF4444"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Up to Date Pill Badge (Completed) -->
                                        <Border Visibility="{x:Bind IsCompleted, Mode=OneWay}" Background="#2010B981" BorderBrush="#6010B981" BorderThickness="1" Padding="14,6" CornerRadius="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#FF10B981"/>
                                                <TextBlock Text="Up to Date" FontSize="11.5" FontWeight="Bold" Foreground="#FF10B981"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Updating Badge Pill (Updating) -->
                                        <Border Visibility="{x:Bind IsUpdating, Mode=OneWay}" Background="#20F59E0B" BorderBrush="#60F59E0B" BorderThickness="1" Padding="12,6" CornerRadius="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <ProgressRing IsActive="True" Width="12" Height="12" Foreground="#FFF59E0B"/>
                                                <TextBlock Text="Updating..." FontSize="11.5" FontWeight="SemiBold" Foreground="#FFF59E0B"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Empty State -->
            <Grid Visibility="{x:Bind IsListEmpty(ViewModel.Updates.Count, ViewModel.IsBusy), Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,48,0,48">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <Border Width="80" Height="80" CornerRadius="40" Background="#1E10B981" BorderBrush="#3010B981" BorderThickness="2" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="40" Foreground="#FF10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="System is up to date!" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="No pending updates found for the selected filter." FontSize="13" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Button Click="OnScanUpdatesClick" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" HorizontalAlignment="Center" Padding="20,10" CornerRadius="8" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="Check Again" VerticalAlignment="Center" FontSize="13.5" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
