<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.UpdaterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinCarePro.Models"
    xmlns:vm="using:WinCarePro.ViewModels"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    mc:Ignorable="d">

    <Grid Padding="20,12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutVisualStates">
                <!-- Wide Layout: Viewport Width >= 1024px (1 single neat row for stats & toolbar) -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1024" />
                    </VisualState.StateTriggers>
                </VisualState>

                <!-- Medium Layout: Viewport Width between 720px and 1024px -->
                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderCol1.Width" Value="0" />
                        <Setter Target="HeaderTitlePanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderActionsPanel.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderActionsPanel.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderActionsPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderActionsPanel.HorizontalAlignment" Value="Left" />
                        <Setter Target="HeaderActionsPanel.Margin" Value="0,8,0,0" />

                        <!-- Stats Grid Stacking to 2x2 layout -->
                        <Setter Target="StatCol2.Width" Value="0" />
                        <Setter Target="StatCol3.Width" Value="0" />
                        <Setter Target="StatCard2.(Grid.Row)" Value="1" />
                        <Setter Target="StatCard2.(Grid.Column)" Value="0" />
                        <Setter Target="StatCard3.(Grid.Row)" Value="1" />
                        <Setter Target="StatCard3.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>

                <!-- Narrow Layout: Viewport Width < 720px -->
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- Header Stacking -->
                        <Setter Target="HeaderCol1.Width" Value="0" />
                        <Setter Target="HeaderTitlePanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderActionsPanel.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderActionsPanel.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderActionsPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderActionsPanel.HorizontalAlignment" Value="Left" />
                        <Setter Target="HeaderActionsPanel.Margin" Value="0,8,0,0" />

                        <!-- Stats Grid Stacking to 1x4 layout -->
                        <Setter Target="StatCol1.Width" Value="0" />
                        <Setter Target="StatCol2.Width" Value="0" />
                        <Setter Target="StatCol3.Width" Value="0" />
                        <Setter Target="StatCard1.(Grid.Row)" Value="1" />
                        <Setter Target="StatCard1.(Grid.Column)" Value="0" />
                        <Setter Target="StatCard2.(Grid.Row)" Value="2" />
                        <Setter Target="StatCard2.(Grid.Column)" Value="0" />
                        <Setter Target="StatCard3.(Grid.Row)" Value="3" />
                        <Setter Target="StatCard3.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="20" />
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0. Header -->
            <RowDefinition Height="Auto" /> <!-- 1. 4-Card Ribbon -->
            <RowDefinition Height="Auto" /> <!-- 2. Toolbar & Filters -->
            <RowDefinition Height="*" />    <!-- 3. Main Workspace -->
        </Grid.RowDefinitions>

        <!-- ==================== 0. MODERN HEADER ==================== -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow0" Height="Auto" />
                <RowDefinition x:Name="HeaderRow1" Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HeaderCol0" Width="*" />
                <ColumnDefinition x:Name="HeaderCol1" Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Title & Subtitle with Gradient Icon Badge -->
            <StackPanel x:Name="HeaderTitlePanel" Grid.Row="0" Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Style="{StaticResource PageHeaderIconBadgeStyle}" Background="{StaticResource PrimaryAccentGradient}">
                        <FontIcon Glyph="&#xE895;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Software Updater" Style="{StaticResource PageHeaderTitleStyle}" />
                        <TextBlock Text="Apps &amp; packages updates via WinGet." Style="{StaticResource PageHeaderSubtitleStyle}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Right: Action Buttons (Scan + Update All + More) -->
            <!-- Right: Action Buttons (Scan + Update All + More) -->
            <StackPanel x:Name="HeaderActionsPanel" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Scan Updates Button (Hero CTA) -->
                <Button x:Name="ScanUpdatesBtn" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" Click="OnScanUpdatesClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" CornerRadius="8" Padding="16,7" FontWeight="Bold" FontSize="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ProgressRing x:Name="ScanUpdatesRing" IsActive="False" Visibility="Collapsed" Width="13" Height="13" Foreground="White" VerticalAlignment="Center"/>
                        <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="White" />
                        <TextBlock x:Name="ScanUpdatesText" Text="Scan for Updates" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <!-- Update All Apps Hero Primary CTA (Only visible when there are pending updates) -->
                <Button x:Name="UpdateAllBtn" Style="{StaticResource AccentButtonStyle}" Background="#FF10B981" Foreground="White" Click="OnUpdateAllClick" Visibility="{x:Bind HasPendingUpdatesVisibility(ViewModel.PendingUpdatesCount, ViewModel.IsBusy), Mode=OneWay}" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" CornerRadius="8" Padding="16,7" FontWeight="Bold" FontSize="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ProgressRing x:Name="UpdateAllRing" IsActive="False" Visibility="Collapsed" Width="13" Height="13" Foreground="White" VerticalAlignment="Center"/>
                        <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="White" />
                        <TextBlock x:Name="UpdateAllText" Text="{x:Bind GetUpdateAllButtonText(ViewModel.PendingUpdatesCount), Mode=OneWay}" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== 1. 4-CARD STAT RIBBON ==================== -->
        <Grid x:Name="StatsGrid" Grid.Row="1" Margin="0,0,0,10" ColumnSpacing="10" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="StatRow0" Height="Auto" />
                <RowDefinition x:Name="StatRow1" Height="Auto" />
                <RowDefinition x:Name="StatRow2" Height="Auto" />
                <RowDefinition x:Name="StatRow3" Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="StatCol0" Width="*" />
                <ColumnDefinition x:Name="StatCol1" Width="*" />
                <ColumnDefinition x:Name="StatCol2" Width="*" />
                <ColumnDefinition x:Name="StatCol3" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 0: System App Health Score -->
            <Border x:Name="StatCard0" Grid.Row="0" Grid.Column="0" Style="{StaticResource QuickStatCardStyle}"
                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="6.5" helpers:Animation3DHelper.DepthZ="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Ellipse Stroke="{StaticResource PrimaryAccentGradient}" StrokeThickness="3" Opacity="0.25" />
                        <ProgressRing Value="{x:Bind GetSecurityRating(ViewModel.PendingUpdatesCount), Mode=OneWay}" Width="38" Height="38" 
                                      Foreground="{StaticResource PrimaryAccentBrush}" Background="Transparent" />
                        <TextBlock Text="{x:Bind GetSecurityRatingText(ViewModel.PendingUpdatesCount), Mode=OneWay}" 
                                   FontSize="12" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource PrimaryAccentBrush}" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Software Security Index" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <Border Background="{ThemeResource AppBadgeGoodBg}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind ViewModel.SystemHealthStatus, Mode=OneWay}" FontSize="10" FontWeight="ExtraBold" Foreground="{ThemeResource AppBadgeGoodFg}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 1: Pending Updates Status -->
            <Border x:Name="StatCard1" Grid.Row="0" Grid.Column="1" Style="{StaticResource QuickStatCardStyle}"
                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="6.5" helpers:Animation3DHelper.DepthZ="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{ThemeResource AppStatusWarningBackground}" BorderBrush="{ThemeResource AppStatusWarningBorder}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE895;" FontSize="16" Foreground="{ThemeResource AppStatusWarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Pending Updates" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PendingUpdatesCount, Mode=OneWay}" FontSize="12" FontWeight="ExtraBold" Foreground="{ThemeResource AppStatusWarningBrush}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                        </Grid>
                        <Border Background="{ThemeResource AppBadgeGoodBg}" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left" Visibility="{x:Bind HasNoPendingUpdatesVisibility(ViewModel.PendingUpdatesCount), Mode=OneWay}">
                            <TextBlock Text="All Up-to-Date" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource AppBadgeGoodFg}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 2: Engine & Channel Mode -->
            <Border x:Name="StatCard2" Grid.Row="0" Grid.Column="2" Style="{StaticResource QuickStatCardStyle}"
                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="6.5" helpers:Animation3DHelper.DepthZ="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{ThemeResource AppStatusInfoBackground}" BorderBrush="{ThemeResource AppStatusInfoBorder}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE896;" FontSize="16" Foreground="{ThemeResource AppStatusInfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Package Provider" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ActiveEngineName, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource AppStatusInfoBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 3: Last Synchronization -->
            <Border x:Name="StatCard3" Grid.Row="0" Grid.Column="3" Style="{StaticResource QuickStatCardStyle}"
                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="6.5" helpers:Animation3DHelper.DepthZ="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{StaticResource PrimaryAccentLightBrush}" BorderBrush="{StaticResource PrimaryAccentBorderBrush}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE777;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Last Sync Time" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.LastScanTime, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 2. TOOLBAR & FILTERS ==================== -->
        <Grid x:Name="ToolbarGrid" Grid.Row="2" Margin="0,0,0,10" Visibility="{x:Bind HasItemsVisibility(ViewModel.TotalFoundCount, ViewModel.IsBusy), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Status Segmented Pills (Pivot) -->
            <Pivot Grid.Column="0" SelectionChanged="OnFilterPivotSelectionChanged" Margin="0,-8,0,0">
                <Pivot.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="13" FontWeight="SemiBold" Margin="0,0,6,0" />
                    </DataTemplate>
                </Pivot.HeaderTemplate>
                <PivotItem Header="All" Tag="All" />
                <PivotItem Header="Pending" Tag="Pending" />
                <PivotItem Header="Completed" Tag="Completed" />
            </Pivot>
            
            <!-- Master Selection & Search Box (Right) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                <CheckBox Content="Select All" 
                          Checked="OnMasterSelectAllChanged" 
                          Unchecked="OnMasterSelectAllChanged" 
                          FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBox x:Name="SearchBox" Width="220" PlaceholderText="Search package..." Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CornerRadius="8" Height="34" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ==================== 3. MAIN WORKSPACE ==================== -->
        <Grid Grid.Row="3">
            <!-- Active Progress Banner Overlay -->
            <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="20" Height="96" VerticalAlignment="Top" HorizontalAlignment="Stretch" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,0,8">
                        <ProgressRing IsActive="True" Width="14" Height="14" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.ProgressMessage, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Grid.Row="0" Grid.Column="1" Click="OnCancelClick" Visibility="{x:Bind ViewModel.CanCancel, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Padding="10,4" CornerRadius="6" FontSize="11">
                        <TextBlock Text="Cancel" Foreground="#FFEF4444" FontWeight="SemiBold"/>
                    </Button>

                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Maximum="100" Height="6" CornerRadius="3" Foreground="{StaticResource PrimaryAccentGradient}" />
                </Grid>
            </Border>

            <!-- Updates List View -->
            <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="12" Visibility="{x:Bind IsListNotEmpty(ViewModel.Updates.Count, ViewModel.IsBusy), Mode=OneWay}">
                <ListView ItemsSource="{x:Bind ViewModel.Updates, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SoftwareUpdateInfo">
                            <Border Background="{x:Bind CardBackgroundBrush, Mode=OneWay}" BorderBrush="{x:Bind CardBorderBrush, Mode=OneWay}" BorderThickness="1.5" CornerRadius="10" Padding="16,12" Margin="0,3"
                                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="3.5" helpers:Animation3DHelper.DepthZ="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Checkbox for multi selection -->
                                    <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanUpdate, Mode=OneWay}" Visibility="{x:Bind IsNotUpdatingVisibility, Mode=OneWay}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    
                                    <!-- Package Brand Icon -->
                                    <Border Grid.Column="1" Width="44" Height="44" Background="{x:Bind BrandBgBrush, Mode=OneWay}" BorderBrush="{x:Bind BrandBorderBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay}" FontSize="20" Foreground="{x:Bind BrandColorBrush, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Name, ID, Source, Completed Tag -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <Border Visibility="{x:Bind IsCompleted, Mode=OneWay}" Background="{ThemeResource AppStatusGoodBackground}" BorderBrush="{ThemeResource AppStatusGoodBorder}" BorderThickness="1" Padding="6,1" CornerRadius="4" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource AppStatusGoodBrush}"/>
                                                    <TextBlock Text="Up to Date" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource AppStatusGoodBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                            <TextBlock Text="{x:Bind Id}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                            <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Padding="4,1" CornerRadius="4" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Source}" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Version Comparison Pill -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Padding="8,4" CornerRadius="6">
                                            <TextBlock Text="{x:Bind CurrentInstalledVersionDisplay, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        </Border>
                                        <FontIcon Glyph="&#xE72A;" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center"/>
                                        <Border Background="{x:Bind StatusBgColor, Mode=OneWay}" BorderBrush="{x:Bind StatusBorderColor, Mode=OneWay}" BorderThickness="1" Padding="8,4" CornerRadius="6">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{x:Bind AvailableVersion}" FontSize="11.5" FontWeight="Bold" Foreground="{x:Bind StatusForegroundColor, Mode=OneWay}"/>
                                                <FontIcon Glyph="{x:Bind StatusIconGlyph, Mode=OneWay}" FontSize="10" Foreground="{x:Bind StatusForegroundColor, Mode=OneWay}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Status Badge / Progress Bar Section -->
                                    <Grid Grid.Column="4" Margin="0,0,14,0" VerticalAlignment="Center" MinWidth="150">
                                        <StackPanel Visibility="{x:Bind IsUpdatingVisibility, Mode=OneWay}" Spacing="4">
                                            <ProgressBar Value="{x:Bind DownloadProgress, Mode=OneWay}" IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}" Maximum="100" Height="6" CornerRadius="3" Foreground="{StaticResource PrimaryAccentGradient}" />
                                            <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource SystemAccentColor}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Visibility="{x:Bind IsNotUpdatingVisibility, Mode=OneWay}" Background="{x:Bind StatusBgColor, Mode=OneWay}" BorderBrush="{x:Bind StatusBorderColor, Mode=OneWay}" BorderThickness="1" CornerRadius="8" Padding="10,4" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="{x:Bind StatusIconGlyph, Mode=OneWay}" FontSize="11" Foreground="{x:Bind StatusForegroundColor, Mode=OneWay}"/>
                                                <TextBlock Text="{x:Bind UpdateStatusDisplay, Mode=OneWay}" Foreground="{x:Bind StatusForegroundColor, Mode=OneWay}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Action Button / State Pill -->
                                    <Grid Grid.Column="5" VerticalAlignment="Center">
                                        <!-- Normal Update Button (Available) -->
                                        <Button Visibility="{x:Bind IsAvailable, Mode=OneWay}" Content="{x:Bind ActionBtnText, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" Click="OnUpdateSingleClick" IsEnabled="{x:Bind CanUpdate, Mode=OneWay}" VerticalAlignment="Center" Padding="16,6" CornerRadius="6" FontWeight="SemiBold"/>

                                        <!-- Retry Button (Failed) -->
                                        <Button Visibility="{x:Bind IsFailed, Mode=OneWay}" Click="OnUpdateSingleClick" Background="{ThemeResource AppStatusDangerBackground}" Foreground="{ThemeResource AppStatusDangerBrush}" BorderBrush="{ThemeResource AppStatusDangerBorder}" BorderThickness="1" VerticalAlignment="Center" Padding="14,6" CornerRadius="6" FontWeight="SemiBold">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="{ThemeResource AppStatusDangerBrush}"/>
                                                <TextBlock Text="Retry" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource AppStatusDangerBrush}"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Up to Date Pill Badge (Completed) -->
                                        <Border Visibility="{x:Bind IsCompleted, Mode=OneWay}" Background="{ThemeResource AppStatusGoodBackground}" BorderBrush="{ThemeResource AppStatusGoodBorder}" BorderThickness="1" Padding="14,6" CornerRadius="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AppStatusGoodBrush}"/>
                                                <TextBlock Text="Up to Date" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource AppStatusGoodBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Updating Badge Pill (Updating) -->
                                        <Border Visibility="{x:Bind IsUpdating, Mode=OneWay}" Background="{ThemeResource AppStatusWarningBackground}" BorderBrush="{ThemeResource AppStatusWarningBorder}" BorderThickness="1" Padding="12,6" CornerRadius="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <ProgressRing IsActive="True" Width="12" Height="12" Foreground="{ThemeResource AppStatusWarningBrush}"/>
                                                <TextBlock Text="Updating..." FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource AppStatusWarningBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Empty State (Aura Glass Synced) -->
            <Grid Visibility="{x:Bind IsListEmpty(ViewModel.Updates.Count, ViewModel.IsBusy), Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,20">
                <Border Background="{ThemeResource AppCardBackground}" BorderBrush="{ThemeResource AppCardBorder}" BorderThickness="1" CornerRadius="16" Padding="32,24" MaxWidth="440">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="28" Background="{ThemeResource AppStatusGoodBackground}" BorderBrush="{ThemeResource AppStatusGoodBorder}" BorderThickness="1.5" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE73E;" FontSize="26" Foreground="{ThemeResource AppStatusGoodBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="3" HorizontalAlignment="Center">
