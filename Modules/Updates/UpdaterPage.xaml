<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.UpdaterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinCarePro.Models"
    xmlns:vm="using:WinCarePro.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutVisualStates">
                <!-- Wide Layout: Viewport Width >= 1120px -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1120" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- Medium Layout: Viewport Width >= 820px and < 1120px (Default windowed mode) -->
                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="820" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- Stats Grid Stacking to 2x2 layout -->
                        <Setter Target="StatsCol2.Width" Value="0" />
                        <Setter Target="StatsCol3.Width" Value="0" />
                        <Setter Target="StatCard3.(Grid.Row)" Value="1" />
                        <Setter Target="StatCard3.(Grid.Column)" Value="0" />
                        <Setter Target="StatCard4.(Grid.Row)" Value="1" />
                        <Setter Target="StatCard4.(Grid.Column)" Value="1" />

                        <!-- Toolbar Section Adjustments -->
                        <Setter Target="ToolbarCol0.Width" Value="240" />
                    </VisualState.Setters>
                </VisualState>
                <!-- Narrow Layout: Viewport Width < 820px -->
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- Header Buttons Stacking -->
                        <Setter Target="HeaderCol0.Width" Value="*" />
                        <Setter Target="HeaderCol1.Width" Value="0" />
                        <Setter Target="HeaderTextPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderActionsPanel.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderActionsPanel.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderActionsPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderActionsPanel.Margin" Value="0,8,0,0" />

                        <!-- Stats Grid Stacking to 1x4 layout -->
                        <Setter Target="StatsCol1.Width" Value="0" />
                        <Setter Target="StatsCol2.Width" Value="0" />
                        <Setter Target="StatsCol3.Width" Value="0" />
                        <Setter Target="StatCard2.(Grid.Row)" Value="1" />
                        <Setter Target="StatCard2.(Grid.Column)" Value="0" />
                        <Setter Target="StatCard3.(Grid.Row)" Value="2" />
                        <Setter Target="StatCard3.(Grid.Column)" Value="0" />
                        <Setter Target="StatCard4.(Grid.Row)" Value="3" />
                        <Setter Target="StatCard4.(Grid.Column)" Value="0" />

                        <!-- Toolbar Section Stacking -->
                        <Setter Target="ToolbarCol0.Width" Value="*" />
                        <Setter Target="ToolbarCol1.Width" Value="0" />
                        <Setter Target="ToolbarCol2.Width" Value="0" />
                        <Setter Target="ToolbarCol3.Width" Value="0" />
                        <Setter Target="SearchBox.(Grid.ColumnSpan)" Value="4" />
                        <Setter Target="SearchBox.Width" Value="NaN" />
                        <Setter Target="SearchBox.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="EngineStack.(Grid.Row)" Value="1" />
                        <Setter Target="EngineStack.(Grid.Column)" Value="0" />
                        <Setter Target="EngineStack.(Grid.ColumnSpan)" Value="4" />
                        <Setter Target="EngineStack.Margin" Value="0,8,0,0" />
                        <Setter Target="SelectionStack.(Grid.Row)" Value="2" />
                        <Setter Target="SelectionStack.(Grid.Column)" Value="0" />
                        <Setter Target="SelectionStack.(Grid.ColumnSpan)" Value="4" />
                        <Setter Target="SelectionStack.Margin" Value="0,8,0,0" />

                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Stats Cards Grid -->
            <RowDefinition Height="Auto" /> <!-- Toolbar -->
            <RowDefinition Height="*" />    <!-- Main Content Area -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,0,16" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow0" Height="Auto" />
                <RowDefinition x:Name="HeaderRow1" Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HeaderCol0" Width="*" />
                <ColumnDefinition x:Name="HeaderCol1" Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="HeaderTextPanel" Spacing="4">
                <TextBlock Text="Software Updater" FontSize="26" FontWeight="ExtraBold" CharacterSpacing="-0.5" />
                <TextBlock Text="Check and install newer builds of local third-party applications securely." FontSize="13" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
            </StackPanel>
            <StackPanel x:Name="HeaderActionsPanel" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Scan Updates" Click="OnScanUpdatesClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" Padding="16,6" CornerRadius="6"/>
                <Button Content="Update Selected" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" Click="OnUpdateSelectedClick" IsEnabled="{x:Bind CanUpdateSelected(ViewModel.HasSelectedUpdates, ViewModel.IsBusy), Mode=OneWay}" Padding="16,6" CornerRadius="6"/>
                <Button Content="Update All" Click="OnUpdateAllClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" Padding="16,6" CornerRadius="6"/>
            </StackPanel>
        </Grid>

        <!-- 2. Statistics Grid Section -->
        <Grid x:Name="StatsGrid" Grid.Row="1" Margin="0,0,0,16" ColumnSpacing="16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="StatsRow0" Height="Auto" />
                <RowDefinition x:Name="StatsRow1" Height="Auto" />
                <RowDefinition x:Name="StatsRow2" Height="Auto" />
                <RowDefinition x:Name="StatsRow3" Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="StatsCol0" Width="*" />
                <ColumnDefinition x:Name="StatsCol1" Width="*" />
                <ColumnDefinition x:Name="StatsCol2" Width="*" />
                <ColumnDefinition x:Name="StatsCol3" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Updates Available -->
            <Border x:Name="StatCard1" Grid.Column="0" Style="{StaticResource QuickStatCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE787;" FontSize="24" Foreground="#FFF59E0B" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Updates Available" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.UpdatesCount, Mode=OneWay}" FontSize="18" FontWeight="ExtraBold" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 2: Last Checked -->
            <Border x:Name="StatCard2" Grid.Column="1" Style="{StaticResource QuickStatCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xEC92;" FontSize="24" Foreground="#FF3B82F6" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Last Checked" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.LastScanTime, Mode=OneWay}" FontSize="18" FontWeight="ExtraBold" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 3: Active Engine -->
            <Border x:Name="StatCard3" Grid.Column="2" Style="{StaticResource QuickStatCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE945;" FontSize="24" Foreground="#FF7F56D9" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Active Engine" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ActiveEngineName, Mode=OneWay}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 4: System Status with Visual Progress ring -->
            <Border x:Name="StatCard4" Grid.Column="3" Style="{StaticResource QuickStatCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                        <ProgressRing Value="{x:Bind GetSecurityRating(ViewModel.UpdatesCount), Mode=OneWay}" IsActive="True" IsIndeterminate="False" Width="36" Height="36" Foreground="{x:Bind GetBrushFromHex(ViewModel.SystemHealthColor), Mode=OneWay}" />
                        <TextBlock Text="{x:Bind GetSecurityRatingText(ViewModel.UpdatesCount), Mode=OneWay}" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Security Health" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SystemHealthStatus, Mode=OneWay}" FontSize="12.5" FontWeight="Bold" Foreground="{x:Bind GetBrushFromHex(ViewModel.SystemHealthColor), Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Toolbar Section -->
        <Grid x:Name="ToolbarGrid" Grid.Row="2" Margin="0,0,0,12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ToolbarRow0" Height="Auto" />
                <RowDefinition x:Name="ToolbarRow1" Height="Auto" />
                <RowDefinition x:Name="ToolbarRow2" Height="Auto" />
                <RowDefinition x:Name="ToolbarRow3" Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ToolbarCol0" Width="260" />
                <ColumnDefinition x:Name="ToolbarCol1" Width="Auto" />
                <ColumnDefinition x:Name="ToolbarCol2" Width="Auto" />
                <ColumnDefinition x:Name="ToolbarCol3" Width="*" />
            </Grid.ColumnDefinitions>
            
            <TextBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="Search outdated packages..." Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CornerRadius="6" Height="32" VerticalAlignment="Center"/>

            <StackPanel x:Name="EngineStack" Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Engine:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                <ComboBox SelectedValue="{x:Bind ViewModel.UpdateEngine, Mode=TwoWay}" SelectedValuePath="Tag" Width="200" Height="32" CornerRadius="6" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}">
                    <ComboBoxItem Content="Windows Package Manager" Tag="winget"/>
                    <ComboBoxItem Content="Direct Downloader" Tag="direct"/>
                </ComboBox>
            </StackPanel>

            <StackPanel x:Name="SelectionStack" Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="8">
                <Button Content="Select All" Click="OnSelectAllClick" FontSize="11" Height="32" CornerRadius="6" Padding="12,0"/>
                <Button Content="Deselect All" Click="OnDeselectAllClick" FontSize="11" Height="32" CornerRadius="6" Padding="12,0"/>
            </StackPanel>

        </Grid>

        <!-- 4. Main Content Area -->
        <Grid Grid.Row="3">
            <!-- Progress Overlay -->
            <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="24" Height="100" VerticalAlignment="Center" HorizontalAlignment="Stretch" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.ProgressMessage, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Maximum="100" Height="6" CornerRadius="3" Foreground="{StaticResource PrimaryAccentGradient}" />
                </StackPanel>
            </Border>

            <!-- Updates List -->
            <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="12" Visibility="{x:Bind IsListNotEmpty(ViewModel.Updates.Count, ViewModel.IsBusy), Mode=OneWay}">
                <ListView ItemsSource="{x:Bind ViewModel.Updates, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SoftwareUpdateInfo">
                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Checkbox for multi selection -->
                                    <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    
                                    <!-- Package Brand Icon -->
                                    <Border Grid.Column="1" Width="40" Height="40" Background="{x:Bind BrandBgBrush, Mode=OneWay}" BorderBrush="{x:Bind BrandBorderBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay}" FontSize="20" Foreground="{x:Bind BrandColorBrush, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Name and ID -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Id}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                            <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Padding="4,1" CornerRadius="4" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Source}" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Version Comparison Pill -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Padding="7,3" CornerRadius="6">
                                            <TextBlock Text="{x:Bind InstalledVersion}" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        </Border>
                                        <FontIcon Glyph="&#xE72A;" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center"/>
                                        <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Padding="7,3" CornerRadius="6">
                                            <TextBlock Text="{x:Bind AvailableVersion}" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Status Badge / Progress -->
                                    <Grid Grid.Column="4" Margin="0,0,12,0" VerticalAlignment="Center" MinWidth="130">
                                        <StackPanel Visibility="{x:Bind IsUpdatingVisibility, Mode=OneWay}" Spacing="4">
                                            <ProgressBar Value="{x:Bind DownloadProgress, Mode=OneWay}" IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}" Maximum="100" Height="5" CornerRadius="2.5" Foreground="{StaticResource PrimaryAccentGradient}" />
                                            <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Visibility="{x:Bind IsNotUpdatingVisibility, Mode=OneWay}" Background="{x:Bind StatusBgColor, Mode=OneWay}" BorderBrush="{x:Bind StatusBorderColor, Mode=OneWay}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Center">
                                            <TextBlock Text="{x:Bind UpdateStatusDisplay, Mode=OneWay}" Foreground="{x:Bind StatusForegroundColor, Mode=OneWay}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <!-- Update Action Button -->
                                    <Button Grid.Column="5" Content="Update" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" Click="OnUpdateSingleClick" IsEnabled="{x:Bind CanUpdate, Mode=OneWay}" VerticalAlignment="Center" Padding="14,6" CornerRadius="6"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Empty State -->
            <Grid Visibility="{x:Bind IsListEmpty(ViewModel.Updates.Count, ViewModel.IsBusy), Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,48,0,48">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <Border Width="80" Height="80" CornerRadius="40" Background="#1E10B981" BorderBrush="#3010B981" BorderThickness="2" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="40" Foreground="#FF10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="Your system is up to date!" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="No updates available for your third-party applications." FontSize="13" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Button Content="Check Again" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" Click="OnScanUpdatesClick" HorizontalAlignment="Center" Padding="16,8"/>
                </StackPanel>
            </Grid>
        </Grid>


    </Grid>
</Page>


