<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinCarePro.Shared.Components.LoadingToggleSwitch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Header Label Column -->
        <TextBlock x:Name="HeaderTextBlock"
                   Grid.Column="0"
                   Text="{x:Bind HeaderText, Mode=OneWay}"
                   FontSize="12.5"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"
                   Visibility="{x:Bind HasHeader(HeaderText), Mode=OneWay}" />

        <!-- Toggle Switch & Loading Spinner Column -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
            <!-- Loading Indicator Spinner -->
            <StackPanel x:Name="LoadingPanel"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind IsLoading, Mode=OneWay}">
                <ProgressRing x:Name="SpinnerRing"
                              IsActive="True"
                              Width="16"
                              Height="16"
                              Foreground="{StaticResource PrimaryAccentBrush}"
                              VerticalAlignment="Center" />
                <TextBlock x:Name="LoadingLabel"
                           Text="{x:Bind LoadingText, Mode=OneWay}"
                           FontSize="11.5"
                           FontStyle="Italic"
                           Foreground="{StaticResource PrimaryAccentBrush}"
                           VerticalAlignment="Center"
                           Visibility="{x:Bind HasLoadingText(LoadingText), Mode=OneWay}" />
            </StackPanel>

            <!-- Native WinUI ToggleSwitch -->
            <ToggleSwitch x:Name="InnerToggle"
                          IsOn="{x:Bind IsOn, Mode=TwoWay}"
                          IsEnabled="{x:Bind GetIsEnabled(IsLoading, UserControlIsEnabled), Mode=OneWay}"
                          OnContent="{x:Bind OnContent, Mode=OneWay}"
                          OffContent="{x:Bind OffContent, Mode=OneWay}"
                          MinWidth="0"
                          CornerRadius="4"
                          Toggled="InnerToggle_Toggled"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right" />
        </StackPanel>
    </Grid>
</UserControl>
