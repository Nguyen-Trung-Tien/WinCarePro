<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinCarePro.Components.ToastNotification"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="356"
    Margin="0,0,0,10"
    Opacity="0">

    <UserControl.Resources>
        <Storyboard x:Name="PulseAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="IconGlowRing"
                             Storyboard.TargetProperty="Opacity"
                             From="0.85" To="0.3" Duration="0:0:0.9"/>
            <DoubleAnimation Storyboard.TargetName="StatusIcon"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.5" Duration="0:0:0.9"/>
        </Storyboard>
        <Storyboard x:Name="RepeatPulseAnimation">
            <DoubleAnimation Storyboard.TargetName="RepeatBadgeTransform" Storyboard.TargetProperty="ScaleX" From="1.0" To="1.25" Duration="0:0:0.18" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="RepeatBadgeTransform" Storyboard.TargetProperty="ScaleY" From="1.0" To="1.25" Duration="0:0:0.18" AutoReverse="True"/>
        </Storyboard>

        <!-- Toast Circular Close Button Style -->
        <Style x:Key="ToastCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="12">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource AppStatChipBackground}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource AppStatChipBorder}"/>
                                            <Setter Target="RootGrid.Opacity" Value="0.8"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.3"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="ContainerBorder"
            Background="{ThemeResource AppCardBackground}"
            BorderBrush="{ThemeResource AppCardBorder}"
            BorderThickness="1.2"
            CornerRadius="16"
            Padding="0"
            Translation="0,4,24">
        <Grid>
            <!-- Top Specular Sheen Line -->
            <Border Height="1" VerticalAlignment="Top" CornerRadius="16,16,0,0" Opacity="0.45">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#FFFFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Background Ambient Tint -->
            <Border x:Name="AmbientTintBorder"
                    CornerRadius="16"
                    Opacity="0.08"
                    Background="{StaticResource PrimaryAccentBrush}" />

            <!-- Main Content Grid -->
            <Grid Padding="14,12,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Glowing Status Icon Badge -->
                <Grid Grid.Column="0" Width="36" Height="36" VerticalAlignment="Top" Margin="0,2,12,0">
                    <Border x:Name="IconGlowRing"
                            Width="36" Height="36"
                            CornerRadius="12"
                            Background="{ThemeResource AppBadgeNeutralBg}"
                            BorderBrush="{ThemeResource AppBadgeNeutralBorder}"
                            BorderThickness="1"/>
                    <FontIcon x:Name="StatusIcon"
                              Glyph="&#xE946;"
                              FontSize="16"
                              Foreground="{ThemeResource AppBadgeNeutralFg}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Grid>

                <!-- Text Content Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="TitleTextBlock"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   FontFamily="Segoe UI Variable Display"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        
                        <!-- Repeat Counter Badge (e.g. x2, x3) -->
                        <Border x:Name="RepeatBadge"
                                Background="{StaticResource PrimaryAccentBrush}"
                                CornerRadius="8"
                                Padding="6,1"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="RepeatBadgeTransform"/>
                            </Border.RenderTransform>
                            <TextBlock x:Name="RepeatCountText"
                                       Text="1"
                                       FontSize="9.5"
                                       FontWeight="ExtraBold"
                                       Foreground="White"
                                       Typography.NumeralAlignment="Tabular"/>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="DescTextBlock"
                               FontSize="11.5"
                               LineHeight="16"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Contextual Action Button -->
                <Button x:Name="ActionBtn"
                        Grid.Column="2"
                        Margin="2,0,6,0"
                        Padding="10,4"
                        FontSize="11"
                        FontWeight="Bold"
                        CornerRadius="7"
                        VerticalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="Collapsed"/>

                <!-- Close Button -->
                <Button x:Name="CloseBtn"
                        Grid.Column="3"
                        Style="{StaticResource ToastCloseButtonStyle}"
                        VerticalAlignment="Top"
                        Margin="0,-2,-2,0">
                    <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Button>
            </Grid>

            <!-- Bottom Auto-dismiss Progress Micro-Bar -->
            <ProgressBar x:Name="DismissProgressBar"
                         Minimum="0"
                         Maximum="100"
                         Value="100"
                         Height="2.5"
                         CornerRadius="0,0,16,16"
                         VerticalAlignment="Bottom"
                         HorizontalAlignment="Stretch"
                         Background="Transparent"
                         Foreground="{StaticResource PrimaryAccentBrush}"/>
        </Grid>
    </Border>
</UserControl>


