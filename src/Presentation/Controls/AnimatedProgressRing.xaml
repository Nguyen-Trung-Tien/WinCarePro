<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinCarePro.Shared.Components.AnimatedProgressRing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- AnimatedProgressRing — v4.0.0 Aura Glass 2.0
         Premium progress ring with gradient stroke, pulsing glow halo,
         count-up animated value text, and smooth spring transitions. -->
    <Grid x:Name="RingContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Pulsing Glow Halo (background depth) -->
        <Ellipse x:Name="GlowHalo" Opacity="0.08" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FF8B5CF6" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Track Ring (background track) -->
        <Ellipse x:Name="TrackRing" Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="5" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3" />

        <!-- Value ProgressRing (actual value display) -->
        <ProgressRing x:Name="ValueRing" IsIndeterminate="False" Foreground="{StaticResource PrimaryAccentGradient}" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- Center Text Stack -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
            <TextBlock x:Name="ValueText" Text="0" FontFamily="Segoe UI Variable Display" FontWeight="ExtraBold" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryAccentBrush}" CharacterSpacing="-20" />
            <TextBlock x:Name="LabelText" Text="Score" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
