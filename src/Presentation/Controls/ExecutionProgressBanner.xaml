<UserControl
    x:Class="WinCarePro.Presentation.Controls.ExecutionProgressBanner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinCarePro.Presentation.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- High-Performance Cyan to Emerald 120 FPS Gradient -->
        <LinearGradientBrush x:Key="ProgressGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF00D2FF" Offset="0.0" />
            <GradientStop Color="#FF00E676" Offset="1.0" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Border Background="{ThemeResource V6SurfaceCardBackground}"
            BorderBrush="{ThemeResource V6SurfaceCardBorder}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14,10"
            Margin="0,0,0,10">
        <Grid RowSpacing="7">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header + Action -->
                <RowDefinition Height="Auto" /> <!-- Live Monospace Ticker -->
                <RowDefinition Height="Auto" /> <!-- Dual-Mode Gradient ProgressBar -->
            </Grid.RowDefinitions>

            <!-- Row 0: Current Task & Target App/Action + Cancel Button -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Spinner + Task Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ProgressRing IsActive="True" Width="16" Height="16" Foreground="#FF00D2FF" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                               FontSize="13"
                               FontWeight="Bold"
                               FontFamily="Segoe UI Variable Display"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Numeric Percentage + Cancel Button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind local:ExecutionProgressBanner.FormatPercent(ProgressPercentage), Mode=OneWay}"
                               Visibility="{x:Bind local:ExecutionProgressBanner.DeterminateVisibility(IsIndeterminate), Mode=OneWay}"
                               FontSize="12.5"
                               FontWeight="ExtraBold"
                               FontFamily="Segoe UI Variable Display"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="#FF00E676"
                               VerticalAlignment="Center"/>

                    <!-- Cancel Button -->
                    <Button Command="{x:Bind CancelCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind CanCancel, Mode=OneWay}"
                            Background="#22EF4444"
                            BorderBrush="#44EF4444"
                            BorderThickness="1"
                            Foreground="#FFEF4444"
                            CornerRadius="6"
                            Padding="10,4"
                            FontSize="11"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="#FFEF4444"/>
                            <TextBlock Text="{x:Bind CancelText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: Live Status Ticker (Path, File, Registry, Package) -->
            <Border Grid.Row="1"
                    Background="{ThemeResource V6SurfaceCardHover}"
                    BorderBrush="{ThemeResource V6SubtleBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,4"
                    Visibility="{x:Bind local:ExecutionProgressBanner.HasTargetItemVisibility(TargetItem), Mode=OneWay}">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="11" Foreground="#FF00D2FF" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind TargetItem, Mode=OneWay}"
                               FontFamily="Cascadia Code, Consolas, Segoe UI Variable Text"
                               FontSize="11"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Row 2: Precision Gradient ProgressBar -->
            <ProgressBar Grid.Row="2"
                         Value="{x:Bind ProgressPercentage, Mode=OneWay}"
                         IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                         Maximum="100"
                         Height="5"
                         CornerRadius="2.5"
                         Foreground="{StaticResource ProgressGradientBrush}"
                         Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                         HorizontalAlignment="Stretch"/>
        </Grid>
    </Border>
</UserControl>
