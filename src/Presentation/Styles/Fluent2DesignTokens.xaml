<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- WINCARE PRO V6.0.0 — MODERN FLUENT 2 DESIGN TOKENS (ZERO-BLOAT)           -->
    <!-- Native WinUI 3, 2-Layer Flat Depth, High-Performance Render, 100ms Motion -->
    <!-- ========================================================================= -->

    <ResourceDictionary.ThemeDictionaries>
        <!-- ==================== DARK MODE (MICA ALT NATIVE) ==================== -->
        <ResourceDictionary x:Key="Default">
            <!-- Surface Layer 1 Tokens (#161922 Obsidian Card Background) -->
            <SolidColorBrush x:Key="V6SurfaceCardBackground" Color="#E6161922" />
            <SolidColorBrush x:Key="V6SurfaceCardHover" Color="#F21C202C" />
            <SolidColorBrush x:Key="V6SurfaceCardBorder" Color="#25FFFFFF" />
            <SolidColorBrush x:Key="V6SubtleBorder" Color="#15FFFFFF" />

            <!-- Semantic Flat Badges (Flat, Zero-Glow) -->
            <SolidColorBrush x:Key="V6BadgeGoodBg" Color="#1810B981" />
            <SolidColorBrush x:Key="V6BadgeGoodBorder" Color="#3010B981" />
            <SolidColorBrush x:Key="V6BadgeGoodFg" Color="#FF10B981" />

            <SolidColorBrush x:Key="V6BadgeWarningBg" Color="#18F59E0B" />
            <SolidColorBrush x:Key="V6BadgeWarningBorder" Color="#30F59E0B" />
            <SolidColorBrush x:Key="V6BadgeWarningFg" Color="#FFF59E0B" />

            <SolidColorBrush x:Key="V6BadgeCriticalBg" Color="#18EF4444" />
            <SolidColorBrush x:Key="V6BadgeCriticalBorder" Color="#30EF4444" />
            <SolidColorBrush x:Key="V6BadgeCriticalFg" Color="#FFEF4444" />

            <SolidColorBrush x:Key="V6BadgeNeutralBg" Color="#140F6CBD" />
            <SolidColorBrush x:Key="V6BadgeNeutralBorder" Color="#280F6CBD" />
            <SolidColorBrush x:Key="V6BadgeNeutralFg" Color="#FF38BDF8" />

            <!-- Hardware Telemetry Accent Fills -->
            <SolidColorBrush x:Key="V6CpuBrush" Color="#FFF59E0B" />
            <SolidColorBrush x:Key="V6RamBrush" Color="#FF0284C7" />
            <SolidColorBrush x:Key="V6GpuBrush" Color="#FF8B5CF6" />
            <SolidColorBrush x:Key="V6DiskBrush" Color="#FF10B981" />
            <SolidColorBrush x:Key="V6TrackBrush" Color="#1AFFFFFF" />
        </ResourceDictionary>

        <!-- ==================== LIGHT MODE (MICA ALT NATIVE) ==================== -->
        <ResourceDictionary x:Key="Light">
            <!-- Surface Layer 1 Tokens -->
            <SolidColorBrush x:Key="V6SurfaceCardBackground" Color="#F8FFFFFF" />
            <SolidColorBrush x:Key="V6SurfaceCardHover" Color="#FFF1F5F9" />
            <SolidColorBrush x:Key="V6SurfaceCardBorder" Color="#0F000000" />
            <SolidColorBrush x:Key="V6SubtleBorder" Color="#08000000" />

            <!-- Semantic Flat Badges (Flat, Zero-Glow) -->
            <SolidColorBrush x:Key="V6BadgeGoodBg" Color="#18059669" />
            <SolidColorBrush x:Key="V6BadgeGoodBorder" Color="#30059669" />
            <SolidColorBrush x:Key="V6BadgeGoodFg" Color="#FF059669" />

            <SolidColorBrush x:Key="V6BadgeWarningBg" Color="#18D97706" />
            <SolidColorBrush x:Key="V6BadgeWarningBorder" Color="#30D97706" />
            <SolidColorBrush x:Key="V6BadgeWarningFg" Color="#FFD97706" />

            <SolidColorBrush x:Key="V6BadgeCriticalBg" Color="#18DC2626" />
            <SolidColorBrush x:Key="V6BadgeCriticalBorder" Color="#30DC2626" />
            <SolidColorBrush x:Key="V6BadgeCriticalFg" Color="#FFDC2626" />

            <SolidColorBrush x:Key="V6BadgeNeutralBg" Color="#100284C7" />
            <SolidColorBrush x:Key="V6BadgeNeutralBorder" Color="#250284C7" />
            <SolidColorBrush x:Key="V6BadgeNeutralFg" Color="#FF0284C7" />

            <!-- Hardware Telemetry Accent Fills -->
            <SolidColorBrush x:Key="V6CpuBrush" Color="#FFD97706" />
            <SolidColorBrush x:Key="V6RamBrush" Color="#FF0284C7" />
            <SolidColorBrush x:Key="V6GpuBrush" Color="#FF7C3AED" />
            <SolidColorBrush x:Key="V6DiskBrush" Color="#FF059669" />
            <SolidColorBrush x:Key="V6TrackBrush" Color="#0A000000" />
        </ResourceDictionary>

        <!-- ==================== HIGH CONTRAST MODE ==================== -->
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="V6SurfaceCardBackground" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="V6SurfaceCardHover" ResourceKey="SystemColorHighlightBrush" />
            <StaticResource x:Key="V6SurfaceCardBorder" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="V6SubtleBorder" ResourceKey="SystemColorWindowTextColorBrush" />

            <StaticResource x:Key="V6BadgeGoodBg" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="V6BadgeGoodBorder" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="V6BadgeGoodFg" ResourceKey="SystemColorHighlightBrush" />

            <StaticResource x:Key="V6BadgeWarningBg" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="V6BadgeWarningBorder" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="V6BadgeWarningFg" ResourceKey="SystemColorHighlightBrush" />

            <StaticResource x:Key="V6BadgeCriticalBg" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="V6BadgeCriticalBorder" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="V6BadgeCriticalFg" ResourceKey="SystemColorHighlightBrush" />

            <StaticResource x:Key="V6BadgeNeutralBg" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="V6BadgeNeutralBorder" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="V6BadgeNeutralFg" ResourceKey="SystemColorHighlightBrush" />

            <StaticResource x:Key="V6CpuBrush" ResourceKey="SystemColorHighlightBrush" />
            <StaticResource x:Key="V6RamBrush" ResourceKey="SystemColorHighlightBrush" />
            <StaticResource x:Key="V6GpuBrush" ResourceKey="SystemColorHighlightBrush" />
            <StaticResource x:Key="V6DiskBrush" ResourceKey="SystemColorHighlightBrush" />
            <StaticResource x:Key="V6TrackBrush" ResourceKey="SystemColorWindowTextColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ========================================================================= -->
    <!-- BASE STYLES: FLAT SURFACE CARDS (LAYER 1)                                -->
    <!-- ========================================================================= -->

    <!-- V6 Standard Surface Card -->
    <Style x:Key="V6FlatCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource V6SurfaceCardBackground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource V6SurfaceCardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- V6 Interactive Bento Tile Button (Micro-Interaction: Hover tint & 0.98x Pressed tactile feedback) -->
    <Style x:Key="V6BentoTileButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" Background="Transparent">
                        <Border x:Name="CardBorder"
                                Background="{ThemeResource V6SurfaceCardBackground}"
                                BorderBrush="{ThemeResource V6SurfaceCardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="CardBorder.Background" Value="{ThemeResource V6SurfaceCardHover}" />
                                        <Setter Target="CardBorder.BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="CardBorder.Background" Value="{ThemeResource V6SurfaceCardHover}" />
                                        <Setter Target="RootGrid.Scale" Value="0.98,0.98,1.0" />
                                        <Setter Target="RootGrid.CenterPoint" Value="0.5,0.5,0.0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="CardBorder.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- TYPOGRAPHY: TABULAR NUMBERS & TITLES                                      -->
    <!-- ========================================================================= -->

    <!-- V6 Large Telemetry Metric (Strict Tabular Figures: Zero layout jitter) -->
    <Style x:Key="V6MetricDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- V6 Subtitle / Label Text -->
    <Style x:Key="V6MetricLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- ========================================================================= -->
    <!-- SLIM PROGRESS BAR (3px COMPACT BAR — REPLACES HEAVY RINGS)                -->
    <!-- ========================================================================= -->

    <Style x:Key="V6SlimProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="CornerRadius" Value="1.5" />
        <Setter Property="MinHeight" Value="3" />
        <Setter Property="MaxHeight" Value="3" />
        <Setter Property="Background" Value="{ThemeResource V6TrackBrush}" />
    </Style>

    <!-- ========================================================================= -->
    <!-- PRAGMATIC BUTTONS (4px CORNER RADIUS, FAST 100ms FEEDBACK)                -->
    <!-- ========================================================================= -->

    <Style x:Key="V6PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="V6SecondaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- ========================================================================= -->
    <!-- CONTEXTUAL INDICATORS & STATUS BADGES                                     -->
    <!-- ========================================================================= -->

    <Style x:Key="V6StatusBadgeGoodStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource V6BadgeGoodBg}" />
        <Setter Property="BorderBrush" Value="{ThemeResource V6BadgeGoodBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="V6StatusBadgeWarningStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource V6BadgeWarningBg}" />
        <Setter Property="BorderBrush" Value="{ThemeResource V6BadgeWarningBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="V6StatusBadgeCriticalStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource V6BadgeCriticalBg}" />
        <Setter Property="BorderBrush" Value="{ThemeResource V6BadgeCriticalBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="V6StatusBadgeNeutralStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource V6BadgeNeutralBg}" />
        <Setter Property="BorderBrush" Value="{ThemeResource V6BadgeNeutralBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ========================================================================= -->
    <!-- 2026 NATIVE LIST & ROW INTERACTION TOKENS                                 -->
    <!-- ========================================================================= -->

    <!-- V6 Row Card for Virtualized Lists (ListView items) -->
    <Style x:Key="V6RowCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- V6 Micro Icon Button (Compact 28x28 Toolbar & Actions) -->
    <Style x:Key="V6IconActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- V6 Subtle Hairline Divider (Crisp 1px separator, zero bleed) -->
    <Style x:Key="V6HairlineDividerStyle" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Opacity" Value="0.25" />
    </Style>

</ResourceDictionary>

