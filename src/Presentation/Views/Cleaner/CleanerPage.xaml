<Page
    x:Class="WinCarePro.Views.CleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinCarePro.ViewModels"
    xmlns:controls="using:WinCarePro.Presentation.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid RowSpacing="12" Margin="4,0,4,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0. Action Header -->
            <RowDefinition Height="Auto" /> <!-- 1. Heavy Task Execution Banner -->
            <RowDefinition Height="*" />    <!-- 2. Virtualized Checklist View & Skeleton -->
            <RowDefinition Height="Auto" /> <!-- 3. Execution Footer -->
        </Grid.RowDefinitions>

        <!-- 0. Header Card -->
        <Border Grid.Row="0" Style="{StaticResource V6FlatCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="System Cleaner (Zero-Risk Engine)" FontSize="15" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display"/>
                    <TextBlock Text="Safely audit and clean temporary clutter, orphaned uninstall registry keys, and leftover app files." FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Scan Button with Instant/Busy Visual Feedback (Mini ProgressRing 14x14) -->
                    <Button Style="{StaticResource V6SecondaryActionButtonStyle}" Command="{x:Bind ViewModel.ScanAllCommand}" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="14" Height="14" Foreground="{StaticResource PrimaryAccentBrush}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <FontIcon Glyph="&#xE721;" FontSize="11.5" Visibility="{x:Bind ViewModel.IsNotBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="Scan Clutter" />
                        </StackPanel>
                    </Button>

                    <!-- Clean Button -->
                    <Button Style="{StaticResource V6PrimaryActionButtonStyle}" Command="{x:Bind ViewModel.CleanSelectedCommand}" IsEnabled="{x:Bind ViewModel.CanClean, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE74D;" FontSize="11.5"/>
                            <TextBlock Text="Clean Selected" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. Execution Progress Card / Overlay Banner (>5s tasks) -->
        <controls:ExecutionProgressBanner
            Grid.Row="1"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
            StatusText="{x:Bind ViewModel.CurrentStatusText, Mode=OneWay}"
            TargetItem="{x:Bind ViewModel.CurrentTargetItem, Mode=OneWay}"
            ProgressPercentage="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}"
            IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
            CancelCommand="{x:Bind ViewModel.CancelCurrentTaskCommand, Mode=OneWay}"
            CanCancel="{x:Bind ViewModel.CanCancel, Mode=OneWay}" />

        <!-- 2. Main Workspace: Virtualized Checklist View & Skeleton Shimmer Loading -->
        <Border Grid.Row="2" Style="{StaticResource V6FlatCardStyle}" Padding="0">
            <Grid>
                <!-- Skeleton Shimmer Loading State (1-5s tasks: prevents empty list layout flash) -->
                <ScrollViewer Visibility="{x:Bind SkeletonVisibility(ViewModel.CleanerCategories.Count, ViewModel.IsBusy), Mode=OneWay}" Padding="8">
                    <controls:SkeletonCardControl />
                </ScrollViewer>

                <!-- Loaded Items ListView -->
                <ListView ItemsSource="{x:Bind ViewModel.CleanerCategories, Mode=OneWay}"
                          Visibility="{x:Bind ListVisibility(ViewModel.CleanerCategories.Count, ViewModel.IsBusy), Mode=OneWay}"
                          SelectionMode="None"
                          Padding="8">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CleanerCategoryItem">
                            <Border Style="{StaticResource V6RowCardStyle}" Margin="0,3">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12.5"/>
                                            <Border Style="{StaticResource V6StatusBadgeGoodStyle}" Visibility="{x:Bind IsSafeGuarded}">
                                                <TextBlock Text="ARMORED" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource V6BadgeGoodFg}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeFormatted}" FontWeight="Bold" FontSize="12" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- 3. Footer Audit Status & Live Status Ticker -->
        <Border Grid.Row="3" Style="{StaticResource V6FlatCardStyle}" Padding="12,8">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.CurrentTargetItem, Mode=OneWay}"
                               FontSize="11"
                               FontFamily="Cascadia Code, Consolas"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="380"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.TotalSelectedSizeFormatted, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>
