<Page
    x:Class="WinCarePro.Views.CleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinCarePro.ViewModels"
    xmlns:controls="using:WinCarePro.Presentation.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition>
                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    <EntranceNavigationTransitionInfo />
                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
            </NavigationThemeTransition>
            <EntranceThemeTransition FromVerticalOffset="24" />
        </TransitionCollection>
    </Page.Transitions>

    <Grid Background="{ThemeResource AppDeepObsidianBackground}">
        <!-- Ambient Mesh Glow (Deep Obsidian Canvas with Cyan/Indigo Luminous Atmosphere in Dark Mode) -->
        <Grid x:Name="AmbientMeshGlowGrid" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Top-Left Radial Mesh Glow (Cyan #00D2FF &amp; Indigo #7B2CBF) -->
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top"
                       Width="720" Height="540" Margin="-100,-100,0,0"
                       Opacity="0.12"
                       Fill="{StaticResource AppAmbientMeshGlowBrush}" />

            <!-- Bottom-Right Subtle Accent Glow -->
            <Rectangle HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Width="560" Height="440" Margin="0,0,-80,-80"
                       Opacity="0.08"
                       Fill="{StaticResource AppSecondaryMeshGlowBrush}" />
        </Grid>

        <Grid RowSpacing="16" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0. Action Header -->
            <RowDefinition Height="Auto" /> <!-- 1. Heavy Task Execution Banner -->
            <RowDefinition Height="*" />    <!-- 2. Virtualized Checklist View & Skeleton -->
            <RowDefinition Height="Auto" /> <!-- 3. Execution Footer -->
        </Grid.RowDefinitions>

        <!-- 0. Header Card -->
        <Border Grid.Row="0" Style="{StaticResource V6FlatCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Style="{StaticResource IconBadgeStyle}" Background="{StaticResource PrimaryAccentGradient}">
                        <FontIcon Glyph="&#xE74D;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Source='System Cleaner (Zero-Risk Engine)', Converter={StaticResource TranslationConverter}}" Style="{StaticResource PageHeaderTitleStyle}"/>
                        <TextBlock Text="{Binding Source='Safely audit and clean temporary clutter, orphaned uninstall registry keys, and leftover app files.', Converter={StaticResource TranslationConverter}}" Style="{StaticResource PageHeaderSubtitleStyle}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Scan Button with Instant/Busy Visual Feedback (Mini ProgressRing 14x14) -->
                    <Button Style="{StaticResource SecondaryGlassButtonStyle}" Height="34" CornerRadius="8" Padding="14,0" Command="{x:Bind ViewModel.ScanAllCommand}" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="14" Height="14" Foreground="{StaticResource PrimaryAccentBrush}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <FontIcon Glyph="&#xE721;" FontSize="11.5" Visibility="{x:Bind ViewModel.IsNotBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding Source='Scan Clutter', Converter={StaticResource TranslationConverter}}" />
                        </StackPanel>
                    </Button>

                    <!-- Clean Button -->
                    <Button Style="{StaticResource PrimaryGradientButtonStyle}" Height="34" CornerRadius="8" Padding="16,0" Command="{x:Bind ViewModel.CleanSelectedCommand}" IsEnabled="{x:Bind ViewModel.CanClean, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE74D;" FontSize="11.5" Foreground="White"/>
                            <TextBlock Text="{Binding Source='Clean Selected', Converter={StaticResource TranslationConverter}}" Foreground="White" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. Contextual Status Banners & Execution Progress -->
        <StackPanel Grid.Row="1" Spacing="8">
            <!-- Inline Safety Protection Notice Card -->
            <controls:InlineStatusCard
                CardType="SafetyNotice"
                Title="{Binding Source='SafePathGuard Armor Active', Converter={StaticResource TranslationConverter}}"
                Message="{Binding Source='Core Windows directories, user files, and system volumes are permanently shielded from deletion.', Converter={StaticResource TranslationConverter}}"
                Visibility="{x:Bind ViewModel.IsSafetyNoticeVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                IsDismissible="True" />

            <!-- Inline Post-Action Summary Card -->
            <controls:InlineStatusCard
                CardType="Summary"
                Title="{Binding Source='Cleanup Summary', Converter={StaticResource TranslationConverter}}"
                Message="{x:Bind ViewModel.SummaryCleanedText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsSummaryCardVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                IsDismissible="True" />

            <!-- Execution Progress Card / Overlay Banner (>5s tasks) -->
            <controls:ExecutionProgressBanner
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                StatusText="{x:Bind ViewModel.CurrentStatusText, Mode=OneWay}"
                TargetItem="{x:Bind ViewModel.CurrentTargetItem, Mode=OneWay}"
                ProgressPercentage="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}"
                IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                CancelCommand="{x:Bind ViewModel.CancelCurrentTaskCommand, Mode=OneWay}"
                CanCancel="{x:Bind ViewModel.CanCancel, Mode=OneWay}" />
        </StackPanel>

        <!-- 2. Main Workspace: Virtualized Checklist View & Skeleton Shimmer Loading -->
        <Border Grid.Row="2" Style="{StaticResource V6FlatCardStyle}" Padding="0">
            <Grid>
                <!-- Empty State Card when no clutter found or ready to scan -->
                <controls:EmptyStateCard
                    Visibility="{x:Bind EmptyStateVisibility(ViewModel.CleanerCategories.Count, ViewModel.IsBusy), Mode=OneWay}"
                    IconGlyph="&#xE74D;"
                    Title="{Binding Source='Ready to Clean System', Converter={StaticResource TranslationConverter}}"
                    Description="{Binding Source='Safely audit and clean temporary clutter, orphaned uninstall registry keys, and leftover app files.', Converter={StaticResource TranslationConverter}}"
                    ActionText="{Binding Source='Scan Clutter', Converter={StaticResource TranslationConverter}}"
                    ActionCommand="{x:Bind ViewModel.ScanAllCommand}" />

                <!-- Skeleton Shimmer Loading State (1-5s tasks: prevents empty list layout flash) -->
                <ScrollViewer Visibility="{x:Bind SkeletonVisibility(ViewModel.CleanerCategories.Count, ViewModel.IsBusy), Mode=OneWay}" Padding="8">
                    <controls:SkeletonCardControl />
                </ScrollViewer>

                <!-- Loaded Items ListView -->
                <ListView ItemsSource="{x:Bind ViewModel.CleanerCategories, Mode=OneWay}"
                          Visibility="{x:Bind ListVisibility(ViewModel.CleanerCategories.Count, ViewModel.IsBusy), Mode=OneWay}"
                          SelectionMode="None"
                          Padding="8">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CleanerCategoryItem">
                            <Border Style="{StaticResource V6RowCardStyle}" Margin="0,3">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12.5"/>
                                            <Border Style="{StaticResource V6StatusBadgeGoodStyle}" Visibility="{x:Bind IsSafeGuarded}">
                                                <TextBlock Text="ARMORED" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource V6BadgeGoodFg}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeFormatted}" FontWeight="Bold" FontSize="12" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- 3. Footer Audit Status & Live Status Ticker -->
        <Border Grid.Row="3" Style="{StaticResource V6FlatCardStyle}" Padding="12,8">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.CurrentTargetItem, Mode=OneWay}"
                               FontSize="11"
                               FontFamily="Cascadia Code, Consolas"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="380"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.TotalSelectedSizeFormatted, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</Page>
