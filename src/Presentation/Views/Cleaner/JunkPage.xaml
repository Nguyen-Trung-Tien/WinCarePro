<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.JunkPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinCarePro.Models"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    mc:Ignorable="d">

    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition>
                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    <EntranceNavigationTransitionInfo />
                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
            </NavigationThemeTransition>
            <EntranceThemeTransition FromVerticalOffset="24" />
        </TransitionCollection>
    </Page.Transitions>

    <Grid Background="{ThemeResource AppDeepObsidianBackground}">
        <!-- Ambient Mesh Glow (Deep Obsidian Canvas with Cyan/Indigo Luminous Atmosphere in Dark Mode) -->
        <Grid x:Name="AmbientMeshGlowGrid" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Top-Left Radial Mesh Glow (Cyan #00D2FF &amp; Indigo #7B2CBF) -->
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top"
                       Width="720" Height="540" Margin="-100,-100,0,0"
                       Opacity="0.12"
                       Fill="{StaticResource AppAmbientMeshGlowBrush}" />

            <!-- Bottom-Right Subtle Accent Glow -->
            <Rectangle HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Width="560" Height="440" Margin="0,0,-80,-80"
                       Opacity="0.08"
                       Fill="{StaticResource AppSecondaryMeshGlowBrush}" />
        </Grid>

        <Grid Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="LayoutVisualStates">
                    <!-- Wide Layout: Viewport Width >= 950px -->
                    <VisualState x:Name="WideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="950" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <!-- Narrow Layout: Viewport Width < 950px -->
                    <VisualState x:Name="NarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HeaderCol0.Width" Value="*" />
                            <Setter Target="HeaderCol1.Width" Value="0" />
                            <Setter Target="HeaderStatsPanel.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="HeaderActionsPanel.(Grid.Row)" Value="1" />
                            <Setter Target="HeaderActionsPanel.(Grid.Column)" Value="0" />
                            <Setter Target="HeaderActionsPanel.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="HeaderActionsPanel.Margin" Value="0,12,0,0" />
                            <Setter Target="HeaderActionsPanel.HorizontalAlignment" Value="Left" />

                            <Setter Target="LeftColumn.Width" Value="*" />
                            <Setter Target="RightColumn.Width" Value="0" />

                            <Setter Target="LockingCol2.Width" Value="0" />
                            <Setter Target="LockingActionsPanel.(Grid.Row)" Value="1" />
                            <Setter Target="LockingActionsPanel.(Grid.Column)" Value="0" />
                            <Setter Target="LockingActionsPanel.(Grid.ColumnSpan)" Value="3" />
                            <Setter Target="LockingActionsPanel.Margin" Value="0,8,0,0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 0: Page Header -->
                <RowDefinition Height="Auto" /> <!-- 1: Bento Ribbon Stat Deck -->
                <RowDefinition Height="Auto" /> <!-- 2: Dynamic Alert / Banner Area -->
                <RowDefinition Height="*" />    <!-- 3: Master-Detail Explorer Area -->
            </Grid.RowDefinitions>

            <!-- Page Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid x:Name="HeaderGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="HeaderRow0" Height="Auto" />
                        <RowDefinition x:Name="HeaderRow1" Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="HeaderCol0" Width="*" />
                        <ColumnDefinition x:Name="HeaderCol1" Width="Auto" />
                    </Grid.ColumnDefinitions>

                <!-- Left: Info & Badges Display (IconBadge + Standard Header) -->
                <StackPanel x:Name="HeaderStatsPanel" Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Style="{StaticResource IconBadgeStyle}" Background="{StaticResource PrimaryAccentGradient}">
                        <FontIcon Glyph="&#xE74D;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Source='Junk Cleaner', Converter={StaticResource TranslationConverter}}" Style="{StaticResource PageHeaderTitleStyle}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source='Clean temporary files &amp; system cache.', Converter={StaticResource TranslationConverter}}" Style="{StaticResource PageHeaderSubtitleStyle}" VerticalAlignment="Center"/>
                            <Border Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="6" Padding="6,1.5" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE72E;" FontSize="10" Foreground="{ThemeResource AppBadgeGoodFg}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Source='SafePathGuard Protected', Converter={StaticResource TranslationConverter}}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AppBadgeGoodFg}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Scan & Clean Actions -->
                <StackPanel x:Name="HeaderActionsPanel" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Export Report -->
                    <Button Click="OnExportReportClick" Style="{StaticResource DefaultButtonStyle}" CornerRadius="8" Height="34" Padding="10,0" ToolTipService.ToolTip="Export Junk &amp; Storage Report (CSV)"
                            helpers:AnimationHelper.HoverScale="1.03" helpers:AnimationHelper.PressedScale="0.97">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEDE1;" FontSize="12.5"/>
                            <TextBlock Text="Export CSV" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ScanJunkBtn" Style="{x:Bind GetScanButtonStyle(ViewModel.HasCleanableJunk), Mode=OneWay}" Click="OnScanJunkClick" IsEnabled="{x:Bind IsNot(ViewModel.IsScanning), Mode=OneWay}" MinWidth="125" Padding="14,7" CornerRadius="8"
                            helpers:AnimationHelper.HoverScale="1.03" helpers:AnimationHelper.PressedScale="0.97"
                            AutomationProperties.Name="Scan Junk and System Cache"
                            AutomationProperties.HelpText="Evaluates safe-to-clean junk files and system caching logs.">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <ProgressRing x:Name="ScanJunkRing" IsActive="False" Visibility="Collapsed" Width="14" Height="14" VerticalAlignment="Center"/>
                            <FontIcon x:Name="ScanJunkIcon" Glyph="&#xE721;" FontSize="12.5" />
                            <TextBlock x:Name="ScanJunkText" Text="{x:Bind GetScanButtonText(ViewModel.HasCleanableJunk), Mode=OneWay}" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CleanJunkBtn" Style="{x:Bind GetCleanButtonStyle(ViewModel.HasCleanableJunk), Mode=OneWay}" Click="OnCleanJunkClick" Visibility="{x:Bind GetCleanButtonVisibility(ViewModel.HasCleanableJunk), Mode=OneWay}" IsEnabled="{x:Bind CanClean(ViewModel.IsCleaning, ViewModel.Categories.Count, ViewModel.TotalCleanableBytes), Mode=OneWay}" MinWidth="125" Padding="14,7" CornerRadius="8"
                            helpers:AnimationHelper.HoverScale="1.03" helpers:AnimationHelper.PressedScale="0.97"
                            AutomationProperties.Name="Clean Selected Junk"
                            AutomationProperties.HelpText="Permanently removes selected temporary junk and cache files.">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <ProgressRing x:Name="CleanJunkRing" IsActive="False" Visibility="Collapsed" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                            <FontIcon x:Name="CleanJunkIcon" Glyph="&#xE74D;" FontSize="12.5" />
                            <TextBlock x:Name="CleanJunkText" Text="Clean Now" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 1. Sleek Storage Cockpit Ribbon (Compact, Modern, Actionable) -->
        <Border Grid.Row="1" Margin="0,0,0,10" Style="{StaticResource CockpitBentoCardStyle}" Padding="12,8"
                helpers:AnimationHelper.StaggerIndex="0"
                helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="3.0" helpers:Animation3DHelper.DepthZ="8">
            <Grid x:Name="TopStatsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Quick Preset Selection Pills -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Style="{StaticResource TransparentWrapperButtonStyle}" Click="OnPresetSafeClick" Padding="10,6" CornerRadius="8"
                            Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1"
                            helpers:AnimationHelper.HoverScale="1.03" helpers:AnimationHelper.PressedScale="0.97"
                            ToolTipService.ToolTip="Select only 100% safe items (Recommended)"
                            AutomationProperties.Name="Safe Only Preset">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AppBadgeGoodFg}"/>
                            <TextBlock Text="Safe Cache" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppBadgeGoodFg}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TransparentWrapperButtonStyle}" Click="OnPresetAllClick" Padding="10,6" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                            helpers:AnimationHelper.HoverScale="1.03" helpers:AnimationHelper.PressedScale="0.97"
                            ToolTipService.ToolTip="Select all detected junk categories"
                            AutomationProperties.Name="Select All Preset">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE762;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="Select All" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: Breakdown Metrics Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Tier 1: Safe Cache -->
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="#3010B981" BorderThickness="1" CornerRadius="8" Padding="10,5"
                            helpers:AnimationHelper.HoverScale="1.02">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#FF10B981"/>
                            <TextBlock Text="Safe Cache:" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.SafeJunkSizeFormatted, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#FF10B981" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                        </StackPanel>
                    </Border>
                    <!-- Tier 2: Browser Data -->
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="#30F59E0B" BorderThickness="1" CornerRadius="8" Padding="10,5"
                            helpers:AnimationHelper.HoverScale="1.02">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#FFF59E0B"/>
                            <TextBlock Text="Browser Data:" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.ReviewJunkSizeFormatted, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#FFF59E0B" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                        </StackPanel>
                    </Border>
                    <!-- Tier 3: Advanced -->
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="#308B5CF6" BorderThickness="1" CornerRadius="8" Padding="10,5"
                            helpers:AnimationHelper.HoverScale="1.02">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#FFA78BFA"/>
                            <TextBlock Text="Advanced:" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.DevJunkSizeFormatted, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#FFA78BFA" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Dynamic Contextual Alert Banners (Celebration & Locking Apps) -->
        <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,10">
            <Border Background="{ThemeResource AppBadgeGoodBg}"
                    BorderBrush="{ThemeResource AppBadgeGoodBorder}"
                    BorderThickness="1.5"
                    CornerRadius="14"
                    Padding="14,10"
                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="3.5" helpers:Animation3DHelper.DepthZ="10"
                    Visibility="{x:Bind GetCelebrationVisibility(ViewModel.IsCelebrationActive), Mode=OneWay}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Animated Aura Icon Ring -->
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#3510B981" BorderBrush="#FF10B981" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="#FF10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Message & Stats -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Clean Completed Successfully!" FontWeight="Bold" FontSize="13" Foreground="#FF10B981"/>
                            <Border Background="#3510B981" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                <TextBlock Text="OPTIMAL" FontSize="9" FontWeight="Bold" Foreground="#FF10B981"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Working sets and debris cleared. Disk and cache performance are at peak efficiency." 
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Action -->
                    <Button Grid.Column="2" Click="OnScanJunkClick" Style="{StaticResource DefaultButtonStyle}" CornerRadius="8" Padding="12,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <TextBlock Text="Scan Again" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Sleek Non-intrusive Locking Apps Pill Banner -->
            <Border x:Name="LockingAppsBannerBorder" Background="#15EF4444" 
                    BorderBrush="#35EF4444" 
                    BorderThickness="1" 
                    CornerRadius="10" 
                    Padding="12,8" 
                    Visibility="{x:Bind ViewModel.ShowLockingAppsBanner, Mode=OneWay}">
                <Grid x:Name="LockingAppsGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="LockingRow0" Height="Auto" />
                        <RowDefinition x:Name="LockingRow1" Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LockingCol0" Width="Auto" />
                        <ColumnDefinition x:Name="LockingCol1" Width="*" />
                        <ColumnDefinition x:Name="LockingCol2" Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <FontIcon Grid.Row="0" Grid.Column="0" Glyph="&#xE7BA;" Foreground="#FFEF4444" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                    
                    <StackPanel x:Name="LockingInfoPanel" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="Active Apps Locking Files:" FontWeight="Bold" FontSize="12" Foreground="#FFEF4444" VerticalAlignment="Center"/>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ActiveLockingApps, Mode=OneWay}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="6,2" BorderThickness="1" BorderBrush="#30EF4444">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7BA;" Foreground="#FFEF4444" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding LockedSizeFormatted}" FontSize="10" Foreground="#FFEF4444" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    
                    <StackPanel x:Name="LockingActionsPanel" Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Content="Close Apps" 
                                Click="OnCloseAppsClick" 
                                Background="#FFEF4444" 
                                Foreground="White" 
                                FontWeight="SemiBold" 
                                CornerRadius="6" 
                                Padding="10,4" 
                                FontSize="11"
                                VerticalAlignment="Center" />
                        <Button Content="Bypass &amp; Ignore"
                                Click="OnDismissLockingAppsClick"
                                Style="{StaticResource TransparentWrapperButtonStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="11"
                                Padding="8,4"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- 3. Dual-Pane Master-Detail Area (Categories & File Inspector with Virtualized Internal Scrolling) -->
        <Grid Grid.Row="3" ColumnSpacing="16" helpers:AnimationHelper.StaggerIndex="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="1.15*" />
                <ColumnDefinition x:Name="RightColumn" Width="0.85*" />
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Categories List with Docked Action Footer -->
            <Border x:Name="LeftPaneBorder" Grid.Column="0" Style="{StaticResource CockpitBentoCardStyle}" Padding="16,14,16,12"
                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="3.5" helpers:Animation3DHelper.DepthZ="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <!-- Row 0: Header with title, search, sort & selection actions -->
                    <StackPanel Grid.Row="0" Margin="4,0,4,10" Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Junk Categories" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Style="{StaticResource TransparentWrapperButtonStyle}" Click="OnSelectAllCategoriesClick" Padding="6,2" ToolTipService.ToolTip="Select All Categories"
                                        AutomationProperties.Name="Select All Categories" AutomationProperties.HelpText="Selects all junk categories for cleaning.">
                                    <TextBlock Text="Select All" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                </Button>
                                <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource TransparentWrapperButtonStyle}" Click="OnDeselectAllCategoriesClick" Padding="6,2" ToolTipService.ToolTip="Deselect All Categories"
                                        AutomationProperties.Name="Deselect All Categories" AutomationProperties.HelpText="Deselects all junk categories.">
                                    <TextBlock Text="Deselect All" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Search Box & Sort Selection -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" PlaceholderText="Search categories or file paths..."
                                     Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32" CornerRadius="6" FontSize="11.5" VerticalAlignment="Center"/>

                            <ComboBox Grid.Column="1" Height="32" SelectionChanged="OnSortSelectionChanged" SelectedIndex="0" CornerRadius="6" VerticalAlignment="Center" MinWidth="135" FontSize="11.5">
                                <ComboBoxItem Content="Size (High-Low)"/>
                                <ComboBoxItem Content="Size (Low-High)"/>
                                <ComboBoxItem Content="Name (A-Z)"/>
                                <ComboBoxItem Content="Name (Z-A)"/>
                                <ComboBoxItem Content="Safety Tier"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Row 1: Categories ListView with UI Virtualization -->
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" SelectionMode="Single" ItemContainerStyle="{StaticResource ModernCardListViewItemStyle}">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Tilt3DCardStyle}" Padding="12,10" BorderThickness="1"
                                        helpers:AnimationHelper.HoverScale="1.015" helpers:AnimationHelper.PressedScale="0.985"
                                        helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="3.5" helpers:Animation3DHelper.DepthZ="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />  <!-- CheckBox -->
                                            <ColumnDefinition Width="Auto" />  <!-- Circle Icon -->
                                            <ColumnDefinition Width="*" />     <!-- Label Details -->
                                            <ColumnDefinition Width="Auto" />  <!-- Size & File Count -->
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="OnJunkSelectionChanged" Unchecked="OnJunkSelectionChanged" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="0" />
                                        
                                        <!-- Category Icon with 3D Elevation -->
                                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#157F56D9" BorderBrush="#357F56D9" BorderThickness="1.2" Margin="0,0,12,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <FontIcon Glyph="{Binding IconGlyph}" Foreground="{Binding IconColor}" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <Border Background="{Binding SafetyTierBgColor}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SafetyTierText}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding SafetyTierColor}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Visibility="{Binding ElementName=PageRoot, Path=WideLayoutVisibility}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="1" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding CleanableSizeFormatted}" FontWeight="Bold" FontSize="13" Foreground="#FF10B981" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                            <TextBlock Text="{Binding LockedSizeFormatted}" FontSize="10" Foreground="#FFEF4444" FontWeight="SemiBold" HorizontalAlignment="Right" Visibility="{Binding LockedSizeVisibility}" Typography.NumeralAlignment="Tabular"/>
                                            <TextBlock Text="{Binding FileCountFormatted}" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Row 2: Clean Summary Footer Card (Unified Status Info) -->
                    <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource SpecularGlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource PrimaryAccentGradient}" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xEA99;" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="Total Cleanable Space" FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.TotalJunkSize, Mode=OneWay}" FontSize="13" FontWeight="ExtraBold" Foreground="{ThemeResource AppBadgeGoodFg}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind GetSummaryHintText(ViewModel.HasCleanableJunk), Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AppBadgeGoodFg}"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Pane: Switchable Details, Progress or Empty State -->
            <Grid x:Name="RightPaneGrid" Grid.Row="0" Grid.Column="1" Visibility="{Binding ElementName=PageRoot, Path=WideLayoutVisibility}">
                
                 <!-- STATE 1: Empty state (Initial state before scan) -->
                <Border Style="{StaticResource CockpitBentoCardStyle}" Padding="24" Visibility="{x:Bind GetEmptyVisibility(ViewModel.SelectedCategory, ViewModel.IsScanning, ViewModel.IsCleaning), Mode=OneWay}">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel Spacing="16" HorizontalAlignment="Center">
                            <Border Width="72" Height="72" CornerRadius="36" Background="#107F56D9" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xEA99;" Foreground="#FF7F56D9" FontSize="32" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="Ready to Scan Caches" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" />
                                <TextBlock Text="Click 'Scan Directories' in the top header action bar to evaluate safe-to-clean junk files and system caching logs." FontSize="12.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- STATE 2: Detailed File Inspector (Idle and item selected) -->
                <Border Style="{StaticResource CockpitBentoCardStyle}" Padding="20" Visibility="{x:Bind GetDetailVisibility(ViewModel.SelectedCategory, ViewModel.IsScanning, ViewModel.IsCleaning), Mode=OneWay}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />  <!-- Category details header -->
                            <RowDefinition Height="Auto" />  <!-- Section heading: Top Files -->
                            <RowDefinition Height="*" />     <!-- Files ListView -->
                        </Grid.RowDefinitions>

                        <!-- Header Info Card -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="{x:Bind ViewModel.SelectedCategory.IconGlyph, Mode=OneWay}" Foreground="{x:Bind ViewModel.SelectedCategory.IconColor, Mode=OneWay}" FontSize="16" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedCategory.Name, Mode=OneWay}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedCategory.Description, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedCategory.FolderPath, Mode=OneWay}" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" Opacity="0.8" />
                                </StackPanel>

                                <Button Grid.Column="1" Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Width="36" Height="36" CornerRadius="18" Padding="0" ToolTipService.ToolTip="Open Folder Location" Click="OnOpenFolderClick" VerticalAlignment="Top" HorizontalAlignment="Right"
                                        AutomationProperties.Name="Open Selected Folder in File Explorer" AutomationProperties.HelpText="Opens this category folder in Windows File Explorer.">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="15" />
                                </Button>
                            </Grid>

                            <!-- Modern cleanable vs locked breakdown bar -->
                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10" Padding="12" BorderThickness="1" BorderBrush="{ThemeResource SpecularGlassBorderBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Cleanable -->
                                    <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Center">
                                        <TextBlock Text="Cleanable Space" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedCategory.CleanableSizeFormatted, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="#FF10B981" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Divider -->
                                    <Border Grid.Column="1" Width="1" Height="22" Background="{ThemeResource ControlStrokeColorDefaultBrush}" VerticalAlignment="Center" />

                                    <!-- Locked -->
                                    <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Center">
                                        <TextBlock Text="Locked / In Use" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedCategory.LockedSizeFormatted, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="#FFEF4444" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Top Largest Files" FontSize="13" FontWeight="Bold" Margin="4,0,0,8" />

                        <!-- File list scroll viewer -->
                        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.SelectedCategory.TopFiles, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="4,6" />
                                    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />  <!-- File icon -->
                                            <ColumnDefinition Width="*" />     <!-- Path info -->
                                            <ColumnDefinition Width="Auto" />  <!-- Size -->
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="{Binding IconGlyph}" Foreground="{Binding IconColor}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <Border Background="{Binding StatusBgColor}" CornerRadius="4" Padding="5,1.5" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding StatusForegroundColor}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis"
                                                        ToolTipService.ToolTip="{Binding Path}" AutomationProperties.Name="{Binding Path}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding SizeFormatted}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- STATE 3: Progress (Visible during scanning or cleaning) — smooth 120 FPS fluid transition -->
                <Grid x:Name="ProgressOverlayGrid" Visibility="Collapsed" Opacity="0">
                    <Grid.Resources>
                        <Storyboard x:Name="FadeInProgress">
                            <DoubleAnimation Storyboard.TargetName="ProgressOverlayGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ProgressCardTransform" Storyboard.TargetProperty="ScaleX" From="0.94" To="1.0" Duration="0:0:0.35">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ProgressCardTransform" Storyboard.TargetProperty="ScaleY" From="0.94" To="1.0" Duration="0:0:0.35">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                        <Storyboard x:Name="FadeOutProgress" Completed="FadeOutProgress_Completed">
                            <DoubleAnimation Storyboard.TargetName="ProgressOverlayGrid" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </Grid.Resources>
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="28,24" VerticalAlignment="Center" HorizontalAlignment="Center" Width="380" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <CompositeTransform x:Name="ProgressCardTransform" ScaleX="1.0" ScaleY="1.0" />
                        </Border.RenderTransform>
                        <StackPanel Spacing="16" HorizontalAlignment="Center">
                            <!-- Glowing Icon Badge -->
                            <Grid Width="64" Height="64" HorizontalAlignment="Center">
                                <Border Width="64" Height="64" CornerRadius="18" Background="#1510B981" BorderBrush="#4010B981" BorderThickness="1.5">
                                    <FontIcon Glyph="&#xE74D;" FontSize="24" Foreground="#FF10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="Junk Sweeper Operation" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.ProgressMessage, Mode=OneWay}" TextWrapping="Wrap" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" MaxWidth="320" HorizontalAlignment="Center"
                                           AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>

                            <!-- Percentage Progress Bar -->
                            <StackPanel Spacing="8" Width="300" HorizontalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="Progress" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind ViewModel.ProgressPercentFormatted, Mode=OneWay}" FontSize="13" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Right" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                </Grid>
                                <Border Background="#1AFFFFFF" CornerRadius="4" Height="8" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="1">
                                    <ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Maximum="100" Height="4" CornerRadius="2" Foreground="{StaticResource PrimaryAccentGradient}" Background="Transparent" HorizontalAlignment="Stretch" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
    </Grid>
</Page>


