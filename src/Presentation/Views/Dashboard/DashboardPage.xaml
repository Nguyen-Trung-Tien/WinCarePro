<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinCarePro.ViewModels"
    xmlns:models="using:WinCarePro.Models"
    xmlns:local="using:WinCarePro.Views"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    xmlns:db="using:WinCarePro.Database"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition>
                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    <EntranceNavigationTransitionInfo />
                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
            </NavigationThemeTransition>
            <EntranceThemeTransition FromVerticalOffset="24" />
        </TransitionCollection>
    </Page.Transitions>

    <Grid Background="{ThemeResource AppDeepObsidianBackground}">
        <!-- Ambient Mesh Glow (Deep Obsidian Canvas with Cyan/Indigo Luminous Atmosphere in Dark Mode) -->
        <Grid x:Name="AmbientMeshGlowGrid" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Top-Left Radial Mesh Glow (Cyan #00D2FF &amp; Indigo #7B2CBF) -->
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top"
                       Width="720" Height="540" Margin="-100,-100,0,0"
                       Opacity="0.12"
                       Fill="{StaticResource AppAmbientMeshGlowBrush}" />

            <!-- Bottom-Right Subtle Accent Glow -->
            <Rectangle HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Width="560" Height="440" Margin="0,0,-80,-80"
                       Opacity="0.08"
                       Fill="{StaticResource AppSecondaryMeshGlowBrush}" />
        </Grid>

        <!-- Main Responsive Content Canvas -->
        <Grid Padding="24" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Clean Fluent Page Header (IconBadge + Title + Subtitle + Action Toolbar) -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Border Style="{StaticResource IconBadgeStyle}" Background="{StaticResource PrimaryAccentGradient}">
                    <FontIcon Glyph="&#xE80F;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source='System Dashboard', Converter={StaticResource TranslationConverter}}" Style="{StaticResource PageHeaderTitleStyle}"/>
                    <TextBlock Text="{Binding Source='Live system metrics &amp; 1-click care.', Converter={StaticResource TranslationConverter}}" Style="{StaticResource PageHeaderSubtitleStyle}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Main Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10">

                <!-- Main Content Grid combining Core and Extended layers -->
                <Grid x:Name="MainContentGrid" ColumnSpacing="0" RowSpacing="0" Padding="0">
                    <Grid.RowDefinitions>
                        <!-- Wide Layout Rows -->
                        <RowDefinition x:Name="Row0" Height="Auto" />
                        <RowDefinition x:Name="Row1" Height="Auto" />
                        <RowDefinition x:Name="Row2" Height="Auto" />
                        <RowDefinition x:Name="Row3" Height="Auto" />
                        <RowDefinition x:Name="Row4" Height="Auto" />
                        <!-- Extra rows for Narrow Layout stacking -->
                        <RowDefinition x:Name="Row5" Height="Auto" />
                        <RowDefinition x:Name="Row6" Height="Auto" />
                        <RowDefinition x:Name="Row7" Height="Auto" />
                        <RowDefinition x:Name="Row8" Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftCol" Width="1*" />
                        <ColumnDefinition x:Name="RightCol" Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Row 0: Flagship System Health Cockpit & Action Deck -->
                    <Border x:Name="HealthGaugeCard" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="4,0,4,10" Padding="20,16" CornerRadius="12" Background="{ThemeResource GlassCardBackgroundBrush}" BorderBrush="{ThemeResource SpecularGlassBorderBrush}" BorderThickness="1">
                        <Grid x:Name="HealthGaugeGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="HealthGaugeRow0" Height="Auto" />
                                <RowDefinition x:Name="HealthGaugeRow1" Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="HealthGaugeCol0" Width="*" />
                                <ColumnDefinition x:Name="HealthGaugeCol1" Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Hidden Legacy Gauge Ring Grid to keep code-behind / tests stable -->
                            <Grid x:Name="GaugeRingGrid" Grid.Column="0" Visibility="Collapsed" Width="0" Height="0">
                                <ProgressRing Value="{x:Bind ViewModel.HealthScore, Mode=OneWay}" Minimum="0" Maximum="100" IsIndeterminate="False"/>
                            </Grid>

                            <!-- System Status & Metric Headline with Dynamic Circular Ring Gauge (Left Column) -->
                            <Grid Grid.Column="0" ColumnSpacing="16" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Circular Health Ring Gauge -->
                                <Grid Grid.Column="0" Width="76" Height="76" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border x:Name="HealthGlowBorder" Width="46" Height="46" CornerRadius="23" Background="{StaticResource GaugeGlowGoodBrush}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Path Stroke="{ThemeResource GaugeTrackBrush}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Path.Data>
                                            <PathGeometry>
                                                <PathFigure StartPoint="38,10">
                                                    <ArcSegment Point="37.99,10" Size="28,28" SweepDirection="Clockwise" IsLargeArc="True"/>
                                                </PathFigure>
                                            </PathGeometry>
                                        </Path.Data>
                                    </Path>
                                    <Path Stroke="{StaticResource GaugeHealthBrush}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Path.Data>
                                            <PathGeometry>
                                                <PathFigure x:Name="HealthPathFigure" StartPoint="38,10">
                                                    <ArcSegment x:Name="HealthArcSegment" Point="38,10" Size="28,28" SweepDirection="Clockwise" IsLargeArc="False"/>
                                                </PathFigure>
                                            </PathGeometry>
                                        </Path.Data>
                                    </Path>
                                    <TextBlock Text="{x:Bind ViewModel.HealthScore, Mode=OneWay}" FontSize="18" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel x:Name="GaugeDescPanel" Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock Text="System Health &amp; Readiness" FontSize="18" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <Border Background="{x:Bind GetHealthScoreBadgeBackground(ViewModel.HealthScore), Mode=OneWay}" Padding="8,2" CornerRadius="4">
                                            <TextBlock Text="{x:Bind GetStatusText(ViewModel.HealthScore), Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind GetHealthScoreBrush(ViewModel.HealthScore), Mode=OneWay}" FontFamily="Segoe UI Variable Display"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{x:Bind ViewModel.HealthBreakdownText, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" MaxLines="1" TextTrimming="CharacterEllipsis"/>

                                    <!-- System State Summary Metadata Line -->
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="{ThemeResource AppStatusGoodBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Restore Point Protected" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="•" FontSize="10" Foreground="{ThemeResource ControlStrokeColorDefaultBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.ScanStatus, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                                        <TextBlock Text="•" FontSize="10" Foreground="{ThemeResource ControlStrokeColorDefaultBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE770;" FontSize="11" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind ViewModel.SystemUptime, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='Uptime: {0}'}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Flagship Action Bar (Right Column) -->
                            <StackPanel x:Name="GaugeActionPanel" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Button x:Name="OneClickCareBtn" Style="{StaticResource PrimaryGradientButtonStyle}" Click="OnOneClickSmartCareClick" IsEnabled="{x:Bind GetOneClickEnabled(ViewModel.IsScanning, ViewModel.IsOptimizing), Mode=OneWay}" Height="36" Padding="16,0" CornerRadius="8"
                                        AutomationProperties.Name="1-Click Smart Care"
                                        AutomationProperties.HelpText="Instantly scan and optimize system performance, RAM, and junk files in one single click.">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="13" Foreground="White"/>
                                        <TextBlock Text="1-Click Care" FontWeight="SemiBold" FontSize="13" Foreground="White"/>
                                    </StackPanel>
                                </Button>

                                <ProgressRing x:Name="GaugeActionProgressRing" IsActive="{x:Bind GetProgressRingActive(ViewModel.IsScanning, ViewModel.IsOptimizing), Mode=OneWay}" Visibility="{x:Bind GetProgressRingVisibility(ViewModel.IsScanning, ViewModel.IsOptimizing), Mode=OneWay}" Width="18" Height="18" Foreground="{StaticResource PrimaryCtaGradientBrush}" VerticalAlignment="Center" Margin="2,0" />

                                <Button x:Name="ScanSystemBtn" Style="{StaticResource StandardSecondaryButtonStyle}" IsEnabled="{x:Bind IsNot(ViewModel.IsScanning), Mode=OneWay}" Height="36" Padding="14,0" CornerRadius="8"
                                        AutomationProperties.Name="Scan System"
                                        AutomationProperties.HelpText="Initiates deep system scan for junk files, performance issues, and security status.">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="Bottom">
                                            <MenuFlyoutItem Text="Run All Diagnostics" Click="OnRunAllDiagnosticsMenuClick">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE721;" Foreground="{ThemeResource PrimaryAccentBrush}"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Disk &amp; Cache Cleaner" Tag="DiskAndCache" Click="OnScanCategoryMenuClick">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xEA99;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Startup &amp; Performance Audit" Tag="StartupAndPerformance" Click="OnScanCategoryMenuClick">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE7F4;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Security &amp; Network Armor" Tag="SecurityCheck" Click="OnScanCategoryMenuClick">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xEA18;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Registry &amp; Disk Health" Tag="RegistryAndDiskHealth" Click="OnScanCategoryMenuClick">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xEDA2;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE721;" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        <TextBlock Text="Scan Hub" FontWeight="SemiBold" FontSize="12"/>
                                        <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="OptimizeBtn" Style="{StaticResource StandardSecondaryButtonStyle}" Click="OnOptimizeClick" Visibility="{x:Bind GetOptimizeVisibility(ViewModel.HasScanned, ViewModel.IsScanning), Mode=OneWay}" IsEnabled="{x:Bind IsNot(ViewModel.IsOptimizing), Mode=OneWay}" Height="36" Padding="14,0" CornerRadius="8"
                                        AutomationProperties.Name="Optimize System"
                                        AutomationProperties.HelpText="Optimizes system performance using the selected profile mode.">
                                    <Button.ContextFlyout>
                                        <MenuFlyout Placement="Bottom">
                                            <MenuFlyoutItem Text="Recommended Mode (Caches &amp; Startup)" Click="OnRecommendedOptimizeClick" />
                                            <MenuFlyoutItem Text="Safe Mode (Temp &amp; DNS)" Click="OnSafeOptimizeClick" />
                                            <MenuFlyoutItem Text="Advanced Mode (Registry &amp; Tweaks)" Click="OnAdvancedOptimizeClick" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Undo Last Optimization" Click="OnUndoOptimizeClick" />
                                        </MenuFlyout>
                                    </Button.ContextFlyout>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE945;" FontSize="12" Foreground="{ThemeResource AppStatusGoodBrush}"/>
                                        <TextBlock Text="Optimize" FontWeight="SemiBold" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Scan Progress Line Indicator -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Visibility="{x:Bind GetProgressVisibility(ViewModel.IsScanning), Mode=OneWay}" Spacing="4" Margin="0,12,0,0">
                                <ProgressBar Value="{x:Bind ViewModel.ScanProgress, Mode=OneWay}" Maximum="100" Height="3" Foreground="{StaticResource PrimaryCtaGradientBrush}" CornerRadius="1.5" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 1: 4-Pillar Modular Scan Action Cards Hub (Precision Glass Cards) -->
                    <Grid x:Name="QuickStatsGrid" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" RowSpacing="0" ColumnSpacing="0" Visibility="Visible"
                          helpers:AnimationHelper.StaggerIndex="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Disk & Cache Cleaner -->
                        <Button x:Name="QuickStatsCardDisk" Grid.Row="0" Grid.Column="0" Style="{StaticResource InteractiveCardButtonStyle}" Click="OnScanCardDiskClick"
                                AutomationProperties.Name="Disk and Cache Cleaner Scan" AutomationProperties.HelpText="Open Disk and Cache Cleaner Scan Hub">
                            <Border Margin="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="76" Padding="14,12" CornerRadius="12" Background="{ThemeResource GlassCardBackgroundBrush}" BorderBrush="{ThemeResource SpecularGlassBorderBrush}" BorderThickness="1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Themed Icon Badge (Emerald) -->
                                    <Border Grid.Column="0" Style="{StaticResource IconBadgeStyle}"
                                            Background="{StaticResource IconBadgeDiskBackground}"
                                            BorderBrush="{StaticResource IconBadgeDiskBorder}">
                                        <FontIcon Glyph="&#xEA99;" FontSize="16" Foreground="{StaticResource IconBadgeDiskGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Disk &amp; Cache" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Temp, Prefetch, Updates" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind ViewModel.JunkFileSize, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryAccentBrush}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>

                        <!-- Card 2: Startup & Performance Audit -->
                        <Button x:Name="QuickStatsCardStartup" Grid.Row="0" Grid.Column="1" Style="{StaticResource InteractiveCardButtonStyle}" Click="OnScanCardStartupClick"
                                AutomationProperties.Name="Startup and Performance Audit Scan" AutomationProperties.HelpText="Open Startup and Performance Audit Scan Hub">
                            <Border Margin="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="76" Padding="14,12" CornerRadius="12" Background="{ThemeResource GlassCardBackgroundBrush}" BorderBrush="{ThemeResource SpecularGlassBorderBrush}" BorderThickness="1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Themed Icon Badge (Amber Boost) -->
                                    <Border Grid.Column="0" Style="{StaticResource IconBadgeStyle}"
                                            Background="{StaticResource IconBadgeStartupBackground}"
                                            BorderBrush="{StaticResource IconBadgeStartupBorder}">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{StaticResource IconBadgeStartupGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Startup &amp; Performance" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="High impact apps &amp; services" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind ViewModel.SystemUptime, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryAccentBrush}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>

                        <!-- Card 3: Security & Network Armor -->
                        <Button x:Name="QuickStatsCardSecurity" Grid.Row="0" Grid.Column="2" Style="{StaticResource InteractiveCardButtonStyle}" Click="OnScanCardSecurityClick"
                                AutomationProperties.Name="Security Check Scan" AutomationProperties.HelpText="Open Security and Network Armor Scan Hub">
                            <Border Margin="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="76" Padding="14,12" CornerRadius="12" Background="{ThemeResource GlassCardBackgroundBrush}" BorderBrush="{ThemeResource SpecularGlassBorderBrush}" BorderThickness="1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Themed Icon Badge (Shield Green) -->
                                    <Border Grid.Column="0" Style="{StaticResource IconBadgeStyle}"
                                            Background="{StaticResource IconBadgeSecurityBackground}"
                                            BorderBrush="{StaticResource IconBadgeSecurityBorder}">
                                        <FontIcon Glyph="&#xEA18;" FontSize="16" Foreground="{StaticResource IconBadgeSecurityGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Security &amp; Network" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Defender, UAC &amp; Ports" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind ViewModel.NetworkStatus, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" FontFamily="Segoe UI Variable Display"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>

                        <!-- Card 4: Registry & Disk Health -->
                        <Button x:Name="QuickStatsCardRegistry" Grid.Row="0" Grid.Column="3" Style="{StaticResource InteractiveCardButtonStyle}" Click="OnScanCardRegistryClick"
                                AutomationProperties.Name="Registry and Disk Health Scan" AutomationProperties.HelpText="Open Registry and Disk S.M.A.R.T Health Scan Hub">
                            <Border Margin="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="76" Padding="14,12" CornerRadius="12" Background="{ThemeResource GlassCardBackgroundBrush}" BorderBrush="{ThemeResource SpecularGlassBorderBrush}" BorderThickness="1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Themed Icon Badge (Violet Diamond) -->
                                    <Border Grid.Column="0" Style="{StaticResource IconBadgeStyle}"
                                            Background="{StaticResource IconBadgeRegistryBackground}"
                                            BorderBrush="{StaticResource IconBadgeRegistryBorder}">
                                        <FontIcon Glyph="&#xEDA2;" FontSize="16" Foreground="{StaticResource IconBadgeRegistryGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Registry &amp; Disk Health" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Orphan keys &amp; S.M.A.R.T" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind ViewModel.InstalledAppsCount, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0} apps installed'}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryAccentBrush}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </Grid>

                    <!-- Row 2 Left: 4 Hardware Sensors Bento Matrix (CPU, RAM, GPU, Disk) -->
                    <StackPanel x:Name="HardwareSensorsPanel" Grid.Row="2" Grid.Column="0">
                        <Grid x:Name="CpuRamGrid" ColumnSpacing="0" RowSpacing="0" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="CpuRamRow0" Height="Auto" />
                                <RowDefinition x:Name="CpuRamRow1" Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="CpuRamCol0" Width="*" />
                                <ColumnDefinition x:Name="CpuRamCol1" Width="*" />
                            </Grid.ColumnDefinitions>

                        <!-- CPU Card with Circular Ring Gauge & Specular Rim -->
                        <Border x:Name="CpuCard" Grid.Column="0" Margin="4" Padding="16,14" CornerRadius="12"
                                Background="{ThemeResource GlassCardBackgroundBrush}"
                                BorderThickness="{x:Bind GetCpuCardBorderThickness(ViewModel.CpuUsage), Mode=OneWay}"
                                BorderBrush="{ThemeResource SpecularGlassBorderBrush}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Style="{StaticResource IconBadgeStyle}"
                                                Background="{StaticResource IconBadgeCpuBackground}"
                                                BorderBrush="{StaticResource IconBadgeCpuBorder}">
                                            <FontIcon Glyph="&#xE9CA;" FontSize="15" Foreground="{StaticResource IconBadgeCpuGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="CPU" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                            <TextBlock Text="{x:Bind FormatPercent(ViewModel.CpuUsage), Mode=OneWay}" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE9CA;" FontSize="10" Foreground="{StaticResource CpuAccentBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind ViewModel.CpuTempFormatted, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Circular Ring Gauge -->
                                <Grid Grid.Column="1" Width="72" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border x:Name="CpuGlowBorder" Width="44" Height="44" CornerRadius="22" Background="{StaticResource GaugeGlowGoodBrush}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Path Stroke="{ThemeResource GaugeTrackBrush}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Path.Data>
                                            <PathGeometry>
                                                <PathFigure StartPoint="36,8">
                                                    <ArcSegment Point="35.99,8" Size="28,28" SweepDirection="Clockwise" IsLargeArc="True"/>
                                                </PathFigure>
                                            </PathGeometry>
                                        </Path.Data>
                                    </Path>
                                    <Path Stroke="{StaticResource GaugeCpuBrush}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Path.Data>
                                            <PathGeometry>
                                                <PathFigure x:Name="CpuPathFigure" StartPoint="36,8">
                                                    <ArcSegment x:Name="CpuArcSegment" Point="36,8" Size="28,28" SweepDirection="Clockwise" IsLargeArc="False"/>
                                                </PathFigure>
                                            </PathGeometry>
                                        </Path.Data>
                                    </Path>
                                    <TextBlock Text="{x:Bind FormatPercent(ViewModel.CpuUsage), Mode=OneWay}" FontSize="12" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- RAM Card with Circular Ring Gauge & Specular Rim -->
                        <Border x:Name="RamCard" Grid.Column="1" Margin="4" Padding="16,14" CornerRadius="12"
                                Background="{ThemeResource GlassCardBackgroundBrush}"
                                BorderBrush="{ThemeResource SpecularGlassBorderBrush}" BorderThickness="1">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Style="{StaticResource IconBadgeStyle}"
                                                Background="{StaticResource IconBadgeRamBackground}"
                                                BorderBrush="{StaticResource IconBadgeRamBorder}">
                                            <FontIcon Glyph="&#xE950;" FontSize="15" Foreground="{StaticResource IconBadgeRamGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="Memory (RAM)" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                            <TextBlock Text="{x:Bind FormatPercent(ViewModel.RamUsage), Mode=OneWay}" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE950;" FontSize="10" Foreground="{StaticResource RamAccentBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind ViewModel.RamCapacityFormatted, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Circular Ring Gauge -->
                                <Grid Grid.Column="1" Width="72" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border x:Name="RamGlowBorder" Width="44" Height="44" CornerRadius="22" Background="{StaticResource GaugeGlowGoodBrush}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Path Stroke="{ThemeResource GaugeTrackBrush}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Path.Data>
                                            <PathGeometry>
                                                <PathFigure StartPoint="36,8">
                                                    <ArcSegment Point="35.99,8" Size="28,28" SweepDirection="Clockwise" IsLargeArc="True"/>
                                                </PathFigure>
                                            </PathGeometry>
                                        </Path.Data>
                                    </Path>
                                    <Path Stroke="{StaticResource GaugeRamBrush}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Path.Data>
                                            <PathGeometry>
                                                <PathFigure x:Name="RamPathFigure" StartPoint="36,8">
                                                    <ArcSegment x:Name="RamArcSegment" Point="36,8" Size="28,28" SweepDirection="Clockwise" IsLargeArc="False"/>
                                                </PathFigure>
                                            </PathGeometry>
                                        </Path.Data>
                                    </Path>
                                    <TextBlock Text="{x:Bind FormatPercent(ViewModel.RamUsage), Mode=OneWay}" FontSize="12" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                        <!-- Bottom 2 Sensors: GPU and Disk Cards -->
                        <Grid x:Name="GpuDiskGrid" ColumnSpacing="0" RowSpacing="0" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="GpuDiskRow0" Height="Auto" />
                                <RowDefinition x:Name="GpuDiskRow1" Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="GpuDiskCol0" Width="*" />
                                <ColumnDefinition x:Name="GpuDiskCol1" Width="*" />
                            </Grid.ColumnDefinitions>

                        <!-- GPU Card with Circular Ring Gauge & Specular Rim -->
                        <Border x:Name="GpuCard" Grid.Column="0" Margin="4" Padding="16,14" CornerRadius="12"
                                Background="{ThemeResource GlassCardBackgroundBrush}" BorderBrush="{ThemeResource SpecularGlassBorderBrush}" BorderThickness="1">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Style="{StaticResource IconBadgeStyle}"
                                                Background="{StaticResource IconBadgeGpuBackground}"
                                                BorderBrush="{StaticResource IconBadgeGpuBorder}">
                                            <FontIcon Glyph="&#xE9F5;" FontSize="15" Foreground="{StaticResource IconBadgeGpuGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="GPU" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                            <TextBlock Text="{x:Bind FormatPercent(ViewModel.GpuUsage), Mode=OneWay}" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE9F5;" FontSize="10" Foreground="{StaticResource GpuAccentBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Active Engine" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Circular Ring Gauge -->
                                <Grid Grid.Column="1" Width="72" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border x:Name="GpuGlowBorder" Width="44" Height="44" CornerRadius="22" Background="{StaticResource GaugeGlowGoodBrush}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Path Stroke="{ThemeResource GaugeTrackBrush}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Path.Data>
                                            <PathGeometry>
                                                <PathFigure StartPoint="36,8">
                                                    <ArcSegment Point="35.99,8" Size="28,28" SweepDirection="Clockwise" IsLargeArc="True"/>
                                                </PathFigure>
                                            </PathGeometry>
                                        </Path.Data>
                                    </Path>
                                    <Path Stroke="{StaticResource GaugeGpuBrush}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Path.Data>
                                            <PathGeometry>
                                                <PathFigure x:Name="GpuPathFigure" StartPoint="36,8">
                                                    <ArcSegment x:Name="GpuArcSegment" Point="36,8" Size="28,28" SweepDirection="Clockwise" IsLargeArc="False"/>
                                                </PathFigure>
                                            </PathGeometry>
                                        </Path.Data>
                                    </Path>
                                    <TextBlock Text="{x:Bind FormatPercent(ViewModel.GpuUsage), Mode=OneWay}" FontSize="12" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Disk Card with Circular Ring Gauge & Specular Rim -->
                        <Border x:Name="DiskCard" Grid.Column="1" Margin="4" Padding="16,14" CornerRadius="12"
                                Background="{ThemeResource GlassCardBackgroundBrush}"
                                BorderThickness="{x:Bind GetDiskCardBorderThickness(ViewModel.DiskUsage), Mode=OneWay}"
                                BorderBrush="{ThemeResource SpecularGlassBorderBrush}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Style="{StaticResource IconBadgeStyle}"
                                                Background="{StaticResource IconBadgeDiskBackground}"
                                                BorderBrush="{StaticResource IconBadgeDiskBorder}">
                                            <FontIcon Glyph="&#xEA99;" FontSize="15" Foreground="{StaticResource IconBadgeDiskGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="Disk (C:)" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                            <TextBlock Text="{x:Bind FormatPercent(ViewModel.DiskUsage), Mode=OneWay}" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xEA99;" FontSize="10" Foreground="{StaticResource DiskAccentBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind ViewModel.JunkFileSize, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='Cache: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Circular Ring Gauge -->
                                <Grid Grid.Column="1" Width="72" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border x:Name="DiskGlowBorder" Width="44" Height="44" CornerRadius="22" Background="{StaticResource GaugeGlowGoodBrush}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Path Stroke="{ThemeResource GaugeTrackBrush}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Path.Data>
                                            <PathGeometry>
                                                <PathFigure StartPoint="36,8">
                                                    <ArcSegment Point="35.99,8" Size="28,28" SweepDirection="Clockwise" IsLargeArc="True"/>
                                                </PathFigure>
                                            </PathGeometry>
                                        </Path.Data>
                                    </Path>
                                    <Path Stroke="{StaticResource GaugeDiskBrush}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Path.Data>
                                            <PathGeometry>
                                                <PathFigure x:Name="DiskPathFigure" StartPoint="36,8">
                                                    <ArcSegment x:Name="DiskArcSegment" Point="36,8" Size="28,28" SweepDirection="Clockwise" IsLargeArc="False"/>
                                                </PathFigure>
                                            </PathGeometry>
                                        </Path.Data>
                                    </Path>
                                    <TextBlock Text="{x:Bind FormatPercent(ViewModel.DiskUsage), Mode=OneWay}" FontSize="12" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    </StackPanel>

                    <!-- Row 2 Right: Performance Trend Chart Card with Series Toggles -->
                    <Border x:Name="PerformanceChartCard" Grid.Row="2" Grid.Column="1" Margin="4" Padding="16" CornerRadius="12" Background="{ThemeResource GlassCardBackgroundBrush}" BorderBrush="{ThemeResource SpecularGlassBorderBrush}" BorderThickness="1" Visibility="Visible">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel x:Name="PerformanceHeaderGrid" Grid.Row="0" Margin="0,0,0,12" Spacing="8">
                                <StackPanel x:Name="PerformanceTitlePanel" Spacing="2">
                                    <TextBlock Text="Performance History" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Load levels for CPU, RAM, GPU, Disk" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                </StackPanel>

                                <!-- Resource Insights Telemetry Banner -->
                                <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,2,0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE9D9;" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ResourceInsightsText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ResourceAverageLoadText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                </Border>

                                <StackPanel x:Name="PerformanceFiltersPanel" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                                    <CheckBox x:Name="CpuFilterCheck" Content="CPU" IsChecked="True" Checked="OnChartFilterChanged" Unchecked="OnChartFilterChanged" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <CheckBox x:Name="RamFilterCheck" Content="RAM" IsChecked="True" Checked="OnChartFilterChanged" Unchecked="OnChartFilterChanged" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <CheckBox x:Name="GpuFilterCheck" Content="GPU" IsChecked="True" Checked="OnChartFilterChanged" Unchecked="OnChartFilterChanged" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <CheckBox x:Name="DiskFilterCheck" Content="Disk" IsChecked="True" Checked="OnChartFilterChanged" Unchecked="OnChartFilterChanged" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <lvc:CartesianChart
                                Grid.Row="1"
                                Height="220"
                                Background="Transparent"
                                Series="{x:Bind ViewModel.PerformanceSeries, Mode=OneWay}"
                                XAxes="{x:Bind ViewModel.XAxes, Mode=OneWay}"
                                YAxes="{x:Bind ViewModel.YAxes, Mode=OneWay}"
                                FindingStrategy="CompareAll" />
                        </Grid>
                    </Border>

                    <!-- Row 3: Recommendations Card (Actionable layout) -->
                    <Border x:Name="RecommendationsCard" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="4" Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SpecularGlassBorderBrush}" BorderThickness="1" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,12" Spacing="4">
                                <TextBlock Text="System Recommendations" FontSize="18" FontWeight="Bold" />
                                <TextBlock Text="Suggested optimization actions" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="No recommendations. Run a full scan to evaluate your PC health." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Visibility="{x:Bind GetVisibility(ViewModel.Recommendations.Count), Mode=OneWay}" Margin="0,16,0,0" TextAlignment="Center" />

                                    <ItemsControl ItemsSource="{x:Bind ViewModel.Recommendations, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border BorderBrush="{ThemeResource SpecularGlassBorderBrush}" BorderThickness="1" Background="{ThemeResource ControlAltFillColorSecondaryBrush}" CornerRadius="10" Margin="0,0,0,10" Padding="14">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" Spacing="12" Grid.Column="0">
                                                            <Border Width="28" Height="28" Background="#157F56D9" CornerRadius="14" VerticalAlignment="Center">
                                                                <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Text="{x:Bind}" TextWrapping="Wrap" FontSize="12" LineHeight="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                        </StackPanel>
                                                        <!-- Actionable Quick Fix button in the card -->
                                                        <Button Grid.Column="1" Content="Fix" Style="{StaticResource DefaultButtonStyle}" VerticalAlignment="Center" Padding="12,6" Height="30" CornerRadius="6" FontSize="11.5" FontWeight="Bold" Click="OnRecommendationFixClick"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Clean Advanced Details & History Log Toggle Banner Deck -->
                <Border Background="{ThemeResource GlassCardBackgroundBrush}"
                        BorderBrush="{ThemeResource SpecularGlassBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16,12"
                        Margin="6,4,6,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                <FontIcon Glyph="&#xE9D9;" FontSize="15" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="System Deep Layer Diagnostics" FontWeight="SemiBold" FontSize="13.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Detailed audits, itemized discoveries &amp; operation logs" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <ToggleButton Grid.Column="2"
                                      x:Name="ShowDetailedInsightsBtn"
                                      Content="Advanced Details &amp; History Log"
                                      Checked="OnShowDeepLayerChecked"
                                      Unchecked="OnShowDeepLayerUnchecked"
                                      Style="{StaticResource DefaultToggleButtonStyle}"
                                      Background="{StaticResource PrimaryAccentGradient}"
                                      Foreground="White"
                                      FontWeight="SemiBold"
                                      CornerRadius="6"
                                      Padding="14,6"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Toggle Advanced Details and History Log"/>
                    </Grid>
                </Border>

                <!-- 3. DEEP LAYER (Loaded on Demand) -->
                <StackPanel x:Name="DeepLayerPanel" x:Load="False" Spacing="16">

                    <!-- Row 1: Detailed Audits Table -->
                    <Border x:Name="AuditsCard" Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE721;" FontSize="16" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Diagnostics Discoveries" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Export Report controls -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="ExportFormatCombo" SelectedIndex="0" Width="100" CornerRadius="6">
                                        <ComboBoxItem Content="TXT" />
                                        <ComboBoxItem Content="JSON" />
                                        <ComboBoxItem Content="CSV" />
                                    </ComboBox>
                                    <Button Style="{StaticResource DefaultButtonStyle}" Click="OnExportReportClick" CornerRadius="6" Padding="12,5">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xEDE1;" FontSize="11" Foreground="{ThemeResource PrimaryAccentBrush}"/>
                                            <TextBlock Text="Export Report" FontSize="11.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="0" Margin="0,0,0,16" VerticalAlignment="Bottom">
                                <TextBlock x:Name="ExportStatusText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="MediumSeaGreen" Visibility="Collapsed"/>
                            </StackPanel>

                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.DiagnosticItems, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="False" MaxHeight="360">
                                <ListView.ItemContainerTransitions>
                                    <TransitionCollection>
                                        <AddDeleteThemeTransition />
                                        <RepositionThemeTransition />
                                    </TransitionCollection>
                                </ListView.ItemContainerTransitions>
                                <ListView.Header>
                                    <Grid Padding="12,8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.8*" />
                                            <ColumnDefinition Width="4*" />
                                            <ColumnDefinition Width="1.5*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Category" FontWeight="Bold" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                        <TextBlock Grid.Column="1" Text="Check Name" FontWeight="Bold" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                        <TextBlock Grid.Column="2" Text="Description" FontWeight="Bold" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                        <TextBlock Grid.Column="3" Text="Status" FontWeight="Bold" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Left" />
                                    </Grid>
                                </ListView.Header>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="12,10" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="1.8*" />
                                                <ColumnDefinition Width="4*" />
                                                <ColumnDefinition Width="1.5*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayCategory}" VerticalAlignment="Center" FontSize="12.5" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayCheckName}" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Text="{Binding DisplayDescription}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Margin="0,0,16,0" LineHeight="16"/>
                                            <Grid Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <Border Background="{Binding StatusBadgeBg}" CornerRadius="6" Padding="10,5" Visibility="{Binding StatusBadgeVisibility}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="{Binding StatusIcon}" Foreground="{Binding StatusColor}" FontSize="11" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding DisplayStatusLabel}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <Button Content="Fix Now" Style="{StaticResource DefaultButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" Padding="12,5" Height="28" CornerRadius="6" FontSize="11" FontWeight="Bold" Visibility="{Binding FixButtonVisibility}" Click="OnFixItemClick" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Operations Timeline -->
                    <Border Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEC92;" FontSize="16" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Operations &amp; Optimization Timeline" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.ActionLogs, Mode=OneWay}" SelectionMode="None" MaxHeight="360">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="10,10" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="30" Height="30" Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="15" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="MediumSeaGreen" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding DisplayAction}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding DisplayModule}" FontSize="10.5" Foreground="{StaticResource PrimaryAccentBrush}" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                                <TextBlock Text="{Binding CreatedAtFormatted}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding DisplayStatus}" FontSize="11" Foreground="MediumSeaGreen" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ======================================================================== -->
        <!-- Right Slide-in Detail Panel & Modal Overlay for Modular Scans               -->
        <!-- ======================================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Visibility="{x:Bind ViewModel.IsScanPanelOpen, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="Transparent"
              Opacity="1.0"
              Canvas.ZIndex="1000">

            <!-- Backdrop Scrim (Click to dismiss) -->
            <Button Background="#80000000" Click="OnScanPanelScrimClick" Style="{StaticResource TransparentWrapperButtonStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="Dismiss Scan Panel"/>

            <!-- Right-aligned Slide-in Detail Panel (100% Solid Opaque Surface) -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Width="520"
                    Background="{ThemeResource AppFlyoutBackground}"
                    BorderBrush="{ThemeResource AppFlyoutBorder}"
                    BorderThickness="1,0,0,0"
                    CornerRadius="16,0,0,16"
                    Padding="24,20,24,20">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <!-- Header & Close -->
                        <RowDefinition Height="Auto" />
                        <!-- Pre-Scan Subcategory Config or Finding List -->
                        <RowDefinition Height="*" />
                        <!-- Scanning Progress & Module Status -->
                        <RowDefinition Height="Auto" />
                        <!-- Action Deck Footer -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Panel Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="{ThemeResource AppFlyoutItemBackground}" BorderBrush="{ThemeResource AppFlyoutItemBorder}" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                            <FontIcon Glyph="{x:Bind ViewModel.ModeHeaderGlyph, Mode=OneWay}" FontSize="20" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.ModeHeaderTitle, Mode=OneWay}" FontSize="17" FontWeight="Bold" FontFamily="Segoe UI Variable Display" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind ViewModel.ModeHeaderSubtitle, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource DateTimeFlyoutCalendarButtonStyle}" Width="32" Height="32" Click="OnCloseScanPanelClick" VerticalAlignment="Top" AutomationProperties.Name="Close Scan Panel">
                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Row 1: Dual-State Scrollable Content (Pre-scan Config vs Post-scan Findings) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="12">

                            <!-- State A: Pre-Scan Subcategory Config Selection -->
                            <StackPanel Visibility="{x:Bind ViewModel.HasModeScanned, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Spacing="10">
                                <TextBlock Text="Pre-Scan Categories" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Configure items to include before starting scan" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>

                                <ItemsControl ItemsSource="{x:Bind ViewModel.ModeSubCategories, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:DashboardSubCategoryItem">
                                            <Border Background="{ThemeResource AppFlyoutItemBackground}" BorderBrush="{ThemeResource AppFlyoutItemBorder}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="{ThemeResource AppFlyoutBackground}" BorderBrush="{ThemeResource AppFlyoutItemBorder}" BorderThickness="1" VerticalAlignment="Center">
                                                        <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="13" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{x:Bind DisplayName}" FontSize="12.5" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{x:Bind DisplayDescription}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="2" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind DisplayName}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- State B: Post-Scan Findings & Categorized Health Audit -->
                            <StackPanel Visibility="{x:Bind ViewModel.HasModeScanned, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Spacing="12">
                                <!-- Severity KPI Summary Bar -->
                                <Border Background="{ThemeResource AppFlyoutItemBackground}" BorderBrush="{ThemeResource AppFlyoutItemBorder}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Safe Count -->
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="#FF10B981" VerticalAlignment="Center"/>
                                                <TextBlock Text="Safe" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.SafeCount, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#FF10B981" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>

                                        <!-- Notice / Warning Count -->
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="#FFF59E0B" VerticalAlignment="Center"/>
                                                <TextBlock Text="Notice" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.WarningCount, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#FFF59E0B" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>

                                        <!-- Risk / Danger Count -->
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="#FFEF4444" VerticalAlignment="Center"/>
                                                <TextBlock Text="Risk" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.DangerCount, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#FFEF4444" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Quick Fix Result Message if any -->
                                <Border Visibility="{x:Bind GetQuickFixResultVisibility(ViewModel.QuickFixResultMessage), Mode=OneWay}" Background="#1510B981" BorderBrush="#3510B981" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#FF10B981" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.QuickFixResultMessage, Mode=OneWay}" FontSize="11.5" Foreground="#FF10B981" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Scan Findings &amp; Health Audit" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                                <!-- Findings List with Color Badges -->
                                <ItemsControl ItemsSource="{x:Bind ViewModel.ModeFindings, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:DashboardScanFinding">
                                            <Border Background="{ThemeResource AppFlyoutItemBackground}" BorderBrush="{ThemeResource AppFlyoutItemBorder}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,6">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <!-- Severity Badge -->
                                                    <Border Grid.Column="1" Background="{x:Bind BadgeBg, Mode=OneWay}" Padding="8,3" CornerRadius="6" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind SeverityBadgeText, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Foreground="{x:Bind BadgeFg, Mode=OneWay}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Row 2: Live Scanning Progress HUD -->
                    <Border Grid.Row="2" Visibility="{x:Bind ViewModel.IsModeScanning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{ThemeResource AppFlyoutItemBackground}" BorderBrush="{ThemeResource AppFlyoutItemBorder}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                        <StackPanel Spacing="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ProgressRing Width="16" Height="16" IsActive="True" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.ModeCurrentModuleName, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ModeScannedItemCount, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0} items'}" FontSize="12" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            </Grid>
                            <ProgressBar Value="{x:Bind ViewModel.ModeScanProgress, Mode=OneWay}" Maximum="100" Height="4.5" Foreground="{StaticResource PrimaryAccentGradient}" CornerRadius="2"/>
                            <TextBlock Text="{x:Bind ViewModel.ModeScanStatus, Mode=OneWay}" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- Row 3: Action Buttons Deck -->
                    <Grid Grid.Row="3" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Primary Action: Scan or Stop Scan or Quick Fix -->
                        <!-- If Scanning: Stop Scan -->
                        <Button Grid.Column="0" Visibility="{x:Bind ViewModel.IsModeScanning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource StandardSecondaryButtonStyle}" Click="OnCancelModeScanClick" Height="38" HorizontalAlignment="Stretch" CornerRadius="10"
                                AutomationProperties.Name="Stop Scan">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE71A;" FontSize="12" Foreground="#FFEF4444"/>
                                <TextBlock Text="Stop Scan" FontWeight="Bold" FontSize="12" Foreground="#FFEF4444"/>
                            </StackPanel>
                        </Button>

                        <!-- If Idle & Not Scanned: Start Scan -->
                        <Button Grid.Column="0" Visibility="{x:Bind GetScanButtonVisibility(ViewModel.IsModeScanning, ViewModel.HasModeScanned), Mode=OneWay}"
                                Style="{StaticResource VibrantPrimaryButtonStyle}" Click="OnStartModeScanClick" Height="38" HorizontalAlignment="Stretch" CornerRadius="10"
                                AutomationProperties.Name="Start Scan">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE721;" FontSize="12" Foreground="White"/>
                                <TextBlock Text="Start Scan" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <!-- If Scanned: Quick Fix / Clean Now -->
                        <Button Grid.Column="0" Visibility="{x:Bind GetQuickFixButtonVisibility(ViewModel.IsModeScanning, ViewModel.HasModeScanned), Mode=OneWay}"
                                IsEnabled="{x:Bind IsNot(ViewModel.IsModeFixing), Mode=OneWay}"
                                Style="{StaticResource VibrantPrimaryButtonStyle}" Click="OnExecuteModeQuickFixClick" Height="38" HorizontalAlignment="Stretch" CornerRadius="10"
                                AutomationProperties.Name="{x:Bind ViewModel.ModeActionFixButtonText, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE945;" FontSize="12" Foreground="White"/>
                                <TextBlock Text="{x:Bind ViewModel.ModeActionFixButtonText, Mode=OneWay}" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <!-- Secondary Action: Open Deep Module Page -->
                        <Button Grid.Column="1" Style="{StaticResource StandardSecondaryButtonStyle}" Click="OnModeDeepNavClick" Height="38" HorizontalAlignment="Stretch" CornerRadius="10"
                                AutomationProperties.Name="{x:Bind ViewModel.ModeDeepNavButtonText, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8A7;" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.ModeDeepNavButtonText, Mode=OneWay}" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </Grid>
</Page>



