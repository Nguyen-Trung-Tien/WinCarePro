<Page
    x:Class="WinCarePro.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Background="Transparent">
        <!-- OpenPaneLength set to 220px, CompactPaneLength to 60px -->
        <NavigationView x:Name="NavView" PaneDisplayMode="Auto" SelectionChanged="OnNavSelectionChanged" BackRequested="OnNavBackRequested" IsBackButtonVisible="Auto" AlwaysShowHeader="False" IsSettingsVisible="False" OpenPaneLength="220" CompactPaneLength="60" Background="Transparent">

            <!-- Navigation Pane Footer -->
            <NavigationView.PaneFooter>
                <StackPanel Padding="0,0,0,8">
                    <Button x:Name="UserProfileButton" Visibility="Visible" Margin="8,0,8,4" Padding="8,6" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource StandardSecondaryButtonStyle}" Click="OnUserProfileClick" AutomationProperties.Name="User Profile Settings">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border x:Name="UserAvatarBorder" Width="32" Height="32" CornerRadius="16" Background="{StaticResource CyberAccentGradient}">
                                    <FontIcon Glyph="&#xE77B;" FontSize="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <!-- Online Status Beacon -->
                                <Border Width="9" Height="9" CornerRadius="4.5" Background="#FF10B981" BorderBrush="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="10,0,0,0" Visibility="{x:Bind NavView.IsPaneOpen, Mode=OneWay}">
                                <TextBlock x:Name="NavUserName" Text="User" FontSize="12.5" FontWeight="Bold" Foreground="{ThemeResource NavigationViewItemForeground}" TextTrimming="CharacterEllipsis" MaxWidth="130" FontFamily="Segoe UI Variable Display"/>
                                <TextBlock x:Name="NavMachineName" Text="PC" FontSize="11" Foreground="{ThemeResource NavigationViewItemHeaderForeground}" TextTrimming="CharacterEllipsis" MaxWidth="130" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
            </NavigationView.PaneFooter>

            <NavigationView.MenuItems>
                <!-- WINCARE PRO V6.0.0 STREAMLINED CORE SUITE -->
                <NavigationViewItem x:Name="NavDashboard" Tag="Dashboard" Content="Dashboard" Visibility="Visible" AutomationProperties.Name="Dashboard" AutomationProperties.HelpText="Overview of system health, hardware telemetry, and one-click quick boost.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavCleaner" Tag="Cleaner" Content="System Cleaner" Visibility="Visible" AutomationProperties.Name="System Cleaner" AutomationProperties.HelpText="Unified cleanup for temporary junk, system cache, and remnant app files.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavUninstall" Tag="Uninstall" Content="App Manager" Visibility="Visible" AutomationProperties.Name="App Manager" AutomationProperties.HelpText="Manage and uninstall desktop and Store applications with deep leftover sweep.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavUpdater" Tag="Updater" Content="Software Updater" Visibility="Visible" AutomationProperties.Name="Software Updater" AutomationProperties.HelpText="Scan, detect and update third-party apps and Windows components.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavNetwork" Tag="Network" Content="Network Center" Visibility="Visible" AutomationProperties.Name="Network Center" AutomationProperties.HelpText="Manage adapters, switch secure DNS with 1-click and rescue connection issues.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavRepair" Tag="Repair" Content="System Repair" Visibility="Visible" AutomationProperties.Name="System Repair" AutomationProperties.HelpText="Windows component doctor, SFC/DISM repairs, Windows Update Fixer, and restore points.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Navigation Footer Menu Items (Settings) -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavSettings" Tag="Settings" Content="Settings" Visibility="Visible" AutomationProperties.Name="Settings" AutomationProperties.HelpText="Application configuration, backup rollback manager, and SQLite audit logs.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Navigation Frame Content Area without overlapping top bar -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Contextual Hub Sub-Navigation Bar collapsed by default to prevent overlapping page content -->
                <Border x:Name="HubSubNavBar" Grid.Row="0" Margin="28,8,28,0" Padding="6,5" CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" HorizontalAlignment="Left" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="HubTabBtn1" Click="OnHubSubTabClick" Tag="Dashboard" CornerRadius="8" Padding="12,5" Style="{StaticResource VibrantPrimaryButtonStyle}" AutomationProperties.Name="Primary Hub View">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon x:Name="HubTabIcon1" Glyph="&#xE80F;" FontSize="12.5"/>
                                <TextBlock x:Name="HubTabText1" Text="Smart Cockpit" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="HubTabBtn3" Click="OnHubSubTabClick" Tag="ContextMenu" Visibility="Collapsed" CornerRadius="8" Padding="12,5" Style="{StaticResource StandardSecondaryButtonStyle}" AutomationProperties.Name="Tertiary Hub View">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon x:Name="HubTabIcon3" Glyph="&#xE8EC;" FontSize="12.5"/>
                                <TextBlock x:Name="HubTabText3" Text="Context Menu" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Frame x:Name="ContentFrame" Grid.Row="1" Margin="0,4,0,0">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <NavigationThemeTransition>
                                <EntranceNavigationTransitionInfo />
                            </NavigationThemeTransition>
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>
            </Grid>
        </NavigationView>
    </Grid>
</Page>
