<Page
    x:Class="WinCarePro.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Background="Transparent">
        <!-- OpenPaneLength set to 220px, CompactPaneLength to 60px -->
        <NavigationView x:Name="NavView" PaneDisplayMode="Auto" SelectionChanged="OnNavSelectionChanged" BackRequested="OnNavBackRequested" IsBackButtonVisible="Auto" AlwaysShowHeader="False" IsSettingsVisible="True" OpenPaneLength="220" CompactPaneLength="60" Background="Transparent">

            <!-- Navigation Pane Footer -->
            <NavigationView.PaneFooter>
                <StackPanel Padding="0,0,0,8">
                    <Button x:Name="UserProfileButton" Visibility="Visible" Margin="8,0,8,4" Padding="8,6" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource StandardSecondaryButtonStyle}" Click="OnUserProfileClick" AutomationProperties.Name="User Profile Settings">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border x:Name="UserAvatarBorder" Width="32" Height="32" CornerRadius="16" Background="{StaticResource CyberAccentGradient}">
                                    <FontIcon Glyph="&#xE77B;" FontSize="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <!-- Online Status Beacon -->
                                <Border Width="9" Height="9" CornerRadius="4.5" Background="#FF10B981" BorderBrush="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="10,0,0,0" Visibility="{x:Bind NavView.IsPaneOpen, Mode=OneWay}">
                                <TextBlock x:Name="NavUserName" Text="User" FontSize="12.5" FontWeight="Bold" Foreground="{ThemeResource NavigationViewItemForeground}" TextTrimming="CharacterEllipsis" MaxWidth="130" FontFamily="Segoe UI Variable Display"/>
                                <TextBlock x:Name="NavMachineName" Text="PC" FontSize="11" Foreground="{ThemeResource NavigationViewItemHeaderForeground}" TextTrimming="CharacterEllipsis" MaxWidth="130" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
            </NavigationView.PaneFooter>

            <NavigationView.MenuItems>
                <!-- HUB 1: OVERVIEW -->
                <NavigationViewItemHeader x:Name="NavHeaderOverview" Content="OVERVIEW" Visibility="Visible" />

                <NavigationViewItem x:Name="NavDashboard" Tag="Dashboard" Content="Dashboard" Visibility="Visible" AutomationProperties.Name="Dashboard" AutomationProperties.HelpText="Overview of system health, hardware telemetry, and one-click quick boost.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavAi" Tag="AiWinCareEngine" Content="Diagnostics" Visibility="Collapsed" AutomationProperties.Name="Diagnostics" AutomationProperties.HelpText="Intelligent multi-factor system diagnostics and automated remedies.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE99A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- HUB 2: APPLICATIONS -->
                <NavigationViewItemSeparator x:Name="NavSepApps" Visibility="Visible" />
                <NavigationViewItemHeader x:Name="NavHeaderApps" Content="APPLICATIONS" Visibility="Visible" />

                <NavigationViewItem x:Name="NavUninstall" Tag="Uninstall" Content="Uninstaller" Visibility="Visible" AutomationProperties.Name="Uninstaller" AutomationProperties.HelpText="Uninstall desktop and Store apps with deep leftover cleanup.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavStartup" Tag="Startup" Content="Startup" Visibility="Visible" AutomationProperties.Name="Startup" AutomationProperties.HelpText="Manage Windows boot apps and background services.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavContextMenu" Tag="ContextMenu" Content="Context Menu" Visibility="Visible" AutomationProperties.Name="Context Menu" AutomationProperties.HelpText="Manage and clean Windows Explorer right-click shell extensions.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavUpdater" Tag="Updater" Content="Updater" Visibility="Visible" AutomationProperties.Name="Updater" AutomationProperties.HelpText="Scan and update installed third-party software applications.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- HUB 3: CLEAN & REPAIR -->
                <NavigationViewItemSeparator x:Name="NavSepClean" Visibility="Visible" />
                <NavigationViewItemHeader x:Name="NavHeaderClean" Content="CLEAN &amp; REPAIR" Visibility="Visible" />

                <NavigationViewItem x:Name="NavJunk" Tag="Junk" Content="Junk Cleaner" Visibility="Visible" AutomationProperties.Name="Junk Cleaner" AutomationProperties.HelpText="Scan and safely clean temporary files, cache, and system clutter.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA99;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavRegistry" Tag="Registry" Content="Registry" Visibility="Visible" AutomationProperties.Name="Registry" AutomationProperties.HelpText="Registry backup, defragmentation, and cleanup.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDA2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavRepair" Tag="Repair" Content="Repair" Visibility="Visible" AutomationProperties.Name="Repair" AutomationProperties.HelpText="Windows system file checker, DISM repair, and subsystem restoration.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- HUB 4: TWEAKS & SECURITY -->
                <NavigationViewItemSeparator x:Name="NavSepTweaks" Visibility="Visible" />
                <NavigationViewItemHeader x:Name="NavHeaderTweaks" Content="TWEAKS &amp; SECURITY" Visibility="Visible" />

                <NavigationViewItem x:Name="NavOptimizer" Tag="Optimizer" Content="Optimizer" Visibility="Visible" AutomationProperties.Name="Optimizer" AutomationProperties.HelpText="System tweaks, RAM boost, and performance profiles.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavSecurity" Tag="Security" Content="Security" Visibility="Visible" AutomationProperties.Name="Security" AutomationProperties.HelpText="Windows Defender, Firewall, and privacy telemetry settings.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE727;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavNetwork" Tag="Network" Content="Network" Visibility="Visible" AutomationProperties.Name="Network" AutomationProperties.HelpText="Network monitoring, DNS benchmark, and latency diagnostics.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE701;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Navigation Frame Content Area without overlapping top bar -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Contextual Hub Sub-Navigation Bar collapsed by default to prevent overlapping page content -->
                <Border x:Name="HubSubNavBar" Grid.Row="0" Margin="28,8,28,0" Padding="6,5" CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" HorizontalAlignment="Left" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="HubTabBtn1" Click="OnHubSubTabClick" Tag="Dashboard" CornerRadius="8" Padding="12,5" Style="{StaticResource VibrantPrimaryButtonStyle}" AutomationProperties.Name="Primary Hub View">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon x:Name="HubTabIcon1" Glyph="&#xE80F;" FontSize="12.5"/>
                                <TextBlock x:Name="HubTabText1" Text="Smart Cockpit" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="HubTabBtn2" Click="OnHubSubTabClick" Tag="AiWinCareEngine" CornerRadius="8" Padding="12,5" Style="{StaticResource StandardSecondaryButtonStyle}" AutomationProperties.Name="Secondary Hub View">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon x:Name="HubTabIcon2" Glyph="&#xE99A;" FontSize="12.5"/>
                                <TextBlock x:Name="HubTabText2" Text="Smart Diagnostics" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="HubTabBtn3" Click="OnHubSubTabClick" Tag="ContextMenu" Visibility="Collapsed" CornerRadius="8" Padding="12,5" Style="{StaticResource StandardSecondaryButtonStyle}" AutomationProperties.Name="Tertiary Hub View">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon x:Name="HubTabIcon3" Glyph="&#xE8EC;" FontSize="12.5"/>
                                <TextBlock x:Name="HubTabText3" Text="Context Menu" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Frame x:Name="ContentFrame" Grid.Row="1" Margin="0,4,0,0" />
            </Grid>
        </NavigationView>
    </Grid>
</Page>
