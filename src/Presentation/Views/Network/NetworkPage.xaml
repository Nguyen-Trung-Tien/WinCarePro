<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinCarePro.Models"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    xmlns:controls="using:WinCarePro.Presentation.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition>
                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    <EntranceNavigationTransitionInfo />
                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
            </NavigationThemeTransition>
            <EntranceThemeTransition FromVerticalOffset="24" />
        </TransitionCollection>
    </Page.Transitions>

    <Grid Background="{ThemeResource AppDeepObsidianBackground}">
        <!-- Ambient Mesh Glow (Deep Obsidian Canvas with Cyan/Indigo Luminous Atmosphere in Dark Mode) -->
        <Grid x:Name="AmbientMeshGlowGrid" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Top-Left Radial Mesh Glow (Cyan #00D2FF &amp; Indigo #7B2CBF) -->
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top"
                       Width="720" Height="540" Margin="-100,-100,0,0"
                       Opacity="0.12"
                       Fill="{StaticResource AppAmbientMeshGlowBrush}" />

            <!-- Bottom-Right Subtle Accent Glow -->
            <Rectangle HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Width="560" Height="440" Margin="0,0,-80,-80"
                       Opacity="0.08"
                       Fill="{StaticResource AppSecondaryMeshGlowBrush}" />
        </Grid>

        <Grid Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0. Header & Action Bar -->
            <RowDefinition Height="Auto" /> <!-- 1. Contextual Status Banners -->
            <RowDefinition Height="*" />    <!-- 2. Pivot Workspace -->
        </Grid.RowDefinitions>

        <!-- ==================== 0. FLAT HEADER & ACTION BAR ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Top Edge Thin Progress Bar (Visible during Ping measurement, DNS switch, Winsock reset) -->
            <ProgressBar Grid.ColumnSpan="2"
                         VerticalAlignment="Bottom"
                         Margin="0,0,0,-10"
                         IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Height="2.5"
                         CornerRadius="1.25"
                         Foreground="{StaticResource PrimaryAccentBrush}"
                         HorizontalAlignment="Stretch"/>

            <!-- Left: Title & Subtitle (Standardized Aura Header) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Border Style="{StaticResource IconBadgeStyle}" Background="{StaticResource PrimaryAccentGradient}">
                    <FontIcon Glyph="&#xE968;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source='Network Center &amp; Diagnostics', Converter={StaticResource TranslationConverter}}"
                               Style="{StaticResource PageHeaderTitleStyle}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Source='Network telemetry, DNS speed &amp; TCP/IP repairs.', Converter={StaticResource TranslationConverter}}"
                               Style="{StaticResource PageHeaderSubtitleStyle}" />
                </StackPanel>
            </StackPanel>

            <!-- Right: Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Export Audit Report -->
                <Button Click="OnExportReportClick"
                        IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}"
                        Style="{StaticResource SecondaryGlassButtonStyle}"
                        CornerRadius="8"
                        Padding="12,7"
                        FontSize="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEDE1;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Export Report" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <!-- Refresh Button -->
                <Button Click="OnRefreshClick"
                        Style="{StaticResource PrimaryGradientButtonStyle}"
                        Foreground="White"
                        CornerRadius="8"
                        Padding="14,7"
                        FontSize="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        <TextBlock Text="Refresh" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== 1. CONTEXTUAL STATUS BANNERS ==================== -->
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,12">
            <!-- Summary / Post-Action Card -->
            <controls:InlineStatusCard
                CardType="Summary"
                Title="{Binding Source='Network Operation Summary', Converter={StaticResource TranslationConverter}}"
                Message="{x:Bind ViewModel.SummaryNetworkText, Mode=OneWay}"
                IsDismissible="True"
                Visibility="{x:Bind ViewModel.IsSummaryCardVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <!-- ==================== 2. MAIN TABBED WORKSPACE ==================== -->
        <Pivot x:Name="MainPivot"
               Grid.Row="2"
               Margin="0,-4,0,0"
               SelectionChanged="OnPivotSelectionChanged">
            <Pivot.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,10,0" />
                </DataTemplate>
            </Pivot.HeaderTemplate>

            <!-- ==================== TAB 1: BANDWIDTH & RADAR ==================== -->
            <PivotItem Header="Bandwidth &amp; Radar" Margin="0" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,10,0,20">
                    <Grid HorizontalAlignment="Stretch">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch">

                            <!-- SECTION 1: ACTIVE CONNECTION DETAILS -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="18">
                                <StackPanel Spacing="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE839;" FontSize="15" Foreground="{ThemeResource SystemAccentColor}" />
                                            <TextBlock Text="Active Network Connection" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Online Status Pill -->
                                        <Border Grid.Column="1"
                                                Background="{ThemeResource AppStatusGoodBackground}"
                                                BorderBrush="{ThemeResource AppStatusGoodBorder}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,4"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="6" Height="6" Fill="{ThemeResource AppStatusGoodBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind ViewModel.ActiveAdapterName, Mode=OneWay}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource AppStatusGoodBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="180" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- 4 Adapter Detail Cards -->
                                    <Grid ColumnSpacing="12" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Cell 1: Adapter Name & Type -->
                                        <Border Grid.Column="0"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,10">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Network Adapter" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.ActiveAdapterName, Mode=OneWay}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind ViewModel.AdapterType, Mode=OneWay}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Cell 2: IPv4 & Subnet -->
                                        <Border Grid.Column="1"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,10">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="IPv4 Address" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.Ipv4Address, Mode=OneWay}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Typography.NumeralAlignment="Tabular"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind ViewModel.SubnetMask, Mode=OneWay}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           Typography.NumeralAlignment="Tabular"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Cell 3: Gateway & MAC -->
                                        <Border Grid.Column="2"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,10">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Default Gateway" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind ViewModel.GatewayAddress, Mode=OneWay}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Typography.NumeralAlignment="Tabular"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind ViewModel.MacAddress, Mode=OneWay}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           Typography.NumeralAlignment="Tabular"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Cell 4: Current DNS -->
                                        <Border Grid.Column="3"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,10">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Current DNS Server" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind ViewModel.CurrentDnsDisplay, Mode=OneWay}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Typography.NumeralAlignment="Tabular"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="Active Resolver"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Sub-Card: On-Demand Diagnostics (Ping Test) -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,10">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE9D9;" FontSize="13" Foreground="{ThemeResource SystemAccentColor}" />
                                                    <TextBlock Text="{Binding Source='On-Demand Diagnostics', Converter={StaticResource TranslationConverter}}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="—" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" />
                                                    <TextBlock Text="{x:Bind ViewModel.DiagnosticsStatusText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- 3 Latency Badges -->
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="4" Padding="8,4">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="Gateway:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{x:Bind ViewModel.GatewayLatencyText, Mode=OneWay}"
                                                                       FontSize="11.5"
                                                                       FontWeight="Bold"
                                                                       Typography.NumeralAlignment="Tabular" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="4" Padding="8,4">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="Cloudflare (1.1.1.1):" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{x:Bind ViewModel.CloudflareLatencyText, Mode=OneWay}"
                                                                       FontSize="11.5"
                                                                       FontWeight="Bold"
                                                                       Typography.NumeralAlignment="Tabular"
                                                                       Foreground="{ThemeResource AppStatusCyanBrush}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="4" Padding="8,4">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="Google (8.8.8.8):" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{x:Bind ViewModel.GoogleLatencyText, Mode=OneWay}"
                                                                       FontSize="11.5"
                                                                       FontWeight="Bold"
                                                                       Typography.NumeralAlignment="Tabular"
                                                                       Foreground="{ThemeResource AppStatusGoodBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Check Button -->
                                            <Button Grid.Column="1"
                                                    Command="{x:Bind ViewModel.RunOnDemandDiagnosticsCommand}"
                                                    Style="{StaticResource DefaultButtonStyle}"
                                                    CornerRadius="8"
                                                    Padding="14,7"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <ProgressRing IsActive="{x:Bind ViewModel.IsDiagnosing, Mode=OneWay}"
                                                                  Visibility="{x:Bind ViewModel.IsDiagnosing, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                  Width="13"
                                                                  Height="13" />
                                                    <FontIcon Glyph="&#xE768;"
                                                              FontSize="12"
                                                              Visibility="{x:Bind ViewModel.IsDiagnosing, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                    <TextBlock Text="{Binding Source='Test', Converter={StaticResource TranslationConverter}}" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 2: BANDWIDTH QUALITY & RADAR METRICS -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Latency -->
                                <Border Grid.Column="0"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Source='Latency (Ping)', Converter={StaticResource TranslationConverter}}" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind FormatMs(ViewModel.LatencyMs), Mode=OneWay}"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource AppStatusGoodBrush}"
                                                       Typography.NumeralAlignment="Tabular" />
                                            <TextBlock Text="{Binding Source='Response Time', Converter={StaticResource TranslationConverter}}" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{ThemeResource AppStatusGoodBackground}" CornerRadius="6" Padding="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE701;" FontSize="16" Foreground="{ThemeResource AppStatusGoodBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Jitter -->
                                <Border Grid.Column="1"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Source='Stability (Jitter)', Converter={StaticResource TranslationConverter}}" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind FormatMs(ViewModel.JitterMs), Mode=OneWay}"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource AppStatusPurpleBrush}"
                                                       Typography.NumeralAlignment="Tabular" />
                                            <TextBlock Text="{Binding Source='Buffer Variance', Converter={StaticResource TranslationConverter}}" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{ThemeResource AppStatusPurpleBackground}" CornerRadius="6" Padding="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE945;" FontSize="16" Foreground="{ThemeResource AppStatusPurpleBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Packet Loss -->
                                <Border Grid.Column="2"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Source='Packet Loss', Converter={StaticResource TranslationConverter}}" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind FormatPercent(ViewModel.PacketLossPercent), Mode=OneWay}"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource AppStatusWarningBrush}"
                                                       Typography.NumeralAlignment="Tabular" />
                                            <TextBlock Text="{Binding Source='Dropped Packet Rate', Converter={StaticResource TranslationConverter}}" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{ThemeResource AppStatusWarningBackground}" CornerRadius="6" Padding="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource AppStatusWarningBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Health Score -->
                                <Border Grid.Column="3"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Source='AI Health Score', Converter={StaticResource TranslationConverter}}" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <TextBlock Text="{x:Bind ViewModel.NetworkHealthScore, Mode=OneWay}"
                                                           FontSize="22"
                                                           FontWeight="Bold"
                                                           Foreground="{ThemeResource AppStatusCyanBrush}"
                                                           Typography.NumeralAlignment="Tabular" />
                                                <TextBlock Text="/100" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.ConnectionQuality, Mode=OneWay}" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{ThemeResource AppStatusCyanBackground}" CornerRadius="6" Padding="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="{ThemeResource AppStatusCyanBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- SECTION 3: SPEED TEST COCKPIT -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20">
                                <StackPanel Spacing="16">
                                    <!-- Card Header: Title Left + Start Button & Status Right -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Title -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8B9;" FontSize="15" Foreground="{ThemeResource SystemAccentColor}" />
                                            <TextBlock Text="Speed Test &amp; Bandwidth Gauge" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Controls Right: Phase Pill + Start Button -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ViewModel.SpeedTestPhase, Mode=OneWay}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>

                                            <Button Click="OnStartSpeedTestClick"
                                                    IsEnabled="{x:Bind IsNot(ViewModel.IsSpeedTesting), Mode=OneWay}"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    CornerRadius="6"
                                                    Padding="14,6"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <ProgressRing IsActive="{x:Bind ViewModel.IsSpeedTesting, Mode=OneWay}"
                                                                  Visibility="{x:Bind ViewModel.IsSpeedTesting, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                  Width="13"
                                                                  Height="13"
                                                                  Foreground="White" />
                                                    <FontIcon Glyph="&#xE768;"
                                                              FontSize="12"
                                                              Visibility="{x:Bind ViewModel.IsSpeedTesting, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                    <TextBlock Text="{Binding Source='Start Test', Converter={StaticResource TranslationConverter}}" FontSize="12" FontWeight="Bold" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Large Speed Readout Strip -->
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind FormatSpeedValue(ViewModel.DisplaySpeed), Mode=OneWay}"
                                                   FontSize="42"
                                                   FontWeight="ExtraBold"
                                                   Typography.NumeralAlignment="Tabular"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <StackPanel VerticalAlignment="Center" Spacing="0">
                                            <TextBlock Text="{x:Bind FormatSpeedUnit(ViewModel.DisplaySpeed), Mode=OneWay}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.DisplaySpeedLabel, Mode=OneWay}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Progress Bar -->
                                    <ProgressBar Value="{x:Bind ViewModel.SpeedProgress, Mode=OneWay}"
                                                 Maximum="100"
                                                 Height="6"
                                                 CornerRadius="3" />

                                    <!-- 4 Stat Cells: Download, Upload, Ping, Public IP -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1.2*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Source='Download', Converter={StaticResource TranslationConverter}}" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind FormatMbps(ViewModel.DownloadSpeed), Mode=OneWay}"
                                                           FontSize="13.5" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource AppStatusGoodBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Source='Upload', Converter={StaticResource TranslationConverter}}" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind FormatMbps(ViewModel.UploadSpeed), Mode=OneWay}"
                                                           FontSize="13.5" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource AppStatusPurpleBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Source='Latency', Converter={StaticResource TranslationConverter}}" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind FormatMs(ViewModel.LatencyMs), Mode=OneWay}"
                                                           FontSize="13.5" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource AppStatusCyanBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Source='Public IP', Converter={StaticResource TranslationConverter}}" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind ViewModel.PublicIpAddress, Mode=OneWay}"
                                                               FontSize="12.5" FontWeight="Bold" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Click="OnCopyPublicIpClick" Style="{StaticResource DefaultButtonStyle}" Padding="6,4" VerticalAlignment="Center" AutomationProperties.Name="Copy Public IP" ToolTipService.ToolTip="{Binding Source='Copy Public IP', Converter={StaticResource TranslationConverter}}">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </PivotItem>

            <!-- ==================== TAB 2: DNS INTELLIGENCE ==================== -->
            <PivotItem Header="DNS Intelligence" Margin="0" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,10,0,20">
                    <Grid HorizontalAlignment="Stretch">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch">

                            <!-- SECTION 1: SECURE DNS SWITCHER -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE774;" FontSize="15" Foreground="{ThemeResource SystemAccentColor}" />
                                            <TextBlock Text="Secure DNS Switcher" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Text="Fast and secure DNS switching for optimal speed and privacy."
                                                   FontSize="12.5"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- DNS Controls Row -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MaxWidth="440" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- DNS Selector ComboBox -->
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Bind ViewModel.DnsProfiles}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedDnsProfile, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="8"
                                                  Height="38">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:DnsProfileOption">
                                                    <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,2">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" />
                                                        <TextBlock Text="{x:Bind Description}"
                                                                   FontSize="11.5"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="260" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- Apply Button -->
                                        <Button Grid.Column="1"
                                                Command="{x:Bind ViewModel.ApplySelectedDnsCommand}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Height="38"
                                                Padding="16,0"
                                                CornerRadius="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ProgressRing IsActive="{x:Bind ViewModel.IsApplyingDns, Mode=OneWay}"
                                                              Visibility="{x:Bind ViewModel.IsApplyingDns, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                              Width="14"
                                                              Height="14"
                                                              Foreground="White" />
                                                <FontIcon Glyph="&#xE73E;"
                                                          FontSize="13"
                                                          Visibility="{x:Bind ViewModel.IsApplyingDns, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                <TextBlock Text="{Binding Source='Apply', Converter={StaticResource TranslationConverter}}" FontSize="13" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Restore DHCP Button -->
                                        <Button Grid.Column="2"
                                                Command="{x:Bind ViewModel.RestoreDhcpDnsCommand}"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                Height="38"
                                                Padding="14,0"
                                                CornerRadius="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                                <TextBlock Text="{Binding Source='Restore DHCP', Converter={StaticResource TranslationConverter}}" FontSize="13" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Revert Backup Button -->
                                        <Button Grid.Column="3"
                                                Command="{x:Bind ViewModel.RestoreDnsBackupCommand}"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                Height="38"
                                                Padding="14,0"
                                                CornerRadius="8"
                                                Visibility="{x:Bind ViewModel.HasDnsBackup, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE7A7;" FontSize="13" />
                                                <TextBlock Text="Restore Default DNS" FontSize="13" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- DNS Status Message -->
                                    <TextBlock Text="{x:Bind ViewModel.DnsStatusMessage, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{x:Bind ViewModel.DnsStatusMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>

                            <!-- SECTION 2: DNS BENCHMARK MATRIX -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20">
                                <StackPanel Spacing="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xEC1B;" FontSize="15" Foreground="{ThemeResource SystemAccentColor}" />
                                                <TextBlock Text="DNS Query Latency Benchmark &amp; Optimization" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Text="Direct UDP port 53 resolution benchmark across global resolver networks."
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <!-- Switch to Fastest Button -->
                                            <Button Click="OnSwitchToFastestDnsClick"
                                                    IsEnabled="{x:Bind IsNot(ViewModel.IsBenchmarkingDns), Mode=OneWay}"
                                                    Style="{StaticResource DefaultButtonStyle}"
                                                    CornerRadius="8"
                                                    Padding="12,7">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AppStatusGoodBrush}" />
                                                    <TextBlock Text="{Binding Source='Apply Fastest DNS', Converter={StaticResource TranslationConverter}}" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Start Benchmark Button -->
                                            <Button Click="OnStartDnsBenchmarkClick"
                                                    IsEnabled="{x:Bind IsNot(ViewModel.IsBenchmarkingDns), Mode=OneWay}"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    CornerRadius="8"
                                                    Padding="14,7">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <ProgressRing IsActive="{x:Bind ViewModel.IsBenchmarkingDns, Mode=OneWay}"
                                                                  Visibility="{x:Bind ViewModel.IsBenchmarkingDns, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                  Width="13" Height="13" Foreground="White" />
                                                    <FontIcon Glyph="&#xE768;" FontSize="12"
                                                              Visibility="{x:Bind ViewModel.IsBenchmarkingDns, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                    <TextBlock Text="{Binding Source='Start DNS Benchmark', Converter={StaticResource TranslationConverter}}" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Fastest DNS Badge -->
                                    <Border Background="{ThemeResource AppStatusGoodBackground}"
                                            BorderBrush="{ThemeResource AppStatusGoodBorder}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="14,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Source='Fastest DNS:', Converter={StaticResource TranslationConverter}}" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource AppStatusGoodBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.FastestDnsText, Mode=OneWay}" FontSize="12.5" FontWeight="Bold" Foreground="{ThemeResource AppStatusGoodBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Source='Low query latency helps web pages load instantly and reduces lag in online games.', Converter={StaticResource TranslationConverter}}" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>

                                    <!-- DNS Servers List -->
                                    <ListView ItemsSource="{x:Bind ViewModel.DnsServers, Mode=OneWay}" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:DnsServerInfo">
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="14,10"
                                                        Margin="0,0,0,8">
                                                    <Grid ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Name & Provider -->
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind Provider}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <!-- IPs -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock Text="{x:Bind PrimaryIp}" FontSize="12" FontFamily="Segoe UI Variable Text" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind SecondaryIp}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <!-- Ping Badge -->
                                                        <Border Grid.Column="2"
                                                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                                CornerRadius="4"
                                                                Padding="10,4"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind LatencyFormatted}"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       Typography.NumeralAlignment="Tabular"
                                                                       Foreground="{ThemeResource AppStatusGoodBrush}" />
                                                        </Border>

                                                        <!-- Apply Button -->
                                                        <Button Grid.Column="3"
                                                                Click="OnApplyDnsServerClick"
                                                                Style="{StaticResource DefaultButtonStyle}"
                                                                Padding="12,5"
                                                                CornerRadius="6"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Source='Apply', Converter={StaticResource TranslationConverter}}" FontSize="11.5" FontWeight="SemiBold" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <controls:EmptyStateCard
                                        Visibility="{x:Bind EmptyStateVisibility(ViewModel.DnsServers.Count, ViewModel.IsBusy), Mode=OneWay}"
                                        IconGlyph="&#xE774;"
                                        Title="{Binding Source='No Benchmark Results Yet', Converter={StaticResource TranslationConverter}}"
                                        Description="{Binding Source='Run the DNS benchmark to test latency across popular public DNS resolvers.', Converter={StaticResource TranslationConverter}}" />

                                    <!-- SECTION 3: DOH SETTINGS STRIP -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,10">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="DNS over HTTPS (DoH) Encryption" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Source='Encrypt all DNS queries with TLS to prevent ISP tracking and website blocking.', Converter={StaticResource TranslationConverter}}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <ComboBox x:Name="CmbDohProvider"
                                                      Grid.Column="1"
                                                      Width="140"
                                                      Height="34"
                                                      VerticalAlignment="Center" />

                                            <Button Grid.Column="2"
                                                    Click="OnApplyDohClick"
                                                    Style="{StaticResource DefaultButtonStyle}"
                                                    Padding="12,6"
                                                    CornerRadius="6"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Source='Apply DoH', Converter={StaticResource TranslationConverter}}" FontSize="11.5" FontWeight="SemiBold" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </PivotItem>

            <!-- ==================== TAB 3: APP SOCKETS & TRAFFIC ==================== -->
            <PivotItem Header="App Sockets &amp; Traffic" Margin="0" Padding="0">
                <Grid RowSpacing="12" Margin="0,10,0,10" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- 0. Filter Bar -->
                        <RowDefinition Height="*" />    <!-- 1. Sockets Table -->
                    </Grid.RowDefinitions>

                    <!-- Filter Bar -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Filter Chips -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Content="{Binding Source='All', Converter={StaticResource TranslationConverter}}" Click="OnFilterSocketCategoryClick" Tag="All" Style="{StaticResource DefaultButtonStyle}" CornerRadius="6" Padding="12,5" FontSize="11.5" />
                            <Button Content="{Binding Source='Established', Converter={StaticResource TranslationConverter}}" Click="OnFilterSocketCategoryClick" Tag="Established" Style="{StaticResource DefaultButtonStyle}" CornerRadius="6" Padding="12,5" FontSize="11.5" />
                            <Button Content="{Binding Source='Listening', Converter={StaticResource TranslationConverter}}" Click="OnFilterSocketCategoryClick" Tag="Listening" Style="{StaticResource DefaultButtonStyle}" CornerRadius="6" Padding="12,5" FontSize="11.5" />
                            <Button Content="TCP" Click="OnFilterSocketCategoryClick" Tag="TCP" Style="{StaticResource DefaultButtonStyle}" CornerRadius="6" Padding="12,5" FontSize="11.5" />
                            <Button Content="UDP" Click="OnFilterSocketCategoryClick" Tag="UDP" Style="{StaticResource DefaultButtonStyle}" CornerRadius="6" Padding="12,5" FontSize="11.5" />
                        </StackPanel>

                        <!-- Search Box -->
                        <TextBox Grid.Column="1"
                                 Text="{x:Bind ViewModel.ConnectionSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="{Binding Source='Search process, IP or port...', Converter={StaticResource TranslationConverter}}"
                                 Margin="16,0"
                                 Height="34"
                                 FontSize="12"
                                 CornerRadius="6" />

                        <!-- Socket Count & Refresh -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="10,6">
                                <TextBlock Text="{x:Bind FormatConnectionCount(ViewModel.ActiveConnectionsCount), Mode=OneWay}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Typography.NumeralAlignment="Tabular" />
                            </Border>

                            <Button Click="OnRefreshSocketsClick" Style="{StaticResource DefaultButtonStyle}" CornerRadius="6" Padding="10,6" AutomationProperties.Name="Refresh connections" ToolTipService.ToolTip="{Binding Source='Refresh connections', Converter={StaticResource TranslationConverter}}">
                                <FontIcon Glyph="&#xE72C;" FontSize="11.5" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Sockets Virtualized List with Sticky Header -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Table Header -->
                            <Grid Grid.Row="0" Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Source='Process / PID', Converter={StaticResource TranslationConverter}}" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Source='Protocol', Converter={StaticResource TranslationConverter}}" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding Source='Local Address', Converter={StaticResource TranslationConverter}}" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{Binding Source='Remote Address', Converter={StaticResource TranslationConverter}}" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="4" Text="{Binding Source='Status', Converter={StaticResource TranslationConverter}}" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="5" Text="{Binding Source='Action', Converter={StaticResource TranslationConverter}}" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,10,0" />
                            </Grid>

                            <!-- Virtualized Sockets -->
                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Connections, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ActiveConnectionInfo">
                                        <Border Padding="10,7" Margin="0,2" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.2*" />
                                                    <ColumnDefinition Width="0.8*" />
                                                    <ColumnDefinition Width="2.2*" />
                                                    <ColumnDefinition Width="2.2*" />
                                                    <ColumnDefinition Width="1.4*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Process & PID -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE756;" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" />
                                                    <TextBlock Text="{x:Bind ProcessName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Pid}" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Typography.NumeralAlignment="Tabular" />
                                                </StackPanel>

                                                <!-- Protocol -->
                                                <Border Grid.Column="1" Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Protocol}" FontSize="10.5" FontWeight="Bold" />
                                                </Border>

                                                <!-- Local Address -->
                                                <TextBlock Grid.Column="2" Text="{x:Bind LocalAddress}" FontSize="11.5" FontFamily="Segoe UI Variable Text" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                <!-- Remote Address -->
                                                <TextBlock Grid.Column="3" Text="{x:Bind RemoteAddress}" FontSize="11.5" FontFamily="Segoe UI Variable Text" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                <!-- State -->
                                                <TextBlock Grid.Column="4" Text="{x:Bind State}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource AppStatusGoodBrush}" TextTrimming="CharacterEllipsis" />

                                                <!-- Action Buttons -->
                                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
                                                    <Button Click="OnCopySocketClick" Style="{StaticResource DefaultButtonStyle}" Padding="6,4" AutomationProperties.Name="Copy socket info" ToolTipService.ToolTip="{Binding Source='Copy socket info', Converter={StaticResource TranslationConverter}}">
                                                        <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                                    </Button>
                                                    <Button Click="OnOpenProcessLocationClick" Style="{StaticResource DefaultButtonStyle}" Padding="6,4" AutomationProperties.Name="Open file location" ToolTipService.ToolTip="{Binding Source='Open file location', Converter={StaticResource TranslationConverter}}">
                                                        <FontIcon Glyph="&#xE8DA;" FontSize="11" />
                                                    </Button>
                                                    <Button Click="OnKillProcessClick" Style="{StaticResource DestructiveButtonStyle}" Padding="6,4" AutomationProperties.Name="Close connection / End process" ToolTipService.ToolTip="{Binding Source='Close connection / End process', Converter={StaticResource TranslationConverter}}">
                                                        <FontIcon Glyph="&#xE711;" FontSize="11" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <controls:EmptyStateCard
                                Grid.Row="1"
                                Visibility="{x:Bind EmptyStateVisibility(ViewModel.Connections.Count, ViewModel.IsBusy), Mode=OneWay}"
                                IconGlyph="&#xE968;"
                                Title="{Binding Source='No Active Sockets Detected', Converter={StaticResource TranslationConverter}}"
                                Description="{Binding Source='No active TCP or UDP socket connections match the current filter.', Converter={StaticResource TranslationConverter}}" />
                        </Grid>
                    </Border>
                </Grid>
            </PivotItem>

            <!-- ==================== TAB 4: SELF-HEALING & TOOLS ==================== -->
            <PivotItem Header="Self-Healing &amp; Tools" Margin="0" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,10,0,20">
                    <Grid HorizontalAlignment="Stretch">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch">

                            <!-- SECTION 1: 1-CLICK RESCUE SUITE -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE90F;" FontSize="15" Foreground="{ThemeResource SystemAccentColor}" />
                                            <TextBlock Text="Network Rescue &amp; Reset" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Text="1-Click tools to fix socket stalls, corrupted resolver cache, and IP lease failures."
                                                   FontSize="12.5"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Restart Warning Banner (Shared AuraAlertBanner, Rule 09 Localized) -->
                                    <controls:AuraAlertBanner IsOpen="{x:Bind ViewModel.RequiresRestart, Mode=OneWay}"
                                                              Severity="Warning"
                                                              IsClosable="False"
                                                              Title="{Binding Source='Restart Required', Converter={StaticResource TranslationConverter}}"
                                                              Message="{Binding Source='Please restart your computer to complete the Winsock and TCP/IP stack reset.', Converter={StaticResource TranslationConverter}}" />

                                    <!-- 8 Action Buttons Grid (2 rows x 4 columns) -->
                                    <Grid ColumnSpacing="12" RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 1. Flush DNS/ARP -->
                                        <Button Grid.Row="0" Grid.Column="0"
                                                Click="OnRepairTileClick" Tag="flushdns"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                HorizontalAlignment="Stretch" CornerRadius="8" Padding="12,10">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Background="{ThemeResource AppStatusCyanBackground}" CornerRadius="6" Width="32" Height="32" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE749;" FontSize="14" Foreground="{ThemeResource AppStatusCyanBrush}" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{Binding Source='Flush DNS Cache', Converter={StaticResource TranslationConverter}}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="ipconfig /flushdns" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>

                                        <!-- 2. Renew IP -->
                                        <Button Grid.Row="0" Grid.Column="1"
                                                Click="OnRepairTileClick" Tag="renewdhcp"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                HorizontalAlignment="Stretch" CornerRadius="8" Padding="12,10">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Background="{ThemeResource AppStatusGoodBackground}" CornerRadius="6" Width="32" Height="32" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE72C;" FontSize="14" Foreground="{ThemeResource AppStatusGoodBrush}" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{Binding Source='Renew IP Address', Converter={StaticResource TranslationConverter}}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="release &amp; renew" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>

                                        <!-- 3. Reset Winsock -->
                                        <Button Grid.Row="0" Grid.Column="2"
                                                Click="OnRepairTileClick" Tag="resetwinsock"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                HorizontalAlignment="Stretch" CornerRadius="8" Padding="12,10">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Background="{ThemeResource AppStatusWarningBackground}" CornerRadius="6" Width="32" Height="32" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource AppStatusWarningBrush}" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{Binding Source='Reset Winsock', Converter={StaticResource TranslationConverter}}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="netsh winsock reset" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>

                                        <!-- 4. Reset TCP/IP Stack -->
                                        <Button Grid.Row="0" Grid.Column="3"
                                                Click="OnRepairTileClick" Tag="resettcpip"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                HorizontalAlignment="Stretch" CornerRadius="8" Padding="12,10">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Background="{ThemeResource AppStatusDangerBackground}" CornerRadius="6" Width="32" Height="32" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE9D9;" FontSize="14" Foreground="{ThemeResource AppStatusDangerBrush}" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{Binding Source='Reset TCP/IP', Converter={StaticResource TranslationConverter}}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="netsh int ip reset" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>

                                        <!-- 5. Reset Firewall -->
                                        <Button Grid.Row="1" Grid.Column="0"
                                                Click="OnRepairTileClick" Tag="resetfirewall"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                HorizontalAlignment="Stretch" CornerRadius="8" Padding="12,10">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Background="{ThemeResource AppStatusPurpleBackground}" CornerRadius="6" Width="32" Height="32" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE727;" FontSize="14" Foreground="{ThemeResource AppStatusPurpleBrush}" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{Binding Source='Reset Firewall', Converter={StaticResource TranslationConverter}}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="advfirewall reset" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>

                                        <!-- 6. Reset Hosts File -->
                                        <Button Grid.Row="1" Grid.Column="1"
                                                Click="OnRepairTileClick" Tag="resethosts"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                HorizontalAlignment="Stretch" CornerRadius="8" Padding="12,10">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Background="{ThemeResource AppStatusInfoBackground}" CornerRadius="6" Width="32" Height="32" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="{ThemeResource AppStatusInfoBrush}" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{Binding Source='Restore Hosts', Converter={StaticResource TranslationConverter}}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Source='Default localhost', Converter={StaticResource TranslationConverter}}" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>

                                        <!-- 7. Restart Adapter -->
                                        <Button Grid.Row="1" Grid.Column="2"
                                                Click="OnRepairTileClick" Tag="restartadapter"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                HorizontalAlignment="Stretch" CornerRadius="8" Padding="12,10">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Background="{ThemeResource AppStatusGoodBackground}" CornerRadius="6" Width="32" Height="32" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE839;" FontSize="14" Foreground="{ThemeResource AppStatusGoodBrush}" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{Binding Source='Restart Adapter', Converter={StaticResource TranslationConverter}}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="Restart-NetAdapter" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>

                                        <!-- 8. Optimize TCP AutoTuning -->
                                        <Button Grid.Row="1" Grid.Column="3"
                                                Click="OnRepairTileClick" Tag="optimizetcp"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                HorizontalAlignment="Stretch" CornerRadius="8" Padding="12,10">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Background="{ThemeResource AppStatusCyanBackground}" CornerRadius="6" Width="32" Height="32" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource AppStatusCyanBrush}" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{Binding Source='Optimize TCP Window', Converter={StaticResource TranslationConverter}}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="autotuning=normal" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Repair Status Message -->
                                    <TextBlock Text="{x:Bind ViewModel.RepairStatusMessage, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{x:Bind ViewModel.RepairStatusMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>

                            <!-- SECTION 2: INTERACTIVE DIAGNOSTIC SUITE & CONSOLE -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="340" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: Interactive Tools & Triggers -->
                                <Border Grid.Column="0"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16">
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE9D9;" FontSize="14" Foreground="{ThemeResource SystemAccentColor}" />
                                            <TextBlock Text="{Binding Source='Deep Diagnostic Tools', Converter={StaticResource TranslationConverter}}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Target Host Input -->
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Source='Target Host Address:', Converter={StaticResource TranslationConverter}}" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBox Text="{x:Bind ViewModel.TestHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     KeyDown="OnHostKeyDown"
                                                     PlaceholderText="{Binding Source='Enter host (e.g. 8.8.8.8, google.com)...', Converter={StaticResource TranslationConverter}}"
                                                     Height="34"
                                                     FontSize="12"
                                                     CornerRadius="6" />
                                        </StackPanel>

                                        <!-- Port Scanner Ports Input -->
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Source='Port Scanner List:', Converter={StaticResource TranslationConverter}}" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBox Text="{x:Bind ViewModel.PortScannerPorts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     PlaceholderText="80,443,3389,8080"
                                                     Height="34"
                                                     FontSize="12"
                                                     CornerRadius="6" />
                                        </StackPanel>

                                        <!-- 4 Utility Buttons Grid -->
                                        <Grid ColumnSpacing="8" RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Row="0" Grid.Column="0" Click="OnPingClick" Style="{StaticResource DefaultButtonStyle}" Height="34" HorizontalAlignment="Stretch" CornerRadius="6">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8B7;" FontSize="11.5" Foreground="{ThemeResource AppStatusGoodBrush}" />
                                                    <TextBlock Text="{Binding Source='Ping Test', Converter={StaticResource TranslationConverter}}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>

                                            <Button Grid.Row="0" Grid.Column="1" Click="OnTraceClick" Style="{StaticResource DefaultButtonStyle}" Height="34" HorizontalAlignment="Stretch" CornerRadius="6">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE756;" FontSize="11.5" Foreground="{ThemeResource AppStatusPurpleBrush}" />
                                                    <TextBlock Text="Traceroute" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>

                                            <Button Grid.Row="1" Grid.Column="0" Click="OnDnsLookupClick" Style="{StaticResource DefaultButtonStyle}" Height="34" HorizontalAlignment="Stretch" CornerRadius="6">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xEC1B;" FontSize="11.5" Foreground="{ThemeResource AppStatusCyanBrush}" />
                                                    <TextBlock Text="DNS Lookup" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>

                                            <Button Grid.Row="1" Grid.Column="1" Click="OnPortScanClick" Style="{StaticResource DefaultButtonStyle}" Height="34" HorizontalAlignment="Stretch" CornerRadius="6">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE71E;" FontSize="11.5" Foreground="{ThemeResource AppStatusWarningBrush}" />
                                                    <TextBlock Text="{Binding Source='Port Scan', Converter={StaticResource TranslationConverter}}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Smart Auto-Heal Button -->
                                        <Button Click="OnRepairTileClick" Tag="smartrepair"
                                                Style="{StaticResource AccentButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                Height="38"
                                                CornerRadius="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE945;" FontSize="13" />
                                                <TextBlock Text="{Binding Source='Smart Auto-Repair (5 Steps)', Converter={StaticResource TranslationConverter}}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Right: Live Terminal Console Output -->
                                <Border Grid.Column="1"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        MinHeight="320">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Console Header -->
                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE756;" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" />
                                                <TextBlock Text="{Binding Source='Live Terminal Console', Converter={StaticResource TranslationConverter}}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Button Click="OnCopyConsoleClick" Style="{StaticResource DefaultButtonStyle}" Height="28" Padding="8,0" CornerRadius="4" AutomationProperties.Name="Copy console log" ToolTipService.ToolTip="{Binding Source='Copy console log', Converter={StaticResource TranslationConverter}}">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                                </Button>
                                                <Button Click="OnClearConsoleClick" Style="{StaticResource DefaultButtonStyle}" Height="28" Padding="8,0" CornerRadius="4" AutomationProperties.Name="Clear console" ToolTipService.ToolTip="{Binding Source='Clear console', Converter={StaticResource TranslationConverter}}">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Console Terminal Output -->
                                        <Border Grid.Row="1"
                                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10">
                                            <ScrollViewer x:Name="TerminalScrollViewer"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <TextBlock Text="{x:Bind ViewModel.ConsoleOutput, Mode=OneWay}"
                                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                                           FontSize="11.5"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                           TextWrapping="Wrap"
                                                           IsTextSelectionEnabled="True"
                                                           LineHeight="17" />
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
    </Grid>
</Page>
