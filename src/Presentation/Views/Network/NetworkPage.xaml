<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinCarePro.Models"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24,18" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0. Header & Action Bar -->
            <RowDefinition Height="*" />    <!-- 1. Pivot Workspace -->
        </Grid.RowDefinitions>

        <!-- ==================== 0. FLAT HEADER & ACTION BAR ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Top Edge Thin Progress Bar (Visible during Ping measurement, DNS switch, Winsock reset) -->
            <ProgressBar Grid.ColumnSpan="2"
                         VerticalAlignment="Bottom"
                         Margin="0,0,0,-10"
                         IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Height="2.5"
                         CornerRadius="1.25"
                         Foreground="{StaticResource PrimaryAccentBrush}"
                         HorizontalAlignment="Stretch"/>

            <!-- Left: Title & Subtitle -->
            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="{StaticResource PrimaryAccentLightBrush}" CornerRadius="6" Padding="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE968;" FontSize="18" Foreground="{StaticResource PrimaryAccentBrush}" />
                    </Border>
                    <TextBlock Text="Network Center &amp; Diagnostics"
                               Style="{StaticResource PageHeaderTitleStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Network telemetry, DNS speed &amp; TCP/IP repairs."
                           Style="{StaticResource PageHeaderSubtitleStyle}" />
            </StackPanel>

            <!-- Right: Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Export Audit Report -->
                <Button Click="OnExportReportClick"
                        IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}"
                        Style="{StaticResource DefaultButtonStyle}"
                        CornerRadius="8"
                        Padding="12,7"
                        FontSize="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEDE1;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Xuất báo cáo" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <!-- Refresh Button -->
                <Button Click="OnRefreshClick"
                        Style="{StaticResource AccentButtonStyle}"
                        CornerRadius="8"
                        Padding="14,7"
                        FontSize="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        <TextBlock Text="Làm mới" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== 1. MAIN TABBED WORKSPACE ==================== -->
        <Pivot x:Name="MainPivot"
               Grid.Row="1"
               Margin="0,-4,0,0"
               SelectionChanged="OnPivotSelectionChanged">
            <Pivot.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,10,0" />
                </DataTemplate>
            </Pivot.HeaderTemplate>

            <!-- ==================== TAB 1: BANDWIDTH & RADAR ==================== -->
            <PivotItem Header="Bandwidth &amp; Radar" Margin="0" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,10,0,20">
                    <Grid HorizontalAlignment="Stretch">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch">

                            <!-- SECTION 1: ACTIVE CONNECTION DETAILS -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="18">
                                <StackPanel Spacing="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE839;" FontSize="15" Foreground="{ThemeResource SystemAccentColor}" />
                                            <TextBlock Text="Active Network Connection" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Online Status Pill -->
                                        <Border Grid.Column="1"
                                                Background="{ThemeResource AppStatusGoodBackground}"
                                                BorderBrush="{ThemeResource AppStatusGoodBorder}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,4"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="6" Height="6" Fill="{ThemeResource AppStatusGoodBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind ViewModel.ActiveAdapterName, Mode=OneWay}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource AppStatusGoodBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="180" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- 4 Adapter Detail Cards -->
                                    <Grid ColumnSpacing="12" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Cell 1: Adapter Name & Type -->
                                        <Border Grid.Column="0"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,10">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Card mạng" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.ActiveAdapterName, Mode=OneWay}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind ViewModel.AdapterType, Mode=OneWay}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Cell 2: IPv4 & Subnet -->
                                        <Border Grid.Column="1"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,10">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Địa chỉ IPv4" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.Ipv4Address, Mode=OneWay}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Typography.NumeralAlignment="Tabular"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind ViewModel.SubnetMask, Mode=OneWay}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           Typography.NumeralAlignment="Tabular"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Cell 3: Gateway & MAC -->
                                        <Border Grid.Column="2"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,10">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Cổng mặc định (Gateway)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind ViewModel.GatewayAddress, Mode=OneWay}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Typography.NumeralAlignment="Tabular"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind ViewModel.MacAddress, Mode=OneWay}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           Typography.NumeralAlignment="Tabular"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Cell 4: Current DNS -->
                                        <Border Grid.Column="3"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,10">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Máy chủ DNS hiện tại" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind ViewModel.CurrentDnsDisplay, Mode=OneWay}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Typography.NumeralAlignment="Tabular"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="Bộ giải quyết đang hoạt động"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Sub-Card: On-Demand Diagnostics (Ping Test) -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,10">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE9D9;" FontSize="13" Foreground="{ThemeResource SystemAccentColor}" />
                                                    <TextBlock Text="Chẩn đoán kết nối tức thì (On-Demand Diagnostics)" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="—" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" />
                                                    <TextBlock Text="{x:Bind ViewModel.DiagnosticsStatusText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- 3 Latency Badges -->
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="4" Padding="8,4">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="Gateway:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{x:Bind ViewModel.GatewayLatencyText, Mode=OneWay}"
                                                                       FontSize="11.5"
                                                                       FontWeight="Bold"
                                                                       Typography.NumeralAlignment="Tabular" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="4" Padding="8,4">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="Cloudflare (1.1.1.1):" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{x:Bind ViewModel.CloudflareLatencyText, Mode=OneWay}"
                                                                       FontSize="11.5"
                                                                       FontWeight="Bold"
                                                                       Typography.NumeralAlignment="Tabular"
                                                                       Foreground="{ThemeResource AppStatusCyanBrush}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="4" Padding="8,4">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="Google (8.8.8.8):" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{x:Bind ViewModel.GoogleLatencyText, Mode=OneWay}"
                                                                       FontSize="11.5"
                                                                       FontWeight="Bold"
                                                                       Typography.NumeralAlignment="Tabular"
                                                                       Foreground="{ThemeResource AppStatusGoodBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Check Button -->
                                            <Button Grid.Column="1"
                                                    Command="{x:Bind ViewModel.RunOnDemandDiagnosticsCommand}"
                                                    Style="{StaticResource DefaultButtonStyle}"
                                                    CornerRadius="8"
                                                    Padding="14,7"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <ProgressRing IsActive="{x:Bind ViewModel.IsDiagnosing, Mode=OneWay}"
                                                                  Visibility="{x:Bind ViewModel.IsDiagnosing, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                  Width="13"
                                                                  Height="13" />
                                                    <FontIcon Glyph="&#xE768;"
                                                              FontSize="12"
                                                              Visibility="{x:Bind ViewModel.IsDiagnosing, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                    <TextBlock Text="Kiểm tra" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 2: BANDWIDTH QUALITY & RADAR METRICS -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Latency -->
                                <Border Grid.Column="0"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Độ trễ (Ping)" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind FormatMs(ViewModel.LatencyMs), Mode=OneWay}"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource AppStatusGoodBrush}"
                                                       Typography.NumeralAlignment="Tabular" />
                                            <TextBlock Text="Thời gian phản hồi" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{ThemeResource AppStatusGoodBackground}" CornerRadius="6" Padding="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE701;" FontSize="16" Foreground="{ThemeResource AppStatusGoodBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Jitter -->
                                <Border Grid.Column="1"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Độ ổn định (Jitter)" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind FormatMs(ViewModel.JitterMs), Mode=OneWay}"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource AppStatusPurpleBrush}"
                                                       Typography.NumeralAlignment="Tabular" />
                                            <TextBlock Text="Biến thiên bộ đệm" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{ThemeResource AppStatusPurpleBackground}" CornerRadius="6" Padding="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE945;" FontSize="16" Foreground="{ThemeResource AppStatusPurpleBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Packet Loss -->
                                <Border Grid.Column="2"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Mất gói tin" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind FormatPercent(ViewModel.PacketLossPercent), Mode=OneWay}"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource AppStatusWarningBrush}"
                                                       Typography.NumeralAlignment="Tabular" />
                                            <TextBlock Text="Tỷ lệ khung hình rơi" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{ThemeResource AppStatusWarningBackground}" CornerRadius="6" Padding="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource AppStatusWarningBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Health Score -->
                                <Border Grid.Column="3"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Điểm sức khỏe AI" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <TextBlock Text="{x:Bind ViewModel.NetworkHealthScore, Mode=OneWay}"
                                                           FontSize="22"
                                                           FontWeight="Bold"
                                                           Foreground="{ThemeResource AppStatusCyanBrush}"
                                                           Typography.NumeralAlignment="Tabular" />
                                                <TextBlock Text="/100" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.ConnectionQuality, Mode=OneWay}" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{ThemeResource AppStatusCyanBackground}" CornerRadius="6" Padding="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="{ThemeResource AppStatusCyanBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- SECTION 3: SPEED TEST COCKPIT -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20">
                                <StackPanel Spacing="16">
                                    <!-- Card Header: Title Left + Start Button & Status Right -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Title -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8B9;" FontSize="15" Foreground="{ThemeResource SystemAccentColor}" />
                                            <TextBlock Text="Speed Test &amp; Bandwidth Gauge" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Controls Right: Phase Pill + Start Button -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ViewModel.SpeedTestPhase, Mode=OneWay}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>

                                            <Button Click="OnStartSpeedTestClick"
                                                    IsEnabled="{x:Bind IsNot(ViewModel.IsSpeedTesting), Mode=OneWay}"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    CornerRadius="6"
                                                    Padding="14,6"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <ProgressRing IsActive="{x:Bind ViewModel.IsSpeedTesting, Mode=OneWay}"
                                                                  Visibility="{x:Bind ViewModel.IsSpeedTesting, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                  Width="13"
                                                                  Height="13"
                                                                  Foreground="White" />
                                                    <FontIcon Glyph="&#xE768;"
                                                              FontSize="12"
                                                              Visibility="{x:Bind ViewModel.IsSpeedTesting, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                    <TextBlock Text="Bắt đầu đo" FontSize="12" FontWeight="Bold" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Large Speed Readout Strip -->
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind FormatSpeedValue(ViewModel.DisplaySpeed), Mode=OneWay}"
                                                   FontSize="42"
                                                   FontWeight="ExtraBold"
                                                   Typography.NumeralAlignment="Tabular"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <StackPanel VerticalAlignment="Center" Spacing="0">
                                            <TextBlock Text="{x:Bind FormatSpeedUnit(ViewModel.DisplaySpeed), Mode=OneWay}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.DisplaySpeedLabel, Mode=OneWay}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Progress Bar -->
                                    <ProgressBar Value="{x:Bind ViewModel.SpeedProgress, Mode=OneWay}"
                                                 Maximum="100"
                                                 Height="6"
                                                 CornerRadius="3" />

                                    <!-- 4 Stat Cells: Download, Upload, Ping, Public IP -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1.2*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Tải xuống" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind FormatMbps(ViewModel.DownloadSpeed), Mode=OneWay}"
                                                           FontSize="13.5" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource AppStatusGoodBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Tải lên" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind FormatMbps(ViewModel.UploadSpeed), Mode=OneWay}"
                                                           FontSize="13.5" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource AppStatusPurpleBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Độ trễ" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind FormatMs(ViewModel.LatencyMs), Mode=OneWay}"
                                                           FontSize="13.5" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource AppStatusCyanBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="IP Công cộng" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind ViewModel.PublicIpAddress, Mode=OneWay}"
                                                               FontSize="12.5" FontWeight="Bold" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Click="OnCopyPublicIpClick" Style="{StaticResource DefaultButtonStyle}" Padding="6,4" VerticalAlignment="Center" AutomationProperties.Name="Sao chép IP công cộng" ToolTipService.ToolTip="Sao chép IP công cộng">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </PivotItem>

            <!-- ==================== TAB 2: DNS INTELLIGENCE ==================== -->
            <PivotItem Header="DNS Intelligence" Margin="0" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,10,0,20">
                    <Grid HorizontalAlignment="Stretch">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch">

                            <!-- SECTION 1: SECURE DNS SWITCHER -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE774;" FontSize="15" Foreground="{ThemeResource SystemAccentColor}" />
                                            <TextBlock Text="Secure DNS Switcher" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Text="Fast and secure DNS switching for optimal speed and privacy."
                                                   FontSize="12.5"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- DNS Controls Row -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MaxWidth="440" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- DNS Selector ComboBox -->
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Bind ViewModel.DnsProfiles}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedDnsProfile, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="8"
                                                  Height="38">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:DnsProfileOption">
                                                    <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,2">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" />
                                                        <TextBlock Text="{x:Bind Description}"
                                                                   FontSize="11.5"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- Apply Button -->
                                        <Button Grid.Column="1"
                                                Command="{x:Bind ViewModel.ApplySelectedDnsCommand}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Height="38"
                                                Padding="16,0"
                                                CornerRadius="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ProgressRing IsActive="{x:Bind ViewModel.IsApplyingDns, Mode=OneWay}"
                                                              Visibility="{x:Bind ViewModel.IsApplyingDns, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                              Width="14"
                                                              Height="14"
                                                              Foreground="White" />
                                                <FontIcon Glyph="&#xE73E;"
                                                          FontSize="13"
                                                          Visibility="{x:Bind ViewModel.IsApplyingDns, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                <TextBlock Text="Áp dụng" FontSize="13" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Restore DHCP Button -->
                                        <Button Grid.Column="2"
                                                Command="{x:Bind ViewModel.RestoreDhcpDnsCommand}"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                Height="38"
                                                Padding="14,0"
                                                CornerRadius="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                                <TextBlock Text="Khôi phục DHCP" FontSize="13" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Revert Backup Button -->
                                        <Button Grid.Column="3"
                                                Command="{x:Bind ViewModel.RestoreDnsBackupCommand}"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                Height="38"
                                                Padding="14,0"
                                                CornerRadius="8"
                                                Visibility="{x:Bind ViewModel.HasDnsBackup, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE7A7;" FontSize="13" />
                                                <TextBlock Text="Hoàn tác DNS" FontSize="13" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- DNS Status Message -->
                                    <TextBlock Text="{x:Bind ViewModel.DnsStatusMessage, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{x:Bind ViewModel.DnsStatusMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>

                            <!-- SECTION 2: DNS BENCHMARK MATRIX -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20">
                                <StackPanel Spacing="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xEC1B;" FontSize="15" Foreground="{ThemeResource SystemAccentColor}" />
                                                <TextBlock Text="DNS Query Latency Benchmark &amp; Optimization" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Text="Direct UDP port 53 resolution benchmark across global resolver networks."
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <!-- Switch to Fastest Button -->
                                            <Button Click="OnSwitchToFastestDnsClick"
                                                    IsEnabled="{x:Bind IsNot(ViewModel.IsBenchmarkingDns), Mode=OneWay}"
                                                    Style="{StaticResource DefaultButtonStyle}"
                                                    CornerRadius="8"
                                                    Padding="12,7">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AppStatusGoodBrush}" />
                                                    <TextBlock Text="Áp dụng DNS nhanh nhất" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Start Benchmark Button -->
                                            <Button Click="OnStartDnsBenchmarkClick"
                                                    IsEnabled="{x:Bind IsNot(ViewModel.IsBenchmarkingDns), Mode=OneWay}"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    CornerRadius="8"
                                                    Padding="14,7">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <ProgressRing IsActive="{x:Bind ViewModel.IsBenchmarkingDns, Mode=OneWay}"
                                                                  Visibility="{x:Bind ViewModel.IsBenchmarkingDns, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                  Width="13" Height="13" Foreground="White" />
                                                    <FontIcon Glyph="&#xE768;" FontSize="12"
                                                              Visibility="{x:Bind ViewModel.IsBenchmarkingDns, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                    <TextBlock Text="Bắt đầu đo DNS" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Fastest DNS Badge -->
                                    <Border Background="{ThemeResource AppStatusGoodBackground}"
                                            BorderBrush="{ThemeResource AppStatusGoodBorder}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="14,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="DNS nhanh nhất:" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource AppStatusGoodBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.FastestDnsText, Mode=OneWay}" FontSize="12.5" FontWeight="Bold" Foreground="{ThemeResource AppStatusGoodBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="Độ trễ truy vấn thấp giúp web tải tức thì và giảm lag trong trò chơi trực tuyến." FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>

                                    <!-- DNS Servers List -->
                                    <ListView ItemsSource="{x:Bind ViewModel.DnsServers, Mode=OneWay}" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:DnsServerInfo">
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="14,10"
                                                        Margin="0,0,0,8">
                                                    <Grid ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Name & Provider -->
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind Provider}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <!-- IPs -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock Text="{x:Bind PrimaryIp}" FontSize="12" FontFamily="Segoe UI Variable Text" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind SecondaryIp}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <!-- Ping Badge -->
                                                        <Border Grid.Column="2"
                                                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                                CornerRadius="4"
                                                                Padding="10,4"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind LatencyFormatted}"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       Typography.NumeralAlignment="Tabular"
                                                                       Foreground="{ThemeResource AppStatusGoodBrush}" />
                                                        </Border>

                                                        <!-- Apply Button -->
                                                        <Button Grid.Column="3"
                                                                Click="OnApplyDnsServerClick"
                                                                Style="{StaticResource DefaultButtonStyle}"
                                                                Padding="12,5"
                                                                CornerRadius="6"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="Áp dụng" FontSize="11.5" FontWeight="SemiBold" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <!-- SECTION 3: DOH SETTINGS STRIP -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,10">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="DNS over HTTPS (DoH) Encryption" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="Mã hóa mọi truy vấn DNS bằng TLS ngăn chặn nhà mạng theo dõi và chặn trang web."
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <ComboBox x:Name="CmbDohProvider"
                                                      Grid.Column="1"
                                                      Width="140"
                                                      Height="34"
                                                      VerticalAlignment="Center" />

                                            <Button Grid.Column="2"
                                                    Click="OnApplyDohClick"
                                                    Style="{StaticResource DefaultButtonStyle}"
                                                    Padding="12,6"
                                                    CornerRadius="6"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="Áp dụng DoH" FontSize="11.5" FontWeight="SemiBold" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </PivotItem>

            <!-- ==================== TAB 3: APP SOCKETS & TRAFFIC ==================== -->
            <PivotItem Header="App Sockets &amp; Traffic" Margin="0" Padding="0">
                <Grid RowSpacing="12" Margin="0,10,0,10" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- 0. Filter Bar -->
                        <RowDefinition Height="*" />    <!-- 1. Sockets Table -->
                    </Grid.RowDefinitions>

                    <!-- Filter Bar -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Filter Chips -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Content="Tất cả" Click="OnFilterSocketCategoryClick" Tag="All" Style="{StaticResource DefaultButtonStyle}" CornerRadius="6" Padding="12,5" FontSize="11.5" />
                            <Button Content="Đang kết nối" Click="OnFilterSocketCategoryClick" Tag="Established" Style="{StaticResource DefaultButtonStyle}" CornerRadius="6" Padding="12,5" FontSize="11.5" />
                            <Button Content="Đang lắng nghe" Click="OnFilterSocketCategoryClick" Tag="Listening" Style="{StaticResource DefaultButtonStyle}" CornerRadius="6" Padding="12,5" FontSize="11.5" />
                            <Button Content="TCP" Click="OnFilterSocketCategoryClick" Tag="TCP" Style="{StaticResource DefaultButtonStyle}" CornerRadius="6" Padding="12,5" FontSize="11.5" />
                            <Button Content="UDP" Click="OnFilterSocketCategoryClick" Tag="UDP" Style="{StaticResource DefaultButtonStyle}" CornerRadius="6" Padding="12,5" FontSize="11.5" />
                        </StackPanel>

                        <!-- Search Box -->
                        <TextBox Grid.Column="1"
                                 Text="{x:Bind ViewModel.ConnectionSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Tìm kiếm theo tiến trình, IP hoặc cổng..."
                                 Margin="16,0"
                                 Height="34"
                                 FontSize="12"
                                 CornerRadius="6" />

                        <!-- Socket Count & Refresh -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="10,6">
                                <TextBlock Text="{x:Bind FormatConnectionCount(ViewModel.ActiveConnectionsCount), Mode=OneWay}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Typography.NumeralAlignment="Tabular" />
                            </Border>

                            <Button Click="OnRefreshSocketsClick" Style="{StaticResource DefaultButtonStyle}" CornerRadius="6" Padding="10,6" AutomationProperties.Name="Làm mới danh sách socket" ToolTipService.ToolTip="Làm mới danh sách kết nối">
                                <FontIcon Glyph="&#xE72C;" FontSize="11.5" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Sockets Virtualized List with Sticky Header -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Table Header -->
                            <Grid Grid.Row="0" Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tiến trình / PID" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="Giao thức" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="Địa chỉ cục bộ" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Text="Địa chỉ từ xa" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="4" Text="Trạng thái" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="5" Text="Thao tác" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,10,0" />
                            </Grid>

                            <!-- Virtualized Sockets -->
                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Connections, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ActiveConnectionInfo">
                                        <Border Padding="10,7" Margin="0,2" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.2*" />
                                                    <ColumnDefinition Width="0.8*" />
                                                    <ColumnDefinition Width="2.2*" />
                                                    <ColumnDefinition Width="2.2*" />
                                                    <ColumnDefinition Width="1.4*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Process & PID -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE756;" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" />
                                                    <TextBlock Text="{x:Bind ProcessName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Pid}" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Typography.NumeralAlignment="Tabular" />
                                                </StackPanel>

                                                <!-- Protocol -->
                                                <Border Grid.Column="1" Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Protocol}" FontSize="10.5" FontWeight="Bold" />
                                                </Border>

                                                <!-- Local Address -->
                                                <TextBlock Grid.Column="2" Text="{x:Bind LocalAddress}" FontSize="11.5" FontFamily="Segoe UI Variable Text" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                <!-- Remote Address -->
                                                <TextBlock Grid.Column="3" Text="{x:Bind RemoteAddress}" FontSize="11.5" FontFamily="Segoe UI Variable Text" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                <!-- State -->
                                                <TextBlock Grid.Column="4" Text="{x:Bind State}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource AppStatusGoodBrush}" TextTrimming="CharacterEllipsis" />

                                                <!-- Action Buttons -->
                                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
                                                    <Button Click="OnCopySocketClick" Style="{StaticResource DefaultButtonStyle}" Padding="6,4" AutomationProperties.Name="Sao chép thông tin socket" ToolTipService.ToolTip="Sao chép thông tin socket">
                                                        <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                                    </Button>
                                                    <Button Click="OnOpenProcessLocationClick" Style="{StaticResource DefaultButtonStyle}" Padding="6,4" AutomationProperties.Name="Mở vị trí tệp tiến trình" ToolTipService.ToolTip="Mở vị trí tệp">
                                                        <FontIcon Glyph="&#xE8DA;" FontSize="11" />
                                                    </Button>
                                                    <Button Click="OnKillProcessClick" Style="{StaticResource DestructiveButtonStyle}" Padding="6,4" AutomationProperties.Name="Đóng kết nối socket" ToolTipService.ToolTip="Đóng kết nối / Dừng tiến trình">
                                                        <FontIcon Glyph="&#xE711;" FontSize="11" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </PivotItem>

            <!-- ==================== TAB 4: SELF-HEALING & TOOLS ==================== -->
            <PivotItem Header="Self-Healing &amp; Tools" Margin="0" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,10,0,20">
                    <Grid HorizontalAlignment="Stretch">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch">

                            <!-- SECTION 1: 1-CLICK RESCUE SUITE -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE90F;" FontSize="15" Foreground="{ThemeResource SystemAccentColor}" />
                                            <TextBlock Text="Network Rescue &amp; Reset" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Text="1-Click tools to fix socket stalls, corrupted resolver cache, and IP lease failures."
                                                   FontSize="12.5"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Restart Warning Banner -->
                                    <InfoBar IsOpen="{x:Bind ViewModel.RequiresRestart, Mode=OneWay}"
                                             Severity="Warning"
                                             IsClosable="False"
                                             Title="Yêu cầu khởi động lại máy"
                                             Message="Vui lòng khởi động lại máy tính để hoàn tất việc cài đặt lại ngăn xếp Winsock và TCP/IP." />

                                    <!-- 8 Action Buttons Grid (2 rows x 4 columns) -->
                                    <Grid ColumnSpacing="12" RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 1. Flush DNS/ARP -->
                                        <Button Grid.Row="0" Grid.Column="0"
                                                Click="OnRepairTileClick" Tag="flushdns"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                HorizontalAlignment="Stretch" CornerRadius="8" Padding="12,10">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Background="{ThemeResource AppStatusCyanBackground}" CornerRadius="6" Width="32" Height="32" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE749;" FontSize="14" Foreground="{ThemeResource AppStatusCyanBrush}" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="Xóa Cache DNS" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="ipconfig /flushdns" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>

                                        <!-- 2. Renew IP -->
                                        <Button Grid.Row="0" Grid.Column="1"
                                                Click="OnRepairTileClick" Tag="renewdhcp"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                HorizontalAlignment="Stretch" CornerRadius="8" Padding="12,10">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Background="{ThemeResource AppStatusGoodBackground}" CornerRadius="6" Width="32" Height="32" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE72C;" FontSize="14" Foreground="{ThemeResource AppStatusGoodBrush}" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="Cấp lại IP" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="release &amp; renew" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>

                                        <!-- 3. Reset Winsock -->
                                        <Button Grid.Row="0" Grid.Column="2"
                                                Click="OnRepairTileClick" Tag="resetwinsock"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                HorizontalAlignment="Stretch" CornerRadius="8" Padding="12,10">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Background="{ThemeResource AppStatusWarningBackground}" CornerRadius="6" Width="32" Height="32" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource AppStatusWarningBrush}" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="Đặt lại Winsock" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="netsh winsock reset" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>

                                        <!-- 4. Reset TCP/IP Stack -->
                                        <Button Grid.Row="0" Grid.Column="3"
                                                Click="OnRepairTileClick" Tag="resettcpip"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                HorizontalAlignment="Stretch" CornerRadius="8" Padding="12,10">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Background="{ThemeResource AppStatusDangerBackground}" CornerRadius="6" Width="32" Height="32" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE9D9;" FontSize="14" Foreground="{ThemeResource AppStatusDangerBrush}" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="Đặt lại TCP/IP" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="netsh int ip reset" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>

                                        <!-- 5. Reset Firewall -->
                                        <Button Grid.Row="1" Grid.Column="0"
                                                Click="OnRepairTileClick" Tag="resetfirewall"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                HorizontalAlignment="Stretch" CornerRadius="8" Padding="12,10">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Background="{ThemeResource AppStatusPurpleBackground}" CornerRadius="6" Width="32" Height="32" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE727;" FontSize="14" Foreground="{ThemeResource AppStatusPurpleBrush}" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="Đặt lại Firewall" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="advfirewall reset" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>

                                        <!-- 6. Reset Hosts File -->
                                        <Button Grid.Row="1" Grid.Column="1"
                                                Click="OnRepairTileClick" Tag="resethosts"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                HorizontalAlignment="Stretch" CornerRadius="8" Padding="12,10">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Background="{ThemeResource AppStatusInfoBackground}" CornerRadius="6" Width="32" Height="32" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="{ThemeResource AppStatusInfoBrush}" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="Khôi phục Hosts" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="Mặc định localhost" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>

                                        <!-- 7. Restart Adapter -->
                                        <Button Grid.Row="1" Grid.Column="2"
                                                Click="OnRepairTileClick" Tag="restartadapter"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                HorizontalAlignment="Stretch" CornerRadius="8" Padding="12,10">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Background="{ThemeResource AppStatusGoodBackground}" CornerRadius="6" Width="32" Height="32" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE839;" FontSize="14" Foreground="{ThemeResource AppStatusGoodBrush}" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="Khởi động Card mạng" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="Restart-NetAdapter" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>

                                        <!-- 8. Optimize TCP AutoTuning -->
                                        <Button Grid.Row="1" Grid.Column="3"
                                                Click="OnRepairTileClick" Tag="optimizetcp"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                HorizontalAlignment="Stretch" CornerRadius="8" Padding="12,10">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Background="{ThemeResource AppStatusCyanBackground}" CornerRadius="6" Width="32" Height="32" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource AppStatusCyanBrush}" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="Tối ưu TCP Window" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="autotuning=normal" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Repair Status Message -->
                                    <TextBlock Text="{x:Bind ViewModel.RepairStatusMessage, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{x:Bind ViewModel.RepairStatusMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>

                            <!-- SECTION 2: INTERACTIVE DIAGNOSTIC SUITE & CONSOLE -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="340" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: Interactive Tools & Triggers -->
                                <Border Grid.Column="0"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16">
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE9D9;" FontSize="14" Foreground="{ThemeResource SystemAccentColor}" />
                                            <TextBlock Text="Công cụ chẩn đoán chuyên sâu" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Target Host Input -->
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Địa chỉ máy chủ đích:" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBox Text="{x:Bind ViewModel.TestHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     KeyDown="OnHostKeyDown"
                                                     PlaceholderText="Nhập host (ví dụ: 8.8.8.8, google.com)..."
                                                     Height="34"
                                                     FontSize="12"
                                                     CornerRadius="6" />
                                        </StackPanel>

                                        <!-- Port Scanner Ports Input -->
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Danh sách cổng quét (Port Scanner):" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBox Text="{x:Bind ViewModel.PortScannerPorts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     PlaceholderText="80,443,3389,8080"
                                                     Height="34"
                                                     FontSize="12"
                                                     CornerRadius="6" />
                                        </StackPanel>

                                        <!-- 4 Utility Buttons Grid -->
                                        <Grid ColumnSpacing="8" RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Row="0" Grid.Column="0" Click="OnPingClick" Style="{StaticResource DefaultButtonStyle}" Height="34" HorizontalAlignment="Stretch" CornerRadius="6">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8B7;" FontSize="11.5" Foreground="{ThemeResource AppStatusGoodBrush}" />
                                                    <TextBlock Text="Kiểm tra Ping" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>

                                            <Button Grid.Row="0" Grid.Column="1" Click="OnTraceClick" Style="{StaticResource DefaultButtonStyle}" Height="34" HorizontalAlignment="Stretch" CornerRadius="6">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE756;" FontSize="11.5" Foreground="{ThemeResource AppStatusPurpleBrush}" />
                                                    <TextBlock Text="Traceroute" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>

                                            <Button Grid.Row="1" Grid.Column="0" Click="OnDnsLookupClick" Style="{StaticResource DefaultButtonStyle}" Height="34" HorizontalAlignment="Stretch" CornerRadius="6">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xEC1B;" FontSize="11.5" Foreground="{ThemeResource AppStatusCyanBrush}" />
                                                    <TextBlock Text="DNS Lookup" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>

                                            <Button Grid.Row="1" Grid.Column="1" Click="OnPortScanClick" Style="{StaticResource DefaultButtonStyle}" Height="34" HorizontalAlignment="Stretch" CornerRadius="6">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE71E;" FontSize="11.5" Foreground="{ThemeResource AppStatusWarningBrush}" />
                                                    <TextBlock Text="Quét Port" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Smart Auto-Heal Button -->
                                        <Button Click="OnRepairTileClick" Tag="smartrepair"
                                                Style="{StaticResource AccentButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                Height="38"
                                                CornerRadius="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE945;" FontSize="13" />
                                                <TextBlock Text="Tự động sửa chữa thông minh (5 bước)" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Right: Live Terminal Console Output -->
                                <Border Grid.Column="1"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        MinHeight="320">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Console Header -->
                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE756;" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" />
                                                <TextBlock Text="Bảng điều khiển nhật ký trực tiếp (Terminal Console)" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Button Click="OnCopyConsoleClick" Style="{StaticResource DefaultButtonStyle}" Height="28" Padding="8,0" CornerRadius="4" AutomationProperties.Name="Sao chép nhật ký console" ToolTipService.ToolTip="Sao chép nhật ký">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                                </Button>
                                                <Button Click="OnClearConsoleClick" Style="{StaticResource DefaultButtonStyle}" Height="28" Padding="8,0" CornerRadius="4" AutomationProperties.Name="Xóa bảng điều khiển console" ToolTipService.ToolTip="Xóa bảng điều khiển">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Console Terminal Output -->
                                        <Border Grid.Row="1"
                                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10">
                                            <ScrollViewer x:Name="TerminalScrollViewer"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <TextBlock Text="{x:Bind ViewModel.ConsoleOutput, Mode=OneWay}"
                                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                                           FontSize="11.5"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                           TextWrapping="Wrap"
                                                           IsTextSelectionEnabled="True"
                                                           LineHeight="17" />
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
