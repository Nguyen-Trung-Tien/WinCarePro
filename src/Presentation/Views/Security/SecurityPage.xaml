<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.SecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinCarePro.ViewModels"
    xmlns:models="using:WinCarePro.Models"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    xmlns:controls="using:WinCarePro.Presentation.Controls"
    xmlns:components="using:WinCarePro.Shared.Components"
    xmlns:views="using:WinCarePro.Views"
    mc:Ignorable="d">

    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition>
                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    <EntranceNavigationTransitionInfo />
                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
            </NavigationThemeTransition>
            <EntranceThemeTransition FromVerticalOffset="24" />
        </TransitionCollection>
    </Page.Transitions>

    <Grid Background="{ThemeResource AppDeepObsidianBackground}">
        <!-- Ambient Mesh Glow (Deep Obsidian Canvas with Cyan/Indigo Luminous Atmosphere in Dark Mode) -->
        <Grid x:Name="AmbientMeshGlowGrid" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Top-Left Radial Mesh Glow (Cyan #00D2FF &amp; Indigo #7B2CBF) -->
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top"
                       Width="720" Height="540" Margin="-100,-100,0,0"
                       Opacity="0.12"
                       Fill="{StaticResource AppAmbientMeshGlowBrush}" />

            <!-- Bottom-Right Subtle Accent Glow -->
            <Rectangle HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Width="560" Height="440" Margin="0,0,-80,-80"
                       Opacity="0.08"
                       Fill="{StaticResource AppSecondaryMeshGlowBrush}" />
        </Grid>

        <Grid Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0. Header & Action Bar -->
            <RowDefinition Height="Auto" /> <!-- 1. Contextual Status Banners -->
            <RowDefinition Height="*" />    <!-- 2. SysInternals-style Tabbed Matrix -->
        </Grid.RowDefinitions>

        <!-- ==================== 0. FLAT HEADER & ACTION BAR ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Top Edge Thin Progress Bar (Visible during Security Rescan or 1-Click Hardening) -->
            <ProgressBar Grid.ColumnSpan="2"
                         VerticalAlignment="Bottom"
                         Margin="0,0,0,-12"
                         IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Height="2.5"
                         CornerRadius="1.25"
                         Foreground="{StaticResource PrimaryAccentBrush}"
                         HorizontalAlignment="Stretch"/>

            <!-- Left: Title & Subtitle (Standardized Aura Header) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Border Style="{StaticResource IconBadgeStyle}" Background="{StaticResource PrimaryAccentGradient}">
                    <FontIcon Glyph="&#xE727;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source='Security &amp; Defense Center', Converter={StaticResource TranslationConverter}}" Style="{StaticResource PageHeaderTitleStyle}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Source='Authentic Windows Security Center status and verified system policy hardening.', Converter={StaticResource TranslationConverter}}" Style="{StaticResource PageHeaderSubtitleStyle}" />
                </StackPanel>
            </StackPanel>

            <!-- Right: Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Export Audit Report -->
                <Button Click="OnExportReportClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" 
                        Style="{StaticResource SecondaryGlassButtonStyle}" CornerRadius="8" Padding="14,7" FontSize="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEDE1;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Export Report" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <!-- 1-Click Quick Harden -->
                <Button Click="OnQuickHardenClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" 
                        Style="{StaticResource SecondaryGlassButtonStyle}" CornerRadius="8" Padding="14,7" FontSize="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE945;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Quick Harden" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <!-- On-Demand Refresh Status Button -->
                <Button Click="OnScanSecurityClick" IsEnabled="{x:Bind IsNot(ViewModel.IsScanning), Mode=OneWay}" 
                        Style="{StaticResource PrimaryGradientButtonStyle}" Foreground="White" CornerRadius="8" Padding="16,7" FontSize="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsScanning, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" Width="13" Height="13" Foreground="White" VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="White" Visibility="{x:Bind ViewModel.IsScanning, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}" />
                        <TextBlock Text="Refresh Status" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== 1. CONTEXTUAL STATUS BANNERS ==================== -->
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,12" helpers:AnimationHelper.StaggerIndex="0">
            <!-- Safety Notice Card -->
            <controls:InlineStatusCard
                CardType="SafetyNotice"
                Title="{Binding Source='Windows Security Subsystem Armor Active', Converter={StaticResource TranslationConverter}}"
                Message="{Binding Source='All telemetry is queried directly via verified Windows Security Center and hypervisor APIs. Policy hardening generates rollback backups.', Converter={StaticResource TranslationConverter}}"
                IsDismissible="True"
                Visibility="{x:Bind ViewModel.IsSafetyNoticeVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- Summary / Post-Action Card -->
            <controls:InlineStatusCard
                CardType="Summary"
                Title="{Binding Source='Security Optimization Summary', Converter={StaticResource TranslationConverter}}"
                Message="{x:Bind ViewModel.SummarySecurityText, Mode=OneWay}"
                IsDismissible="True"
                Visibility="{x:Bind ViewModel.IsSummaryCardVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <!-- ==================== 2. MAIN BODY PIVOTS ==================== -->
        <Pivot Grid.Row="2" Margin="0,-4,0,0">
            <Pivot.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,10,0" />
                </DataTemplate>
            </Pivot.HeaderTemplate>

            <!-- ==================== TAB 1: WINDOWS SECURITY MATRIX ==================== -->
            <PivotItem Header="Windows Security Matrix">
                <Border BorderBrush="{ThemeResource SpecularGlassBorderBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header & Info Strip -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Live Security Subsystem Telemetry" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Binary state verification direct from Windows Security Center, Hypervisor (VBS), and UEFI firmware." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                        </Grid>

                        <!-- Virtualized Table of Security Components -->
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.SecurityMatrixItems, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:SecurityStatusItem">
                                    <Border BorderBrush="{ThemeResource SpecularGlassBorderBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>  <!-- Icon -->
                                                <ColumnDefinition Width="*"/>     <!-- Details -->
                                                <ColumnDefinition Width="Auto"/>  <!-- Status Pill -->
                                                <ColumnDefinition Width="Auto"/>  <!-- Action Button -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Subsystem Icon -->
                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Component Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                    <Border CornerRadius="4" Padding="6,1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                        <TextBlock Text="{x:Bind Category}" FontSize="9.5" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <!-- Binary Status Pill -->
                                            <Border Grid.Column="2" Background="{x:Bind views:SecurityPage.GetStatusPillBg(IsSecure), Mode=OneWay}" BorderBrush="{x:Bind views:SecurityPage.GetStatusPillBorder(IsSecure), Mode=OneWay}" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <FontIcon Glyph="{x:Bind views:SecurityPage.GetStatusIconGlyph(IsSecure), Mode=OneWay}" FontSize="12" Foreground="{x:Bind views:SecurityPage.GetStatusPillFg(IsSecure), Mode=OneWay}"/>
                                                    <TextBlock Text="{x:Bind StatusText}" FontSize="11" FontWeight="Bold" Foreground="{x:Bind views:SecurityPage.GetStatusPillFg(IsSecure), Mode=OneWay}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Action Button -->
                                            <Button Grid.Column="3" Style="{StaticResource DefaultButtonStyle}" CornerRadius="4" Padding="12,6" VerticalAlignment="Center" Click="OnSecurityMatrixActionClick" Tag="{x:Bind ActionTarget}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{x:Bind ActionText}" FontSize="11" FontWeight="SemiBold"/>
                                                    <FontIcon Glyph="&#xE8A7;" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <controls:EmptyStateCard
                            Grid.Row="1"
                            Visibility="{x:Bind EmptyStateVisibility(ViewModel.SecurityMatrixItems.Count, ViewModel.IsBusy), Mode=OneWay}"
                            IconGlyph="&#xE727;"
                            Title="{Binding Source='Security Matrix Initializing', Converter={StaticResource TranslationConverter}}"
                            Description="{Binding Source='Windows security subsystems and hypervisor components are being queried.', Converter={StaticResource TranslationConverter}}" />
                    </Grid>
                </Border>
            </PivotItem>

            <!-- ==================== TAB 2: PRIVACY & TELEMETRY ==================== -->
            <PivotItem Header="Privacy &amp; Telemetry">
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10" HorizontalAlignment="Stretch">
                            <TextBlock Text="System Privacy &amp; Diagnostic Telemetry Hardening" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>

                            <!-- Diagnostic Telemetry -->
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" Spacing="2">
                                        <TextBlock Text="Diagnostic Telemetry" FontWeight="Bold" FontSize="12.5" />
                                        <TextBlock Text="Send diagnostic and usage telemetry data to Microsoft." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <components:LoadingToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.TelemetryEnabled, Mode=TwoWay}" Toggled="OnTelemetryToggled" VerticalAlignment="Center" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" />
                                </Grid>
                            </Border>

                            <!-- Advertising ID -->
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" Spacing="2">
                                        <TextBlock Text="Advertising ID" FontWeight="Bold" FontSize="12.5" />
                                        <TextBlock Text="Cross-app profiling and personalized advertising tracking." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <components:LoadingToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AdvertisingIdEnabled, Mode=TwoWay}" Toggled="OnAdvertisingIdToggled" VerticalAlignment="Center" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" />
                                </Grid>
                            </Border>

                            <!-- Clipboard History -->
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" Spacing="2">
                                        <TextBlock Text="Clipboard Cloud Sync &amp; History" FontWeight="Bold" FontSize="12.5" />
                                        <TextBlock Text="Cache and cloud synchronize copied passwords and credentials." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <components:LoadingToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ClipboardHistoryEnabled, Mode=TwoWay}" Toggled="OnClipboardToggled" VerticalAlignment="Center" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" />
                                </Grid>
                            </Border>

                            <!-- Input Tracking -->
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" Spacing="2">
                                        <TextBlock Text="Typing &amp; Inking Telemetry" FontWeight="Bold" FontSize="12.5" />
                                        <TextBlock Text="Upload keystrokes and handwriting samples for dictionary training." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <components:LoadingToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.InputTrackingEnabled, Mode=TwoWay}" Toggled="OnInputTrackingToggled" VerticalAlignment="Center" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" />
                                </Grid>
                            </Border>

                            <!-- Cortana & Bing Search Suggestions -->
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" Spacing="2">
                                        <TextBlock Text="Start Menu Web Search (Bing)" FontWeight="Bold" FontSize="12.5" />
                                        <TextBlock Text="Send local Start menu queries over the network to Bing search." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <components:LoadingToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.CortanaBingEnabled, Mode=TwoWay}" Toggled="OnCortanaBingToggled" VerticalAlignment="Center" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" />
                                </Grid>
                            </Border>

                            <!-- Location Sensors -->
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" Spacing="2">
                                        <TextBlock Text="Location Tracking Sensors" FontWeight="Bold" FontSize="12.5" />
                                        <TextBlock Text="Hardware GPS and Wi-Fi geo-triangulation sensor services." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <components:LoadingToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.LocationTrackingEnabled, Mode=TwoWay}" Toggled="OnLocationToggled" VerticalAlignment="Center" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" />
                                </Grid>
                            </Border>

                            <!-- Feedback Requests -->
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" Spacing="2">
                                        <TextBlock Text="Windows Feedback Frequency" FontWeight="Bold" FontSize="12.5" />
                                        <TextBlock Text="Prevent background survey prompts and feedback telemetry." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <components:LoadingToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.FeedbackTrackingEnabled, Mode=TwoWay}" Toggled="OnFeedbackToggled" VerticalAlignment="Center" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" />
                                </Grid>
                            </Border>

                            <!-- App Diagnostics Access -->
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" Spacing="2">
                                        <TextBlock Text="Third-Party App Diagnostics Access" FontWeight="Bold" FontSize="12.5" />
                                        <TextBlock Text="Block third-party store applications from reading system diagnostics." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <components:LoadingToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AppDiagnosticsEnabled, Mode=TwoWay}" Toggled="OnAppDiagnosticsToggled" VerticalAlignment="Center" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </PivotItem>

            <!-- ==================== TAB 3: SECURITY SAFEGUARDS ==================== -->
            <PivotItem Header="Security Safeguards">
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Safeguards Header, Stats & Search Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="System Safeguards &amp; Hardening Catalog" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Fine-grained policy controls and exploit mitigation safeguards." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10,5">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE727;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.SafeguardProtectedCount, Mode=OneWay}" FontWeight="Bold" FontSize="11" Typography.NumeralAlignment="Tabular"/>
                                        <TextBlock Text="/" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.SafeguardTotalCount, Mode=OneWay}" FontWeight="Bold" FontSize="11" Typography.NumeralAlignment="Tabular"/>
                                        <TextBlock Text="Protected" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    </StackPanel>
                                </Border>
                                <TextBox Text="{x:Bind ViewModel.SearchSafeguardsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         PlaceholderText="Search safeguards..." Width="200" CornerRadius="8" FontSize="11.5" VerticalAlignment="Center">
                                </TextBox>
                            </StackPanel>
                        </Grid>

                        <!-- Safeguards Items List -->
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.FilteredSafeguards, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:SecuritySafeguardItem">
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Icon -->
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="15" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="12.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                    <Border CornerRadius="4" Padding="6,1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                        <TextBlock Text="{x:Bind Category}" FontSize="9.5" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind ComparisonText}" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <!-- Toggle / Action Button -->
                                            <Button Grid.Column="2" Click="OnToggleSafeguardClick"
                                                    Style="{StaticResource DefaultButtonStyle}" CornerRadius="7" Padding="12,5" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind StatusFormatted}" FontSize="11" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <controls:EmptyStateCard
                            Grid.Row="1"
                            Visibility="{x:Bind EmptyStateVisibility(ViewModel.FilteredSafeguards.Count, ViewModel.IsBusy), Mode=OneWay}"
                            IconGlyph="&#xE727;"
                            Title="{Binding Source='No Safeguards Match Query', Converter={StaticResource TranslationConverter}}"
                            Description="{Binding Source='No security hardening rules or safeguards matched your current search criteria.', Converter={StaticResource TranslationConverter}}" />
                    </Grid>
                </Border>
            </PivotItem>

            <!-- ==================== TAB 4: ADMINISTRATIVE CONSOLES ==================== -->
            <PivotItem Header="Administrative Consoles">
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                            <TextBlock Text="Windows Native Management Consoles" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Direct, authenticated execution of core administrative MSC applets and tools." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Margin="0,-6,0,6"/>

                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Tool 1: Windows Security -->
                                <Border Grid.Row="0" Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE73A;" FontSize="16" Foreground="{ThemeResource AppStatusGoodBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="Windows Security" FontWeight="Bold" FontSize="12.5"/>
                                            <TextBlock Text="Defender threat center." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource DefaultButtonStyle}" VerticalAlignment="Center" Click="OnOpenWindowsSecurityClick" CornerRadius="6" Padding="10,4">
                                            <TextBlock Text="Open" FontSize="11" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Tool 2: System Info (Msinfo32) -->
                                <Border Grid.Row="0" Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7EF;" FontSize="16" Foreground="{ThemeResource AppStatusInfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="System Info (msinfo32)" FontWeight="Bold" FontSize="12.5"/>
                                            <TextBlock Text="Hardware &amp; BIOS inventory." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource DefaultButtonStyle}" VerticalAlignment="Center" Click="OnOpenMsinfoClick" CornerRadius="6" Padding="10,4">
                                            <TextBlock Text="Open" FontSize="11" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Tool 3: Windows Update -->
                                <Border Grid.Row="1" Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE895;" FontSize="16" Foreground="{ThemeResource AppStatusPurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="Windows Update" FontWeight="Bold" FontSize="12.5"/>
                                            <TextBlock Text="Security patches &amp; hotfixes." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource DefaultButtonStyle}" VerticalAlignment="Center" Click="OnOpenWindowsUpdateClick" CornerRadius="6" Padding="10,4">
                                            <TextBlock Text="Open" FontSize="11" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Tool 4: Task Manager -->
                                <Border Grid.Row="1" Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="{ThemeResource AppStatusWarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="Task Manager" FontWeight="Bold" FontSize="12.5"/>
                                            <TextBlock Text="Process &amp; memory monitor." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource DefaultButtonStyle}" VerticalAlignment="Center" Click="OnOpenTaskManagerClick" CornerRadius="6" Padding="10,4">
                                            <TextBlock Text="Open" FontSize="11" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Tool 5: Firewall Rules -->
                                <Border Grid.Row="2" Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE83D;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="Firewall Rules (wf.msc)" FontWeight="Bold" FontSize="12.5"/>
                                            <TextBlock Text="Inbound/outbound port filters." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource DefaultButtonStyle}" VerticalAlignment="Center" Click="OnOpenFirewallClick" CornerRadius="6" Padding="10,4">
                                            <TextBlock Text="Open" FontSize="11" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Tool 6: Event Viewer -->
                                <Border Grid.Row="2" Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource AppStatusPurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="Event Viewer (eventvwr.msc)" FontWeight="Bold" FontSize="12.5"/>
                                            <TextBlock Text="Audit logs &amp; security events." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource DefaultButtonStyle}" VerticalAlignment="Center" Click="OnOpenEventViewerClick" CornerRadius="6" Padding="10,4">
                                            <TextBlock Text="Open" FontSize="11" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Tool 7: Windows Services -->
                                <Border Grid.Row="3" Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource AppStatusInfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="Services (services.msc)" FontWeight="Bold" FontSize="12.5"/>
                                            <TextBlock Text="Windows service daemons." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource DefaultButtonStyle}" VerticalAlignment="Center" Click="OnOpenServicesClick" CornerRadius="6" Padding="10,4">
                                            <TextBlock Text="Open" FontSize="11" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Tool 8: Registry Editor -->
                                <Border Grid.Row="3" Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource AppStatusGoodBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="Registry Editor (regedit)" FontWeight="Bold" FontSize="12.5"/>
                                            <TextBlock Text="HKLM &amp; HKCU system hives." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource DefaultButtonStyle}" VerticalAlignment="Center" Click="OnOpenRegistryEditorClick" CornerRadius="6" Padding="10,4">
                                            <TextBlock Text="Open" FontSize="11" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </PivotItem>
        </Pivot>
    </Grid>
    </Grid>
</Page>
