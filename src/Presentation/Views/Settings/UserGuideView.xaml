<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinCarePro.Views.UserGuideView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="20">
        <!-- ==================== 1. HERO KNOWLEDGE DECK ==================== -->
        <Border Style="{StaticResource ElevatedGlassCardStyle}" Padding="22,18">
            <StackPanel Spacing="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Style="{StaticResource PageHeaderIconBadgeStyle}">
                                <FontIcon Glyph="&#xE82D;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Source='Feature Guide &amp; System Manual', Converter={StaticResource TranslationConverter}}" Style="{StaticResource PageHeaderTitleStyle}" VerticalAlignment="Center" FontSize="20"/>
                            <Border Background="{StaticResource PrimaryAccentLightBrush}" BorderBrush="{StaticResource PrimaryAccentBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                                <TextBlock Text="Polaris v6" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Source='Comprehensive documentation, step-by-step feature guides, and best practices.', Converter={StaticResource TranslationConverter}}"
                                   Style="{StaticResource PageHeaderSubtitleStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Background="{ThemeResource AppBadgeGoodBg}" BorderBrush="{ThemeResource AppBadgeGoodBorder}" BorderThickness="1" CornerRadius="8" Padding="10,5">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AppBadgeGoodFg}"/>
                                <TextBlock Text="{Binding Source='100% Safe Guidelines', Converter={StaticResource TranslationConverter}}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppBadgeGoodFg}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="8" Padding="10,5">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7BE;" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock Text="{Binding Source='8 Core Modules', Converter={StaticResource TranslationConverter}}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <AutoSuggestBox x:Name="GuideSearchBox"
                                PlaceholderText="{Binding Source='Search guide (e.g., RAM, DNS, SFC, junk)...', Converter={StaticResource TranslationConverter}}"
                                QueryIcon="Find"
                                CornerRadius="8"
                                Height="36"
                                HorizontalAlignment="Stretch"
                                TextChanged="OnGuideSearchTextChanged"/>

                <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="9" Padding="4">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="FilterBtnAll" Grid.Column="0" Click="OnCategoryFilterClick" Tag="All" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="32" HorizontalAlignment="Stretch" Padding="2,0" CornerRadius="6" ToolTipService.ToolTip="View all 8 module guides">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE80F;" FontSize="11" Foreground="White"/>
                                <TextBlock Text="All Modules" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="FilterBtnCare" Grid.Column="1" Click="OnCategoryFilterClick" Tag="Care" Style="{StaticResource StandardSecondaryButtonStyle}" Height="32" HorizontalAlignment="Stretch" Padding="2,0" CornerRadius="6" ToolTipService.ToolTip="System Care &amp; Clean">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xEA99;" FontSize="11" Foreground="Orange"/>
                                <TextBlock Text="Care" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="FilterBtnTuning" Grid.Column="2" Click="OnCategoryFilterClick" Tag="Tuning" Style="{StaticResource StandardSecondaryButtonStyle}" Height="32" HorizontalAlignment="Stretch" Padding="2,0" CornerRadius="6" ToolTipService.ToolTip="Network &amp; Software Updates">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE7FC;" FontSize="11" Foreground="#FFF59E0B"/>
                                <TextBlock Text="Tuning" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="FilterBtnSecurity" Grid.Column="3" Click="OnCategoryFilterClick" Tag="Security" Style="{StaticResource StandardSecondaryButtonStyle}" Height="32" HorizontalAlignment="Stretch" Padding="2,0" CornerRadius="6" ToolTipService.ToolTip="Windows Repair &amp; Safety">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE90F;" FontSize="11" Foreground="Teal"/>
                                <TextBlock Text="Security" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="FilterBtnSystem" Grid.Column="4" Click="OnCategoryFilterClick" Tag="System" Style="{StaticResource StandardSecondaryButtonStyle}" Height="32" HorizontalAlignment="Stretch" Padding="2,0" CornerRadius="6" ToolTipService.ToolTip="App Management, Logs &amp; Settings">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE713;" FontSize="11" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock Text="System" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Empty State -->
        <Border x:Name="NoResultsCard" Style="{StaticResource GlassmorphismCardStyle}" Padding="32,24" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xE721;" FontSize="32" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="No matching modules found" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Try searching for another keyword like 'clean', 'speed', 'ram', 'dns', 'restore', or select 'All Modules'." FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center"/>
                <Button Click="OnResetSearchClick" Style="{StaticResource StandardSecondaryButtonStyle}" HorizontalAlignment="Center" Margin="0,8,0,0" Padding="14,6" CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE894;" FontSize="11"/>
                        <TextBlock Text="Clear Search &amp; Show All" FontSize="11.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ==================== 2. ACTIVE 8 CORE MODULES + SAFETY FAQ ==================== -->
        <StackPanel x:Name="CardsContainer" Spacing="16">

            <!-- 1. Dashboard -->
            <Border x:Name="Card_Dashboard" Tag="Care|All|Dashboard|monitor|health|score|ram|cpu|boost" Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#FF0F6CBD" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE80F;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="10,0,0,0">
                            <TextBlock Text="1. Dashboard &amp; System Health Monitor" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Live Telemetry • Quick RAM Boost • Kernel Diagnostics" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Click="OnLaunchModuleClick" Tag="Dashboard" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="32" Padding="12,0" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A7;" FontSize="11" Foreground="White"/>
                                <TextBlock Text="Launch Module" FontSize="11.5" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Purpose &amp; Overview" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <TextBlock Text="Provides real-time system monitoring for CPU, RAM, GPU, and Disk utilization, along with continuous Health Score tracking and one-click Quick Boost optimization." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2. System Cleaner (JunkPage) -->
            <Border x:Name="Card_Junk" Tag="Care|All|Cleaner|junk|temp|cache|registry|leftovers" Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#FFF59E0B" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE74D;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="10,0,0,0">
                            <TextBlock Text="2. System Cleaner &amp; Junk Debris" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Temp Cache • Browser Cache • Locking App Guard • CSV Export" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Click="OnLaunchModuleClick" Tag="Cleaner" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="32" Padding="12,0" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A7;" FontSize="11" Foreground="White"/>
                                <TextBlock Text="Launch Module" FontSize="11.5" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Purpose &amp; Overview" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <TextBlock Text="Deeply scans storage drives protected by SafePathGuard to locate and clean temporary files, browser caches, and Windows Update debris with locking-app detection." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3. App Manager / Uninstaller -->
            <Border x:Name="Card_Uninstall" Tag="System|All|Uninstall|app|software|leftover|bloatware" Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#FFEF4444" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE71D;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="10,0,0,0">
                            <TextBlock Text="3. App Manager &amp; Leftovers Purge" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Batch Uninstall • Leftover File &amp; Registry Sweeper • Bloatware Removal" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Click="OnLaunchModuleClick" Tag="Uninstall" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="32" Padding="12,0" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A7;" FontSize="11" Foreground="White"/>
                                <TextBlock Text="Launch Module" FontSize="11.5" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Purpose &amp; Overview" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <TextBlock Text="Uninstalls desktop and Windows Store applications cleanly, followed by deep residual file and registry leftover scanning." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 4. Software Updater -->
            <Border x:Name="Card_Updater" Tag="Tuning|All|Updater|packages|winget|drivers" Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#FF0EA5E9" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE895;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="10,0,0,0">
                            <TextBlock Text="4. Software Updater &amp; Driver Backup" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Silent App Updates • Winget Integration • Driver Backup &amp; Restore" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Click="OnLaunchModuleClick" Tag="Updater" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="32" Padding="12,0" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A7;" FontSize="11" Foreground="White"/>
                                <TextBlock Text="Launch Module" FontSize="11.5" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Purpose &amp; Overview" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <TextBlock Text="Detects outdated third-party software via WinGet/verified feeds, verifies signatures before installation, and supports driver backup/restore." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 5. Network Center -->
            <Border x:Name="Card_Network" Tag="Tuning|All|Network|ping|dns|speed|tcp|udp|doh" Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#FF06B6D4" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE968;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="10,0,0,0">
                            <TextBlock Text="5. Network Center &amp; Speed Diagnostics" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Bandwidth Speed Test • Secure DNS &amp; DoH • Winsock Rescue" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Click="OnLaunchModuleClick" Tag="Network" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="32" Padding="12,0" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A7;" FontSize="11" Foreground="White"/>
                                <TextBlock Text="Launch Module" FontSize="11.5" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Purpose &amp; Overview" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <TextBlock Text="Inspects active TCP/UDP connections, benchmarks DNS servers, switches secure DoH profiles, runs speed tests, and repairs broken network stacks." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 6. System Repair -->
            <Border x:Name="Card_Repair" Tag="Security|All|Repair|sfc|dism|fix|restore|services" Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#FF8B5CF6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE90F;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="10,0,0,0">
                            <TextBlock Text="6. System Repair Center" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="SFC Integrity Check • DISM Health Restore • Windows Update Auto-Fix" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Click="OnLaunchModuleClick" Tag="Repair" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="32" Padding="12,0" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A7;" FontSize="11" Foreground="White"/>
                                <TextBlock Text="Launch Module" FontSize="11.5" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Purpose &amp; Overview" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <TextBlock Text="Runs SFC and DISM component store repairs, resets stuck Windows Update services, restores core services, and creates System Restore Points." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 7. Notifications & Activity Logs -->
            <Border x:Name="Card_Notifications" Tag="System|All|Notification|notifications|alerts|logs|history" Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#FF6366F1" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEA8F;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="10,0,0,0">
                            <TextBlock Text="7. Notifications &amp; Activity Logs" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="System Alerts • SQLite Audit History • Log Export" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Click="OnLaunchModuleClick" Tag="notification" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="32" Padding="12,0" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A7;" FontSize="11" Foreground="White"/>
                                <TextBlock Text="Launch Module" FontSize="11.5" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Purpose &amp; Overview" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <TextBlock Text="Centralizes system notifications, SQLite WAL audit logs, quick module actions, and diagnostic log exporting." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 8. Settings & Maintenance -->
            <Border x:Name="Card_Settings" Tag="System|All|Settings|theme|language|backup|updates|maintenance" Style="{StaticResource GlassmorphismCardStyle}" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#FF475569" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="10,0,0,0">
                            <TextBlock Text="8. Settings, Backups &amp; Maintenance" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Theme &amp; Language • App Updates • Database Maintenance" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Click="OnLaunchModuleClick" Tag="Settings:0" Style="{StaticResource VibrantPrimaryButtonStyle}" Height="32" Padding="12,0" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A7;" FontSize="11" Foreground="White"/>
                                <TextBlock Text="Launch Module" FontSize="11.5" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Purpose &amp; Overview" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <TextBlock Text="Configures Dark/Light Aura theme, Vietnamese/English localization, self-updates, settings import/export, and SQLite database maintenance." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 9. FAQ & Safe Operation Guidelines -->
            <Border x:Name="Card_SafetyFaq" Tag="All|Security|faq|safe|help" Style="{StaticResource ElevatedGlassCardStyle}" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#FF10B981" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE82F;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="10,0,0,0">
                            <TextBlock Text="9. FAQ &amp; Safe Operation Principles" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="System Restore Protection • Safe Deletion Standards • Reversible Optimization" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="14" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource QuickStatCardStyle}" Padding="14,10">
                            <StackPanel Spacing="4">
