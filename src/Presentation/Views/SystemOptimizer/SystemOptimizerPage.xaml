<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.SystemOptimizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinCarePro.Models"
    xmlns:viewmodels="using:WinCarePro.ViewModels"
    xmlns:components="using:WinCarePro.Shared.Components"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    xmlns:views="using:WinCarePro.Views"
    xmlns:controls="using:WinCarePro.Presentation.Controls"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="OnRefreshAcceleratorInvoked"/>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFindAcceleratorInvoked"/>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAcceleratorInvoked"/>
    </Page.KeyboardAccelerators>

    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition>
                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    <EntranceNavigationTransitionInfo />
                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
            </NavigationThemeTransition>
            <EntranceThemeTransition FromVerticalOffset="24" />
        </TransitionCollection>
    </Page.Transitions>

    <Grid Background="{ThemeResource AppDeepObsidianBackground}">
        <!-- Ambient Mesh Glow (Deep Obsidian Canvas with Cyan/Indigo Luminous Atmosphere in Dark Mode) -->
        <Grid x:Name="AmbientMeshGlowGrid" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Top-Left Radial Mesh Glow (Cyan #00D2FF &amp; Indigo #7B2CBF) -->
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top"
                       Width="720" Height="540" Margin="-100,-100,0,0"
                       Opacity="0.12"
                       Fill="{StaticResource AppAmbientMeshGlowBrush}" />

            <!-- Bottom-Right Subtle Accent Glow -->
            <Rectangle HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Width="560" Height="440" Margin="0,0,-80,-80"
                       Opacity="0.08"
                       Fill="{StaticResource AppSecondaryMeshGlowBrush}" />
        </Grid>

        <Grid Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0. Header & Action Bar -->
            <RowDefinition Height="Auto" /> <!-- 1. Contextual Status Banners -->
            <RowDefinition Height="*" />    <!-- 2. Main Tabbed Workspace -->
            <RowDefinition Height="Auto" /> <!-- 3. Status Bar -->
        </Grid.RowDefinitions>

        <!-- ==================== 0. FLAT HEADER & ACTION BAR ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Title & Subtitle (Standardized Aura Header) -->
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Border Style="{StaticResource IconBadgeStyle}" Background="{StaticResource PrimaryAccentGradient}">
                    <FontIcon Glyph="&#xE9D9;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source='System Optimizer &amp; Policy Suite', Converter={StaticResource TranslationConverter}}" Style="{StaticResource PageHeaderTitleStyle}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Source='Windows performance tuning, startup program management, and telemetry service controls.', Converter={StaticResource TranslationConverter}}" Style="{StaticResource PageHeaderSubtitleStyle}" />
                </StackPanel>
            </StackPanel>

            <!-- Right: Action Buttons -->
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Restore Defaults Button (1-Click Revert Option) -->
                <Button Style="{StaticResource SecondaryGlassButtonStyle}" Height="34" CornerRadius="8" Padding="12,0" FontSize="11.5" Click="OnRestoreDefaultsClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" ToolTipService.ToolTip="Restore Windows Default Settings">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE777;" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        <TextBlock Text="Restore Defaults" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Export Report Button -->
                <Button Style="{StaticResource SecondaryGlassButtonStyle}" Height="34" CornerRadius="8" Padding="12,0" FontSize="11.5" Click="OnExportReportClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" ToolTipService.ToolTip="Export Optimization Audit Report">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEDE1;" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        <TextBlock Text="Export Report" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Refresh Button -->
                <Button Style="{StaticResource SecondaryGlassButtonStyle}" Height="34" CornerRadius="8" Padding="12,0" FontSize="11.5" Click="OnRefreshClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" ToolTipService.ToolTip="Refresh Telemetry (Ctrl+R)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        <TextBlock Text="Refresh" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Apply Selected Tweaks -->
                <Button x:Name="ApplyTweaksBtn" Style="{StaticResource PrimaryGradientButtonStyle}" Click="OnApplyTweaksClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" FontWeight="Bold" Height="34" CornerRadius="8" Padding="18,0" FontSize="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ProgressRing x:Name="ApplyTweaksRing" IsActive="False" Visibility="Collapsed" Width="13" Height="13" Foreground="White" VerticalAlignment="Center" />
                        <FontIcon x:Name="ApplyTweaksIcon" Glyph="&#xE8FB;" FontSize="12" Foreground="White" />
                        <TextBlock x:Name="ApplyTweaksText" Text="Apply Tweaks" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Notification / Alert InfoBar -->
            <InfoBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0" CornerRadius="8"
                     IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=TwoWay}"
                     Title="{x:Bind ViewModel.InfoBarTitle, Mode=OneWay}"
                     Message="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
                     Severity="{x:Bind ViewModel.InfoBarSeverity, Mode=OneWay}"
                     IsClosable="True" />
        </Grid>

        <!-- ==================== 1. CONTEXTUAL STATUS BANNERS ==================== -->
        <StackPanel Grid.Row="1" Spacing="10" Margin="0,0,0,14">
            <!-- Safety Notice Card -->
            <controls:InlineStatusCard
                CardType="SafetyNotice"
                Title="{Binding Source='SafeRegistryGuard &amp; Policy Armor Active', Converter={StaticResource TranslationConverter}}"
                Message="{Binding Source='All system modifications create restore snapshots and protect critical registry roots.', Converter={StaticResource TranslationConverter}}"
                IsDismissible="True"
                Visibility="{x:Bind ViewModel.IsSafetyNoticeVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- Summary / Post-Action Card -->
            <controls:InlineStatusCard
                CardType="Summary"
                Title="{Binding Source='Optimization Profile Applied', Converter={StaticResource TranslationConverter}}"
                Message="{x:Bind ViewModel.SummaryOptimizerText, Mode=OneWay}"
                IsDismissible="True"
                Visibility="{x:Bind ViewModel.IsSummaryCardVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <!-- ==================== 2. MAIN TABBED WORKSPACE ==================== -->
        <Pivot Grid.Row="2" Margin="0,-4,0,0">
            <Pivot.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,10,0" />
                </DataTemplate>
            </Pivot.HeaderTemplate>

            <!-- ==================== TAB 1: SYSTEM TWEAKS ==================== -->
            <PivotItem Header="System Tweaks">
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- 0: Goal Presets Strip -->
                            <RowDefinition Height="Auto" /> <!-- 1: Category Filter & Search Bar -->
                            <RowDefinition Height="Auto" /> <!-- 2: Quick Selection & Counters -->
                            <RowDefinition Height="*" />    <!-- 3: Tweaks List -->
                        </Grid.RowDefinitions>

                        <!-- Goal Presets Strip -->
                        <Grid Grid.Row="0" Margin="0,0,0,10" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Click="OnSelectGamingProfileClick" Style="{StaticResource DefaultButtonStyle}" HorizontalAlignment="Stretch" Height="34" Padding="12,0" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xEA3A;" FontSize="13" Foreground="#FF8B5CF6"/>
                                    <TextBlock Text="Gaming Focus" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1" Click="OnSelectRecommendedProfileClick" Style="{StaticResource DefaultButtonStyle}" HorizontalAlignment="Stretch" Height="34" Padding="12,0" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE99A;" FontSize="13" Foreground="#FF06B6D4"/>
                                    <TextBlock Text="Office &amp; Productivity" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Click="OnSelectEcoProfileClick" Style="{StaticResource DefaultButtonStyle}" HorizontalAlignment="Stretch" Height="34" Padding="12,0" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xEC0A;" FontSize="13" Foreground="#FF3B82F6"/>
                                    <TextBlock Text="Daily Balanced" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="3" Click="OnSelectPrivacyProfileClick" Style="{StaticResource DefaultButtonStyle}" HorizontalAlignment="Stretch" Height="34" Padding="12,0" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE727;" FontSize="13" Foreground="#FF10B981"/>
                                    <TextBlock Text="Privacy Shield" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Filter, Sort & Search Box -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>

                            <Pivot x:Name="CategoryPivot" Grid.Column="0" SelectionChanged="OnPivotSelectionChanged" Margin="0,-8,0,0">
                                <Pivot.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,6,0" />
                                    </DataTemplate>
                                </Pivot.HeaderTemplate>
                                <PivotItem Header="All" Tag="All" />
                                <PivotItem Header="Performance" Tag="Performance" />
                                <PivotItem Header="System &amp; Disk" Tag="System &amp; Disk" />
                                <PivotItem Header="Privacy &amp; Logs" Tag="Privacy &amp; Logs" />
                            </Pivot>

                            <ComboBox Grid.Column="1" SelectionChanged="OnSortSelectionChanged" SelectedIndex="0" CornerRadius="8" Height="34" VerticalAlignment="Center" Margin="0,0,8,0">
                                <ComboBoxItem Content="Default Order" Tag="Default" />
                                <ComboBoxItem Content="Sort: Name" Tag="Name" />
                                <ComboBoxItem Content="Sort: Risk Level" Tag="Risk" />
                                <ComboBoxItem Content="Sort: Optimized First" Tag="Status" />
                            </ComboBox>

                            <TextBox Grid.Column="2" x:Name="TweakSearchBox" 
                                     PlaceholderText="Search tweaks (Ctrl+F)..." 
                                     TextChanged="OnSearchTextChanged"
                                     CornerRadius="8" Height="34" VerticalAlignment="Center">
                            </TextBox>
                        </Grid>

                        <!-- Selection Bar & Counters -->
                        <Grid Grid.Row="2" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <CheckBox Content="Select All" Checked="OnMasterSelectAllChanged" Unchecked="OnMasterSelectAllChanged" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Click="OnSelectUnappliedClick" Style="{StaticResource DefaultButtonStyle}" CornerRadius="6" Padding="10,4" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE71C;" FontSize="10.5" Foreground="{ThemeResource PrimaryAccentBrush}"/>
                                        <TextBlock Text="Unapplied Only" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Total:" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.TotalTweaksCount, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Selected:" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedTweaksCount, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#2010B981" BorderBrush="#4010B981" BorderThickness="1" CornerRadius="6" Padding="8,2">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Optimized:" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.OptimizedTweaksCount, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Foreground="#FF10B981" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Virtualized Tweaks List -->
                        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.FilteredTweaks, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:SystemTweak">
                                    <Border BorderBrush="{ThemeResource SpecularGlassBorderBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />  <!-- 0: CheckBox -->
                                                <ColumnDefinition Width="Auto" />  <!-- 1: Icon -->
                                                <ColumnDefinition Width="*" />     <!-- 2: Details -->
                                                <ColumnDefinition Width="Auto" />  <!-- 3: Status Badge -->
                                            </Grid.ColumnDefinitions>
                                            
                                            <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,4,0" MinWidth="0" />
                                            
                                            <Border Grid.Column="1" Width="34" Height="34" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind IconGlyph}" Foreground="{ThemeResource SystemAccentColor}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" />
                                                    <Border CornerRadius="4" Padding="5,1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                        <TextBlock Text="{x:Bind Category}" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind ComparisonText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource SystemAccentColor}" FontWeight="SemiBold" />
                                            </StackPanel>
                                            
                                            <Border Grid.Column="3" Background="{x:Bind views:SystemOptimizerPage.GetTweakBadgeBg(IsOptimized), Mode=OneWay}" BorderBrush="{x:Bind views:SystemOptimizerPage.GetTweakBadgeBorder(IsOptimized), Mode=OneWay}" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind StatusFormatted, Mode=OneWay}" Foreground="{x:Bind views:SystemOptimizerPage.GetTweakBadgeFg(IsOptimized), Mode=OneWay}" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </PivotItem>

            <!-- ==================== TAB 2: STARTUP MANAGER ==================== -->
            <PivotItem Header="Startup Applications">
                <Border BorderBrush="{ThemeResource SpecularGlassBorderBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header & Search Strip -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Startup Program Execution Manager" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Verified startup programs parsed from Registry Run hives, Startup folders, and Task Scheduler." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Text="{x:Bind ViewModel.StartupSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     PlaceholderText="Filter startup apps..." CornerRadius="8" Height="34" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Virtualized Startup List -->
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.FilteredStartupItems, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:StartupEntry">
                                    <Border BorderBrush="{ThemeResource SpecularGlassBorderBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                                <ColumnDefinition Width="*"/>    <!-- Details -->
                                                <ColumnDefinition Width="Auto"/> <!-- Source Badge -->
                                                <ColumnDefinition Width="Auto"/> <!-- Impact Badge -->
                                                <ColumnDefinition Width="Auto"/> <!-- Toggle Switch -->
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE777;" FontSize="15" Foreground="{ThemeResource SystemAccentColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind Command}" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind SourceFormatted}" FontSize="9.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" FontWeight="SemiBold"/>
                                            </Border>

                                            <Border Grid.Column="3" Background="#15F59E0B" BorderBrush="#30F59E0B" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Impact}" FontSize="9.5" Foreground="#FFF59E0B" FontWeight="Bold"/>
                                            </Border>

                                            <ToggleSwitch Grid.Column="4" IsOn="{x:Bind IsEnabled, Mode=TwoWay}" Toggled="OnStartupItemToggled" OnContent="{Binding Source='Enabled', Converter={StaticResource TranslationConverter}}" OffContent="{Binding Source='Disabled', Converter={StaticResource TranslationConverter}}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </PivotItem>

            <!-- ==================== TAB 3: TELEMETRY & SAFE SERVICES ==================== -->
            <PivotItem Header="Safe Services &amp; Telemetry">
                <Border BorderBrush="{ThemeResource SpecularGlassBorderBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Info Header with Safety Shield Indicator -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource SystemAccentColor}"/>
                                    <TextBlock Text="Telemetry &amp; Background Services Management" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <Border Background="#2010B981" BorderBrush="#4010B981" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                        <TextBlock Text="SafeServiceGuard Shield Active" FontSize="9.5" FontWeight="Bold" Foreground="#FF10B981"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Safe management of diagnostic telemetry services. Core Windows kernel services (RpcSs, DcomLaunch, WinDefend, PlugPlay) are strictly protected." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Services List -->
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.BackgroundServices, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:ServiceStatusItem">
                                    <Border BorderBrush="{ThemeResource SpecularGlassBorderBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind StatusGlyph}" Foreground="{x:Bind StatusColor}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="Bold" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="350"/>
                                                <TextBlock Text="{x:Bind ServiceName}" FontSize="10.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                            </StackPanel>

                                            <Border Grid.Column="2" Background="{x:Bind StatusColor}" CornerRadius="5" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Status}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                            </Border>

                                            <Button Grid.Column="3" Click="OnToggleServiceClick" Style="{StaticResource DefaultButtonStyle}" CornerRadius="6" Padding="12,5" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind views:SystemOptimizerPage.GetServiceActionText(IsRunning), Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </PivotItem>

            <!-- ==================== TAB 4: MEMORY TELEMETRY ==================== -->
            <PivotItem Header="Hardware Memory">
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Physical Hardware RAM Telemetry" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Authentic physical RAM metrics reported via Windows GlobalMemoryStatusEx. No artificial working-set purge or page-file paging." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>

                            <!-- Metric Cards Grid -->
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Total Physical RAM -->
                                <Border Grid.Column="0" BorderBrush="{ThemeResource SpecularGlassBorderBrush}" BorderThickness="1" Background="{ThemeResource GlassCardBackgroundBrush}" CornerRadius="8" Padding="16,14">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Total Physical RAM" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.TotalRamText, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Typography.NumeralAlignment="Tabular"/>
                                        <TextBlock Text="Installed motherboard capacity" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- In-Use RAM -->
                                <Border Grid.Column="1" BorderBrush="{ThemeResource SpecularGlassBorderBrush}" BorderThickness="1" Background="{ThemeResource GlassCardBackgroundBrush}" CornerRadius="8" Padding="16,14">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Currently In Use" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.UsedRamText, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource GaugeRamBrush}" Typography.NumeralAlignment="Tabular"/>
                                        <TextBlock Text="{x:Bind ViewModel.RamUsagePercentageText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Available RAM -->
                                <Border Grid.Column="2" BorderBrush="{ThemeResource SpecularGlassBorderBrush}" BorderThickness="1" Background="{ThemeResource GlassCardBackgroundBrush}" CornerRadius="8" Padding="16,14">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Available Free Memory" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.AvailableRamText, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="#FF10B981" Typography.NumeralAlignment="Tabular"/>
                                        <TextBlock Text="Standby and free pages ready" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Circular Ring Gauge & Telemetry Strip -->
                            <Border BorderBrush="{ThemeResource SpecularGlassBorderBrush}" BorderThickness="1" Background="{ThemeResource GlassCardBackgroundBrush}" CornerRadius="8" Padding="16,12" Margin="0,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Circular Ring Gauge with Dynamic Load Aura Glow -->
                                    <Grid Grid.Column="0" Width="64" Height="64" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <Border x:Name="RamGlowBorder" Width="44" Height="44" CornerRadius="22" Background="{StaticResource GaugeGlowGoodBrush}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Path Stroke="{ThemeResource GaugeTrackBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                            <Path.Data>
                                                <PathGeometry>
                                                    <PathFigure StartPoint="32,7">
                                                        <ArcSegment Point="31.99,7" Size="25,25" SweepDirection="Clockwise" IsLargeArc="True"/>
                                                    </PathFigure>
                                                </PathGeometry>
                                            </Path.Data>
                                        </Path>
                                        <Path Stroke="{StaticResource GaugeRamBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                            <Path.Data>
                                                <PathGeometry>
                                                    <PathFigure x:Name="RamPathFigure" StartPoint="32,7">
                                                        <ArcSegment x:Name="RamArcSegment" Point="32,7" Size="25,25" SweepDirection="Clockwise" IsLargeArc="False"/>
                                                    </PathFigure>
                                                </PathGeometry>
                                            </Path.Data>
                                        </Path>
                                        <TextBlock Text="{x:Bind ViewModel.RamUsagePercentageText, Mode=OneWay}" FontSize="12" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Allocation Metrics and Progress Bar with Tabular Numerals -->
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Memory Allocation Ratio" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.RamUsageText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                                        </Grid>
                                        <ProgressBar Value="{x:Bind ViewModel.RamUsagePercentage, Mode=OneWay}" Maximum="100" Height="4" CornerRadius="2" Foreground="{StaticResource GaugeRamBrush}" Background="{ThemeResource GaugeTrackBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Architectural Note Banner -->
                            <Border BorderBrush="{ThemeResource SpecularGlassBorderBrush}" BorderThickness="1" Background="{ThemeResource GlassCardBackgroundBrush}" CornerRadius="8" Padding="14,10">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE783;" FontSize="15" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Memory Architecture: Modern Windows actively utilizes available RAM to cache frequently accessed binaries and files. Unused RAM is wasted RAM; forcing working-set trims causes hard page faults and application stutter." FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </PivotItem>
        </Pivot>

        <!-- ==================== 3. STATUS BAR FOOTER ==================== -->
        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Margin="0,8,0,0" />
    </Grid>
    </Grid>
</Page>
