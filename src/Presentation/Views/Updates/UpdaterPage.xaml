<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCarePro.Views.UpdaterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinCarePro.Models"
    xmlns:vm="using:WinCarePro.ViewModels"
    xmlns:helpers="using:WinCarePro.Core.Helpers"
    xmlns:controls="using:WinCarePro.Presentation.Controls"
    mc:Ignorable="d">

    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition>
                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    <EntranceNavigationTransitionInfo />
                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
            </NavigationThemeTransition>
            <EntranceThemeTransition FromVerticalOffset="24" />
        </TransitionCollection>
    </Page.Transitions>

    <Grid Background="{ThemeResource AppDeepObsidianBackground}">
        <!-- Ambient Mesh Glow (Deep Obsidian Canvas with Cyan/Indigo Luminous Atmosphere in Dark Mode) -->
        <Grid x:Name="AmbientMeshGlowGrid" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Top-Left Radial Mesh Glow (Cyan #00D2FF &amp; Indigo #7B2CBF) -->
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top"
                       Width="720" Height="540" Margin="-100,-100,0,0"
                       Opacity="0.12"
                       Fill="{StaticResource AppAmbientMeshGlowBrush}" />

            <!-- Bottom-Right Subtle Accent Glow -->
            <Rectangle HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Width="560" Height="440" Margin="0,0,-80,-80"
                       Opacity="0.08"
                       Fill="{StaticResource AppSecondaryMeshGlowBrush}" />
        </Grid>

        <Grid Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutVisualStates">
                <!-- Wide Layout: Viewport Width >= 1050px -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1050" />
                    </VisualState.StateTriggers>
                </VisualState>

                <!-- Medium Layout: Viewport Width between 780px and 1050px -->
                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="780" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderCol1.Width" Value="0" />
                        <Setter Target="HeaderTitlePanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderActionsPanel.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderActionsPanel.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderActionsPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderActionsPanel.HorizontalAlignment" Value="Left" />
                        <Setter Target="HeaderActionsPanel.Margin" Value="0,10,0,0" />
                    </VisualState.Setters>
                </VisualState>

                <!-- Narrow Layout: Viewport Width < 780px -->
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- Header Stacking -->
                        <Setter Target="HeaderCol1.Width" Value="0" />
                        <Setter Target="HeaderTitlePanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderActionsPanel.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderActionsPanel.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderActionsPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderActionsPanel.HorizontalAlignment" Value="Left" />
                        <Setter Target="HeaderActionsPanel.Margin" Value="0,10,0,0" />

                        <!-- Toolbar Stacking -->
                        <Setter Target="ToolbarCol1.Width" Value="0" />
                        <Setter Target="ToolbarActionsPanel.(Grid.Row)" Value="1" />
                        <Setter Target="ToolbarActionsPanel.(Grid.Column)" Value="0" />
                        <Setter Target="ToolbarActionsPanel.HorizontalAlignment" Value="Left" />
                        <Setter Target="ToolbarActionsPanel.Margin" Value="0,8,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0. Header -->
            <RowDefinition Height="Auto" /> <!-- 1. 4-Card Ribbon -->
            <RowDefinition Height="Auto" /> <!-- 2. Toolbar & Filters -->
            <RowDefinition Height="*" />    <!-- 3. Main Workspace -->
        </Grid.RowDefinitions>

        <!-- ==================== 0. MODERN HEADER ==================== -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow0" Height="Auto" />
                <RowDefinition x:Name="HeaderRow1" Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HeaderCol0" Width="*" />
                <ColumnDefinition x:Name="HeaderCol1" Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Title & Subtitle with Gradient Icon Badge (Standardized Aura Header) -->
            <StackPanel x:Name="HeaderTitlePanel" Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Border Style="{StaticResource IconBadgeStyle}" Background="{StaticResource PrimaryAccentGradient}">
                    <FontIcon Glyph="&#xE895;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source='Software Updater', Converter={StaticResource TranslationConverter}}" Style="{StaticResource PageHeaderTitleStyle}" />
                    <TextBlock Text="{Binding Source='Apps &amp; packages updates via WinGet.', Converter={StaticResource TranslationConverter}}" Style="{StaticResource PageHeaderSubtitleStyle}" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                </StackPanel>
            </StackPanel>

            <!-- Right: Action Buttons (Drivers + Scan + Update All) -->
            <StackPanel x:Name="HeaderActionsPanel" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryGlassButtonStyle}" Height="34" Padding="12,0" CornerRadius="8" FontSize="11.5" FontWeight="SemiBold" Click="OnBackupDriversClick" ToolTipService.ToolTip="Backup Installed Hardware Drivers">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74E;" FontSize="11.5" Foreground="{ThemeResource AppStatusInfoBrush}"/>
                        <TextBlock Text="{Binding Source='Backup Drivers', Converter={StaticResource TranslationConverter}}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryGlassButtonStyle}" Height="34" Padding="12,0" CornerRadius="8" FontSize="11.5" FontWeight="SemiBold" Click="OnRestoreDriversClick" ToolTipService.ToolTip="Restore Drivers from Backup">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE777;" FontSize="11.5" Foreground="{ThemeResource AppStatusWarningBrush}"/>
                        <TextBlock Text="{Binding Source='Restore Drivers', Converter={StaticResource TranslationConverter}}"/>
                    </StackPanel>
                </Button>

                <!-- Scan Updates Button (Hero CTA) -->
                <Button x:Name="ScanUpdatesBtn" Style="{StaticResource PrimaryGradientButtonStyle}" Foreground="White" Click="OnScanUpdatesClick" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" CornerRadius="8" Padding="16,7" FontWeight="Bold" FontSize="12"
                        AutomationProperties.Name="Scan for Updates"
                        AutomationProperties.HelpText="Checks for software package updates via winget and Microsoft Store.">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ProgressRing x:Name="ScanUpdatesRing" IsActive="False" Visibility="Collapsed" Width="13" Height="13" Foreground="White" VerticalAlignment="Center"/>
                        <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="White" />
                        <TextBlock x:Name="ScanUpdatesText" Text="{Binding Source='Scan for Updates', Converter={StaticResource TranslationConverter}}" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <!-- Update All Apps Hero Primary CTA (Only visible when there are pending updates) -->
                <Button x:Name="UpdateAllBtn" Style="{StaticResource AccentButtonStyle}" Background="{ThemeResource AppStatusGoodBrush}" Foreground="White" Click="OnUpdateAllClick" Visibility="{x:Bind HasPendingUpdatesVisibility(ViewModel.PendingUpdatesCount, ViewModel.IsBusy), Mode=OneWay}" IsEnabled="{x:Bind IsNot(ViewModel.IsBusy), Mode=OneWay}" CornerRadius="8" Padding="16,7" FontWeight="Bold" FontSize="12"
                        AutomationProperties.Name="Update All Software"
                        AutomationProperties.HelpText="Updates all applications with pending updates.">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ProgressRing x:Name="UpdateAllRing" IsActive="False" Visibility="Collapsed" Width="13" Height="13" Foreground="White" VerticalAlignment="Center"/>
                        <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="White" />
                        <TextBlock x:Name="UpdateAllText" Text="{x:Bind GetUpdateAllButtonText(ViewModel.PendingUpdatesCount), Mode=OneWay}" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== 1. CONTEXTUAL STATUS BANNERS ==================== -->
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,12" helpers:AnimationHelper.StaggerIndex="0">
            <!-- Safety Notice Card -->
            <controls:InlineStatusCard
                CardType="SafetyNotice"
                Title="{Binding Source='Software Repository &amp; Digital Signature Armor Active', Converter={StaticResource TranslationConverter}}"
                Message="{Binding Source='All package updates are verified via official Winget SHA-256 manifests and Microsoft Store signatures before silent installation.', Converter={StaticResource TranslationConverter}}"
                IsDismissible="True"
                Visibility="{x:Bind ViewModel.IsSafetyNoticeVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- Summary / Post-Action Card -->
            <controls:InlineStatusCard
                CardType="Summary"
                Title="{Binding Source='Update Execution Summary', Converter={StaticResource TranslationConverter}}"
                Message="{x:Bind ViewModel.SummaryUpdaterText, Mode=OneWay}"
                IsDismissible="True"
                Visibility="{x:Bind ViewModel.IsSummaryCardVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <!-- ==================== 1. BENTO COCKPIT: RADAR & HUB (Collapsed to eliminate redundant radar/index cards) ==================== -->
        <Grid x:Name="StatsGrid" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,12" ColumnSpacing="12" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="StatRow0" Height="Auto" />
                <RowDefinition x:Name="StatRow1" Height="Auto" />
                <RowDefinition x:Name="StatRow2" Height="0" />
                <RowDefinition x:Name="StatRow3" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="StatCol0" Width="360" />
                <ColumnDefinition x:Name="StatCol1" Width="*" />
                <ColumnDefinition x:Name="StatCol2" Width="0" />
                <ColumnDefinition x:Name="StatCol3" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Card 0: Update Radar & Pulse Health Index (Glassmorphism Cockpit Card) -->
            <Border x:Name="StatCard0" Grid.Row="0" Grid.Column="0"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16,14"
                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="5.0" helpers:Animation3DHelper.DepthZ="12">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Circular Radar Gauge with Pulse Glow -->
                    <Grid Grid.Column="0" Width="68" Height="68" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Background Circular Track -->
                        <Ellipse Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="4" Width="58" Height="58" Opacity="0.3" />
                        <Ellipse Stroke="{StaticResource PrimaryAccentGradient}" StrokeThickness="2" Opacity="0.3" Width="68" Height="68" />
                        <!-- Circular Progress Value -->
                        <ProgressRing Value="{x:Bind ViewModel.SystemHealthScore, Mode=OneWay}" Maximum="100" Width="58" Height="58"
                                      Foreground="{StaticResource PrimaryAccentBrush}" Background="Transparent" />
                        <!-- Central Score & Badge -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="-2">
                            <TextBlock Text="{x:Bind ViewModel.HealthScoreText, Mode=OneWay}"
                                       FontSize="15" FontWeight="ExtraBold" FontFamily="Segoe UI Variable Display"
                                       Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="INDEX" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center"
                                       Foreground="{StaticResource PrimaryAccentBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Radar Information Metrics -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <!-- Pulse Dot Indicator -->
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource AppStatusGoodBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Software Security Index" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <TextBlock Text="{x:Bind ViewModel.SystemHealthStatus, Mode=OneWay}"
                                   FontSize="13.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <!-- Channel info pill -->
                        <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left" Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE753;" FontSize="11.5" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.ActiveEngineName, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 1: Smart Orchestration & Telemetry Hub -->
            <Border x:Name="StatCard1" Grid.Row="0" Grid.Column="1"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16,14"
                    helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="5.0" helpers:Animation3DHelper.DepthZ="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header with Last Sync & Driver Actions -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE777;" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <TextBlock Text="Last Sync:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.LastScanTime, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Hardware Driver Backup & Restore Shortcut Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Style="{StaticResource StandardSecondaryButtonStyle}" Padding="8,3" CornerRadius="6" FontSize="10.5" FontWeight="SemiBold" Click="OnBackupDriversClick" ToolTipService.ToolTip="Backup Installed Hardware Drivers" AutomationProperties.Name="Backup Drivers">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE74E;" FontSize="10" Foreground="{ThemeResource AppStatusInfoBrush}"/>
                                    <TextBlock Text="Backup Drivers"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource StandardSecondaryButtonStyle}" Padding="8,3" CornerRadius="6" FontSize="10.5" FontWeight="SemiBold" Click="OnRestoreDriversClick" ToolTipService.ToolTip="Restore Drivers from Backup" AutomationProperties.Name="Restore Drivers">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE777;" FontSize="10" Foreground="{ThemeResource AppStatusWarningBrush}"/>
                                    <TextBlock Text="Restore"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: 3 Smart Status Chips (Critical Security, Feature Updates, Up-to-Date) -->
                    <Grid Grid.Row="1" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Chip 1: Critical Security / CVE Patches -->
                        <Border Grid.Column="0" Background="{ThemeResource AppStatusDangerBackground}" BorderBrush="{ThemeResource AppStatusDangerBorder}" BorderThickness="1" CornerRadius="10" Padding="10,8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center">
                                    <Border CornerRadius="8" Background="{ThemeResource AppStatusDangerBrush}" Opacity="0.22" />
                                    <Border CornerRadius="8" BorderBrush="{ThemeResource AppStatusDangerBorder}" BorderThickness="1" />
                                    <FontIcon Glyph="&#xE727;" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource AppStatusDangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="Security Patches" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SecurityUpdatesCount, Mode=OneWay}" FontSize="13" FontWeight="ExtraBold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource AppStatusDangerBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Chip 2: Feature Bumps -->
                        <Border Grid.Column="1" Background="{ThemeResource AppStatusWarningBackground}" BorderBrush="{ThemeResource AppStatusWarningBorder}" BorderThickness="1" CornerRadius="10" Padding="10,8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center">
                                    <Border CornerRadius="8" Background="{ThemeResource AppStatusWarningBrush}" Opacity="0.22" />
                                    <Border CornerRadius="8" BorderBrush="{ThemeResource AppStatusWarningBorder}" BorderThickness="1" />
                                    <FontIcon Glyph="&#xE898;" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource AppStatusWarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="Feature Updates" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.FeatureUpdatesCount, Mode=OneWay}" FontSize="13" FontWeight="ExtraBold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource AppStatusWarningBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Chip 3: Up-to-Date Packages -->
                        <Border Grid.Column="2" Background="{ThemeResource AppStatusGoodBackground}" BorderBrush="{ThemeResource AppStatusGoodBorder}" BorderThickness="1" CornerRadius="10" Padding="10,8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center">
                                    <Border CornerRadius="8" Background="{ThemeResource AppStatusGoodBrush}" Opacity="0.22" />
                                    <Border CornerRadius="8" BorderBrush="{ThemeResource AppStatusGoodBorder}" BorderThickness="1" />
                                    <FontIcon Glyph="&#xE73E;" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource AppStatusGoodBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="Up to Date" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.CompletedCount, Mode=OneWay}" FontSize="13" FontWeight="ExtraBold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource AppStatusGoodBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Hidden placeholders for StatCard2 and StatCard3 for full layout compatibility -->
            <Border x:Name="StatCard2" Grid.Row="0" Grid.Column="2" Visibility="Collapsed" />
            <Border x:Name="StatCard3" Grid.Row="0" Grid.Column="3" Visibility="Collapsed" />
        </Grid>

        <!-- ==================== 2. TOOLBAR & FILTERS ==================== -->
        <Grid x:Name="ToolbarGrid" Grid.Row="2" Margin="0,0,0,10" Visibility="{x:Bind HasItemsVisibility(ViewModel.TotalFoundCount, ViewModel.IsBusy), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ToolbarRow0" Height="Auto" />
                <RowDefinition x:Name="ToolbarRow1" Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ToolbarCol0" Width="*" />
                <ColumnDefinition x:Name="ToolbarCol1" Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Status Segmented Pills (Pivot) -->
            <Pivot Grid.Row="0" Grid.Column="0" SelectionChanged="OnFilterPivotSelectionChanged" Margin="0,-8,0,0">
                <Pivot.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="13" FontWeight="SemiBold" Margin="0,0,6,0" />
                    </DataTemplate>
                </Pivot.HeaderTemplate>
                <PivotItem Header="All" Tag="All" />
                <PivotItem Header="Pending" Tag="Pending" />
                <PivotItem Header="Completed" Tag="Completed" />
            </Pivot>

            <!-- Master Selection & Search Box (Right) -->
            <StackPanel x:Name="ToolbarActionsPanel" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                <CheckBox Content="{Binding Source='Select All', Converter={StaticResource TranslationConverter}}"
                          Checked="OnMasterSelectAllChanged"
                          Unchecked="OnMasterSelectAllChanged"
                          FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBox x:Name="SearchBox" Width="220" PlaceholderText="Search package..." Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CornerRadius="8" Height="34" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ==================== 3. MAIN WORKSPACE ==================== -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 0: Active Progress Banner HUD -->
                <RowDefinition Height="*" />    <!-- 1: Workspace Body (List / Skeleton / Empty) -->
            </Grid.RowDefinitions>

            <!-- Active Progress Banner Overlay / Live Download Stream HUD -->
            <Border Grid.Row="0" Style="{StaticResource CockpitBentoCardStyle}" Padding="16,14" VerticalAlignment="Top" HorizontalAlignment="Stretch" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Row 0: Top Status Header -->
                        <RowDefinition Height="Auto" /> <!-- Row 1: Live Monospace URL Stream Pill -->
                        <RowDefinition Height="Auto" /> <!-- Row 2: Progress Bar & Real-time Metrics -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: App Name + Phase Badge + Cancel -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <ProgressRing IsActive="True" Width="16" Height="16" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.ActiveUpdatingAppName, Mode=OneWay}" FontSize="13.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite"/>

                            <!-- Phase Badge (Downloading / Verifying / Installing) -->
                            <Border Background="{StaticResource PrimaryAccentLightBrush}" BorderBrush="{StaticResource PrimaryAccentBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE896;" FontSize="10" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.CurrentPhase, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"
                                               AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Cancel Button -->
                        <Button Grid.Column="1" Click="OnCancelClick" Visibility="{x:Bind ViewModel.CanCancel, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource DefaultButtonStyle}" Background="{ThemeResource AppStatusDangerBackground}" BorderBrush="{ThemeResource AppStatusDangerBorder}" BorderThickness="1" Foreground="{ThemeResource AppStatusDangerBrush}" Padding="12,5" CornerRadius="6" FontSize="11.5" FontWeight="Bold"
                                AutomationProperties.Name="Cancel Update" AutomationProperties.HelpText="Cancels the active package update.">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource AppStatusDangerBrush}"/>
                                <TextBlock Text="Cancel" FontWeight="Bold" Foreground="{ThemeResource AppStatusDangerBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Row 1: Live URL Stream Pill (Terminal Monospace Card) -->
                    <Border Grid.Row="1" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" BorderBrush="{ThemeResource SpecularGlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" Visibility="{x:Bind HasTextVisibility(ViewModel.CurrentDownloadUrl), Mode=OneWay}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="0,0,10,0" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE71B;" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock Text="Downloading" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentDownloadUrl, Mode=OneWay}" FontFamily="Cascadia Code, Consolas, Segoe UI Variable Text" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Row 2: Dual-Metric Progress Bar & Live Stream Sizes (167 MB / 360 MB) -->
                    <StackPanel Grid.Row="2" Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.ProgressMessage, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind GetSpeedDisplay(ViewModel.CurrentSpeedText), Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AppStatusInfoBrush}"/>
                            </StackPanel>

                            <!-- Live 167 MB / 360 MB + 46% -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.CurrentBytesProgress, Mode=OneWay}" FontSize="12" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{x:Bind GetPercentText(ViewModel.ProgressPercent), Mode=OneWay}" FontSize="12" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryAccentBrush}" FontFamily="Segoe UI Variable Display"/>
                            </StackPanel>
                        </Grid>
                        <ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Maximum="100" Height="6" CornerRadius="3" Foreground="{StaticResource PrimaryAccentGradient}" Background="{ThemeResource ControlStrokeColorDefaultBrush}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Workspace Body in Grid.Row="1" -->
            <Grid Grid.Row="1">
                <!-- Updates List View -->
                <Border Style="{StaticResource CockpitBentoCardStyle}" Padding="12" Visibility="{x:Bind IsListNotEmpty(ViewModel.Updates.Count, ViewModel.IsBusy), Mode=OneWay}">
                    <ListView ItemsSource="{x:Bind ViewModel.Updates, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,2" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SoftwareUpdateInfo">
                                <Border Background="{x:Bind CardBackgroundBrush, Mode=OneWay}" BorderBrush="{x:Bind CardBorderBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,3"
                                        helpers:Animation3DHelper.Is3DTiltEnabled="True" helpers:Animation3DHelper.MaxTiltAngle="3.0" helpers:Animation3DHelper.DepthZ="8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Checkbox for multi selection -->
                                        <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanUpdate, Mode=OneWay}" Visibility="{x:Bind IsNotUpdatingVisibility, Mode=OneWay}" VerticalAlignment="Center"/>

                                        <!-- Package Brand Icon with Crisp Glowing Container -->
                                        <Grid Grid.Column="1" Width="44" Height="44" VerticalAlignment="Center">
                                            <Border CornerRadius="12" Background="{x:Bind BrandBgBrush, Mode=OneWay}" />
                                            <Border CornerRadius="12" BorderBrush="{x:Bind BrandBorderBrush, Mode=OneWay}" BorderThickness="1.5" />
                                            <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Foreground="{x:Bind BrandColorBrush, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Name, Category Tag, AI SmartSummary, ID & Source -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="13.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <!-- Dynamic Smart Category Badge (CVE Patch / Major Bump / Optimization) -->
                                                    <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" Padding="6,1.5" CornerRadius="5" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="{x:Bind CategoryIconGlyph, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                                            <TextBlock Text="{x:Bind UpdateCategory, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Up to Date Badge (Completed state) -->
                                                    <Border Visibility="{x:Bind IsCompleted, Mode=OneWay}" Background="{ThemeResource AppStatusGoodBackground}" BorderBrush="{ThemeResource AppStatusGoodBorder}" BorderThickness="1" Padding="6,1" CornerRadius="4" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppStatusGoodBrush}"/>
                                                            <TextBlock Text="Up to Date" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource AppStatusGoodBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- AI Smart Insight / Summary -->
                                            <TextBlock Text="{x:Bind SmartSummary, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="360"/>

                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1,0,0">
                                                <TextBlock Text="{x:Bind Id}" FontSize="10" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                                <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Padding="4,1" CornerRadius="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Source}" FontSize="8.5" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                    <!-- Version Comparison Pill -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Padding="7,3" CornerRadius="6">
                                            <TextBlock Text="{x:Bind CurrentInstalledVersionDisplay, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        </Border>
                                        <FontIcon Glyph="&#xE72A;" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        <Border Background="{x:Bind StatusBgColor, Mode=OneWay}" BorderBrush="{x:Bind StatusBorderColor, Mode=OneWay}" BorderThickness="1" Padding="7,3" CornerRadius="6">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{x:Bind AvailableVersion}" FontSize="11" FontWeight="Bold" Foreground="{x:Bind StatusForegroundColor, Mode=OneWay}"/>
                                                <FontIcon Glyph="{x:Bind StatusIconGlyph, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind StatusForegroundColor, Mode=OneWay}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Status Badge / Progress Bar Section with Live MB Metrics -->
                                    <Grid Grid.Column="4" Margin="0,0,10,0" VerticalAlignment="Center" MinWidth="160">
                                        <StackPanel Visibility="{x:Bind IsUpdatingVisibility, Mode=OneWay}" Spacing="4">
                                            <Grid>
                                                <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Left" Foreground="{ThemeResource PrimaryAccentBrush}" TextTrimming="CharacterEllipsis" MaxWidth="100"/>
                                                <TextBlock Text="{x:Bind BytesProgress, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Right" FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            </Grid>
                                            <ProgressBar Value="{x:Bind DownloadProgress, Mode=OneWay}" IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}" Maximum="100" Height="5" CornerRadius="2.5" Foreground="{StaticResource PrimaryAccentGradient}" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                        </StackPanel>
                                        <Border Visibility="{x:Bind IsNotUpdatingVisibility, Mode=OneWay}" Background="{x:Bind StatusBgColor, Mode=OneWay}" BorderBrush="{x:Bind StatusBorderColor, Mode=OneWay}" BorderThickness="1" CornerRadius="8" Padding="9,3" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="{x:Bind StatusIconGlyph, Mode=OneWay}" FontSize="10" Foreground="{x:Bind StatusForegroundColor, Mode=OneWay}"/>
                                                <TextBlock Text="{x:Bind UpdateStatusDisplay, Mode=OneWay}" Foreground="{x:Bind StatusForegroundColor, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Action Button / State Pill -->
                                    <Grid Grid.Column="5" VerticalAlignment="Center">
                                        <!-- Normal Update Button (Available) -->
                                        <Button Visibility="{x:Bind IsAvailable, Mode=OneWay}" Content="{x:Bind ActionBtnText, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource PrimaryAccentGradient}" Foreground="White" Click="OnUpdateSingleClick" IsEnabled="{x:Bind CanUpdate, Mode=OneWay}" VerticalAlignment="Center" Padding="14,5" CornerRadius="14" FontWeight="SemiBold" FontSize="11.5"
                                                AutomationProperties.Name="{x:Bind ActionBtnText, Mode=OneWay}"
                                                AutomationProperties.HelpText="Starts the update process for this application."/>

                                        <!-- Retry Button (Failed) -->
                                        <Button Visibility="{x:Bind IsFailed, Mode=OneWay}" Click="OnUpdateSingleClick" Background="{ThemeResource AppStatusDangerBackground}" Foreground="{ThemeResource AppStatusDangerBrush}" BorderBrush="{ThemeResource AppStatusDangerBorder}" BorderThickness="1" VerticalAlignment="Center" Padding="12,5" CornerRadius="14" FontWeight="SemiBold" FontSize="11"
                                                AutomationProperties.Name="Retry Failed Update"
                                                AutomationProperties.HelpText="Attempts to restart the failed update.">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE72C;" FontSize="10" Foreground="{ThemeResource AppStatusDangerBrush}"/>
                                                <TextBlock Text="Retry" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppStatusDangerBrush}"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Up to Date Pill Badge (Completed) -->
                                        <Border Visibility="{x:Bind IsCompleted, Mode=OneWay}" Background="{ThemeResource AppStatusGoodBackground}" BorderBrush="{ThemeResource AppStatusGoodBorder}" BorderThickness="1" Padding="12,5" CornerRadius="14">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource AppStatusGoodBrush}"/>
                                                <TextBlock Text="Up to Date" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppStatusGoodBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Updating Badge Pill (Updating) -->
                                        <Border Visibility="{x:Bind IsUpdating, Mode=OneWay}" Background="{ThemeResource AppStatusWarningBackground}" BorderBrush="{ThemeResource AppStatusWarningBorder}" BorderThickness="1" Padding="10,5" CornerRadius="14">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <ProgressRing IsActive="True" Width="11" Height="11" Foreground="{ThemeResource AppStatusWarningBrush}"/>
                                                <TextBlock Text="Updating..." FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AppStatusWarningBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Skeleton Shimmer Loading State (While WinGet queries packages) -->
            <Border Visibility="{x:Bind IsListLoading(ViewModel.Updates.Count, ViewModel.IsBusy), Mode=OneWay}" Padding="12">
                <controls:SkeletonCardControl />
            </Border>

            <!-- Empty State (Aura Glass Synced) -->
            <Grid Visibility="{x:Bind IsListEmpty(ViewModel.Updates.Count, ViewModel.IsBusy), Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,20">
                <Border Background="{ThemeResource AppCardBackground}" BorderBrush="{ThemeResource AppCardBorder}" BorderThickness="1" CornerRadius="16" Padding="32,24" MaxWidth="440">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="28" Background="{ThemeResource AppStatusGoodBackground}" BorderBrush="{ThemeResource AppStatusGoodBorder}" BorderThickness="1.5" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE73E;" FontSize="26" Foreground="{ThemeResource AppStatusGoodBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Source='All Applications Up to Date', Converter={StaticResource TranslationConverter}}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display"/>
                            <TextBlock Text="{Binding Source='No pending software updates detected for your system.', Converter={StaticResource TranslationConverter}}" FontSize="11.5" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Background="{ThemeResource AppStatChipBackground}" BorderBrush="{ThemeResource AppStatChipBorder}" BorderThickness="1" CornerRadius="8" Padding="12,6" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE777;" FontSize="11" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock Text="{Binding Source='WinGet Repository &amp; Direct Channel Synced', Converter={StaticResource TranslationConverter}}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
            </Grid>
        </Grid>
    </Grid>
    </Grid>
</Page>
